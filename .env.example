# ────────────────────────────────────────────────────────────────
# MusicEncyclopedia docker-compose environment (copy to `.env`, never commit)
# ────────────────────────────────────────────────────────────────

# REQUIRED — SQL Server sa password (min 8 chars; upper, lower, digit, symbol).
# Avoid characters that break the SQL connection string / YAML: ; $ # @ and quotes.
MSSQL_SA_PASSWORD=ChangeMe!1234

# Optional — first administrator created on startup (roles + permissions seeded
# regardless; the admin user is only created when ADMIN_EMAIL is set).
# Login uses the email as the user name (same as self-registration).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!5678

# Public site URL (used for sitemaps / canonical / hreflang)
SITE_BASE_URL=https://example.com

# Set true when TLS terminates at an upstream proxy (nginx/Caddy/LB) so
# X-Forwarded-For/Proto are honored; keep false when the app is directly exposed.
BEHIND_PROXY=false
# Redirect HTTP→HTTPS inside the app. Default false in the container: the web
# service listens on plain HTTP 8080 and the proxy terminates TLS, so the app must
# NOT redirect (it would loop to a non-existent HTTPS port).
ENABLE_HTTPS_REDIRECTION=false

# CDN base URL for media (empty = serve from the app's own /media)
CDN_BASE_URL=

# Seed demo content on first boot (false for production)
SEED_SAMPLE_CONTENT=false

# Port mappings
WEB_PORT=8080
MSSQL_PORT=1433

# SQL Server edition: Express | Developer | Standard | Enterprise
MSSQL_PID=Express
