{
  "DatabaseProvider": "SqlServer",

  // Connection string template. In production this is normally overridden via
  // environment variables (ConnectionStrings__DefaultConnection) or the host's
  // secret store — never commit real credentials.
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=MusicEncyclopedia;User Id=sa;Password=ChangeMe!1234;TrustServerCertificate=True;Encrypt=True"
  },

  "Site": {
    "BaseUrl": "https://example.com",
    "BehindProxy": false,
    "EnableHttpsRedirection": true
  },

  "Media": {
    "StoragePath": "media",
    "CdnBaseUrl": "https://cdn.example.com"
  },

  "Search": {
    "Provider": "SqlServerFullText",
    "PageSize": 20
  },

  "Cache": {
    "Provider": "Memory",
    "DefaultPublicPageMinutes": 10
  },

  // Startup database behaviour (see Program.cs + DatabaseInitializer).
  "Seed": {
    "OnStartup": true,
    // false = lookup data only. Set true only for demo/staging environments.
    "SampleContent": false,
    // false = never create the built-in default admin (admin@example.com /
    // Admin@123456) in production — supply Admin:Email/Admin:Password instead.
    "AdminUser": false
  },

  // First-run administrator (created when Admin:Email is set — normally via env).
  "Admin": {
    "Email": "",
    "Password": ""
  },

  // Tuned for production: endpoint-aware limits, stricter search/login quotas.
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 120
      },
      {
        "Endpoint": "*/search",
        "Period": "1m",
        "Limit": 30
      },
      {
        "Endpoint": "*/auth/login",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "*/api/*",
        "Period": "1m",
        "Limit": 60
      }
    ]
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },

  "AllowedHosts": "*"
}
