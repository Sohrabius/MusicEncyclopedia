@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model MusicEncyclopedia.Web.ViewModels.Public.SourceDetailViewModel

@{
    var culture = Context.Items["culture"] as string ?? "fa";
    var dir = Context.Items["dir"] as string ?? "ltr";
    var source = Model.Source;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" dir="@dir">
    <nav aria-label="@Localizer["Breadcrumb"]" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
            <li><a href="/@culture" class="hover:text-blue-600">@Localizer["Home"]</a></li>
            <li><a href="/@culture/sources" class="hover:text-blue-600 ms-1">@Localizer["Sources"]</a></li>
            <li><span class="mx-1">/</span></li>
            <li class="text-gray-900 font-medium truncate max-w-[300px]" aria-current="page">@source.Title</li>
        </ol>
    </nav>

    <div class="flex flex-col lg:flex-row gap-8">
        <div class="flex-1 min-w-0 space-y-8">
            <section>
                <h1 class="text-3xl font-bold text-gray-900">@source.Title</h1>
                <div class="flex flex-wrap gap-3 mt-3">
                    @if (!string.IsNullOrWhiteSpace(source.SourceTypeName))
                    {
                        <span class="inline-block bg-teal-100 text-teal-800 text-sm font-medium px-3 py-1 rounded-full">@source.SourceTypeName</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(source.Author))
                    {
                        <span class="text-sm text-gray-600"><i class="fas fa-user text-gray-400 me-1"></i> @source.Author</span>
                    }
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(source.PublisherName) || source.PublicationDate.HasValue || !string.IsNullOrWhiteSpace(source.Url))
            {
                <section class="bg-white rounded-lg p-5 border border-gray-200">
                    <h2 class="text-lg font-semibold text-gray-900 mb-3">@Localizer["Publication Details"]</h2>
                    <dl class="space-y-2 text-sm">
                        @if (!string.IsNullOrWhiteSpace(source.PublisherName))
                        {
                            <div class="flex gap-2">
                                <dt class="text-gray-500 w-24 flex-shrink-0">@Localizer["Publisher"]</dt>
                                <dd class="text-gray-900">@source.PublisherName</dd>
                            </div>
                        }
                        @if (source.PublicationDate.HasValue)
                        {
                            <div class="flex gap-2">
                                <dt class="text-gray-500 w-24 flex-shrink-0">@Localizer["Date"]</dt>
                                <dd class="text-gray-900">@source.PublicationDate.Value.ToString("yyyy-MM-dd")</dd>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(source.Url))
                        {
                            <div class="flex gap-2">
                                <dt class="text-gray-500 w-24 flex-shrink-0">URL</dt>
                                <dd><a href="@source.Url" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800 break-all">@source.Url <i class="fas fa-external-link-alt text-xs ms-1"></i></a></dd>
                            </div>
                        }
                    </dl>
                </section>
            }

            @if (source.Citations.Count > 0)
            {
                <section>
                    <h2 class="text-lg font-semibold text-gray-900 mb-3">@Localizer["Cited Facts"]</h2>
                    <div class="space-y-3">
                        @foreach (var citation in source.Citations)
                        {
                            <div class="bg-white rounded-lg border border-gray-200 p-4">
                                @if (!string.IsNullOrWhiteSpace(citation.Quote))
                                {
                                    <blockquote class="italic border-s-4 border-gray-300 ps-3 mb-2 text-gray-700">@citation.Quote</blockquote>
                                }
                                <div class="flex flex-wrap gap-2 text-xs text-gray-500">
                                    @if (!string.IsNullOrWhiteSpace(citation.EntityTitle))
                                    {
                                        <span class="inline-block bg-blue-50 text-blue-700 px-2 py-0.5 rounded">@citation.EntityTitle</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(citation.FieldName))
                                    {
                                        <span>@Localizer["Field"]: @citation.FieldName</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(citation.PageNumber))
                                    {
                                        <span>@Localizer["Page"]: @citation.PageNumber</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>

        <aside class="w-full lg:w-72 space-y-4">
            <div class="bg-white rounded-lg border border-gray-200 p-4">
                <h3 class="text-sm font-semibold text-gray-700 mb-2">@Localizer["Source Info"]</h3>
                <dl class="space-y-1 text-sm">
                    <div class="flex justify-between"><dt class="text-gray-500">@Localizer["Type"]</dt><dd class="text-gray-900">@(source.SourceTypeName ?? "—")</dd></div>
                    <div class="flex justify-between"><dt class="text-gray-500">@Localizer["Author"]</dt><dd class="text-gray-900">@(source.Author ?? "—")</dd></div>
                    <div class="flex justify-between"><dt class="text-gray-500">@Localizer["Citations"]</dt><dd class="text-gray-900">@source.Citations.Count</dd></div>
                </dl>
            </div>
        </aside>
    </div>
</div>

<!-- ============================================================
     JSON-LD Structured Data: CreativeWork (Source)
     ============================================================ -->
@section StructuredData {
<script type="application/ld+json">
{
    "@@context": "https://schema.org",
    "@@type": "CreativeWork",
    "name": "@Model.Source.Title",
    @if (!string.IsNullOrWhiteSpace(Model.Source.Author))
    {
        <text>"author": {
            "@@type": "Person",
            "name": "@Model.Source.Author"
        },</text>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Source.PublisherName))
    {
        <text>"publisher": {
            "@@type": "Organization",
            "name": "@Model.Source.PublisherName"
        },</text>
    }
    @if (Model.Source.PublicationDate.HasValue)
    {
        <text>"datePublished": "@Model.Source.PublicationDate.Value.ToString("yyyy-MM-dd")",</text>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Source.Url))
    {
        <text>"url": "@Model.Source.Url",</text>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Source.SourceTypeName))
    {
        <text>"additionalType": "@Model.Source.SourceTypeName",</text>
    }
    "inLanguage": "@culture"
}
</script>
}
