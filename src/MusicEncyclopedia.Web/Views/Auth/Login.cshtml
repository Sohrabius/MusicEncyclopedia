@inject IStringLocalizer<SharedResources> Localizer

@model MusicEncyclopedia.Web.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = Localizer["Login"];
    var dir = Context.Items["dir"] as string ?? "ltr";
    var isRtl = dir == "rtl";
    var culture = Context.Items["culture"] as string ?? "fa";
}

<div class="min-h-[60vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="w-full max-w-md">
        <!-- Header -->
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-ink">@Localizer["Sign in to your account"]</h1>
            <p class="mt-2 text-sm text-ink-secondary">
                @Localizer["Or"]
                <a href="/auth/register" class="font-medium text-accent hover:text-accent transition-colors">
                    @Localizer["create a new account"]
                </a>
            </p>
        </div>

        <!-- Login Form -->
        <form asp-controller="Auth" asp-action="Login" asp-route-returnurl="@Model.ReturnUrl" method="post" class="bg-surface shadow-md rounded-xl px-8 pt-6 pb-8 mb-4" novalidate>
            @Html.AntiForgeryToken()

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-error" role="alert"></div>

            <!-- Email -->
            <div class="mb-5">
                <label asp-for="Email" class="form-label">@Localizer["Email"]</label>
                <input asp-for="Email"
                       type="email"
                       autocomplete="email"
                       placeholder="@Localizer["you@example.com"]"
                       class="form-control @(isRtl ? "text-right" : "")"
                       dir="auto" />
                <span asp-validation-for="Email" aria-live="polite" class="field-error"></span>
            </div>

            <!-- Password -->
            <div class="mb-5">
                <label asp-for="Password" class="form-label">@Localizer["Password"]</label>
                <input asp-for="Password"
                       autocomplete="current-password"
                       class="form-control @(isRtl ? "text-right" : "")" />
                <span asp-validation-for="Password" aria-live="polite" class="field-error"></span>
            </div>

            <!-- Remember Me & Forgot Password -->
            <div class="flex items-center justify-between mb-6">
                <label class="flex items-center gap-2 text-sm text-ink-secondary cursor-pointer">
                    <input asp-for="RememberMe" class="w-4 h-4 text-accent border-rule-strong rounded focus-visible:ring-accent" />
                    @Localizer["Remember me"]
                </label>
                <a href="/auth/forgot-password" class="text-sm font-medium text-accent hover:text-accent transition-colors">
                    @Localizer["Forgot password?"]
                </a>
            </div>

            <!-- Submit -->
            <button type="submit"
                    class="w-full bg-accent hover:bg-accent-hover text-on-accent font-semibold py-2.5 px-4 rounded-lg transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2">
                @Localizer["Sign in"]
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
