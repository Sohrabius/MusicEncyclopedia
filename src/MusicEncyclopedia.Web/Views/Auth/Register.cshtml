@inject IStringLocalizer<SharedResources> Localizer

@model MusicEncyclopedia.Web.ViewModels.Account.RegisterViewModel

@{
    ViewData["Title"] = Localizer["Register"];
    var dir = Context.Items["dir"] as string ?? "ltr";
    var isRtl = dir == "rtl";
}

<div class="min-h-[60vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="w-full max-w-md">
        <!-- Header -->
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-900">@Localizer["Create a new account"]</h1>
            <p class="mt-2 text-sm text-gray-600">
                @Localizer["Or"]
                <a href="/auth/login" class="font-medium text-blue-600 hover:text-blue-500 transition-colors">
                    @Localizer["sign in to your existing account"]
                </a>
            </p>
        </div>

        <!-- Register Form -->
        <form asp-controller="Auth" asp-action="Register" asp-route-returnurl="@Model.ReturnUrl" method="post" class="bg-white shadow-md rounded-xl px-8 pt-6 pb-8 mb-4" novalidate>
            @Html.AntiForgeryToken()

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-600" role="alert"></div>

            <!-- Email -->
            <div class="mb-5">
                <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1">@Localizer["Email"]</label>
                <input asp-for="Email"
                       type="email"
                       autocomplete="email"
                       placeholder="@Localizer["you@example.com"]"
                       class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors @(isRtl ? "text-right" : "")"
                       dir="auto" />
                <span asp-validation-for="Email" class="text-sm text-red-600 mt-1"></span>
            </div>

            <!-- Password -->
            <div class="mb-5">
                <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1">@Localizer["Password"]</label>
                <input asp-for="Password"
                       autocomplete="new-password"
                       class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors @(isRtl ? "text-right" : "")" />
                <span asp-validation-for="Password" class="text-sm text-red-600 mt-1"></span>
                <p class="text-xs text-gray-500 mt-1">@Localizer["At least 10 characters with uppercase, lowercase, digit, and special character."]</p>
            </div>

            <!-- Confirm Password -->
            <div class="mb-6">
                <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700 mb-1">@Localizer["Confirm password"]</label>
                <input asp-for="ConfirmPassword"
                       autocomplete="new-password"
                       class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors @(isRtl ? "text-right" : "")" />
                <span asp-validation-for="ConfirmPassword" class="text-sm text-red-600 mt-1"></span>
            </div>

            <!-- Submit -->
            <button type="submit"
                    class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-4 rounded-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                @Localizer["Register"]
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
