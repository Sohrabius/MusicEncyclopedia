@inject IStringLocalizer<SharedResources> Localizer

@model MusicEncyclopedia.Web.ViewModels.Account.ForgotPasswordViewModel

@{
    ViewData["Title"] = Localizer["Forgot Password"];
    var dir = Context.Items["dir"] as string ?? "ltr";
    var isRtl = dir == "rtl";
}

<div class="min-h-[60vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="w-full max-w-md">
        <!-- Header -->
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-ink">@Localizer["Forgot your password?"]</h1>
            <p class="mt-2 text-sm text-ink-secondary">
                @Localizer["Enter your email address and we will send you a link to reset your password."]
            </p>
        </div>

        <!-- Forgot Password Form -->
        <form asp-controller="Auth" asp-action="ForgotPassword" method="post" class="bg-surface shadow-md rounded-xl px-8 pt-6 pb-8 mb-4" novalidate>
            @Html.AntiForgeryToken()

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-error" role="alert"></div>

            <!-- Email -->
            <div class="mb-6">
                <label asp-for="Email" class="form-label">@Localizer["Email"]</label>
                <input asp-for="Email"
                       type="email"
                       autocomplete="email"
                       placeholder="@Localizer["you@example.com"]"
                       class="form-control @(isRtl ? "text-right" : "")"
                       dir="auto" />
                <span asp-validation-for="Email" aria-live="polite" class="field-error"></span>
            </div>

            <!-- Submit -->
            <button type="submit"
                    class="w-full bg-accent hover:bg-accent-hover text-on-accent font-semibold py-2.5 px-4 rounded-lg transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2">
                @Localizer["Send reset link"]
            </button>

            <!-- Back to Login -->
            <div class="text-center mt-4">
                <a href="/auth/login" class="text-sm font-medium text-accent hover:text-accent transition-colors">
                    @Localizer["Back to login"]
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
