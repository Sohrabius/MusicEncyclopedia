@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model MusicEncyclopedia.Web.ViewModels.Public.SessionListViewModel

@{
    var culture = Context.Items["culture"] as string ?? "fa";
    var dir = Context.Items["dir"] as string ?? "ltr";
    var isRtl = dir == "rtl";
    var items = Model.Items;
}

<link rel="canonical" href="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}{Context.Request.Path}")" />

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" dir="@dir">
    <div class="mb-8">
        <h1 class="text-3xl md:text-4xl font-bold text-ink">@Localizer["Recording Sessions"]</h1>
        <p class="mt-2 text-ink-secondary">@Localizer["Browse recording sessions"]</p>
    </div>

    @if (items.Items.Count == 0)
    {
        <div class="text-center py-16">
            <i aria-hidden="true" class="fas fa-circle text-5xl text-ink-disabled mb-4 block"></i>
            <h3 class="text-lg font-medium text-ink">@Localizer["No sessions found"]</h3>
        </div>
    }
    else
    {
        <p class="text-sm text-ink-muted mb-4">
            @Localizer["Showing {0}–{1} of {2} sessions",
                ((items.Page - 1) * items.PageSize) + 1,
                Math.Min(items.Page * items.PageSize, items.TotalItems),
                items.TotalItems]
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var session in items.Items)
            {
                <article class="bg-surface rounded-lg border border-rule overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                    <a href="/@culture/sessions/@session.Slug" class="block p-5">
                        <div class="flex items-center gap-2 mb-2">
                            @if (!string.IsNullOrWhiteSpace(session.SessionTypeName))
                            {
                                <span class="inline-block bg-accent-soft text-accent-hover text-xs font-medium px-2 py-0.5 rounded-full">
                                    @session.SessionTypeName
                                </span>
                            }
                            @if (session.StartDate.HasValue)
                            {
                                <span class="text-xs text-ink-muted">@session.StartDate.Value.ToString("yyyy-MM-dd")</span>
                            }
                            @if (session.EndDate.HasValue && session.EndDate != session.StartDate)
                            {
                                <span class="text-xs text-ink-muted">– @session.EndDate.Value.ToString("yyyy-MM-dd")</span>
                            }
                        </div>
                        <h3 class="font-semibold text-ink">@session.Slug</h3>
                        @if (!string.IsNullOrWhiteSpace(session.LocationName))
                        {
                            <p class="text-sm text-ink-muted mt-1">
                                <i aria-hidden="true" class="fas fa-map-marker-alt text-ink-muted me-1"></i> @session.LocationName
                            </p>
                        }
                        @if (!string.IsNullOrWhiteSpace(session.NotesPreview))
                        {
                            <p class="text-sm text-ink-secondary mt-2 line-clamp-2">@session.NotesPreview</p>
                        }
                    </a>
                </article>
            }
        </div>

        if (items.TotalPages > 1)
        {
            <nav class="mt-10 flex items-center justify-center gap-1" aria-label="@Localizer["Pagination"]">
                @if (items.Page > 1)
                {
                    <a href="/@culture/sessions?page=@(items.Page - 1)"
                       class="px-3 py-2 text-sm font-medium text-ink-secondary bg-surface border border-rule-strong rounded-md hover:bg-paper"
                       rel="prev">@Localizer["Previous"]</a>
                }
                <span class="px-3 py-2 text-sm font-medium text-on-accent bg-accent border border-accent rounded-md">@items.Page</span>
                @if (items.Page < items.TotalPages)
                {
                    <a href="/@culture/sessions?page=@(items.Page + 1)"
                       class="px-3 py-2 text-sm font-medium text-ink-secondary bg-surface border border-rule-strong rounded-md hover:bg-paper"
                       rel="next">@Localizer["Next"]</a>
                }
            </nav>
        }
    }
</div>
