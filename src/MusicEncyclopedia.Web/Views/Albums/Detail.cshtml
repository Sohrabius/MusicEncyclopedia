@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model MusicEncyclopedia.Web.ViewModels.Public.AlbumDetailViewModel

@{
    var culture = Context.Items["culture"] as string ?? "fa";
    var dir = Context.Items["dir"] as string ?? "ltr";
    var isRtl = dir == "rtl";
    var album = Model.Album;

    var displayDuration = album.DurationSeconds.HasValue
        ? TimeSpan.FromSeconds(album.DurationSeconds.Value)
        : album.Tracks.Count > 0
            ? TimeSpan.FromSeconds(album.Tracks.Sum(t => t.DurationSecondsOverride ?? t.DurationSeconds ?? 0))
            : (TimeSpan?)null;

    var tracksByDisc = album.Tracks
        .GroupBy(t => t.DiscNumber)
        .OrderBy(g => g.Key)
        .ToList();

    var creditsByRole = album.Credits
        .OrderBy(c => c.RoleDisplayOrder)
        .ThenBy(c => c.DisplayOrder)
        .ThenBy(c => c.PersonFullName ?? c.CompanyName)
        .GroupBy(c => c.RoleName)
        .ToList();

    var primaryArtists = album.Credits
        .Where(c => c.RoleCode is "PRIMARY_ARTIST" or "FEATURED_ARTIST" or "GUEST_ARTIST" || c.IsPrimary)
        .OrderBy(c => c.RoleCode == "PRIMARY_ARTIST" ? 0 : 1)
        .ThenBy(c => c.DisplayOrder)
        .ToList();

    var purchaseLinks = album.Links.Where(l => l.LinkType is "PURCHASE" or "STORE" or "BUY").ToList();
    var streamingLinks = album.Links.Where(l => l.LinkType is "STREAM" or "STREAMING" or "LISTEN").ToList();
    var videoLinks = album.Links.Where(l => l.LinkType is "VIDEO" or "MUSIC_VIDEO").ToList();
}

<!-- Breadcrumb -->
<nav class="page-breadcrumb">
    <div class="page-frame">
        <ol class="breadcrumb">
            <li><a href="/@culture">Home</a></li>
            <li class="breadcrumb__sep">/</li>
            <li><a href="/@culture/albums">Albums</a></li>
            <li class="breadcrumb__sep">/</li>
            <li class="breadcrumb__current">@album.Title</li>
        </ol>
    </div>
</nav>

<!-- Header -->
<section class="detail-intro">
    <div class="page-frame">
        <div class="detail-header">
            <div class="detail-header__cover">
                @if (!string.IsNullOrWhiteSpace(album.CoverUrl))
                {
                    <img src="@album.CoverUrl" alt="@album.Title" width="400" height="400" />
                }
                else
                {
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="48" height="48">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
                    </svg>
                }
            </div>
            <div class="detail-header__info">
                <h1 class="detail-header__title">@album.Title</h1>

                @if (!string.IsNullOrWhiteSpace(album.OriginalTitle) && album.OriginalTitle != album.Title)
                {
                    <p class="detail-header__original-title" dir="auto">@album.OriginalTitle</p>
                }
                @if (!string.IsNullOrWhiteSpace(album.EnglishTitle) && album.EnglishTitle != album.Title && album.EnglishTitle != album.OriginalTitle)
                {
                    <p class="detail-header__english-title" dir="ltr">@album.EnglishTitle</p>
                }

                <div class="detail-header__meta">
                    @if (!string.IsNullOrWhiteSpace(album.CategoryName))
                    {
                        <span class="tag tag--accent">@album.CategoryName</span>
                    }
                    @if (album.ReleaseDate.HasValue)
                    {
                        <span>@Localizer["Released"]: @album.ReleaseDate.Value.ToString("yyyy-MM-dd")</span>
                    }
                    @if (displayDuration.HasValue)
                    {
                        <span>@Localizer["Duration"]: @(displayDuration.Value.Hours > 0 ? $"{displayDuration.Value.Hours}h " : "")@displayDuration.Value.Minutes@Localizer["min"]</span>
                    }
                </div>

                @if (primaryArtists.Count > 0)
                {
                    <div class="detail-header__artists">
                        <h2>@Localizer["Artists"]</h2>
                        <div class="detail-header__artist-list">
                            @foreach (var artist in primaryArtists)
                            {
                                <a href="/@culture/people/@(artist.PersonSlug ?? artist.CompanySlug)" class="tag">
                                    @(artist.PersonFullName ?? artist.CompanyName)
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Content -->
<div class="detail-layout">
    <!-- Main -->
    <div class="detail-main">

        <!-- Streaming & Purchase Links -->
        @if (purchaseLinks.Count > 0 || streamingLinks.Count > 0 || videoLinks.Count > 0)
        {
            <section class="detail-section">
                <h2 class="detail-section__title">@Localizer["Listen & Purchase"]</h2>
                <div class="stream-links">
                    @foreach (var link in streamingLinks.Take(4))
                    {
                        <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="stream-link stream-link--green">
                            @(!string.IsNullOrWhiteSpace(link.Title) ? link.Title : Localizer["Stream"])
                        </a>
                    }
                    @foreach (var link in purchaseLinks.Take(4))
                    {
                        <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="stream-link stream-link--ink">
                            @(!string.IsNullOrWhiteSpace(link.Title) ? link.Title : Localizer["Buy"])
                        </a>
                    }
                    @foreach (var link in videoLinks.Take(2))
                    {
                        <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="stream-link stream-link--accent">
                            @(!string.IsNullOrWhiteSpace(link.Title) ? link.Title : Localizer["Video"])
                        </a>
                    }
                </div>
            </section>
        }

        <!-- Description & Tags -->
        @if (!string.IsNullOrWhiteSpace(album.Description) || album.Tags.Count > 0 || album.Genres.Count > 0 || album.Moods.Count > 0)
        {
            <section class="detail-section">
                <h2 class="detail-section__title">@Localizer["Summary"]</h2>

                @if (!string.IsNullOrWhiteSpace(album.Description))
                {
                    <p class="detail-description">@album.Description</p>
                }

                @if (album.Tags.Count > 0)
                {
                    <div class="detail-subsection">
                        <h3 class="detail-subsection__title">@Localizer["Tags"]</h3>
                        <div class="tag-list">
                            @foreach (var tag in album.Tags)
                            {
                                <a href="/@culture/tags/@tag.Slug" class="tag">#@tag.Name</a>
                            }
                        </div>
                    </div>
                }

                @if (album.Genres.Count > 0)
                {
                    <div class="detail-subsection">
                        <h3 class="detail-subsection__title">@Localizer["Genres"]</h3>
                        <div class="tag-list">
                            @foreach (var genre in album.Genres)
                            {
                                <a href="/@culture/genres/@genre.Slug" class="tag tag--accent">@genre.Name</a>
                            }
                        </div>
                    </div>
                }

                @if (album.Moods.Count > 0)
                {
                    <div class="detail-subsection">
                        <h3 class="detail-subsection__title">@Localizer["Moods"]</h3>
                        <div class="tag-list">
                            @foreach (var mood in album.Moods)
                            {
                                <a href="/@culture/moods/@mood.Slug" class="tag">@mood.Name</a>
                            }
                        </div>
                    </div>
                }
            </section>
        }

        <!-- Tracklist -->
        @if (tracksByDisc.Count > 0)
        {
            <section class="detail-section">
                <h2 class="detail-section__title">@Localizer["Tracklist"]</h2>

                @foreach (var discGroup in tracksByDisc)
                {
                    @if (tracksByDisc.Count > 1)
                    {
                        <h3 class="track-disc-heading">
                            @(discGroup.Key == 0 ? Localizer["Tracks"] : Localizer["Disc {0}", discGroup.Key])
                        </h3>
                    }

                    @foreach (var track in discGroup.OrderBy(t => t.TrackNumber).ThenBy(t => t.SequenceNumber))
                    {
                        var displayTitle = !string.IsNullOrWhiteSpace(track.TrackTitleOverride)
                            ? track.TrackTitleOverride
                            : track.Title;
                        var trackDurationSeconds = track.DurationSecondsOverride ?? track.DurationSeconds;

                        <div class="track-row">
                            <div class="track-row__num">
                                @track.TrackNumber
                                @if (track.IsBonus)
                                {
                                    <span title="@Localizer["Bonus track"]">*</span>
                                }
                            </div>
                            <div class="track-row__info">
                                <a href="/@culture/tracks/@track.Slug" class="track-row__title">
                                    @displayTitle
                                </a>
                                @if (track.PrimaryArtists.Count > 0)
                                {
                                    <div class="track-row__artist">@string.Join(", ", track.PrimaryArtists)</div>
                                }
                            </div>
                            <div class="track-row__duration">
                                @if (trackDurationSeconds.HasValue)
                                {
                                    @TimeSpan.FromSeconds(trackDurationSeconds.Value).ToString(@"m\:ss")
                                }
                                else
                                {
                                    <span class="track-row__missing">—</span>
                                }
                            </div>
                        </div>
                    }
                }
            </section>
        }

        <!-- Credits -->
        @if (creditsByRole.Count > 0)
        {
            <section class="detail-section">
                <h2 class="detail-section__title">@Localizer["Credits"]</h2>
                @foreach (var roleGroup in creditsByRole)
                {
                    <div class="credit-group">
                        <h3 class="credit-role">@roleGroup.Key</h3>
                        <ul class="credit-list">
                            @foreach (var credit in roleGroup)
                            {
                                <li>
                                    @if (credit.PersonId.HasValue)
                                    {
                                        <a href="/@culture/people/@credit.PersonSlug" class="detail-link">@credit.PersonFullName</a>
                                        @if (!string.IsNullOrWhiteSpace(credit.InstrumentName))
                                        {
                                            <span class="credit-list__secondary"> — @credit.InstrumentName</span>
                                        }
                                    }
                                    else if (credit.CompanyId.HasValue)
                                    {
                                        <a href="/@culture/companies/@credit.CompanySlug" class="detail-link">@credit.CompanyName</a>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }
            </section>
        }

        <!-- Companies -->
        @if (album.Companies.Count > 0)
        {
            <section class="detail-section">
                <h2 class="detail-section__title">@Localizer["Companies"]</h2>
                <div class="detail-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>@Localizer["Role"]</th>
                                <th>@Localizer["Company"]</th>
                                <th>@Localizer["Catalog Number"]</th>
                                <th>@Localizer["Barcode"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var company in album.Companies)
                            {
                                <tr>
                                    <td>@company.CompanyRole</td>
                                    <td><a href="/@culture/companies/@company.CompanySlug" class="detail-link">@company.CompanyName</a></td>
                                    <td class="detail-table__code">@(company.CatalogNumber ?? "—")</td>
                                    <td class="detail-table__code">@(company.Barcode ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        <!-- Awards -->
        @if (album.Awards.Count > 0)
        {
            <section class="detail-section">
                <h2 class="detail-section__title">@Localizer["Awards & Nominations"]</h2>
                @foreach (var award in album.Awards.OrderByDescending(a => a.Year))
                {
                    <div class="track-row">
                        <div class="track-row__num track-row__num--award">
                            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                            </svg>
                        </div>
                        <div class="track-row__info">
                            <div class="track-row__title">
                                <a href="/@culture/awards/@award.AwardSlug" class="detail-link">@award.AwardName</a>
                                @if (!string.IsNullOrWhiteSpace(award.Category))
                                {
                                    <span class="credit-list__secondary"> — @award.Category</span>
                                }
                            </div>
                            <div class="track-row__artist">
                                @if (award.Year.HasValue) { <span>@award.Year</span> }
                                @if (!string.IsNullOrWhiteSpace(award.Result))
                                {
                                    <span class="@(award.Result == "Winner" ? "text-success" : "credit-list__secondary")"> · @award.Result</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </section>
        }

        <!-- Certifications -->
        @if (album.Certifications.Count > 0)
        {
            <section class="detail-section">
                <h2 class="detail-section__title">@Localizer["Certifications"]</h2>
                @foreach (var cert in album.Certifications.OrderByDescending(c => c.CertificationDate))
                {
                    <div class="track-row">
                        <div class="track-row__num track-row__num--certification">
                            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div class="track-row__info">
                            <div class="track-row__title">@cert.CertificationName</div>
                            <div class="track-row__artist">
                                @if (!string.IsNullOrWhiteSpace(cert.Country)) { <span>@cert.Country</span> }
                                @if (cert.CertificationDate.HasValue) { <span> · @cert.CertificationDate.Value.ToString("yyyy-MM-dd")</span> }
                            </div>
                        </div>
                    </div>
                }
            </section>
        }

        <!-- Chart History -->
        @if (album.ChartEntries.Count > 0)
        {
            <section class="detail-section">
                <h2 class="detail-section__title">@Localizer["Chart History"]</h2>
                <div class="detail-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>@Localizer["Chart"]</th>
                                <th>@Localizer["Date"]</th>
                                <th class="detail-table__center">@Localizer["Position"]</th>
                                <th class="detail-table__center">@Localizer["Previous"]</th>
                                <th class="detail-table__center">@Localizer["Weeks"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in album.ChartEntries.OrderByDescending(e => e.Date))
                            {
                                <tr>
                                    <td><a href="/@culture/charts/@entry.ChartSlug" class="detail-link">@entry.ChartName</a></td>
                                    <td>@entry.Date.ToString("yyyy-MM-dd")</td>
                                    <td class="detail-table__center"><strong>@entry.Position</strong></td>
                                    <td class="detail-table__center">@(entry.PreviousPosition?.ToString() ?? "—")</td>
                                    <td class="detail-table__center">@(entry.WeeksOnChart?.ToString() ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        <!-- Related Albums (4.3) -->
        @if (album.RelatedAlbums.Count > 0)
        {
            <section class="detail-section">
                <h2 class="detail-section__title">@Localizer["Related Albums"]</h2>
                <div class="card-grid related-albums-grid">
                    @foreach (var related in album.RelatedAlbums)
                    {
                        <a href="/@culture/albums/@related.Slug" class="card">
                            <div class="card__image">
                                @if (!string.IsNullOrWhiteSpace(related.CoverUrl))
                                {
                                    <img src="@related.CoverUrl" alt="@related.Title" loading="lazy" />
                                }
                                else
                                {
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
                                    </svg>
                                }
                            </div>
                            <div class="card__body">
                                <div class="card__title" title="@related.Title">@related.Title</div>
                                <div class="card__meta">
                                    @if (!string.IsNullOrWhiteSpace(related.RelationName))
                                    {
                                        <span class="tag tag--accent">@related.RelationName</span>
                                    }
                                    @if (related.ReleaseDate.HasValue)
                                    {
                                        <span>@related.ReleaseDate.Value.Year</span>
                                    }
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </section>
        }

        <!-- Recording Sessions (4.3) -->
        @if (album.RecordingSessions.Count > 0)
        {
            <section class="detail-section">
                <h2 class="detail-section__title">@Localizer["Recording Sessions"]</h2>
                <div class="detail-stack">
                    @foreach (var session in album.RecordingSessions.OrderByDescending(s => s.StartDate))
                    {
                        <div class="track-row">
                            <div class="track-row__num track-row__num--session">
                                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <div class="track-row__info">
                                <a href="/@culture/sessions/@session.Slug" class="track-row__title">
                                    @(session.SessionTypeName ?? Localizer["Recording Session"].ToString())
                                </a>
                                <div class="track-row__artist">
                                    @if (session.StartDate.HasValue) { <span>@session.StartDate.Value.ToString("yyyy-MM-dd")</span> }
                                    @if (!string.IsNullOrWhiteSpace(session.LocationName)) { <span> · @session.LocationName</span> }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

        <!-- Performance Events (4.3) -->
        @if (album.PerformanceEvents.Count > 0)
        {
            <section class="detail-section">
                <h2 class="detail-section__title">@Localizer["Live Performances"]</h2>
                <div class="detail-stack">
                    @foreach (var evt in album.PerformanceEvents.OrderByDescending(e => e.Date))
                    {
                        <div class="track-row">
                            <div class="track-row__num track-row__num--event">
                                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V7a2 2 0 00-2-2H4a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <div class="track-row__info">
                                <a href="/@culture/events/@evt.Slug" class="track-row__title">
                                    @(evt.EventTypeName ?? Localizer["Live Performance"].ToString())
                                </a>
                                <div class="track-row__artist">
                                    @if (evt.Date.HasValue) { <span>@evt.Date.Value.ToString("yyyy-MM-dd")</span> }
                                    @if (!string.IsNullOrWhiteSpace(evt.LocationName)) { <span> · @evt.LocationName</span> }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

        <!-- Media -->
        @{
            var images = album.Media.Where(m => m.MediaType == "IMAGE").ToList();
            var videos = album.Media.Where(m => m.MediaType == "VIDEO").ToList();
        }
        @if (images.Count > 0 || videos.Count > 0)
        {
            <section class="detail-section">
                <h2 class="detail-section__title">@Localizer["Media"]</h2>
                @if (images.Count > 0)
                {
                    <div class="media-grid">
                        @foreach (var media in images)
                        {
                            <a href="@media.Url" target="_blank" rel="noopener noreferrer" class="card">
                                <div class="card__image">
                                    <img src="@(media.ThumbnailUrl ?? media.Url)" alt="@(media.Description ?? "")" loading="lazy" />
                                </div>
                            </a>
                        }
                    </div>
                }
                @if (videos.Count > 0)
                {
                    @foreach (var media in videos)
                    {
                        <div class="media-video">
                            @if (media.Url.Contains("youtube") || media.Url.Contains("youtu.be"))
                            {
                                <iframe src="@media.Url" allowfullscreen loading="lazy" title="@(media.Description ?? "")"></iframe>
                            }
                            else
                            {
                                <video src="@media.Url" controls preload="none"></video>
                            }
                        </div>
                    }
                }
            </section>
        }

        <!-- Aliases -->
        @if (album.Aliases.Count > 0)
        {
            <section class="detail-section">
                <h2 class="detail-section__title">@Localizer["Also Known As"]</h2>
                @foreach (var alias in album.Aliases)
                {
                    <div class="track-row">
                        <div class="track-row__info">
                            <div class="track-row__title" dir="auto">@alias.AliasName</div>
                            <div class="track-row__artist">
                                @if (!string.IsNullOrWhiteSpace(alias.Language)) { <span>@alias.Language</span> }
                                @if (!string.IsNullOrWhiteSpace(alias.AliasType)) { <span> · @alias.AliasType</span> }
                                @if (alias.IsPrimary) { <span> · @Localizer["Primary"]</span> }
                            </div>
                        </div>
                    </div>
                }
            </section>
        }

        <!-- Citations -->
        @if (album.Citations.Count > 0)
        {
            <section class="detail-section">
                <h2 class="detail-section__title">@Localizer["References"]</h2>
                <ol class="detail-list">
                    @foreach (var citation in album.Citations)
                    {
                        <li>
                            @if (!string.IsNullOrWhiteSpace(citation.Quote))
                            {
                                <strong>"@citation.Quote"</strong>
                            }
                            @if (!string.IsNullOrWhiteSpace(citation.SourceName))
                            {
                                <a href="/@culture/sources/@citation.SourceSlug" class="detail-link">@citation.SourceName</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(citation.Url))
                            {
                                <a href="@citation.Url" target="_blank" rel="noopener noreferrer" class="detail-link citation-source">[@Localizer["Source"]]</a>
                            }
                        </li>
                    }
                </ol>
            </section>
        }

        <!-- External Links -->
        @{
            var otherLinks = album.Links
                .Where(l => l.LinkType is not ("PURCHASE" or "STORE" or "BUY" or "STREAM" or "STREAMING" or "LISTEN" or "VIDEO" or "MUSIC_VIDEO"))
                .ToList();
        }
        @if (otherLinks.Count > 0)
        {
            <section class="detail-section">
                <h2 class="detail-section__title">@Localizer["External Links"]</h2>
                @foreach (var link in otherLinks)
                {
                    <div class="track-row">
                        <div class="track-row__info">
                            <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="detail-link">
                                @(!string.IsNullOrWhiteSpace(link.Title) ? link.Title : link.Url)
                            </a>
                            @if (!string.IsNullOrWhiteSpace(link.LinkType))
                            {
                                <span class="credit-list__secondary"> [@link.LinkType]</span>
                            }
                        </div>
                    </div>
                }
            </section>
        }
    </div>

    <!-- Sidebar -->
    <aside class="detail-sidebar" role="complementary" aria-label="@Localizer["Album metadata"]">
        <div class="detail-sidebar__card">
            <h3 class="detail-sidebar__heading">@Localizer["Details"]</h3>

            @if (album.Languages.Count > 0)
            {
                <div class="detail-sidebar__item">
                    <div class="detail-sidebar__label">@Localizer["Languages"]</div>
                    <div class="detail-sidebar__tags">
                        @foreach (var lang in album.Languages)
                        {
                            <span class="tag">@lang.Name</span>
                        }
                    </div>
                </div>
            }

            @if (album.Countries.Count > 0)
            {
                <div class="detail-sidebar__item">
                    <div class="detail-sidebar__label">@Localizer["Countries"]</div>
                    <div class="detail-sidebar__tags">
                        @foreach (var country in album.Countries)
                        {
                            <span class="tag">@country.Name</span>
                        }
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(album.CopyrightNotice))
            {
                <div class="detail-sidebar__item">
                    <div class="detail-sidebar__label">@Localizer["Copyright"]</div>
                    <div class="detail-sidebar__value">@album.CopyrightNotice</div>
                </div>
            }

            @if (album.Identifiers.Count > 0)
            {
                <div class="detail-sidebar__item">
                    <div class="detail-sidebar__label">@Localizer["Identifiers"]</div>
                    @foreach (var id in album.Identifiers)
                    {
                        <div class="detail-sidebar__identifier">
                            <span class="detail-sidebar__identifier-type">@id.IdentifierType</span>
                            <span class="detail-sidebar__identifier-value">@id.IdentifierValue</span>
                        </div>
                    }
                </div>
            }
        </div>
    </aside>
</div>

<!-- JSON-LD -->
<script type="application/ld+json">
{
    "@@context": "https://schema.org",
    "@@type": "MusicAlbum",
    "name": "@album.Title",
    @if (!string.IsNullOrWhiteSpace(album.OriginalTitle)) { <text>"alternateName": "@album.OriginalTitle",</text> }
    @if (album.ReleaseDate.HasValue) { <text>"datePublished": "@album.ReleaseDate.Value.ToString("yyyy-MM-dd")",</text> }
    @if (!string.IsNullOrWhiteSpace(album.CoverUrl)) { <text>"image": "@album.CoverUrl",</text> }
    @if (album.Tracks.Count > 0) { <text>"numTracks": @album.Tracks.Count,</text> }
    "byArtist": [
        @foreach (var artist in primaryArtists)
        {
            <text>{ "@@type": "@(artist.PersonId.HasValue ? "Person" : "Organization")", "name": "@(artist.PersonFullName ?? artist.CompanyName)" }@(artist != primaryArtists.Last() ? "," : "")</text>
        }
    ]
}
</script>
