@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model MusicEncyclopedia.Web.ViewModels.Public.GenreDetailViewModel

@{
    var culture = Context.Items["culture"] as string ?? "fa";
    var dir = Context.Items["dir"] as string ?? "ltr";
    var isRtl = dir == "rtl";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" dir="@dir">

    <!-- ============================================================
         Breadcrumb
         ============================================================ -->
    <nav aria-label="@Localizer["Breadcrumb"]" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-ink-muted">
            <li><a href="/@culture" class="hover:text-accent transition-colors">@Localizer["Home"]</a></li>
            <li><span class="mx-1">/</span></li>
            <li><a href="/@culture/genres" class="hover:text-accent transition-colors">@Localizer["Genres"]</a></li>
            <li><span class="mx-1">/</span></li>
            <li class="text-ink font-medium truncate max-w-[200px]" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <!-- ============================================================
         1. Header
         ============================================================ -->
    <div class="mb-10">
        <h1 class="text-3xl md:text-4xl font-bold text-ink">@Model.Name</h1>

        <!-- Parent genre -->
        @if (Model.ParentGenre is not null)
        {
            <p class="mt-2 text-ink-secondary">
                @Localizer["Parent genre"]:
                <a href="/@culture/genres/@Model.ParentGenre.Slug"
                   class="text-accent hover:text-accent-hover font-medium">
                    @Model.ParentGenre.Name
                </a>
            </p>
        }

        <!-- Child genres -->
        @if (Model.ChildGenres.Count > 0)
        {
            <div class="flex flex-wrap gap-2 mt-3">
                <span class="text-sm text-ink-muted me-1">@Localizer["Sub-genres"]:</span>
                @foreach (var child in Model.ChildGenres)
                {
                    <a href="/@culture/genres/@child.Slug"
                       class="inline-block bg-accent-soft text-accent-hover text-xs px-2.5 py-1 rounded-full hover:bg-accent-soft transition-colors">
                        @child.Name
                    </a>
                }
            </div>
        }
    </div>

    <div class="flex flex-col lg:flex-row gap-8">
        <!-- ============================================================
             Main Content
             ============================================================ -->
        <div class="flex-1 min-w-0 space-y-10">

            <!-- ============================================================
                 2. Description
                 ============================================================ -->
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <section>
                    <h2 class="text-2xl font-bold text-ink mb-4">@Localizer["Description"]</h2>
                    <div class="prose prose-gray max-w-none text-ink-secondary leading-relaxed">
                        @Model.Description
                    </div>
                </section>
            }

            <!-- ============================================================
                 3. Albums in Genre
                 ============================================================ -->
            @if (Model.Albums.Count > 0)
            {
                <section>
                    <h2 class="text-2xl font-bold text-ink mb-4">
                        @Localizer["Albums"] (@Model.Albums.Count)
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                        @foreach (var album in Model.Albums)
                        {
                            <a href="/@culture/albums/@album.Slug"
                               class="block bg-surface rounded-lg border border-rule p-4 hover:shadow-md transition-shadow">
                                <h3 class="font-medium text-accent hover:text-accent-hover">@album.Title</h3>
                                @if (album.ReleaseDate.HasValue)
                                {
                                    <span class="text-sm text-ink-muted">@album.ReleaseDate.Value.Year</span>
                                }
                            </a>
                        }
                    </div>
                </section>
            }

            <!-- ============================================================
                 4. Tracks in Genre
                 ============================================================ -->
            @if (Model.Tracks.Count > 0)
            {
                <section>
                    <h2 class="text-2xl font-bold text-ink mb-4">
                        @Localizer["Tracks"] (@Model.Tracks.Count)
                    </h2>
                    <div class="space-y-2">
                        @foreach (var track in Model.Tracks)
                        {
                            <a href="/@culture/tracks/@track.Slug"
                               class="flex items-center justify-between bg-surface rounded-lg border border-rule px-4 py-2 hover:bg-paper transition-colors">
                                <span class="text-sm font-medium text-accent hover:text-accent-hover">@track.Title</span>
                                @if (track.DurationSeconds.HasValue)
                                {
                                    <span class="text-xs text-ink-muted tabular-nums">
                                        @TimeSpan.FromSeconds(track.DurationSeconds.Value).ToString(@"m\:ss")
                                    </span>
                                }
                            </a>
                        }
                    </div>
                </section>
            }

            <!-- ============================================================
                 5. Artists Associated
                 ============================================================ -->
            @if (Model.Artists.Count > 0)
            {
                <section>
                    <h2 class="text-2xl font-bold text-ink mb-4">
                        @Localizer["Artists"] (@Model.Artists.Count)
                    </h2>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var artist in Model.Artists)
                        {
                            <a href="/@culture/people/@artist.Slug"
                               class="inline-block bg-info-soft text-info-hover text-sm px-3 py-1.5 rounded-full hover:bg-info-soft transition-colors">
                                @artist.Name
                            </a>
                        }
                    </div>
                </section>
            }

            <!-- ============================================================
                 6. Media Gallery
                 ============================================================ -->
            @if (Model.Media.Count > 0)
            {
                var images = Model.Media.Where(m => m.MediaType == "IMAGE" || m.MediaType == "image").ToList();
                var videos = Model.Media.Where(m => m.MediaType == "VIDEO" || m.MediaType == "video").ToList();

                <section>
                    <h2 class="text-2xl font-bold text-ink mb-4">@Localizer["Media"]</h2>

                    @if (images.Count > 0)
                    {
                        <h3 class="text-lg font-semibold text-ink-secondary mb-2">@Localizer["Images"]</h3>
                        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 mb-6">
                            @foreach (var media in images)
                            {
                                <a href="@media.Url"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="block aspect-square bg-paper-muted rounded-lg overflow-hidden hover:opacity-90 transition-opacity">
                                    <img src="@(media.ThumbnailUrl ?? media.Url)"
                                         alt="@(media.Description ?? "")"
                                         class="w-full h-full object-cover"
                                         loading="lazy" />
                                </a>
                            }
                        </div>
                    }

                    @if (videos.Count > 0)
                    {
                        <h3 class="text-lg font-semibold text-ink-secondary mb-2">@Localizer["Videos"]</h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                            @foreach (var media in videos)
                            {
                                <div class="aspect-video bg-paper-muted rounded-lg overflow-hidden">
                                    @if (media.Url.Contains("youtube") || media.Url.Contains("youtu.be"))
                                    {
                                        <iframe src="@media.Url"
                                                class="w-full h-full"
                                                allowfullscreen
                                                loading="lazy"
                                                title="@(media.Description ?? "")"></iframe>
                                    }
                                    else
                                    {
                                        <video src="@media.Url"
                                               class="w-full h-full object-cover"
                                               controls
                                               preload="none"></video>
                                    }
                                </div>
                            }
                        </div>
                    }
                </section>
            }

            <!-- ============================================================
                 7. References / Citations
                 ============================================================ -->
            @if (Model.Citations.Count > 0)
            {
                <section>
                    <h2 class="text-2xl font-bold text-ink mb-4">@Localizer["References"]</h2>
                    <ol class="space-y-3 list-decimal list-inside">
                        @foreach (var citation in Model.Citations)
                        {
                            <li class="text-sm text-ink-secondary">
                                @if (!string.IsNullOrWhiteSpace(citation.Quote))
                                {
                                    <span class="font-medium">"@citation.Quote"</span>
                                    <br />
                                }
                                <span class="text-ink-muted">
                                    @if (!string.IsNullOrWhiteSpace(citation.SourceSlug))
                                    {
                                        <a href="/@culture/sources/@citation.SourceSlug"
                                           class="text-accent hover:text-accent-hover">
                                            @citation.SourceName
                                        </a>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(citation.SourceName))
                                    {
                                        <span>@citation.SourceName</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(citation.PageNumber))
                                    {
                                        <span>, @Localizer["p."] @citation.PageNumber</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(citation.Url))
                                    {
                                        <a href="@citation.Url"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="text-accent hover:text-accent-hover ms-1">
                                            @Localizer["Source"]
                                        </a>
                                    }
                                </span>
                            </li>
                        }
                    </ol>
                </section>
            }

            <!-- ============================================================
                 8. External Links
                 ============================================================ -->
            @if (Model.Links.Count > 0)
            {
                <section>
                    <h2 class="text-2xl font-bold text-ink mb-4">@Localizer["External Links"]</h2>
                    <ul class="space-y-1.5">
                        @foreach (var link in Model.Links)
                        {
                            <li>
                                <a href="@link.Url"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="text-accent hover:text-accent-hover text-sm font-medium">
                                    @(!string.IsNullOrWhiteSpace(link.Title) ? link.Title : link.Url)
                                </a>
                                @if (!string.IsNullOrWhiteSpace(link.LinkType))
                                {
                                    <span class="text-ink-muted text-xs ms-1">[@link.LinkType]</span>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>

        <!-- ============================================================
             Sidebar
             ============================================================ -->
        <aside class="w-full lg:w-72 flex-shrink-0" role="complementary" aria-label="@Localizer["Genre metadata"]">
            <div class="bg-paper rounded-lg border border-rule p-5 space-y-4 sticky top-4">
                <h3 class="text-sm font-semibold text-ink-muted uppercase tracking-wider">@Localizer["Details"]</h3>

                <div>
                    <h4 class="text-xs font-medium text-ink-muted uppercase">@Localizer["Name"]</h4>
                    <p class="mt-1 text-sm text-ink-secondary">@Model.Name</p>
                </div>

                @if (Model.ParentGenre is not null)
                {
                    <div>
                        <h4 class="text-xs font-medium text-ink-muted uppercase">@Localizer["Parent Genre"]</h4>
                        <a href="/@culture/genres/@Model.ParentGenre.Slug"
                           class="mt-1 text-sm text-accent hover:text-accent-hover block">
                            @Model.ParentGenre.Name
                        </a>
                    </div>
                }

                <div>
                    <h4 class="text-xs font-medium text-ink-muted uppercase">@Localizer["Sub-genres"]</h4>
                    <p class="mt-1 text-sm text-ink-secondary">@Model.ChildGenres.Count</p>
                </div>

                <div>
                    <h4 class="text-xs font-medium text-ink-muted uppercase">@Localizer["Albums"]</h4>
                    <p class="mt-1 text-sm text-ink-secondary">@Model.Albums.Count</p>
                </div>

                <div>
                    <h4 class="text-xs font-medium text-ink-muted uppercase">@Localizer["Tracks"]</h4>
                    <p class="mt-1 text-sm text-ink-secondary">@Model.Tracks.Count</p>
                </div>

                @if (Model.Artists.Count > 0)
                {
                    <div>
                        <h4 class="text-xs font-medium text-ink-muted uppercase">@Localizer["Artists"]</h4>
                        <p class="mt-1 text-sm text-ink-secondary">@Model.Artists.Count</p>
                    </div>
                }
            </div>
        </aside>
    </div>
</div>

<!-- ============================================================
     JSON-LD Structured Data
     ============================================================ -->
<script type="application/ld+json">
{
    "@@context": "https://schema.org",
    "@@type": "DefinedTerm",
    "name": "@Model.Name",
    "@if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <text>"description": "@Model.Description",</text>
    }
    "inDefinedTermSet": "@($"{Context.Request.Scheme}://{Context.Request.Host}/{culture}/genres")"
}
</script>
