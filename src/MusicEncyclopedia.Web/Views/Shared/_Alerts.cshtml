@{
    // Renders TempData alerts (Success / Error / Info / Warning) using the
    // shared .alert component (see site.css). Include once per page/layout.
    var alerts = new (string Key, string Type)[]
    {
        ("SuccessMessage", "success"),
        ("ErrorMessage", "error"),
        ("InfoMessage", "info"),
        ("WarningMessage", "warning")
    };
}

@foreach (var (key, type) in alerts)
{
    if (TempData[key] is string message && !string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert--@type" role="alert">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                @if (type == "success")
                {
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                }
                else if (type == "error")
                {
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                }
                else if (type == "warning")
                {
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
                }
                else
                {
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                }
            </svg>
            <span class="alert__body">@message</span>
            <button type="button" class="alert__close" aria-label="Dismiss" onclick="this.closest('.alert').remove()">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    }
}
