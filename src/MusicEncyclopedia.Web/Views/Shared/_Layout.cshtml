@inject IStringLocalizer<SharedResources> L
@{
    Layout = null;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var culture = Context.Items["culture"] as string ?? CultureConstants.DefaultCulture;
    var dir = Context.Items["dir"] as string ?? "rtl";

    // Same-page URL for a target culture (used by the language switcher and hreflang).
    var currentPath = Context.Request.Path.Value ?? "/";
    var pathSuffix = currentPath.StartsWith("/" + culture, StringComparison.OrdinalIgnoreCase)
        ? currentPath.Substring(culture.Length + 1)
        : currentPath;
    if (string.IsNullOrEmpty(pathSuffix))
        pathSuffix = "/";
    var queryString = Context.Request.QueryString.HasValue ? Context.Request.QueryString.Value : string.Empty;
    var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
    string CultureUrl(string targetCulture) => origin + "/" + targetCulture + pathSuffix + queryString;
}
<!DOCTYPE html>
<html lang="@culture" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="description" content="@ViewData["Description"]" />

    <title>@ViewData["Title"] · @L["Brand.Name"]</title>

    <!-- Hreflang · fa-only launch (multilingual disabled — see CultureMiddleware) -->
    <link rel="alternate" hreflang="fa" href="@CultureUrl("fa")" />
    <link rel="alternate" hreflang="x-default" href="@CultureUrl(CultureConstants.DefaultCulture)" />

    <!-- Fonts (self-hosted: Vazirmatn for the Persian RTL launch) -->
    <link rel="stylesheet" href="~/css/fonts.css" />

    <!-- Tailwind (utility layer, kept for legacy view classes) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="~/js/tailwind-theme.js"></script>

    <!-- Styles -->
    <link rel="stylesheet" href="~/css/site.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="min-h-screen bg-[var(--color-paper)] text-[var(--color-ink)] font-[var(--font-body)] antialiased">
    <a href="#main-content" class="skip-link">پرش به محتوای اصلی</a>

    <!-- Nav · sticky top bar -->
    <nav class="nav" aria-label="@L["Nav.MainNavigation"]">
        <div class="nav__inner">
            <a href="/@culture" class="nav__brand">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" />
                </svg>
                @L["Brand.Name"]
            </a>

            <ul class="nav__links">
                <li><a href="/@culture" class="nav__link @(currentAction == "Index" && currentController == "Home" ? "active" : "")">@L["Nav.Home"]</a></li>
                <li><a href="/@culture/albums" class="nav__link @(currentController == "Albums" ? "active" : "")">@L["Nav.Albums"]</a></li>
                <li><a href="/@culture/artists" class="nav__link @(currentController == "Artists" ? "active" : "")">@L["Nav.Artists"]</a></li>
                <li><a href="/@culture/poets" class="nav__link @(currentController == "Poets" ? "active" : "")">@L["Nav.Poets"]</a></li>
                <li><a href="/@culture/people" class="nav__link @(currentController == "People" ? "active" : "")">@L["Nav.People"]</a></li>
            </ul>

            <div class="nav__actions">
                <a href="/@culture/search" class="nav__search" aria-label="@L["Nav.Search"]">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" />
                    </svg>
                    <span>@L["Nav.Search"]</span>
                </a>

                @* Language switcher disabled for the fa-only launch (see CultureMiddleware). *@

                <button class="nav__toggle" aria-label="@L["Nav.OpenMenu"]" aria-expanded="false" aria-controls="mobile-nav">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                </button>
            </div>
        </div>
    </nav>

    <!-- Mobile Nav -->
    <div class="nav__mobile" id="mobile-nav" aria-hidden="true" inert>
        <button class="nav__mobile-close" aria-label="@L["Nav.CloseMenu"]">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <a href="/@culture">@L["Nav.Home"]</a>
        <a href="/@culture/albums">@L["Nav.Albums"]</a>
        <a href="/@culture/artists">@L["Nav.Artists"]</a>
        <a href="/@culture/poets">@L["Nav.Poets"]</a>
        <a href="/@culture/people">@L["Nav.People"]</a>
        <a href="/@culture/search">@L["Nav.Search"]</a>
    </div>

    <main id="main-content" class="min-h-[60vh]" tabindex="-1">
        @await Html.PartialAsync("_Alerts")
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer__inner">
            <div class="footer__left">
                <a href="/@culture" class="footer__brand">@L["Brand.Name"]</a>
                <span class="footer__copy">@string.Format(L["Footer.Copyright"], DateTime.Now.Year)</span>
            </div>
            <ul class="footer__links">
                <li><a href="/@culture/albums">@L["Nav.Albums"]</a></li>
                <li><a href="/@culture/artists">@L["Nav.Artists"]</a></li>
                <li><a href="/@culture/poets">@L["Nav.Poets"]</a></li>
                <li><a href="/@culture/people">@L["Nav.People"]</a></li>
            </ul>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Structured data · JSON-LD from detail views -->
    @await RenderSectionAsync("StructuredData", required: false)
</body>
</html>
