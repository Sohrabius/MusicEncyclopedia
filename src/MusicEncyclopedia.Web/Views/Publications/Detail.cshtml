@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model MusicEncyclopedia.Web.ViewModels.Public.PublicationDetailViewModel

@{
    var culture = Context.Items["culture"] as string ?? "fa";
    var dir = Context.Items["dir"] as string ?? "ltr";
    var publication = Model.Publication;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" dir="@dir">
    <nav aria-label="@Localizer["Breadcrumb"]" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-ink-muted">
            <li><a href="/@culture" class="hover:text-accent">@Localizer["Home"]</a></li>
            <li><a href="/@culture/publications" class="hover:text-accent ms-1">@Localizer["Publications"]</a></li>
            <li><span class="mx-1">/</span></li>
            <li class="text-ink font-medium truncate max-w-[300px]" aria-current="page">@publication.Title</li>
        </ol>
    </nav>

    <div class="flex flex-col lg:flex-row gap-8">
        <div class="flex-1 min-w-0 space-y-8">
            <section>
                <h1 class="text-3xl font-bold text-ink">@publication.Title</h1>
                <div class="flex flex-wrap gap-3 mt-3">
                    @if (!string.IsNullOrWhiteSpace(publication.PublicationTypeName))
                    {
                        <span class="inline-block bg-info-soft text-info-hover text-sm font-medium px-3 py-1 rounded-full">@publication.PublicationTypeName</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(publication.AuthorName))
                    {
                        <span class="text-sm text-ink-secondary"><i aria-hidden="true" class="fas fa-user text-ink-muted me-1"></i>
                            @if (!string.IsNullOrWhiteSpace(publication.AuthorSlug))
                            {
                                <a href="/@culture/people/@publication.AuthorSlug" class="text-accent hover:text-accent-hover">@publication.AuthorName</a>
                            }
                            else
                            {
                                @publication.AuthorName
                            }
                        </span>
                    }
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(publication.PublisherName) || publication.PublicationDate.HasValue || !string.IsNullOrWhiteSpace(publication.ISBN))
            {
                <section class="bg-surface rounded-lg p-5 border border-rule">
                    <h2 class="text-lg font-semibold text-ink mb-3">@Localizer["Publication Details"]</h2>
                    <dl class="space-y-2 text-sm">
                        @if (!string.IsNullOrWhiteSpace(publication.PublisherName))
                        {
                            <div class="flex gap-2">
                                <dt class="text-ink-muted w-24 flex-shrink-0">@Localizer["Publisher"]</dt>
                                <dd class="text-ink">@publication.PublisherName</dd>
                            </div>
                        }
                        @if (publication.PublicationDate.HasValue)
                        {
                            <div class="flex gap-2">
                                <dt class="text-ink-muted w-24 flex-shrink-0">@Localizer["Date"]</dt>
                                <dd class="text-ink">@publication.PublicationDate.Value.ToString("yyyy-MM-dd")</dd>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(publication.ISBN))
                        {
                            <div class="flex gap-2">
                                <dt class="text-ink-muted w-24 flex-shrink-0">ISBN</dt>
                                <dd class="text-ink" dir="ltr">@publication.ISBN</dd>
                            </div>
                        }
                    </dl>
                </section>
            }

            @if (publication.Poems.Count > 0)
            {
                <section>
                    <h2 class="text-lg font-semibold text-ink mb-3">@Localizer["Poems in this Collection"] (@publication.Poems.Count)</h2>
                    <ul class="space-y-2">
                        @foreach (var poem in publication.Poems)
                        {
                            <li>
                                <a href="/@culture/poems/@poem.Slug" class="text-accent hover:text-accent-hover text-sm font-medium">@poem.Title</a>
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>

        <aside class="w-full lg:w-72 space-y-4">
            <div class="bg-surface rounded-lg border border-rule p-4">
                <h3 class="text-sm font-semibold text-ink-secondary mb-2">@Localizer["Publication Info"]</h3>
                <dl class="space-y-1 text-sm">
                    <div class="flex justify-between"><dt class="text-ink-muted">@Localizer["Type"]</dt><dd class="text-ink">@(publication.PublicationTypeName ?? "—")</dd></div>
                    <div class="flex justify-between"><dt class="text-ink-muted">@Localizer["Poems"]</dt><dd class="text-ink">@publication.Poems.Count</dd></div>
                </dl>
            </div>
        </aside>
    </div>
</div>

<!-- ============================================================
     JSON-LD Structured Data: Book / CreativeWork
     ============================================================ -->
@section StructuredData {
<script type="application/ld+json">
{
    "@@context": "https://schema.org",
    "@@type": "Book",
    "name": "@Model.Publication.Title",
    @if (!string.IsNullOrWhiteSpace(Model.Publication.AuthorName))
    {
        <text>"author": {
            "@@type": "Person",
            "name": "@Model.Publication.AuthorName"
        },</text>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Publication.PublisherName))
    {
        <text>"publisher": {
            "@@type": "Organization",
            "name": "@Model.Publication.PublisherName"
        },</text>
    }
    @if (Model.Publication.PublicationDate.HasValue)
    {
        <text>"datePublished": "@Model.Publication.PublicationDate.Value.ToString("yyyy-MM-dd")",</text>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Publication.ISBN))
    {
        <text>"isbn": "@Model.Publication.ISBN",</text>
    }
    "inLanguage": "@culture"
}
</script>
}
