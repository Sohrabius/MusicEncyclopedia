@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model MusicEncyclopedia.Web.ViewModels.Public.EventDetailViewModel

@{
    var culture = Context.Items["culture"] as string ?? "fa";
    var dir = Context.Items["dir"] as string ?? "ltr";
    var evt = Model.Event;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" dir="@dir">
    <nav aria-label="@Localizer["Breadcrumb"]" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-ink-muted">
            <li><a href="/@culture" class="hover:text-accent">@Localizer["Home"]</a></li>
            <li><span class="mx-1">/</span></li>
            <li><a href="/@culture/events" class="hover:text-accent">@Localizer["Events"]</a></li>
            <li><span class="mx-1">/</span></li>
            <li class="text-ink font-medium truncate max-w-[200px]" aria-current="page">@evt.Slug</li>
        </ol>
    </nav>

    <div class="flex flex-col lg:flex-row gap-8">
        <div class="flex-1 min-w-0 space-y-8">
            <section>
                <h1 class="text-3xl font-bold text-ink">@Localizer["Performance Event"]: @evt.Slug</h1>
                <div class="flex flex-wrap gap-3 mt-3">
                    @if (!string.IsNullOrWhiteSpace(evt.EventTypeName))
                    {
                        <span class="inline-block bg-info-soft text-info-hover text-sm font-medium px-3 py-1 rounded-full">@evt.EventTypeName</span>
                    }
                    @if (evt.Date.HasValue)
                    {
                        <span class="text-sm text-ink-secondary"><i aria-hidden="true" class="fas fa-calendar text-ink-muted me-1"></i> @evt.Date.Value.ToString("yyyy-MM-dd HH:mm")</span>
                    }
                </div>
            </section>

            @if (evt.LocationId.HasValue)
            {
                <section class="bg-paper rounded-lg p-5 border border-rule">
                    <h2 class="text-lg font-semibold text-ink mb-2">@Localizer["Venue"]</h2>
                    <a href="/@culture/locations/@evt.VenueSlug" class="text-accent hover:text-accent-hover">
                        <i aria-hidden="true" class="fas fa-map-marker-alt me-1"></i> @evt.VenueName
                    </a>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(evt.AudienceInfo))
            {
                <section class="bg-surface rounded-lg p-5 border border-rule">
                    <h2 class="text-lg font-semibold text-ink mb-2">@Localizer["Audience"]</h2>
                    <p class="text-ink-secondary">@evt.AudienceInfo</p>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(evt.PerformanceNotes))
            {
                <section class="bg-surface rounded-lg p-5 border border-rule">
                    <h2 class="text-lg font-semibold text-ink mb-2">@Localizer["Performance Notes"]</h2>
                    <div class="text-ink-secondary whitespace-pre-line">@evt.PerformanceNotes</div>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(evt.ImprovisationNotes))
            {
                <section class="bg-surface rounded-lg p-5 border border-rule">
                    <h2 class="text-lg font-semibold text-ink mb-2">@Localizer["Improvisation Notes"]</h2>
                    <div class="text-ink-secondary whitespace-pre-line">@evt.ImprovisationNotes</div>
                </section>
            }

            @if (evt.Albums.Count > 0)
            {
                <section>
                    <h2 class="text-lg font-semibold text-ink mb-3">@Localizer["Albums Performed"]</h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        @foreach (var album in evt.Albums)
                        {
                            <a href="/@culture/albums/@album.Slug" class="flex items-center gap-3 bg-surface rounded-lg border border-rule p-3 hover:shadow-sm">
                                <div class="w-12 h-12 bg-paper-muted rounded flex-shrink-0 flex items-center justify-center text-ink-muted"><i aria-hidden="true" class="fas fa-compact-disc"></i></div>
                                <span class="font-medium text-ink">@album.Title</span>
                            </a>
                        }
                    </div>
                </section>
            }

            @if (evt.Tracks.Count > 0)
            {
                <section>
                    <h2 class="text-lg font-semibold text-ink mb-3">@Localizer["Tracks Performed"]</h2>
                    <div class="bg-surface rounded-lg border border-rule divide-y">
                        @foreach (var track in evt.Tracks)
                        {
                            <a href="/@culture/tracks/@track.Slug" class="flex items-center justify-between p-3 hover:bg-paper">
                                <span class="text-ink font-medium">@track.Title</span>
                                @if (track.DurationSeconds.HasValue)
                                {
                                    <span class="text-sm text-ink-muted">@TimeSpan.FromSeconds(track.DurationSeconds.Value).ToString(@"m\:ss")</span>
                                }
                            </a>
                        }
                    </div>
                </section>
            }

            @if (evt.Media.Count > 0)
            {
                <section>
                    <h2 class="text-lg font-semibold text-ink mb-3">@Localizer["Media"]</h2>
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                        @foreach (var media in evt.Media)
                        {
                            <div class="bg-paper-muted rounded-lg aspect-square overflow-hidden">
                                @if (!string.IsNullOrWhiteSpace(media.Url))
                                {
                                    <img src="@media.Url" alt="@media.FileName" class="w-full h-full object-cover" loading="lazy" />
                                }
                            </div>
                        }
                    </div>
                </section>
            }

            @if (evt.Citations.Count > 0)
            {
                <section>
                    <h2 class="text-lg font-semibold text-ink mb-3">@Localizer["References"]</h2>
                    <ul class="space-y-2">
                        @foreach (var citation in evt.Citations)
                        {
                            <li class="bg-surface rounded-lg border border-rule p-3 text-sm text-ink-secondary">
                                @if (!string.IsNullOrWhiteSpace(citation.Quote))
                                {
                                    <blockquote class="italic border-s-4 border-rule-strong ps-3 mb-1">@citation.Quote</blockquote>
                                }
                                @if (!string.IsNullOrWhiteSpace(citation.SourceName))
                                {
                                    <p class="text-xs text-ink-muted">— @citation.SourceName</p>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>

        <aside class="w-full lg:w-72 space-y-4">
            <div class="bg-surface rounded-lg border border-rule p-4">
                <h3 class="text-sm font-semibold text-ink-secondary mb-2">@Localizer["Event Info"]</h3>
                <dl class="space-y-1 text-sm">
                    <div class="flex justify-between"><dt class="text-ink-muted">@Localizer["Type"]</dt><dd class="text-ink">@(evt.EventTypeName ?? "—")</dd></div>
                    <div class="flex justify-between"><dt class="text-ink-muted">@Localizer["Date"]</dt><dd class="text-ink">@(evt.Date?.ToString("yyyy-MM-dd") ?? "—")</dd></div>
                    <div class="flex justify-between"><dt class="text-ink-muted">@Localizer["Venue"]</dt><dd class="text-ink">@(evt.VenueName ?? "—")</dd></div>
                </dl>
            </div>
        </aside>
    </div>
</div>

<!-- ============================================================
     JSON-LD Structured Data: Event
     ============================================================ -->
@section StructuredData {
<script type="application/ld+json">
{
    "@@context": "https://schema.org",
    "@@type": "Event",
    "name": "@Model.Event.Slug",
    @if (Model.Event.Date.HasValue)
    {
        <text>"startDate": "@Model.Event.Date.Value.ToString("yyyy-MM-ddTHH:mm:ss")",</text>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Event.PerformanceNotes))
    {
        <text>"description": "@Model.Event.PerformanceNotes",</text>
    }
    @if (Model.Event.LocationId.HasValue && !string.IsNullOrWhiteSpace(Model.Event.VenueName))
    {
        <text>"location": {
            "@@type": "Place",
            "name": "@Model.Event.VenueName"
        },</text>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Event.EventTypeName))
    {
        <text>"eventType": "@Model.Event.EventTypeName",</text>
    }
    "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}/{culture}/events/{Model.Event.Slug}")"
}
</script>
}
