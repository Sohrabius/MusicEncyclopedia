@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Page Not Found"];
    var culture = Context.Items["culture"] as string ?? "fa";
    var dir = Context.Items["dir"] as string ?? "ltr";
}

<div class="min-h-[60vh] flex items-center justify-center px-4">
    <div class="text-center max-w-lg">
        <div class="text-8xl font-bold text-amber-200 mb-4">404</div>
        <h1 class="text-3xl font-bold text-gray-900 mb-4">@Localizer["Page Not Found"]</h1>
        <p class="text-lg text-gray-600 mb-8">
            @Localizer["The page you are looking for does not exist or has been moved."]
        </p>

        <div class="flex flex-wrap justify-center gap-4">
            <a href="/@culture"
               class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                @Localizer["Go to Home"]
            </a>
            <a href="/@culture/search"
               class="px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors">
                @Localizer["Search"]
            </a>
            <a href="javascript:history.back()"
               class="px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors">
                @Localizer["Go Back"]
            </a>
        </div>
    </div>
</div>
