@model MusicEncyclopedia.Web.ViewModels.ErrorViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Error"];
    var culture = Context.Items["culture"] as string ?? "fa";
    var dir = Context.Items["dir"] as string ?? "ltr";
}

<div class="min-h-[60vh] flex items-center justify-center px-4">
    <div class="text-center max-w-lg">
        <div class="text-8xl font-bold text-error mb-4">500</div>
        <h1 class="text-3xl font-bold text-ink mb-4">@Localizer["Something went wrong"]</h1>
        <p class="text-lg text-ink-secondary mb-8">
            @Localizer["An unexpected error occurred while processing your request. Please try again later."]
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="text-sm text-ink-muted mb-6">
                @Localizer["Request ID"]: <code class="bg-paper-muted px-2 py-1 rounded">@Model.RequestId</code>
            </p>
        }

        <div class="flex flex-wrap justify-center gap-4">
            <a href="/@culture"
               class="px-6 py-3 bg-accent text-on-accent rounded-lg hover:bg-accent-hover transition-colors">
                @Localizer["Go to Home"]
            </a>
            <a href="/@culture/search"
               class="px-6 py-3 border border-rule-strong text-ink-secondary rounded-lg hover:bg-paper transition-colors">
                @Localizer["Search"]
            </a>
        </div>
    </div>
</div>
