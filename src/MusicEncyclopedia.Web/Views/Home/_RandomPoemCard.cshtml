@inject Microsoft.Extensions.Localization.IStringLocalizer<MusicEncyclopedia.Web.SharedResources> L
@model MusicEncyclopedia.Web.ViewModels.RandomPoemCard

@{
    var culture = Context.Items["culture"] as string ?? "fa";
}

<div class="home-poem" id="home-poem-card">
    <div class="home-poem__head">
        <span class="home-poem__icon" aria-hidden="true">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                      d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
        </span>
        <h3 class="home-poem__title">@L["Home.RandomPoem"]</h3>
        <button type="button" id="home-poem-shuffle" class="home-poem__shuffle"
                title="@L["Home.ShufflePoem"]" aria-label="@L["Home.ShufflePoem"]"
                data-url="/@culture/home/random-poem">
            <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
        </button>
    </div>

    <a href="/@culture/poems/@Model.PoemSlug" class="home-poem__verse">
        @Model.PoemTitle
    </a>

    @if (!string.IsNullOrWhiteSpace(Model.Poet))
    {
        <p class="home-poem__poet">@Model.Poet</p>
    }

    @if (!string.IsNullOrWhiteSpace(Model.TrackSlug))
    {
        <div class="home-poem__links">
            <span class="home-poem__label">@L["Home.RandomPoemSungBy"]</span>
            <a href="/@culture/tracks/@Model.TrackSlug">@Model.TrackTitle</a>
            @if (!string.IsNullOrWhiteSpace(Model.AlbumSlug))
            {
                <span class="home-poem__sep" aria-hidden="true">·</span>
                <a href="/@culture/albums/@Model.AlbumSlug">@Model.AlbumTitle</a>
            }
        </div>
    }
</div>
