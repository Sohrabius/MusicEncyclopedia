@inject Microsoft.Extensions.Localization.IStringLocalizer<MusicEncyclopedia.Web.SharedResources> L
@model MusicEncyclopedia.Web.ViewModels.AboutStats

@{
    var culture = Context.Items["culture"] as string ?? "fa";
}

<div class="home-about">
    <h3 class="home-about__title">@L["Home.AboutTitle"]</h3>
    <p class="home-about__text">@L["Home.AboutText"]</p>

    <dl class="home-about__stats">
        <div class="home-about__stat">
            <dt class="home-about__stat-label">@L["Album"]</dt>
            <dd class="home-about__stat-value">@Model.Albums</dd>
        </div>
        <div class="home-about__stat">
            <dt class="home-about__stat-label">@L["Track"]</dt>
            <dd class="home-about__stat-value">@Model.Tracks</dd>
        </div>
        <div class="home-about__stat">
            <dt class="home-about__stat-label">@L["Home.AboutArtists"]</dt>
            <dd class="home-about__stat-value">@Model.People</dd>
        </div>
    </dl>

    <a href="/@culture" class="home-about__link">@L["Home.AboutCta"]</a>
</div>
