@model MusicEncyclopedia.Web.ViewModels.HomeViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<MusicEncyclopedia.Web.SharedResources> L
@using MusicEncyclopedia.Web.Constants
@using MusicEncyclopedia.Core.DTOs

@{
    ViewData["Title"] = L["Brand.Name"];
    ViewData["Description"] = Model.MetaDescription;
    var culture = Model.CurrentCulture;
    var dir = Context.Items["dir"] as string ?? "ltr";

    var totalItems = Model.Albums?.TotalItems ?? 0;
    var hasAlbums = Model.Albums is not null && Model.Albums.Items.Count > 0;
    var currentPage = Model.Albums?.Page ?? 1;
    var isHybridLanding = currentPage == 1;
    var isNoScriptContinuation = currentPage > 1 && currentPage <= HomeConstants.LazyLoadCapPages;
    var showLoadMore = isHybridLanding && hasAlbums && Model.LoadedCount < totalItems;
    var showTailPagination = totalItems > HomeConstants.LazyLoadCap
        && (isHybridLanding || currentPage > HomeConstants.LazyLoadCapPages);
}

<!-- Canonical + Open Graph -->
<link rel="canonical" href="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}{Context.Request.Path}")" />
<meta property="og:title" content="@ViewData["Title"]" />
<meta property="og:description" content="@Model.MetaDescription" />
<meta property="og:url" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}{Context.Request.Path}")" />
<meta property="og:type" content="website" />

<!-- Banner · search-first -->
<section class="home-banner">
    <div class="home-banner__inner">
        <p class="home-banner__eyebrow">@L["Home.Eyebrow"]</p>
        <h1 class="home-banner__title">@ViewData["Title"]</h1>
        <p class="home-banner__subtitle">@L["Home.Tagline"]</p>

        <form action="/@culture/search" method="get" class="search" role="search">
            <div class="relative">
                <svg class="search__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input type="search"
                       name="q"
                       class="search__input"
                       placeholder="@L["Home.SearchPlaceholder"]"
                       aria-label="@L["Nav.Search"]" />
            </div>
        </form>

        @if (Model.Genres.Count > 0 || Model.Moods.Count > 0 || Model.Instruments.Count > 0)
        {
            <div class="hero__hints">
                @foreach (var genre in Model.Genres.Take(4))
                {
                    <a href="/@culture/genres/@genre.Slug" class="tag">@genre.Name</a>
                }
                @foreach (var mood in Model.Moods.Take(3))
                {
                    <a href="/@culture/moods/@mood.Slug" class="tag">@mood.Name</a>
                }
                @foreach (var instrument in Model.Instruments.Take(3))
                {
                    <a href="/@culture/instruments/@instrument.Slug" class="tag">@instrument.Name</a>
                }
            </div>
        }
    </div>
</section>

<!-- Catalog + Sidebar -->
<section class="section" style="padding-top: 0;">
    <div class="section__inner">
        <div class="home-layout">

            <!-- Main column: category chips + album grid -->
            <div class="home-main">
                <div class="section__head">
                    <h2 class="section__title">@L["Home.AllAlbums"]</h2>
                    @if (totalItems > 0)
                    {
                        <span class="home-result-count">@L["Home.AlbumCount", totalItems]</span>
                    }
                </div>

                @if (Model.Categories.Count > 0)
                {
                    <div class="chip-row" role="group" aria-label="@L["Home.Categories"]">
                        <a href="/@culture"
                           class="chip @(string.IsNullOrEmpty(Model.SelectedCategory) ? "chip--active" : "")"
                           aria-current="@(string.IsNullOrEmpty(Model.SelectedCategory) ? "page" : null)">
                            @L["All"]
                        </a>
                        @foreach (var c in Model.Categories)
                        {
                            var active = string.Equals(c.Code, Model.SelectedCategory, StringComparison.OrdinalIgnoreCase);
                            var categoryLabel = L[$"AlbumCategory.{c.Code}"];
                            <a href="/@culture?category=@Uri.EscapeDataString(c.Code)"
                               class="chip @(active ? "chip--active" : "")"
                               aria-current="@(active ? "page" : null)">
                                @(categoryLabel.ResourceNotFound ? c.Name : categoryLabel.Value)
                                <span class="chip__count">@c.AlbumCount</span>
                            </a>
                        }
                    </div>
                }

                @if (!hasAlbums)
                {
                    <div class="empty">
                        <svg class="empty__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                  d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
                        </svg>
                        <h3 class="empty__title">@L["Home.NoAlbums"]</h3>
                        <p class="empty__text">@L["Home.NoAlbumsHint"]</p>
                        <a href="/@culture" class="empty__link">@L["Home.ClearCategory"]</a>
                    </div>
                }
                else
                {
                    <div class="card-grid" id="home-album-grid">
                        @await Html.PartialAsync("_AlbumCardGrid", Model.Albums)
                    </div>

                    @if (showLoadMore)
                    {
                        <div class="home-loadmore">
                            <button type="button"
                                    id="home-load-more"
                                    class="btn btn--secondary"
                                    data-culture="@culture"
                                    data-category="@Model.SelectedCategory"
                                    data-next-page="@(currentPage + 1)"
                                    data-total="@totalItems"
                                    data-cap="@HomeConstants.LazyLoadCap"
                                    data-pagesize="@HomeConstants.InitialPageSize"
                                    data-loaded="@Model.LoadedCount"
                                    data-loading-message="@L["Home.Loading"]"
                                    data-loaded-template="@L["Home.LoadedMore"]"
                                    aria-describedby="home-loaded-count home-load-error">
                                <span class="home-loadmore__icon" aria-hidden="true">
                                    <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                    </svg>
                                </span>
                                <span id="home-load-more-label">@L["Home.LoadMore"]</span>
                            </button>
                            <p id="home-loaded-count" class="home-loadmore__count" role="status"
                               aria-live="polite" aria-atomic="true"
                               data-template="@L["Home.ShowingOf"]">
                                @L["Home.ShowingOf", Model.LoadedCount, totalItems]
                            </p>
                            <p id="home-load-error" class="home-loadmore__error" role="alert" hidden>
                                @L["Home.LoadFailed"]
                            </p>
                        </div>
                    }

                    @if (isHybridLanding && Model.Albums!.TotalPages > 1)
                    {
                        <noscript>
                            @await Html.PartialAsync("_Pagination", new
                            {
                                Items = Model.Albums,
                                PageUrl = (Func<int, string>)GetPageUrl
                            })
                        </noscript>
                    }

                    @if (isNoScriptContinuation)
                    {
                        @await Html.PartialAsync("_Pagination", new
                        {
                            Items = Model.Albums,
                            PageUrl = (Func<int, string>)GetPageUrl
                        })
                    }

                    @if (showTailPagination)
                    {
                        <div id="home-pagination" @(isHybridLanding ? "hidden" : "")>
                            @await Html.PartialAsync("_HomeTailPagination", new
                            {
                                Items = PagedResult<AlbumListItemDto>.Create(
                                    Array.Empty<AlbumListItemDto>(),
                                    isHybridLanding ? HomeConstants.LazyLoadCapPages : currentPage,
                                    HomeConstants.PaginationPageSize,
                                    totalItems),
                                PageUrl = (Func<int, string>)GetPageUrl
                            })
                        </div>
                    }
                }
            </div>

            <!-- Sidebar: random poem + about -->
            <aside class="home-sidebar" role="complementary" aria-label="@L["Home.Sidebar"]">
                @if (Model.RandomPoem is not null)
                {
                    @await Html.PartialAsync("_RandomPoemCard", Model.RandomPoem)
                }
                <p id="home-poem-status" class="home-interaction-status" role="status"
                   aria-live="polite" aria-atomic="true"
                   data-loading="@L["Home.Loading"]"
                   data-updated="@L["Home.PoemUpdated"]"
                   data-unavailable="@L["Home.PoemUnavailable"]"
                   data-error="@L["Home.PoemLoadFailed"]"></p>
                @await Html.PartialAsync("_AboutCard", Model.About)
            </aside>

        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/home.js" defer></script>
}

@functions {
    string GetPageUrl(int page)
    {
        var query = $"page={page}";
        if (!string.IsNullOrWhiteSpace(Model.SelectedCategory))
            query += $"&category={Uri.EscapeDataString(Model.SelectedCategory)}";
        return $"/{Model.CurrentCulture}?{query}";
    }
}
