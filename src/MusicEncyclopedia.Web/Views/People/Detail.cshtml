@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model MusicEncyclopedia.Web.ViewModels.Public.PersonDetailViewModel

@{
    var culture = Context.Items["culture"] as string ?? "fa";
    var dir = Context.Items["dir"] as string ?? "ltr";
    var isRtl = dir == "rtl";
    dynamic person = Model.Person;

    // Helper: safely get a string value from a dynamic object
    string? SafeString(dynamic obj, string prop)
    {
        try
        {
            var val = (object?)obj.GetType().GetProperty(prop)?.GetValue(obj, null);
            return val?.ToString();
        }
        catch { return null; }
    }

    DateTime? SafeDate(dynamic obj, string prop)
    {
        try
        {
            var val = (object?)obj.GetType().GetProperty(prop)?.GetValue(obj, null);
            if (val is DateTime dt) return dt;
            if (val is null) return null;
            if (DateTime.TryParse(val.ToString(), out var parsed)) return parsed;
            return null;
        }
        catch { return null; }
    }

    // Extract properties safely
    var fullName = SafeString(person, "FullName") ?? SafeString(person, "Name") ?? "";
    var originalName = SafeString(person, "OriginalName");
    var englishName = SafeString(person, "EnglishName");
    var personKind = SafeString(person, "PersonKind") ?? SafeString(person, "PersonKindName");
    var nationality = SafeString(person, "Nationality");
    var birthPlace = SafeString(person, "BirthPlace");
    var deathPlace = SafeString(person, "DeathPlace");
    var biography = SafeString(person, "Biography");
    var imageUrl = SafeString(person, "ImageUrl") ?? SafeString(person, "PhotoUrl");

    var birthDate = SafeDate(person, "BirthDate");
    var deathDate = SafeDate(person, "DeathDate");

    // Helper: get a list from a dynamic object
    List<dynamic> SafeList(dynamic obj, string prop)
    {
        try
        {
            var val = (object?)obj.GetType().GetProperty(prop)?.GetValue(obj, null);
            if (val is System.Collections.IEnumerable enumerable)
            {
                var list = new List<dynamic>();
                foreach (var item in enumerable) list.Add(item);
                return list;
            }
        }
        catch { }
        return new List<dynamic>();
    }

    var instruments = SafeList(person, "Instruments");
    var roles = SafeList(person, "Roles");
    var media = SafeList(person, "Media");
    var links = SafeList(person, "Links") ?? SafeList(person, "ExternalLinks");
    var aliases = SafeList(person, "Aliases");
    var tags = SafeList(person, "Tags");
    var citations = SafeList(person, "Citations") ?? SafeList(person, "References");
    var timeline = SafeList(person, "Timeline");
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" dir="@dir">

    <!-- ============================================================
         Breadcrumb
         ============================================================ -->
    <nav aria-label="@Localizer["Breadcrumb"]" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
            <li><a href="/@culture" class="hover:text-blue-600 transition-colors">@Localizer["Home"]</a></li>
            <li><span class="mx-1">/</span></li>
            <li><a href="/@culture/people" class="hover:text-blue-600 transition-colors">@Localizer["People"]</a></li>
            <li><span class="mx-1">/</span></li>
            <li class="text-gray-900 font-medium truncate max-w-[200px]" aria-current="page">@fullName</li>
        </ol>
    </nav>

    <!-- ============================================================
         1. Header — Image, Full Name, Original Name, English Name,
            Person Kind, Nationality, Birth/Death Date, Birth/Death Place
         ============================================================ -->
    <div class="flex flex-col md:flex-row gap-8 mb-10">
        <!-- Image -->
        <div class="w-full md:w-72 flex-shrink-0">
            <div class="aspect-square bg-gray-100 rounded-lg overflow-hidden shadow-lg flex items-center justify-center">
                @if (!string.IsNullOrWhiteSpace(imageUrl))
                {
                    <img src="@imageUrl"
                         alt="@fullName"
                         class="w-full h-full object-cover"
                         width="400"
                         height="400" />
                }
                else
                {
                    <svg class="w-24 h-24 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                }
            </div>
        </div>

        <!-- Person Info -->
        <div class="flex-1 min-w-0">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900">@fullName</h1>

            @if (!string.IsNullOrWhiteSpace(originalName) && originalName != fullName)
            {
                <p class="text-xl text-gray-500 mt-1" dir="auto">@originalName</p>
            }
            @if (!string.IsNullOrWhiteSpace(englishName) && englishName != fullName && englishName != originalName)
            {
                <p class="text-lg text-gray-400 mt-0.5" dir="ltr">@englishName</p>
            }

            <!-- Kind & Nationality badges -->
            <div class="flex flex-wrap items-center gap-2 mt-3">
                @if (!string.IsNullOrWhiteSpace(personKind))
                {
                    <span class="inline-block bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
                        @personKind
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(nationality))
                {
                    <span class="inline-block bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
                        @nationality
                    </span>
                }
            </div>

            <!-- Birth / Death dates -->
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-3 text-sm text-gray-600">
                @if (birthDate.HasValue)
                {
                    <span>
                        <span class="font-medium text-gray-700">@Localizer["Born"]:</span>
                        @birthDate.Value.ToString("yyyy-MM-dd")
                        @if (!string.IsNullOrWhiteSpace(birthPlace))
                        {
                            <span>, @birthPlace</span>
                        }
                    </span>
                }
                else if (!string.IsNullOrWhiteSpace(birthPlace))
                {
                    <span>
                        <span class="font-medium text-gray-700">@Localizer["Born"]:</span>
                        @birthPlace
                    </span>
                }

                @if (deathDate.HasValue)
                {
                    <span>
                        <span class="font-medium text-gray-700">@Localizer["Died"]:</span>
                        @deathDate.Value.ToString("yyyy-MM-dd")
                        @if (!string.IsNullOrWhiteSpace(deathPlace))
                        {
                            <span>, @deathPlace</span>
                        }
                    </span>
                }
                else if (!string.IsNullOrWhiteSpace(deathPlace))
                {
                    <span>
                        <span class="font-medium text-gray-700">@Localizer["Died"]:</span>
                        @deathPlace
                    </span>
                }
            </div>
        </div>
    </div>

    <div class="flex flex-col lg:flex-row gap-8">
        <!-- ============================================================
             Main Content
             ============================================================ -->
        <div class="flex-1 min-w-0 space-y-10">

            <!-- ============================================================
                 2. Biography
                 ============================================================ -->
            @if (!string.IsNullOrWhiteSpace(biography))
            {
                <section>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">@Localizer["Biography"]</h2>
                    <div class="prose prose-gray max-w-none text-gray-700 leading-relaxed">
                        @biography
                    </div>
                </section>
            }

            <!-- ============================================================
                 3. Timeline (4.1) — album/track releases, sessions, events,
                    awards, chart entries, publications — date-sorted with links
                 ============================================================ -->
            @if (timeline.Count > 0)
            {
                <section>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">@Localizer["Timeline"]</h2>
                    <div class="relative">
                        <div class="absolute top-0 bottom-0 start-4 w-px bg-gray-200" aria-hidden="true"></div>
                        <ul class="space-y-4">
                            @foreach (var entry in timeline)
                            {
                                string? entryTitle = null;
                                string? entryType = null;
                                string? entryRoute = null;
                                string? entrySlug = null;
                                string? entryDetail = null;
                                DateTime? entryDate = null;
                                int? entryYear = null;
                                try { entryTitle = (string?)entry.Title ?? (string?)entry.Name; } catch { }
                                try { entryType = (string?)entry.Type ?? (string?)entry.EventType; } catch { }
                                try { entryRoute = (string?)entry.RouteName; } catch { }
                                try { entrySlug = (string?)entry.Slug; } catch { }
                                try { entryDetail = (string?)entry.Detail; } catch { }
                                try { entryDate = (DateTime?)entry.Date; } catch { }
                                try { entryYear = (int?)entry.Year; } catch { }

                                var badgeClass = entryType switch
                                {
                                    "AlbumRelease" => "bg-emerald-50 text-emerald-700",
                                    "TrackRelease" => "bg-teal-50 text-teal-700",
                                    "RecordingSession" => "bg-indigo-50 text-indigo-700",
                                    "PerformanceEvent" => "bg-rose-50 text-rose-700",
                                    "Award" => "bg-amber-50 text-amber-700",
                                    "ChartEntry" => "bg-sky-50 text-sky-700",
                                    "Publication" => "bg-violet-50 text-violet-700",
                                    _ => "bg-gray-100 text-gray-600"
                                };
                                var typeLabel = entryType switch
                                {
                                    "AlbumRelease" => Localizer["Album Release"].Value,
                                    "TrackRelease" => Localizer["Track Release"].Value,
                                    "RecordingSession" => Localizer["Recording Session"].Value,
                                    "PerformanceEvent" => Localizer["Live Performance"].Value,
                                    "Award" => Localizer["Award"].Value,
                                    "ChartEntry" => Localizer["Chart Entry"].Value,
                                    "Publication" => Localizer["Publication"].Value,
                                    _ => entryType
                                };
                                var entryDateText = entryDate.HasValue
                                    ? entryDate.Value.ToString("yyyy-MM-dd")
                                    : entryYear.HasValue ? entryYear.Value.ToString() : null;
                                var hasLink = !string.IsNullOrWhiteSpace(entryRoute) && !string.IsNullOrWhiteSpace(entrySlug);

                                <li class="relative ps-10">
                                    <span class="absolute start-0 top-1.5 flex h-8 w-8 items-center justify-center rounded-full bg-white border border-gray-200 shadow-sm" aria-hidden="true">
                                        @switch (entryType)
                                        {
                                            case "AlbumRelease":
                                                <text>&#128218;</text>
                                                break;
                                            case "TrackRelease":
                                                <text>&#127925;</text>
                                                break;
                                            case "RecordingSession":
                                                <text>&#127908;</text>
                                                break;
                                            case "PerformanceEvent":
                                                <text>&#127897;</text>
                                                break;
                                            case "Award":
                                                <text>&#127942;</text>
                                                break;
                                            case "ChartEntry":
                                                <text>&#128200;</text>
                                                break;
                                            case "Publication":
                                                <text>&#128214;</text>
                                                break;
                                            default:
                                                <text>&#9679;</text>
                                                break;
                                        }
                                    </span>
                                    <div class="flex flex-wrap items-center gap-2">
                                        @if (!string.IsNullOrWhiteSpace(entryDateText))
                                        {
                                            <span class="text-xs font-semibold text-gray-500 tabular-nums">@entryDateText</span>
                                        }
                                        <span class="inline-block text-xs font-medium px-2 py-0.5 rounded-full @badgeClass">@typeLabel</span>
                                    </div>
                                    @if (hasLink)
                                    {
                                        <a href="/@culture/@entryRoute/@entrySlug"
                                           class="mt-1 block text-sm font-medium text-gray-900 hover:text-blue-600 transition-colors">
                                            @entryTitle
                                        </a>
                                    }
                                    else
                                    {
                                        <p class="mt-1 text-sm font-medium text-gray-900">@entryTitle</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(entryDetail))
                                    {
                                        <p class="text-xs text-gray-500 mt-0.5">@entryDetail</p>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </section>
            }

            <!-- ============================================================
                 4. Discography (4.2) — filterable by category / year / role / instrument
                 ============================================================ -->
            @if (Model.Person.Albums.Count > 0)
            {
                var hasAlbumFilters = Model.Person.AlbumCategories.Count > 0 || Model.Person.AlbumYears.Count > 0
                    || Model.Person.AlbumRoles.Count > 0 || Model.Person.AlbumInstruments.Count > 0;

                <section>
                    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                        <h2 class="text-2xl font-bold text-gray-900">@Localizer["Discography"]</h2>
                        <span class="text-sm text-gray-500">@Model.Person.Albums.Count @Localizer["albums"]</span>
                    </div>

                    @if (hasAlbumFilters)
                    {
                        <form method="get" class="flex flex-wrap items-end gap-3 mb-6 p-4 bg-gray-50 rounded-lg border border-gray-200">
                            @if (Model.Person.AlbumCategories.Count > 0)
                            {
                                <div>
                                    <label for="albumCategory" class="block text-xs font-medium text-gray-500 mb-1">@Localizer["Category"]</label>
                                    <select id="albumCategory" name="albumCategory" class="text-sm border border-gray-300 rounded-md px-2.5 py-1.5 bg-white">
                                        <option value="">@Localizer["All"]</option>
                                        @foreach (var category in Model.Person.AlbumCategories)
                                        {
                                            var selectedAttr = Model.AlbumCategory == category ? "selected" : null;
                                            <option value="@category" selected="@selectedAttr">@category</option>
                                        }
                                    </select>
                                </div>
                            }
                            @if (Model.Person.AlbumYears.Count > 0)
                            {
                                <div>
                                    <label for="albumYear" class="block text-xs font-medium text-gray-500 mb-1">@Localizer["Year"]</label>
                                    <select id="albumYear" name="albumYear" class="text-sm border border-gray-300 rounded-md px-2.5 py-1.5 bg-white">
                                        <option value="">@Localizer["All"]</option>
                                        @foreach (var year in Model.Person.AlbumYears)
                                        {
                                            var selectedAttr = Model.AlbumYear == year ? "selected" : null;
                                            <option value="@year" selected="@selectedAttr">@year</option>
                                        }
                                    </select>
                                </div>
                            }
                            @if (Model.Person.AlbumRoles.Count > 0)
                            {
                                <div>
                                    <label for="albumRole" class="block text-xs font-medium text-gray-500 mb-1">@Localizer["Role"]</label>
                                    <select id="albumRole" name="albumRole" class="text-sm border border-gray-300 rounded-md px-2.5 py-1.5 bg-white">
                                        <option value="">@Localizer["All"]</option>
                                        @foreach (var role in Model.Person.AlbumRoles)
                                        {
                                            var selectedAttr = Model.AlbumRole == role ? "selected" : null;
                                            <option value="@role" selected="@selectedAttr">@role</option>
                                        }
                                    </select>
                                </div>
                            }
                            @if (Model.Person.AlbumInstruments.Count > 0)
                            {
                                <div>
                                    <label for="albumInstrument" class="block text-xs font-medium text-gray-500 mb-1">@Localizer["Instrument"]</label>
                                    <select id="albumInstrument" name="albumInstrument" class="text-sm border border-gray-300 rounded-md px-2.5 py-1.5 bg-white">
                                        <option value="">@Localizer["All"]</option>
                                        @foreach (var instrument in Model.Person.AlbumInstruments)
                                        {
                                            var selectedAttr = Model.AlbumInstrument == instrument ? "selected" : null;
                                            <option value="@instrument" selected="@selectedAttr">@instrument</option>
                                        }
                                    </select>
                                </div>
                            }
                            <button type="submit" class="text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-md px-4 py-1.5 transition-colors">
                                @Localizer["Filter"]
                            </button>
                            @if (Model.AlbumCategory is not null || Model.AlbumYear is not null || Model.AlbumRole is not null || Model.AlbumInstrument is not null)
                            {
                                <a href="/@culture/people/@Model.Person.Slug" class="text-sm text-gray-500 hover:text-gray-700 px-2 py-1.5">@Localizer["Clear"]</a>
                            }
                        </form>
                    }

                    @{
                        var filteredAlbums = Model.Person.Albums
                            .Where(a => string.IsNullOrEmpty(Model.AlbumCategory) || a.CategoryName == Model.AlbumCategory)
                            .Where(a => !Model.AlbumYear.HasValue || a.ReleaseDate?.Year == Model.AlbumYear)
                            .Where(a => string.IsNullOrEmpty(Model.AlbumRole) || a.Roles.Contains(Model.AlbumRole))
                            .Where(a => string.IsNullOrEmpty(Model.AlbumInstrument) || a.Instruments.Contains(Model.AlbumInstrument))
                            .ToList();
                    }

                    @if (filteredAlbums.Count == 0)
                    {
                        <p class="text-sm text-gray-500">@Localizer["No albums match the selected filters."]</p>
                    }
                    else
                    {
                        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            @foreach (var album in filteredAlbums)
                            {
                                <li>
                                    <a href="/@culture/albums/@album.Slug"
                                       class="group flex gap-4 p-3 rounded-lg border border-gray-200 hover:border-blue-300 hover:shadow-md transition-all bg-white">
                                        <div class="w-16 h-16 flex-shrink-0 rounded-md bg-gray-100 overflow-hidden">
                                            @if (!string.IsNullOrWhiteSpace(album.CoverUrl))
                                            {
                                                <img src="@album.CoverUrl" alt="@album.Title" class="w-full h-full object-cover" loading="lazy" />
                                            }
                                            else
                                            {
                                                <svg class="w-full h-full p-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21a9 9 0 110-18 9 9 0 010 18zm0-11l5 3-5 3V10z" />
                                                </svg>
                                            }
                                        </div>
                                        <div class="min-w-0">
                                            <p class="text-sm font-semibold text-gray-900 group-hover:text-blue-600 transition-colors truncate">@album.Title</p>
                                            <p class="text-xs text-gray-500 mt-0.5">
                                                @album.CategoryName
                                                @if (album.ReleaseDate.HasValue)
                                                {
                                                    <text> · @album.ReleaseDate.Value.Year</text>
                                                }
                                            </p>
                                            @if (album.Roles.Count > 0)
                                            {
                                                <p class="text-xs text-gray-400 mt-1 truncate">@string.Join(" · ", album.Roles)</p>
                                            }
                                        </div>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </section>
            }

            <!-- ============================================================
                 5. Track Contributions (4.2) — filterable by role / instrument / album / genre
                 ============================================================ -->
            @if (Model.Person.TrackContributions.Count > 0)
            {
                var hasContributionFilters = Model.Person.ContributionRoles.Count > 0 || Model.Person.ContributionInstruments.Count > 0
                    || Model.Person.ContributionAlbums.Count > 0 || Model.Person.ContributionGenres.Count > 0;

                <section>
                    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                        <h2 class="text-2xl font-bold text-gray-900">@Localizer["Track Contributions"]</h2>
                        <span class="text-sm text-gray-500">@Model.Person.TrackContributions.Count @Localizer["tracks"]</span>
                    </div>

                    @if (hasContributionFilters)
                    {
                        <form method="get" class="flex flex-wrap items-end gap-3 mb-6 p-4 bg-gray-50 rounded-lg border border-gray-200">
                            @if (Model.Person.ContributionRoles.Count > 0)
                            {
                                <div>
                                    <label for="contributionRole" class="block text-xs font-medium text-gray-500 mb-1">@Localizer["Role"]</label>
                                    <select id="contributionRole" name="contributionRole" class="text-sm border border-gray-300 rounded-md px-2.5 py-1.5 bg-white">
                                        <option value="">@Localizer["All"]</option>
                                        @foreach (var role in Model.Person.ContributionRoles)
                                        {
                                            var selectedAttr = Model.ContributionRole == role ? "selected" : null;
                                            <option value="@role" selected="@selectedAttr">@role</option>
                                        }
                                    </select>
                                </div>
                            }
                            @if (Model.Person.ContributionInstruments.Count > 0)
                            {
                                <div>
                                    <label for="contributionInstrument" class="block text-xs font-medium text-gray-500 mb-1">@Localizer["Instrument"]</label>
                                    <select id="contributionInstrument" name="contributionInstrument" class="text-sm border border-gray-300 rounded-md px-2.5 py-1.5 bg-white">
                                        <option value="">@Localizer["All"]</option>
                                        @foreach (var instrument in Model.Person.ContributionInstruments)
                                        {
                                            var selectedAttr = Model.ContributionInstrument == instrument ? "selected" : null;
                                            <option value="@instrument" selected="@selectedAttr">@instrument</option>
                                        }
                                    </select>
                                </div>
                            }
                            @if (Model.Person.ContributionAlbums.Count > 0)
                            {
                                <div>
                                    <label for="contributionAlbum" class="block text-xs font-medium text-gray-500 mb-1">@Localizer["Album"]</label>
                                    <select id="contributionAlbum" name="contributionAlbum" class="text-sm border border-gray-300 rounded-md px-2.5 py-1.5 bg-white">
                                        <option value="">@Localizer["All"]</option>
                                        @foreach (var album in Model.Person.ContributionAlbums)
                                        {
                                            var selectedAttr = Model.ContributionAlbum == album ? "selected" : null;
                                            <option value="@album" selected="@selectedAttr">@album</option>
                                        }
                                    </select>
                                </div>
                            }
                            @if (Model.Person.ContributionGenres.Count > 0)
                            {
                                <div>
                                    <label for="contributionGenre" class="block text-xs font-medium text-gray-500 mb-1">@Localizer["Genre"]</label>
                                    <select id="contributionGenre" name="contributionGenre" class="text-sm border border-gray-300 rounded-md px-2.5 py-1.5 bg-white">
                                        <option value="">@Localizer["All"]</option>
                                        @foreach (var genre in Model.Person.ContributionGenres)
                                        {
                                            var selectedAttr = Model.ContributionGenre == genre ? "selected" : null;
                                            <option value="@genre" selected="@selectedAttr">@genre</option>
                                        }
                                    </select>
                                </div>
                            }
                            <button type="submit" class="text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-md px-4 py-1.5 transition-colors">
                                @Localizer["Filter"]
                            </button>
                            @if (Model.ContributionRole is not null || Model.ContributionInstrument is not null || Model.ContributionAlbum is not null || Model.ContributionGenre is not null)
                            {
                                <a href="/@culture/people/@Model.Person.Slug" class="text-sm text-gray-500 hover:text-gray-700 px-2 py-1.5">@Localizer["Clear"]</a>
                            }
                        </form>
                    }

                    @{
                        var filteredContributions = Model.Person.TrackContributions
                            .Where(c => string.IsNullOrEmpty(Model.ContributionRole) || c.Roles.Contains(Model.ContributionRole))
                            .Where(c => string.IsNullOrEmpty(Model.ContributionInstrument) || c.Instruments.Contains(Model.ContributionInstrument))
                            .Where(c => string.IsNullOrEmpty(Model.ContributionAlbum) || c.AlbumTitle == Model.ContributionAlbum)
                            .Where(c => string.IsNullOrEmpty(Model.ContributionGenre) || c.Genres.Contains(Model.ContributionGenre))
                            .ToList();
                    }

                    @if (filteredContributions.Count == 0)
                    {
                        <p class="text-sm text-gray-500">@Localizer["No tracks match the selected filters."]</p>
                    }
                    else
                    {
                        <ul class="divide-y divide-gray-100 border border-gray-200 rounded-lg overflow-hidden bg-white">
                            @foreach (var contribution in filteredContributions)
                            {
                                <li class="p-3 hover:bg-gray-50 transition-colors">
                                    <div class="flex items-center justify-between gap-3">
                                        <a href="/@culture/tracks/@contribution.Slug"
                                           class="text-sm font-medium text-gray-900 hover:text-blue-600 transition-colors">
                                            @contribution.Title
                                        </a>
                                        @if (contribution.ReleaseDate.HasValue)
                                        {
                                            <span class="text-xs text-gray-400 tabular-nums">@contribution.ReleaseDate.Value.Year</span>
                                        }
                                    </div>
                                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-1 text-xs text-gray-500">
                                        @if (!string.IsNullOrWhiteSpace(contribution.AlbumTitle))
                                        {
                                            <a href="/@culture/albums/@contribution.AlbumSlug" class="hover:text-blue-600 transition-colors">@contribution.AlbumTitle</a>
                                        }
                                        @foreach (var role in contribution.Roles)
                                        {
                                            <span class="inline-block bg-purple-50 text-purple-700 px-1.5 py-0.5 rounded">@role</span>
                                        }
                                        @foreach (var instrument in contribution.Instruments)
                                        {
                                            <span class="inline-block bg-amber-50 text-amber-700 px-1.5 py-0.5 rounded">@instrument</span>
                                        }
                                        @foreach (var genre in contribution.Genres)
                                        {
                                            <span class="inline-block bg-teal-50 text-teal-700 px-1.5 py-0.5 rounded">@genre</span>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </section>
            }

            <!-- ============================================================
                 6. Instruments
                 ============================================================ -->
            @if (instruments.Count > 0)
            {
                <section>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">@Localizer["Instruments"]</h2>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var instrument in instruments)
                        {
                            string? instrName = null;
                            string? instrSlug = null;
                            try { instrName = (string?)instrument.Name ?? (string?)instrument.InstrumentName; } catch { }
                            try { instrSlug = (string?)instrument.Slug ?? (string?)instrument.InstrumentSlug; } catch { }

                            if (!string.IsNullOrWhiteSpace(instrSlug))
                            {
                                <a href="/@culture/instruments/@instrSlug"
                                   class="inline-block bg-amber-50 text-amber-700 text-sm px-3 py-1 rounded-full hover:bg-amber-100 transition-colors">
                                    @instrName
                                </a>
                            }
                            else
                            {
                                <span class="inline-block bg-amber-50 text-amber-700 text-sm px-3 py-1 rounded-full">@instrName</span>
                            }
                        }
                    </div>
                </section>
            }

            <!-- ============================================================
                 7. Roles
                 ============================================================ -->
            @if (roles.Count > 0)
            {
                <section>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">@Localizer["Roles"]</h2>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var role in roles)
                        {
                            string? roleName = null;
                            try { roleName = (string?)role.Name ?? (string?)role.RoleName; } catch { }

                            <span class="inline-block bg-purple-50 text-purple-700 text-sm px-3 py-1 rounded-full">
                                @roleName
                            </span>
                        }
                    </div>
                </section>
            }

            <!-- ============================================================
                 9. Media Gallery
                 ============================================================ -->
            @if (media.Count > 0)
            {
                var images = new List<dynamic>();
                var videos = new List<dynamic>();
                foreach (var m in media)
                {
                    string? mediaType = null;
                    try { mediaType = (string?)m.MediaType ?? (string?)m.Type; } catch { }
                    if (mediaType == "IMAGE" || mediaType == "image") images.Add(m);
                    else if (mediaType == "VIDEO" || mediaType == "video") videos.Add(m);
                }

                <section>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">@Localizer["Media"]</h2>

                    @if (images.Count > 0)
                    {
                        <h3 class="text-lg font-semibold text-gray-700 mb-2">@Localizer["Images"]</h3>
                        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 mb-6">
                            @foreach (var img in images)
                            {
                                string? imgUrl = null;
                                string? thumbUrl = null;
                                string? imgDesc = null;
                                try { imgUrl = (string?)img.Url; } catch { }
                                try { thumbUrl = (string?)img.ThumbnailUrl ?? imgUrl; } catch { }
                                try { imgDesc = (string?)img.Description; } catch { }

                                <a href="@imgUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="block aspect-square bg-gray-100 rounded-lg overflow-hidden hover:opacity-90 transition-opacity">
                                    <img src="@(thumbUrl ?? imgUrl)"
                                         alt="@(imgDesc ?? "")"
                                         class="w-full h-full object-cover"
                                         loading="lazy" />
                                </a>
                            }
                        </div>
                    }

                    @if (videos.Count > 0)
                    {
                        <h3 class="text-lg font-semibold text-gray-700 mb-2">@Localizer["Videos"]</h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                            @foreach (var vid in videos)
                            {
                                string? vidUrl = null;
                                string? vidDesc = null;
                                try { vidUrl = (string?)vid.Url; } catch { }
                                try { vidDesc = (string?)vid.Description; } catch { }

                                <div class="aspect-video bg-gray-100 rounded-lg overflow-hidden">
                                    @if (vidUrl is not null && (vidUrl.Contains("youtube") || vidUrl.Contains("youtu.be")))
                                    {
                                        <iframe src="@vidUrl"
                                                class="w-full h-full"
                                                allowfullscreen
                                                loading="lazy"
                                                title="@(vidDesc ?? "")"></iframe>
                                    }
                                    else if (vidUrl is not null)
                                    {
                                        <video src="@vidUrl"
                                               class="w-full h-full object-cover"
                                               controls
                                               preload="none"></video>
                                    }
                                </div>
                            }
                        </div>
                    }
                </section>
            }

            <!-- ============================================================
                 10. References / Citations
                 ============================================================ -->
            @if (citations.Count > 0)
            {
                <section>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">@Localizer["References"]</h2>
                    <ol class="space-y-3 list-decimal list-inside">
                        @foreach (var citation in citations)
                        {
                            string? quote = null;
                            string? sourceName = null;
                            string? sourceSlug = null;
                            string? pageNumber = null;
                            string? citationUrl = null;
                            try { quote = (string?)citation.Quote; } catch { }
                            try { sourceName = (string?)citation.SourceName; } catch { }
                            try { sourceSlug = (string?)citation.SourceSlug; } catch { }
                            try { pageNumber = (string?)citation.PageNumber; } catch { }
                            try { citationUrl = (string?)citation.Url; } catch { }

                            <li class="text-sm text-gray-700">
                                @if (!string.IsNullOrWhiteSpace(quote))
                                {
                                    <span class="font-medium">"@quote"</span>
                                    <br />
                                }
                                <span class="text-gray-500">
                                    @if (!string.IsNullOrWhiteSpace(sourceSlug))
                                    {
                                        <a href="/@culture/sources/@sourceSlug"
                                           class="text-blue-600 hover:text-blue-800">
                                            @sourceName
                                        </a>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(sourceName))
                                    {
                                        <span>@sourceName</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(pageNumber))
                                    {
                                        <span>, @Localizer["p."] @pageNumber</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(citationUrl))
                                    {
                                        <a href="@citationUrl"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="text-blue-600 hover:text-blue-800 ms-1">
                                            @Localizer["Source"]
                                        </a>
                                    }
                                </span>
                            </li>
                        }
                    </ol>
                </section>
            }

            <!-- ============================================================
                 11. External Links
                 ============================================================ -->
            @if (links.Count > 0)
            {
                <section>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">@Localizer["External Links"]</h2>
                    <ul class="space-y-1.5">
                        @foreach (var link in links)
                        {
                            string? linkUrl = null;
                            string? linkTitle = null;
                            string? linkType = null;
                            try { linkUrl = (string?)link.Url; } catch { }
                            try { linkTitle = (string?)link.Title ?? (string?)link.Name; } catch { }
                            try { linkType = (string?)link.LinkType ?? (string?)link.Type; } catch { }

                            <li>
                                <a href="@linkUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="text-blue-600 hover:text-blue-800 text-sm font-medium">
                                    @(!string.IsNullOrWhiteSpace(linkTitle) ? linkTitle : linkUrl)
                                </a>
                                @if (!string.IsNullOrWhiteSpace(linkType))
                                {
                                    <span class="text-gray-400 text-xs ms-1">[@linkType]</span>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }

            <!-- ============================================================
                 12. Tags
                 ============================================================ -->
            @if (tags.Count > 0)
            {
                <section>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">@Localizer["Tags"]</h2>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var tag in tags)
                        {
                            string? tagName = null;
                            string? tagSlug = null;
                            try { tagName = (string?)tag.Name ?? (string?)tag.TagName; } catch { }
                            try { tagSlug = (string?)tag.Slug ?? (string?)tag.TagSlug; } catch { }

                            <a href="/@culture/tags/@tagSlug"
                               class="inline-block bg-gray-100 text-gray-700 text-xs px-2.5 py-1 rounded-full hover:bg-gray-200 transition-colors">
                                #@tagName
                            </a>
                        }
                    </div>
                </section>
            }

            <!-- ============================================================
                 13. Aliases
                 ============================================================ -->
            @if (aliases.Count > 0)
            {
                <section>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">@Localizer["Also Known As"]</h2>
                    <ul class="space-y-1.5">
                        @foreach (var alias in aliases)
                        {
                            string? aliasName = null;
                            string? aliasLanguage = null;
                            string? aliasType = null;
                            bool isPrimary = false;
                            try { aliasName = (string?)alias.AliasName ?? (string?)alias.Name; } catch { }
                            try { aliasLanguage = (string?)alias.Language; } catch { }
                            try { aliasType = (string?)alias.AliasType ?? (string?)alias.Type; } catch { }
                            try { isPrimary = (bool)alias.IsPrimary; } catch { }

                            <li class="text-sm text-gray-700">
                                <span dir="auto">@aliasName</span>
                                @if (!string.IsNullOrWhiteSpace(aliasLanguage))
                                {
                                    <span class="text-gray-400 text-xs ms-2">(@aliasLanguage)</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(aliasType))
                                {
                                    <span class="text-gray-400 text-xs ms-1">[@aliasType]</span>
                                }
                                @if (isPrimary)
                                {
                                    <span class="text-blue-500 text-xs ms-1">@Localizer["Primary"]</span>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>

        <!-- ============================================================
             Sidebar — Summary metadata
             ============================================================ -->
        <aside class="w-full lg:w-72 flex-shrink-0" role="complementary" aria-label="@Localizer["Person metadata"]">
            <div class="bg-gray-50 rounded-lg border border-gray-200 p-5 space-y-4 sticky top-4">
                <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider">@Localizer["Details"]</h3>

                @if (!string.IsNullOrWhiteSpace(personKind))
                {
                    <div>
                        <h4 class="text-xs font-medium text-gray-500 uppercase">@Localizer["Kind"]</h4>
                        <p class="mt-1 text-sm text-gray-700">@personKind</p>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(nationality))
                {
                    <div>
                        <h4 class="text-xs font-medium text-gray-500 uppercase">@Localizer["Nationality"]</h4>
                        <p class="mt-1 text-sm text-gray-700">@nationality</p>
                    </div>
                }

                @if (birthDate.HasValue)
                {
                    <div>
                        <h4 class="text-xs font-medium text-gray-500 uppercase">@Localizer["Born"]</h4>
                        <p class="mt-1 text-sm text-gray-700">
                            @birthDate.Value.ToString("yyyy-MM-dd")
                            @if (!string.IsNullOrWhiteSpace(birthPlace))
                            {
                                <text>, @birthPlace</text>
                            }
                        </p>
                    </div>
                }

                @if (deathDate.HasValue)
                {
                    <div>
                        <h4 class="text-xs font-medium text-gray-500 uppercase">@Localizer["Died"]</h4>
                        <p class="mt-1 text-sm text-gray-700">
                            @deathDate.Value.ToString("yyyy-MM-dd")
                            @if (!string.IsNullOrWhiteSpace(deathPlace))
                            {
                                <text>, @deathPlace</text>
                            }
                        </p>
                    </div>
                }
            </div>
        </aside>
    </div>
</div>

<!-- ============================================================
     JSON-LD Structured Data: Person
     ============================================================ -->
<script type="application/ld+json">
{
    "@@context": "https://schema.org",
    "@@type": "Person",
    "name": "@fullName",
    @if (!string.IsNullOrWhiteSpace(originalName))
    {
        <text>"alternateName": "@originalName",</text>
    }
    @if (!string.IsNullOrWhiteSpace(englishName))
    {
        <text>"alternateName": "@englishName",</text>
    }
    @if (!string.IsNullOrWhiteSpace(imageUrl))
    {
        <text>"image": "@imageUrl",</text>
    }
    @if (birthDate.HasValue)
    {
        <text>"birthDate": "@birthDate.Value.ToString("yyyy-MM-dd")",</text>
    }
    @if (deathDate.HasValue)
    {
        <text>"deathDate": "@deathDate.Value.ToString("yyyy-MM-dd")",</text>
    }
    @if (!string.IsNullOrWhiteSpace(birthPlace))
    {
        <text>"birthPlace": "@birthPlace",</text>
    }
    @if (!string.IsNullOrWhiteSpace(deathPlace))
    {
        <text>"deathPlace": "@deathPlace",</text>
    }
    @if (!string.IsNullOrWhiteSpace(nationality))
    {
        <text>"nationality": "@nationality",</text>
    }
    "description": "@(!string.IsNullOrWhiteSpace(biography) ? (biography.Length > 200 ? biography[..200] + "..." : biography) : "")"
}
</script>
