@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model MusicEncyclopedia.Web.ViewModels.Public.PersonDetailViewModel

@{
    var culture = Context.Items["culture"] as string ?? "fa";
    var dir = Context.Items["dir"] as string ?? "ltr";
    var isRtl = dir == "rtl";
    dynamic person = Model.Person;

    // Helper: safely get a string value from a dynamic object
    string? SafeString(dynamic obj, string prop)
    {
        try
        {
            var val = (object?)obj.GetType().GetProperty(prop)?.GetValue(obj, null);
            return val?.ToString();
        }
        catch { return null; }
    }

    DateTime? SafeDate(dynamic obj, string prop)
    {
        try
        {
            var val = (object?)obj.GetType().GetProperty(prop)?.GetValue(obj, null);
            if (val is DateTime dt) return dt;
            if (val is null) return null;
            if (DateTime.TryParse(val.ToString(), out var parsed)) return parsed;
            return null;
        }
        catch { return null; }
    }

    // Extract properties safely
    var fullName = SafeString(person, "FullName") ?? SafeString(person, "Name") ?? "";
    var originalName = SafeString(person, "OriginalName");
    var englishName = SafeString(person, "EnglishName");
    var personKind = SafeString(person, "PersonKind") ?? SafeString(person, "PersonKindName");
    var nationality = SafeString(person, "Nationality");
    var birthPlace = SafeString(person, "BirthPlace");
    var deathPlace = SafeString(person, "DeathPlace");
    var biography = SafeString(person, "Biography");
    var imageUrl = SafeString(person, "ImageUrl") ?? SafeString(person, "PhotoUrl");

    var birthDate = SafeDate(person, "BirthDate");
    var deathDate = SafeDate(person, "DeathDate");

    // Helper: get a list from a dynamic object
    List<dynamic> SafeList(dynamic obj, string prop)
    {
        try
        {
            var val = (object?)obj.GetType().GetProperty(prop)?.GetValue(obj, null);
            if (val is System.Collections.IEnumerable enumerable)
            {
                var list = new List<dynamic>();
                foreach (var item in enumerable) list.Add(item);
                return list;
            }
        }
        catch { }
        return new List<dynamic>();
    }

    var instruments = SafeList(person, "Instruments");
    var roles = SafeList(person, "Roles");
    var media = SafeList(person, "Media");
    var links = SafeList(person, "Links") ?? SafeList(person, "ExternalLinks");
    var aliases = SafeList(person, "Aliases");
    var tags = SafeList(person, "Tags");
    var citations = SafeList(person, "Citations") ?? SafeList(person, "References");
    var timeline = SafeList(person, "Timeline");
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" dir="@dir">

    <!-- ============================================================
         Breadcrumb
         ============================================================ -->
    <nav aria-label="@Localizer["Breadcrumb"]" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
            <li><a href="/@culture" class="hover:text-blue-600 transition-colors">@Localizer["Home"]</a></li>
            <li><span class="mx-1">/</span></li>
            <li><a href="/@culture/people" class="hover:text-blue-600 transition-colors">@Localizer["People"]</a></li>
            <li><span class="mx-1">/</span></li>
            <li class="text-gray-900 font-medium truncate max-w-[200px]" aria-current="page">@fullName</li>
        </ol>
    </nav>

    <!-- ============================================================
         1. Header — Image, Full Name, Original Name, English Name,
            Person Kind, Nationality, Birth/Death Date, Birth/Death Place
         ============================================================ -->
    <div class="flex flex-col md:flex-row gap-8 mb-10">
        <!-- Image -->
        <div class="w-full md:w-72 flex-shrink-0">
            <div class="aspect-square bg-gray-100 rounded-lg overflow-hidden shadow-lg flex items-center justify-center">
                @if (!string.IsNullOrWhiteSpace(imageUrl))
                {
                    <img src="@imageUrl"
                         alt="@fullName"
                         class="w-full h-full object-cover"
                         width="400"
                         height="400" />
                }
                else
                {
                    <svg class="w-24 h-24 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                }
            </div>
        </div>

        <!-- Person Info -->
        <div class="flex-1 min-w-0">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900">@fullName</h1>

            @if (!string.IsNullOrWhiteSpace(originalName) && originalName != fullName)
            {
                <p class="text-xl text-gray-500 mt-1" dir="auto">@originalName</p>
            }
            @if (!string.IsNullOrWhiteSpace(englishName) && englishName != fullName && englishName != originalName)
            {
                <p class="text-lg text-gray-400 mt-0.5" dir="ltr">@englishName</p>
            }

            <!-- Kind & Nationality badges -->
            <div class="flex flex-wrap items-center gap-2 mt-3">
                @if (!string.IsNullOrWhiteSpace(personKind))
                {
                    <span class="inline-block bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
                        @personKind
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(nationality))
                {
                    <span class="inline-block bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
                        @nationality
                    </span>
                }
            </div>

            <!-- Birth / Death dates -->
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-3 text-sm text-gray-600">
                @if (birthDate.HasValue)
                {
                    <span>
                        <span class="font-medium text-gray-700">@Localizer["Born"]:</span>
                        @birthDate.Value.ToString("yyyy-MM-dd")
                        @if (!string.IsNullOrWhiteSpace(birthPlace))
                        {
                            <span>, @birthPlace</span>
                        }
                    </span>
                }
                else if (!string.IsNullOrWhiteSpace(birthPlace))
                {
                    <span>
                        <span class="font-medium text-gray-700">@Localizer["Born"]:</span>
                        @birthPlace
                    </span>
                }

                @if (deathDate.HasValue)
                {
                    <span>
                        <span class="font-medium text-gray-700">@Localizer["Died"]:</span>
                        @deathDate.Value.ToString("yyyy-MM-dd")
                        @if (!string.IsNullOrWhiteSpace(deathPlace))
                        {
                            <span>, @deathPlace</span>
                        }
                    </span>
                }
                else if (!string.IsNullOrWhiteSpace(deathPlace))
                {
                    <span>
                        <span class="font-medium text-gray-700">@Localizer["Died"]:</span>
                        @deathPlace
                    </span>
                }
            </div>
        </div>
    </div>

    <div class="flex flex-col lg:flex-row gap-8">
        <!-- ============================================================
             Main Content
             ============================================================ -->
        <div class="flex-1 min-w-0 space-y-10">

            <!-- ============================================================
                 2. Biography
                 ============================================================ -->
            @if (!string.IsNullOrWhiteSpace(biography))
            {
                <section>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">@Localizer["Biography"]</h2>
                    <div class="prose prose-gray max-w-none text-gray-700 leading-relaxed">
                        @biography
                    </div>
                </section>
            }

            <!-- ============================================================
                 3. Timeline
                 ============================================================ -->
            @if (timeline.Count > 0)
            {
                <section>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">@Localizer["Timeline"]</h2>
                    <div class="space-y-4">
                        @foreach (var entry in timeline)
                        {
                            string? entryTitle = null;
                            string? entryDate = null;
                            string? entryType = null;
                            try { entryTitle = (string?)entry.Title ?? (string?)entry.Name; } catch { }
                            try { entryDate = (string?)entry.Date?.ToString() ?? (string?)entry.Year?.ToString(); } catch { }
                            try { entryType = (string?)entry.Type ?? (string?)entry.EventType; } catch { }

                            <div class="border-s-2 border-blue-300 ps-4 py-1">
                                @if (!string.IsNullOrWhiteSpace(entryDate))
                                {
                                    <span class="text-xs text-blue-600 font-medium">@entryDate</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(entryTitle))
                                {
                                    <p class="text-sm text-gray-700 mt-0.5">@entryTitle</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(entryType))
                                {
                                    <span class="text-xs text-gray-400">@entryType</span>
                                }
                            </div>
                        }
                    </div>
                </section>
            }

            <!-- ============================================================
                 6. Instruments
                 ============================================================ -->
            @if (instruments.Count > 0)
            {
                <section>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">@Localizer["Instruments"]</h2>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var instrument in instruments)
                        {
                            string? instrName = null;
                            string? instrSlug = null;
                            try { instrName = (string?)instrument.Name ?? (string?)instrument.InstrumentName; } catch { }
                            try { instrSlug = (string?)instrument.Slug ?? (string?)instrument.InstrumentSlug; } catch { }

                            if (!string.IsNullOrWhiteSpace(instrSlug))
                            {
                                <a href="/@culture/instruments/@instrSlug"
                                   class="inline-block bg-amber-50 text-amber-700 text-sm px-3 py-1 rounded-full hover:bg-amber-100 transition-colors">
                                    @instrName
                                </a>
                            }
                            else
                            {
                                <span class="inline-block bg-amber-50 text-amber-700 text-sm px-3 py-1 rounded-full">@instrName</span>
                            }
                        }
                    </div>
                </section>
            }

            <!-- ============================================================
                 7. Roles
                 ============================================================ -->
            @if (roles.Count > 0)
            {
                <section>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">@Localizer["Roles"]</h2>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var role in roles)
                        {
                            string? roleName = null;
                            try { roleName = (string?)role.Name ?? (string?)role.RoleName; } catch { }

                            <span class="inline-block bg-purple-50 text-purple-700 text-sm px-3 py-1 rounded-full">
                                @roleName
                            </span>
                        }
                    </div>
                </section>
            }

            <!-- ============================================================
                 9. Media Gallery
                 ============================================================ -->
            @if (media.Count > 0)
            {
                var images = new List<dynamic>();
                var videos = new List<dynamic>();
                foreach (var m in media)
                {
                    string? mediaType = null;
                    try { mediaType = (string?)m.MediaType ?? (string?)m.Type; } catch { }
                    if (mediaType == "IMAGE" || mediaType == "image") images.Add(m);
                    else if (mediaType == "VIDEO" || mediaType == "video") videos.Add(m);
                }

                <section>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">@Localizer["Media"]</h2>

                    @if (images.Count > 0)
                    {
                        <h3 class="text-lg font-semibold text-gray-700 mb-2">@Localizer["Images"]</h3>
                        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 mb-6">
                            @foreach (var img in images)
                            {
                                string? imgUrl = null;
                                string? thumbUrl = null;
                                string? imgDesc = null;
                                try { imgUrl = (string?)img.Url; } catch { }
                                try { thumbUrl = (string?)img.ThumbnailUrl ?? imgUrl; } catch { }
                                try { imgDesc = (string?)img.Description; } catch { }

                                <a href="@imgUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="block aspect-square bg-gray-100 rounded-lg overflow-hidden hover:opacity-90 transition-opacity">
                                    <img src="@(thumbUrl ?? imgUrl)"
                                         alt="@(imgDesc ?? "")"
                                         class="w-full h-full object-cover"
                                         loading="lazy" />
                                </a>
                            }
                        </div>
                    }

                    @if (videos.Count > 0)
                    {
                        <h3 class="text-lg font-semibold text-gray-700 mb-2">@Localizer["Videos"]</h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                            @foreach (var vid in videos)
                            {
                                string? vidUrl = null;
                                string? vidDesc = null;
                                try { vidUrl = (string?)vid.Url; } catch { }
                                try { vidDesc = (string?)vid.Description; } catch { }

                                <div class="aspect-video bg-gray-100 rounded-lg overflow-hidden">
                                    @if (vidUrl is not null && (vidUrl.Contains("youtube") || vidUrl.Contains("youtu.be")))
                                    {
                                        <iframe src="@vidUrl"
                                                class="w-full h-full"
                                                allowfullscreen
                                                loading="lazy"
                                                title="@(vidDesc ?? "")"></iframe>
                                    }
                                    else if (vidUrl is not null)
                                    {
                                        <video src="@vidUrl"
                                               class="w-full h-full object-cover"
                                               controls
                                               preload="none"></video>
                                    }
                                </div>
                            }
                        </div>
                    }
                </section>
            }

            <!-- ============================================================
                 10. References / Citations
                 ============================================================ -->
            @if (citations.Count > 0)
            {
                <section>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">@Localizer["References"]</h2>
                    <ol class="space-y-3 list-decimal list-inside">
                        @foreach (var citation in citations)
                        {
                            string? quote = null;
                            string? sourceName = null;
                            string? sourceSlug = null;
                            string? pageNumber = null;
                            string? citationUrl = null;
                            try { quote = (string?)citation.Quote; } catch { }
                            try { sourceName = (string?)citation.SourceName; } catch { }
                            try { sourceSlug = (string?)citation.SourceSlug; } catch { }
                            try { pageNumber = (string?)citation.PageNumber; } catch { }
                            try { citationUrl = (string?)citation.Url; } catch { }

                            <li class="text-sm text-gray-700">
                                @if (!string.IsNullOrWhiteSpace(quote))
                                {
                                    <span class="font-medium">"@quote"</span>
                                    <br />
                                }
                                <span class="text-gray-500">
                                    @if (!string.IsNullOrWhiteSpace(sourceSlug))
                                    {
                                        <a href="/@culture/sources/@sourceSlug"
                                           class="text-blue-600 hover:text-blue-800">
                                            @sourceName
                                        </a>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(sourceName))
                                    {
                                        <span>@sourceName</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(pageNumber))
                                    {
                                        <span>, @Localizer["p."] @pageNumber</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(citationUrl))
                                    {
                                        <a href="@citationUrl"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="text-blue-600 hover:text-blue-800 ms-1">
                                            @Localizer["Source"]
                                        </a>
                                    }
                                </span>
                            </li>
                        }
                    </ol>
                </section>
            }

            <!-- ============================================================
                 11. External Links
                 ============================================================ -->
            @if (links.Count > 0)
            {
                <section>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">@Localizer["External Links"]</h2>
                    <ul class="space-y-1.5">
                        @foreach (var link in links)
                        {
                            string? linkUrl = null;
                            string? linkTitle = null;
                            string? linkType = null;
                            try { linkUrl = (string?)link.Url; } catch { }
                            try { linkTitle = (string?)link.Title ?? (string?)link.Name; } catch { }
                            try { linkType = (string?)link.LinkType ?? (string?)link.Type; } catch { }

                            <li>
                                <a href="@linkUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="text-blue-600 hover:text-blue-800 text-sm font-medium">
                                    @(!string.IsNullOrWhiteSpace(linkTitle) ? linkTitle : linkUrl)
                                </a>
                                @if (!string.IsNullOrWhiteSpace(linkType))
                                {
                                    <span class="text-gray-400 text-xs ms-1">[@linkType]</span>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }

            <!-- ============================================================
                 12. Tags
                 ============================================================ -->
            @if (tags.Count > 0)
            {
                <section>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">@Localizer["Tags"]</h2>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var tag in tags)
                        {
                            string? tagName = null;
                            string? tagSlug = null;
                            try { tagName = (string?)tag.Name ?? (string?)tag.TagName; } catch { }
                            try { tagSlug = (string?)tag.Slug ?? (string?)tag.TagSlug; } catch { }

                            <a href="/@culture/tags/@tagSlug"
                               class="inline-block bg-gray-100 text-gray-700 text-xs px-2.5 py-1 rounded-full hover:bg-gray-200 transition-colors">
                                #@tagName
                            </a>
                        }
                    </div>
                </section>
            }

            <!-- ============================================================
                 13. Aliases
                 ============================================================ -->
            @if (aliases.Count > 0)
            {
                <section>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">@Localizer["Also Known As"]</h2>
                    <ul class="space-y-1.5">
                        @foreach (var alias in aliases)
                        {
                            string? aliasName = null;
                            string? aliasLanguage = null;
                            string? aliasType = null;
                            bool isPrimary = false;
                            try { aliasName = (string?)alias.AliasName ?? (string?)alias.Name; } catch { }
                            try { aliasLanguage = (string?)alias.Language; } catch { }
                            try { aliasType = (string?)alias.AliasType ?? (string?)alias.Type; } catch { }
                            try { isPrimary = (bool)alias.IsPrimary; } catch { }

                            <li class="text-sm text-gray-700">
                                <span dir="auto">@aliasName</span>
                                @if (!string.IsNullOrWhiteSpace(aliasLanguage))
                                {
                                    <span class="text-gray-400 text-xs ms-2">(@aliasLanguage)</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(aliasType))
                                {
                                    <span class="text-gray-400 text-xs ms-1">[@aliasType]</span>
                                }
                                @if (isPrimary)
                                {
                                    <span class="text-blue-500 text-xs ms-1">@Localizer["Primary"]</span>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>

        <!-- ============================================================
             Sidebar — Summary metadata
             ============================================================ -->
        <aside class="w-full lg:w-72 flex-shrink-0" role="complementary" aria-label="@Localizer["Person metadata"]">
            <div class="bg-gray-50 rounded-lg border border-gray-200 p-5 space-y-4 sticky top-4">
                <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider">@Localizer["Details"]</h3>

                @if (!string.IsNullOrWhiteSpace(personKind))
                {
                    <div>
                        <h4 class="text-xs font-medium text-gray-500 uppercase">@Localizer["Kind"]</h4>
                        <p class="mt-1 text-sm text-gray-700">@personKind</p>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(nationality))
                {
                    <div>
                        <h4 class="text-xs font-medium text-gray-500 uppercase">@Localizer["Nationality"]</h4>
                        <p class="mt-1 text-sm text-gray-700">@nationality</p>
                    </div>
                }

                @if (birthDate.HasValue)
                {
                    <div>
                        <h4 class="text-xs font-medium text-gray-500 uppercase">@Localizer["Born"]</h4>
                        <p class="mt-1 text-sm text-gray-700">
                            @birthDate.Value.ToString("yyyy-MM-dd")
                            @if (!string.IsNullOrWhiteSpace(birthPlace))
                            {
                                <text>, @birthPlace</text>
                            }
                        </p>
                    </div>
                }

                @if (deathDate.HasValue)
                {
                    <div>
                        <h4 class="text-xs font-medium text-gray-500 uppercase">@Localizer["Died"]</h4>
                        <p class="mt-1 text-sm text-gray-700">
                            @deathDate.Value.ToString("yyyy-MM-dd")
                            @if (!string.IsNullOrWhiteSpace(deathPlace))
                            {
                                <text>, @deathPlace</text>
                            }
                        </p>
                    </div>
                }
            </div>
        </aside>
    </div>
</div>

<!-- ============================================================
     JSON-LD Structured Data: Person
     ============================================================ -->
<script type="application/ld+json">
{
    "@@context": "https://schema.org",
    "@@type": "Person",
    "name": "@fullName",
    @if (!string.IsNullOrWhiteSpace(originalName))
    {
        <text>"alternateName": "@originalName",</text>
    }
    @if (!string.IsNullOrWhiteSpace(englishName))
    {
        <text>"alternateName": "@englishName",</text>
    }
    @if (!string.IsNullOrWhiteSpace(imageUrl))
    {
        <text>"image": "@imageUrl",</text>
    }
    @if (birthDate.HasValue)
    {
        <text>"birthDate": "@birthDate.Value.ToString("yyyy-MM-dd")",</text>
    }
    @if (deathDate.HasValue)
    {
        <text>"deathDate": "@deathDate.Value.ToString("yyyy-MM-dd")",</text>
    }
    @if (!string.IsNullOrWhiteSpace(birthPlace))
    {
        <text>"birthPlace": "@birthPlace",</text>
    }
    @if (!string.IsNullOrWhiteSpace(deathPlace))
    {
        <text>"deathPlace": "@deathPlace",</text>
    }
    @if (!string.IsNullOrWhiteSpace(nationality))
    {
        <text>"nationality": "@nationality",</text>
    }
    "description": "@(!string.IsNullOrWhiteSpace(biography) ? (biography.Length > 200 ? biography[..200] + "..." : biography) : "")"
}
</script>
