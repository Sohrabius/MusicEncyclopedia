@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model MusicEncyclopedia.Web.ViewModels.Public.AwardDetailViewModel

@{
    var culture = Context.Items["culture"] as string ?? "fa";
    var dir = Context.Items["dir"] as string ?? "ltr";
    var award = Model.Award;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" dir="@dir">
    <nav aria-label="@Localizer["Breadcrumb"]" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
            <li><a href="/@culture" class="hover:text-blue-600">@Localizer["Home"]</a></li>
            <li><a href="/@culture/awards" class="hover:text-blue-600 ms-1">@Localizer["Awards"]</a></li>
            <li><span class="mx-1">/</span></li>
            <li class="text-gray-900 font-medium truncate max-w-[200px]" aria-current="page">@award.Name</li>
        </ol>
    </nav>

    <div class="flex flex-col lg:flex-row gap-8">
        <div class="flex-1 min-w-0 space-y-8">
            <section>
                <h1 class="text-3xl font-bold text-gray-900">@award.Name</h1>
                <div class="flex flex-wrap gap-3 mt-3">
                    @if (!string.IsNullOrWhiteSpace(award.Organization))
                    {
                        <span class="text-sm text-gray-600"><i class="fas fa-building text-gray-400 me-1"></i> @award.Organization</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(award.CountryName))
                    {
                        <span class="text-sm text-gray-600"><i class="fas fa-globe text-gray-400 me-1"></i> @award.CountryName</span>
                    }
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(award.Description))
            {
                <section class="bg-white rounded-lg p-5 border border-gray-200">
                    <h2 class="text-lg font-semibold text-gray-900 mb-2">@Localizer["Description"]</h2>
                    <div class="text-gray-700 whitespace-pre-line">@award.Description</div>
                </section>
            }

            @if (award.Assignments.Count > 0)
            {
                <section>
                    <h2 class="text-lg font-semibold text-gray-900 mb-3">@Localizer["Winners & Nominees"]</h2>
                    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
                        <table class="w-full text-sm">
                            <thead class="bg-gray-50 border-b border-gray-200">
                                <tr>
                                    <th class="text-start px-4 py-2 font-medium text-gray-600">@Localizer["Year"]</th>
                                    <th class="text-start px-4 py-2 font-medium text-gray-600">@Localizer["Category"]</th>
                                    <th class="text-start px-4 py-2 font-medium text-gray-600">@Localizer["Entity"]</th>
                                    <th class="text-start px-4 py-2 font-medium text-gray-600">@Localizer["Result"]</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                @foreach (var assignment in award.Assignments)
                                {
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-4 py-2 text-gray-900">@assignment.Year?.ToString()</td>
                                        <td class="px-4 py-2 text-gray-700">@(assignment.Category ?? "—")</td>
                                        <td class="px-4 py-2 text-gray-900">@assignment.EntityName</td>
                                        <td class="px-4 py-2">
                                            <span class="inline-block px-2 py-0.5 text-xs rounded-full @(assignment.ResultTypeCode == "WINNER" ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-600")">
                                                @(assignment.ResultTypeName ?? "Nominated")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        </div>

        <aside class="w-full lg:w-72 space-y-4">
            <div class="bg-white rounded-lg border border-gray-200 p-4">
                <h3 class="text-sm font-semibold text-gray-700 mb-2">@Localizer["Award Info"]</h3>
                <dl class="space-y-1 text-sm">
                    <div class="flex justify-between"><dt class="text-gray-500">@Localizer["Organization"]</dt><dd class="text-gray-900">@(award.Organization ?? "—")</dd></div>
                    <div class="flex justify-between"><dt class="text-gray-500">@Localizer["Country"]</dt><dd class="text-gray-900">@(award.CountryName ?? "—")</dd></div>
                    <div class="flex justify-between"><dt class="text-gray-500">@Localizer["Assignments"]</dt><dd class="text-gray-900">@award.Assignments.Count</dd></div>
                </dl>
            </div>
        </aside>
    </div>
</div>

<!-- ============================================================
     JSON-LD Structured Data: Award
     ============================================================ -->
@section StructuredData {
<script type="application/ld+json">
{
    "@@context": "https://schema.org",
    "@@type": "Thing",
    "name": "@Model.Award.Name",
    @if (!string.IsNullOrWhiteSpace(Model.Award.Description))
    {
        <text>"description": "@Model.Award.Description",</text>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Award.Organization))
    {
        <text>"publisher": {
            "@@type": "Organization",
            "name": "@Model.Award.Organization"
        },</text>
    }
    "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}/{culture}/awards/{Model.Award.Slug}")"
}
</script>
}
