@model RoleEditViewModel
@{
    var isEditing = !string.IsNullOrWhiteSpace(Model.Id);
    ViewData["Title"] = isEditing ? $"Edit Role: {Model.Name}" : "Create Role";
    ViewData["ActiveMenu"] = "Roles";
    var actionUrl = isEditing ? $"/admin/roles/{Model.Id}/Edit" : "/admin/roles/Create";
}

<form method="post" action="@actionUrl">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-error-soft border border-error-border text-error-hover text-sm" role="alert"></div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">نقش نام</h2>
                <div><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" aria-live="polite" class="field-error"></span></div>
            </div>
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-1">دسترسی‌ها</h2>
                <p class="text-sm text-ink-muted mb-4">دسترسی‌های اعطاشده به هر کاربر در این نقش. هنگام ورود به‌صورت خودکار اعمال می‌شود.</p>
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-2 border border-rule rounded-md p-3 max-h-96 overflow-y-auto">
                    @foreach (var permission in Model.AllPermissions)
                    {
                        <label class="flex items-center gap-2 text-sm cursor-pointer hover:bg-paper rounded px-1 py-0.5">
                            <input type="checkbox" name="SelectedPermissions" value="@permission" @(Model.SelectedPermissions.Contains(permission) ? "checked" : "") class="rounded border-rule-strong text-accent focus-visible:ring-accent" />
                            <span class="font-mono text-xs">@permission</span>
                        </label>
                    }
                </div>
            </div>
        </div>
        <div class="space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">عملیات</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-accent text-on-accent text-sm font-medium rounded-md hover:bg-accent-hover transition-colors flex items-center justify-center gap-2"><i aria-hidden="true" class="fas fa-save"></i> @(isEditing ? "Save Changes" : "Create Role")</button>
                <a href="/admin/roles" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-ink-secondary bg-paper-muted rounded-md hover:bg-rule transition-colors"><i aria-hidden="true" class="fas fa-arrow-left me-1"></i> بازگشت به نقش‌ها</a>
            </div>
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
