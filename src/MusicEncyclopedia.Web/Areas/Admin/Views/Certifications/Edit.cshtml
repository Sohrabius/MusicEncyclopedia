@model CertificationEditViewModel
@{
    ViewData["Title"] = $"Edit: {Model.Name}";
    ViewData["ActiveMenu"] = "Certifications";
}

<form method="post" action="/admin/certifications/@Model.CertificationId/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CertificationId" />
    <input type="hidden" asp-for="RowVersion" />
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-error-soft border border-error-border text-error-hover text-sm" role="alert"></div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">اطلاعات پایه</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" aria-live="polite" class="field-error"></span></div>
                    <div><label asp-for="Organization" class="form-label"></label><input asp-for="Organization" class="form-control" /></div>
                    <div><label asp-for="CountryId" class="form-label"></label><select asp-for="CountryId" class="form-control"><option value="">-- هیچ‌کدام --</option>@foreach (var c in Model.Countries) { <option value="@c.CountryId">@c.Name</option> }</select></div>
                    <div class="md:col-span-2"><label asp-for="Slug" class="form-label"></label><input asp-for="Slug" class="form-control" /><span asp-validation-for="Slug" aria-live="polite" class="field-error"></span></div>
                </div>
            </div>
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">توضیحات</h2>
                <div><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="5" class="form-control"></textarea></div>
            </div>
        </div>
        <div class="space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">عملیات</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-accent text-on-accent text-sm font-medium rounded-md hover:bg-accent-hover transition-colors flex items-center justify-center gap-2"><i aria-hidden="true" class="fas fa-save"></i> ذخیره تغییرات</button>
                <a href="/admin/certifications" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-ink-secondary bg-paper-muted rounded-md hover:bg-rule transition-colors"><i aria-hidden="true" class="fas fa-arrow-left me-1"></i> بازگشت به فهرست</a>
                <hr class="border-rule my-3" />
                <form method="post" action="/admin/certifications/@Model.CertificationId/Delete" onsubmit="return confirm('Are you sure?');">@Html.AntiForgeryToken()<button type="submit" class="w-full px-4 py-2 text-sm text-error border border-error-border rounded-md hover:bg-error-soft transition-colors flex items-center justify-center gap-2"><i aria-hidden="true" class="fas fa-trash-alt"></i> حذف</button></form>
            </div>
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
