@model LinkEditViewModel
@{
    ViewData["Title"] = "ویرایش پیوند";
    ViewData["ActiveMenu"] = "Links";
}

<form method="post" action="/admin/links/@Model.EntityLinkId/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="EntityLinkId" />
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-error-soft border border-error-border text-error-hover text-sm" role="alert"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">پیوند جزئیات</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="EntityTypeId" class="form-label"></label>
                        <select asp-for="EntityTypeId" class="form-control">
                            <option value="">-- انتخاب نوع موجودیت --</option>
                            @foreach (var et in Model.EntityTypes)
                            {
                                <option value="@et.EntityTypeId">@et.Name (@et.Code)</option>
                            }
                        </select>
                        <span asp-validation-for="EntityTypeId" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="EntityId" class="form-label"></label>
                        <input asp-for="EntityId" type="number" class="form-control" placeholder="شناسه موجودیت" />
                        <span asp-validation-for="EntityId" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="LinkTypeId" class="form-label"></label>
                        <select asp-for="LinkTypeId" class="form-control">
                            <option value="">-- انتخاب نوع پیوند --</option>
                            @foreach (var lt in Model.LinkTypes)
                            {
                                <option value="@lt.LinkTypeId">@lt.Name</option>
                            }
                        </select>
                        <span asp-validation-for="LinkTypeId" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" placeholder="پیوند title" />
                        <span asp-validation-for="Title" aria-live="polite" class="field-error"></span>
                    </div>
                </div>
            </div>
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">URL</h2>
                <div>
                    <label asp-for="Url" class="form-label"></label>
                    <input asp-for="Url" type="url" class="form-control" placeholder="https://example.com" />
                    <span asp-validation-for="Url" aria-live="polite" class="field-error"></span>
                </div>
            </div>
        </div>
        <div class="space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">عملیات</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-accent text-on-accent text-sm font-medium rounded-md hover:bg-accent-hover transition-colors flex items-center justify-center gap-2"><i aria-hidden="true" class="fas fa-save"></i> ذخیره تغییرات</button>
                <a href="/admin/links" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-ink-secondary bg-paper-muted rounded-md hover:bg-rule transition-colors"><i aria-hidden="true" class="fas fa-arrow-left me-1"></i> بازگشت به فهرست</a>
                <hr class="border-rule my-3" />
                <form method="post" action="/admin/links/@Model.EntityLinkId/Delete" onsubmit="return confirm('Are you sure you want to delete this link?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full px-4 py-2 text-sm text-error border border-error-border rounded-md hover:bg-error-soft transition-colors flex items-center justify-center gap-2"><i aria-hidden="true" class="fas fa-trash-alt"></i> حذف</button>
                </form>
            </div>
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-sm font-semibold text-ink-secondary mb-2">اطلاعات</h2>
                <dl class="space-y-2 text-xs">
                    <div class="flex justify-between"><dt class="text-ink-muted">ID</dt><dd class="text-ink font-mono">@Model.EntityLinkId</dd></div>
                </dl>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.1.0/jquery.validate.unobtrusive.min.js"></script>
}
