@model LinkEditViewModel
@{
    ViewData["Title"] = "ویرایش پیوند";
    ViewData["ActiveMenu"] = "Links";
}

<form method="post" action="/admin/links/@Model.EntityLinkId/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="EntityLinkId" />
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-red-50 border border-red-200 text-red-800 text-sm" role="alert"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">پیوند جزئیات</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="EntityTypeId" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <select asp-for="EntityTypeId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">-- انتخاب نوع موجودیت --</option>
                            @foreach (var et in Model.EntityTypes)
                            {
                                <option value="@et.EntityTypeId">@et.Name (@et.Code)</option>
                            }
                        </select>
                        <span asp-validation-for="EntityTypeId" class="text-xs text-red-600"></span>
                    </div>
                    <div>
                        <label asp-for="EntityId" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="EntityId" type="number" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="شناسه موجودیت" />
                        <span asp-validation-for="EntityId" class="text-xs text-red-600"></span>
                    </div>
                    <div>
                        <label asp-for="LinkTypeId" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <select asp-for="LinkTypeId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">-- انتخاب نوع پیوند --</option>
                            @foreach (var lt in Model.LinkTypes)
                            {
                                <option value="@lt.LinkTypeId">@lt.Name</option>
                            }
                        </select>
                        <span asp-validation-for="LinkTypeId" class="text-xs text-red-600"></span>
                    </div>
                    <div>
                        <label asp-for="Title" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="Title" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="پیوند title" />
                        <span asp-validation-for="Title" class="text-xs text-red-600"></span>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">URL</h2>
                <div>
                    <label asp-for="Url" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="Url" type="url" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="https://example.com" />
                    <span asp-validation-for="Url" class="text-xs text-red-600"></span>
                </div>
            </div>
        </div>
        <div class="space-y-6">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">عملیات</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors flex items-center justify-center gap-2"><i class="fas fa-save"></i> ذخیره تغییرات</button>
                <a href="/admin/links" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-gray-600 bg-gray-100 rounded-md hover:bg-gray-200 transition-colors"><i class="fas fa-arrow-left me-1"></i> بازگشت به فهرست</a>
                <hr class="border-gray-200 my-3" />
                <form method="post" action="/admin/links/@Model.EntityLinkId/Delete" onsubmit="return confirm('Are you sure you want to delete this link?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full px-4 py-2 text-sm text-red-600 border border-red-200 rounded-md hover:bg-red-50 transition-colors flex items-center justify-center gap-2"><i class="fas fa-trash-alt"></i> حذف</button>
                </form>
            </div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-sm font-semibold text-gray-700 mb-2">اطلاعات</h2>
                <dl class="space-y-2 text-xs">
                    <div class="flex justify-between"><dt class="text-gray-500">ID</dt><dd class="text-gray-900 font-mono">@Model.EntityLinkId</dd></div>
                </dl>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.1.0/jquery.validate.unobtrusive.min.js"></script>
}
