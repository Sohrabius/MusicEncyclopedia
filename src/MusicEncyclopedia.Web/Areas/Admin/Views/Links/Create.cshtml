@model LinkEditViewModel
@{
    ViewData["Title"] = "ایجاد پیوند";
    ViewData["ActiveMenu"] = "Links";
}

<form method="post" action="/admin/links/Create">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-error-soft border border-error-border text-error-hover text-sm" role="alert"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">پیوند جزئیات</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="EntityTypeId" class="form-label"></label>
                        <select asp-for="EntityTypeId" class="form-control">
                            <option value="">-- انتخاب نوع موجودیت --</option>
                            @foreach (var et in Model.EntityTypes)
                            {
                                <option value="@et.EntityTypeId">@et.Name (@et.Code)</option>
                            }
                        </select>
                        <span asp-validation-for="EntityTypeId" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="EntityId" class="form-label"></label>
                        <input asp-for="EntityId" type="number" class="form-control" placeholder="شناسه موجودیت" />
                        <span asp-validation-for="EntityId" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="LinkTypeId" class="form-label"></label>
                        <select asp-for="LinkTypeId" class="form-control">
                            <option value="">-- انتخاب نوع پیوند --</option>
                            @foreach (var lt in Model.LinkTypes)
                            {
                                <option value="@lt.LinkTypeId">@lt.Name</option>
                            }
                        </select>
                        <span asp-validation-for="LinkTypeId" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" placeholder="پیوند title" />
                        <span asp-validation-for="Title" aria-live="polite" class="field-error"></span>
                    </div>
                </div>
            </div>
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">URL</h2>
                <div>
                    <label asp-for="Url" class="form-label"></label>
                    <input asp-for="Url" type="url" class="form-control" placeholder="https://example.com" />
                    <span asp-validation-for="Url" aria-live="polite" class="field-error"></span>
                </div>
            </div>
        </div>
        <div class="space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">انتشار</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-accent text-on-accent text-sm font-medium rounded-md hover:bg-accent-hover transition-colors flex items-center justify-center gap-2"><i aria-hidden="true" class="fas fa-save"></i> ایجاد پیوند</button>
                <a href="/admin/links" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-ink-secondary bg-paper-muted rounded-md hover:bg-rule transition-colors">انصراف</a>
            </div>
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-sm font-semibold text-ink-secondary mb-2">درباره پیوندها</h2>
                <ul class="text-xs text-ink-muted space-y-1 list-disc list-inside">
                    <li>پیوندها موجودیت‌ها را به منابع خارجی متصل می‌کنند.</li>
                    <li>نوع موجودیت و شناسه را برای مرتبط‌کردن این پیوند انتخاب کنید.</li>
                    <li>Valid URLs must include the protocol (https://).</li>
                </ul>
            </div>
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
