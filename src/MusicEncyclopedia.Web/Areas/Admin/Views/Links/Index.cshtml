@model LinkListViewModel
@{
    ViewData["Title"] = "پیوندهای موجودیت";
    ViewData["ActiveMenu"] = "Links";
}

<div class="bg-surface rounded-lg shadow-sm border border-rule p-4 mb-6">
    <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between">
        <form method="get" action="/admin/links" class="flex items-center gap-2 flex-1 max-w-md">
            <div class="relative flex-1">
                <i aria-hidden="true" class="fas fa-search absolute start-3 top-1/2 -translate-y-1/2 text-ink-muted text-sm"></i>
                <input type="text" name="q" value="@Model.SearchQuery" placeholder="جستجو پیوندی..." class="w-full ps-9 pe-3 py-2 border border-rule-strong rounded-md text-sm focus-visible:ring-2 focus-visible:ring-accent focus-visible:border-accent" />
            </div>
            <button type="submit" class="px-4 py-2 bg-accent text-on-accent text-sm rounded-md hover:bg-accent-hover transition-colors min-w-11 min-h-11 inline-flex items-center justify-center" aria-label="جستجو"><i aria-hidden="true" class="fas fa-search"></i></button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery)) { <a href="/admin/links" class="px-3 py-2 text-sm text-ink-secondary hover:text-ink"><i aria-hidden="true" class="fas fa-times"></i> پاک کردن</a> }
        </form>
        <a href="/admin/links/Create" class="inline-flex items-center gap-2 px-4 py-2 bg-success text-on-accent text-sm rounded-md hover:bg-success-hover transition-colors"><i aria-hidden="true" class="fas fa-plus"></i> <span>ایجاد پیوند</span></a>
    </div>
</div>

<div class="bg-surface rounded-lg shadow-sm border border-rule overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-paper border-b border-rule">
                <tr>
                    <th class="text-start px-4 py-3 font-medium text-ink-secondary">URL</th>
                    <th class="text-start px-4 py-3 font-medium text-ink-secondary">عنوان</th>
                    <th class="text-start px-4 py-3 font-medium text-ink-secondary">نوع پیوند</th>
                    <th class="text-center px-4 py-3 font-medium text-ink-secondary">موجودیت</th>
                    <th class="text-end px-4 py-3 font-medium text-ink-secondary">عملیات</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-rule-light">
                @if (Model.Items.Items.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="ui-state ui-state--empty">
                            <i aria-hidden="true" class="fas fa-link text-3xl text-ink-disabled mb-2 block"></i>
                            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                            {
                                <span>هیچ پیوندی مطابق با "<strong>@Model.SearchQuery</strong>".</span>
                            }
                            else
                            {
                                <span>هنوز پیوندی وجود ندارد. <a href="/admin/links/Create" class="text-accent hover:underline">ایجاد کنید</a>.</span>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items.Items)
                    {
                        <tr class="hover:bg-paper transition-colors">
                            <td class="px-4 py-3 max-w-xs truncate">
                                <a href="@item.Url" target="_blank" rel="noopener" class="text-accent hover:underline font-medium text-xs font-mono">
                                    <i aria-hidden="true" class="fas fa-external-link-alt me-1 text-xs"></i>@item.Url
                                </a>
                            </td>
                            <td class="px-4 py-3 text-ink-secondary">@item.Title</td>
                            <td class="px-4 py-3">
                                @if (!string.IsNullOrEmpty(item.LinkTypeName))
                                {
                                    <span class="inline-block px-2 py-0.5 bg-info-soft text-info-hover text-xs rounded-full">@item.LinkTypeName</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-center text-xs text-ink-muted">#@item.EntityId</td>
                            <td class="px-4 py-3 text-end">
                                <a href="/admin/links/@item.EntityLinkId/Edit" class="inline-flex items-center gap-1 px-2 py-1 text-xs text-accent hover:bg-accent-soft rounded"><i aria-hidden="true" class="fas fa-edit"></i> ویرایش</a>
                                <form method="post" action="/admin/links/@item.EntityLinkId/Delete" onsubmit="return confirm('Are you sure you want to delete this link?');" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="inline-flex items-center gap-1 px-2 py-1 text-xs text-error hover:bg-error-soft rounded"><i aria-hidden="true" class="fas fa-trash-alt"></i> حذف</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.Items.TotalPages > 1)
    {
        <div class="flex items-center justify-between px-4 py-3 bg-paper border-t border-rule">
            <p class="text-sm text-ink-muted">صفحه <strong>@Model.Items.Page</strong> از <strong>@Model.Items.TotalPages</strong> (@Model.Items.TotalItems total)</p>
            <nav class="flex items-center gap-1">
                @if (Model.Items.Page > 1) { <a href="/admin/links?page=@(Model.Items.Page - 1)&q=@Model.SearchQuery" class="px-3 py-1.5 text-sm text-ink-secondary hover:bg-rule rounded"><i aria-hidden="true" class="fas fa-chevron-right"></i> قبلی</a> }
                @if (Model.Items.Page < Model.Items.TotalPages) { <a href="/admin/links?page=@(Model.Items.Page + 1)&q=@Model.SearchQuery" class="px-3 py-1.5 text-sm text-ink-secondary hover:bg-rule rounded">بعدی <i aria-hidden="true" class="fas fa-chevron-left"></i></a> }
            </nav>
        </div>
    }
</div>
