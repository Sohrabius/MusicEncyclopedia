@model CitationEditViewModel
@{
    ViewData["Title"] = "ایجاد ارجاع";
    ViewData["ActiveMenu"] = "Citations";
}

<form method="post" action="/admin/citations/Create">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-error-soft border border-error-border text-error-hover text-sm" role="alert"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">منبع & موجودیت</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="EntityTypeId" class="form-label"></label>
                        <select asp-for="EntityTypeId" class="form-control">
                            <option value="">-- انتخاب نوع موجودیت --</option>
                            @foreach (var et in Model.EntityTypes)
                            {
                                <option value="@et.EntityTypeId">@et.Name (@et.Code)</option>
                            }
                        </select>
                        <span asp-validation-for="EntityTypeId" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="EntityId" class="form-label"></label>
                        <input asp-for="EntityId" type="number" class="form-control" placeholder="شناسه موجودیت" />
                        <span asp-validation-for="EntityId" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="SourceId" class="form-label"></label>
                        <div class="flex gap-2">
                            <select asp-for="SourceId" class="flex-1 px-3 py-2 border border-rule-strong rounded-md text-sm focus-visible:ring-2 focus-visible:ring-accent focus-visible:border-accent">
                                <option value="">-- انتخاب منبع --</option>
                                @foreach (var src in Model.Sources)
                                {
                                    <option value="@src.SourceId">@src.Title</option>
                                }
                            </select>
                            <button type="button" id="btn-create-source" class="px-3 py-2 bg-paper-muted text-ink-secondary text-sm rounded-md hover:bg-rule transition-colors min-w-11 min-h-11 inline-flex items-center justify-center" title="ایجاد جدید منبع"><i aria-hidden="true" class="fas fa-plus"></i></button>
                        </div>
                        <span asp-validation-for="SourceId" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="FieldName" class="form-label"></label>
                        <input asp-for="FieldName" class="form-control" placeholder="مثلاً عنوان, توضیحات" />
                        <span asp-validation-for="FieldName" aria-live="polite" class="field-error"></span>
                    </div>
                </div>
            </div>

            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">ارجاع جزئیات</h2>
                <div class="space-y-4">
                    <div>
                        <label asp-for="Quote" class="form-label"></label>
                        <textarea asp-for="Quote" rows="4" class="form-control" placeholder="Exact quote from the source..."></textarea>
                        <span asp-validation-for="Quote" aria-live="polite" class="field-error"></span>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label asp-for="PageNumber" class="form-label"></label>
                            <input asp-for="PageNumber" class="form-control" placeholder="مثلاً 42" />
                            <span asp-validation-for="PageNumber" aria-live="polite" class="field-error"></span>
                        </div>
                        <div>
                            <label asp-for="AccessedDate" class="form-label"></label>
                            <input asp-for="AccessedDate" type="date" class="form-control" />
                            <span asp-validation-for="AccessedDate" aria-live="polite" class="field-error"></span>
                        </div>
                        <div>
                            <label asp-for="Url" class="form-label"></label>
                            <input asp-for="Url" type="url" class="form-control" placeholder="https://..." />
                            <span asp-validation-for="Url" aria-live="polite" class="field-error"></span>
                        </div>
                    </div>
                    <div>
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" rows="3" class="form-control" placeholder="Additional notes about this citation..."></textarea>
                        <span asp-validation-for="Notes" aria-live="polite" class="field-error"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">انتشار</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-accent text-on-accent text-sm font-medium rounded-md hover:bg-accent-hover transition-colors flex items-center justify-center gap-2"><i aria-hidden="true" class="fas fa-save"></i> ایجاد ارجاع</button>
                <a href="/admin/citations" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-ink-secondary bg-paper-muted rounded-md hover:bg-rule transition-colors">انصراف</a>
            </div>
        </div>
    </div>
</form>

<!-- Create Source Modal -->
<div id="create-source-modal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="fixed inset-0 bg-ink-muted bg-opacity-50 transition-opacity" onclick="closeSourceModal()"></div>
        <div class="relative bg-surface rounded-lg shadow-xl max-w-md w-full p-6">
            <div id="modal-content">
                <!-- Loaded via AJAX -->
                <div class="text-center py-4">
                    <i aria-hidden="true" class="fas fa-spinner fa-spin text-ink-muted text-2xl"></i>
                    <p class="ui-state--loading text-sm text-ink-muted mt-2" role="status">در حال بارگذاری…</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.1.0/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var btn = document.getElementById('btn-create-source');
            if (btn) {
                btn.addEventListener('click', function () {
                    openSourceModal();
                });
            }
        });

        function openSourceModal() {
            var modal = document.getElementById('create-source-modal');
            modal.classList.remove('hidden');
            document.body.classList.add('overflow-hidden');

            // Load the inline source creation form via AJAX
            fetch('/admin/citations/CreateSourceInline')
                .then(function (response) { return response.text(); })
                .then(function (html) {
                    document.getElementById('modal-content').innerHTML = html;
                })
                .catch(function () {
                    document.getElementById('modal-content').innerHTML = '<p class="text-error text-sm">بارگذاری فرم ناموفق بود.</p>';
                });
        }

        function closeSourceModal() {
            var modal = document.getElementById('create-source-modal');
            modal.classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
        }

        function submitInlineSource() {
            var form = document.getElementById('inline-source-form');
            if (!form) return;

            var formData = new FormData(form);

            fetch('/admin/citations/CreateSourceInline', {
                method: 'POST',
                body: formData,
                headers: { 'RequestVerificationToken': document.querySelector('[name=__RequestVerificationToken]').value }
            })
            .then(function (response) { return response.json(); })
            .then(function (data) {
                if (data.success) {
                    // Add the new source to the dropdown
                    var select = document.getElementById('SourceId');
                    var option = document.createElement('option');
                    option.value = data.sourceId;
                    option.text = data.title;
                    option.selected = true;
                    select.appendChild(option);
                    closeSourceModal();
                } else {
                    alert(data.message || 'Failed to create source.');
                }
            })
            .catch(function () {
                alert('An error occurred while creating the source.');
            });
        }
    </script>
}
