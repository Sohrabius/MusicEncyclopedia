@model TagEditViewModel
@{
    ViewData["Title"] = "ایجاد برچسب";
    ViewData["ActiveMenu"] = "Tags";
}

<form method="post" action="/admin/tags/Create">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-error-soft border border-error-border text-error-hover text-sm" role="alert"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">اطلاعات پایه</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" aria-live="polite" class="field-error"></span>
                    </div>
                    <div class="md:col-span-2">
                        <label asp-for="Slug" class="form-label"></label>
                        <input asp-for="Slug" class="form-control" placeholder="my-tag-slug" />
                        <span asp-validation-for="Slug" aria-live="polite" class="field-error"></span>
                    </div>
                </div>
            </div>
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">توضیحات</h2>
                <div>
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                    <span asp-validation-for="Description" aria-live="polite" class="field-error"></span>
                </div>
            </div>
        </div>
        <div class="space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">انتشار</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-accent text-on-accent text-sm font-medium rounded-md hover:bg-accent-hover transition-colors flex items-center justify-center gap-2"><i aria-hidden="true" class="fas fa-save"></i> ایجاد برچسب</button>
                <a href="/admin/tags" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-ink-secondary bg-paper-muted rounded-md hover:bg-rule transition-colors">انصراف</a>
            </div>
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-sm font-semibold text-ink-secondary mb-2">درباره برچسب‌ها</h2>
                <ul class="text-xs text-ink-muted space-y-1 list-disc list-inside">
                    <li>برچسب‌ها برای برچسب‌گذاری موجودیت‌ها در سراسر دایرة‌المعارف استفاده می‌شوند.</li>
                    <li>هر برچسب باید یک Slug یکتا داشته باشد.</li>
                    <li>پس از ایجاد، برچسب می‌تواند به آلبوم‌ها، ترک‌ها، اشخاص و غیره اختصاص یابد.</li>
                </ul>
            </div>
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
