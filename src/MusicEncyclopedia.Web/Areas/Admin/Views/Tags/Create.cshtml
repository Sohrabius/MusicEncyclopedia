@model TagEditViewModel
@{
    ViewData["Title"] = "Create Tag";
    ViewData["ActiveMenu"] = "Tags";
}

<form method="post" action="/admin/tags/Create">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-red-50 border border-red-200 text-red-800 text-sm" role="alert"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Basic Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2">
                        <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="Name" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <span asp-validation-for="Name" class="text-xs text-red-600"></span>
                    </div>
                    <div class="md:col-span-2">
                        <label asp-for="Slug" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="Slug" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="my-tag-slug" />
                        <span asp-validation-for="Slug" class="text-xs text-red-600"></span>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Description</h2>
                <div>
                    <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <textarea asp-for="Description" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
                    <span asp-validation-for="Description" class="text-xs text-red-600"></span>
                </div>
            </div>
        </div>
        <div class="space-y-6">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Publish</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors flex items-center justify-center gap-2"><i class="fas fa-save"></i> Create Tag</button>
                <a href="/admin/tags" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-gray-600 bg-gray-100 rounded-md hover:bg-gray-200 transition-colors">Cancel</a>
            </div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-sm font-semibold text-gray-700 mb-2">About Tags</h2>
                <ul class="text-xs text-gray-500 space-y-1 list-disc list-inside">
                    <li>Tags are used to label entities across the encyclopedia.</li>
                    <li>Each tag must have a unique slug.</li>
                    <li>After creation, tags can be assigned to albums, tracks, people, etc.</li>
                </ul>
            </div>
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
