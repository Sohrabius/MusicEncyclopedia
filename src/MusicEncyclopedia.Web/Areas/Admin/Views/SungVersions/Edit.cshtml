@model SungVersionEditViewModel
@{
    ViewData["Title"] = $"Edit: {Model.Title}";
    ViewData["ActiveMenu"] = "Sung Versions";
}

<form method="post" action="/admin/sung-versions/@Model.SungVersionId/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="SungVersionId" />
    <input type="hidden" asp-for="RowVersion" />
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-error-soft border border-error-border text-error-hover text-sm" role="alert"></div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">اطلاعات پایه</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" aria-live="polite" class="field-error"></span></div>
                    <div><label asp-for="Slug" class="form-label"></label><input asp-for="Slug" class="form-control" /><span asp-validation-for="Slug" aria-live="polite" class="field-error"></span></div>
                    <div><label asp-for="PoemId" class="form-label"></label><select asp-for="PoemId" class="form-control"><option value="">-- انتخاب شعر --</option>@foreach (var item in Model.Poems) { <option value="@item.PoemId">@item.Title</option> }</select><span asp-validation-for="PoemId" aria-live="polite" class="field-error"></span></div>
                    <div><label asp-for="VocalStyleId" class="form-label"></label><select asp-for="VocalStyleId" class="form-control"><option value="">-- انتخاب سبک آواز --</option>@foreach (var item in Model.VocalStyles) { <option value="@item.VocalStyleId">@item.Name</option> }</select></div>
                </div>
            </div>
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">محتوا</h2>
                <div class="space-y-4">
                    <div><label asp-for="Text" class="form-label"></label><textarea asp-for="Text" rows="8" class="form-control"></textarea></div>
                    <div><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" rows="4" class="form-control"></textarea></div>
                    <div><label class="inline-flex items-center gap-2 cursor-pointer"><input asp-for="IsCanonical" type="checkbox" class="rounded border-rule-strong text-accent focus-visible:ring-accent" /><span class="text-sm text-ink-secondary">@Html.DisplayNameFor(m => m.IsCanonical)</span></label></div>
                </div>
            </div>
        </div>
        <div class="space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">عملیات</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-accent text-on-accent text-sm font-medium rounded-md hover:bg-accent-hover transition-colors flex items-center justify-center gap-2"><i aria-hidden="true" class="fas fa-save"></i> ذخیره تغییرات</button>
                <a href="/admin/sung-versions" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-ink-secondary bg-paper-muted rounded-md hover:bg-rule transition-colors"><i aria-hidden="true" class="fas fa-arrow-left me-1"></i> بازگشت به فهرست</a>
                <hr class="border-rule my-3" />
                <form method="post" action="/admin/sung-versions/@Model.SungVersionId/Delete" onsubmit="return confirm('Are you sure?');">@Html.AntiForgeryToken()<button type="submit" class="w-full px-4 py-2 text-sm text-error border border-error-border rounded-md hover:bg-error-soft transition-colors flex items-center justify-center gap-2"><i aria-hidden="true" class="fas fa-trash-alt"></i> حذف</button></form>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.1.0/jquery.validate.unobtrusive.min.js"></script>
}
