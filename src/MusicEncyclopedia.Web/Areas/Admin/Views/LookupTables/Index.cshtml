@model LookupTableListViewModel
@{
    ViewData["Title"] = "جدول‌های مرجع";
    ViewData["ActiveMenu"] = "Lookup Tables";
}

<div class="bg-surface rounded-lg shadow-sm border border-rule p-4 mb-6">
    <p class="text-sm text-ink-muted">مدیریت جدول‌های مرجع کوچک <strong>کد + نام</strong> مرجع که در سراسر دایرة‌المعارف استفاده می‌شوند (انواع، دسته‌بندی‌ها، نقش‌ها، ...). ردیف‌هایی که در محتوا استفاده شده‌اند قابل حذف نیستند.</p>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    @foreach (var table in Model.Tables)
    {
        <a href="/admin/lookup-tables/@table.Key" class="group bg-surface rounded-lg shadow-sm border border-rule p-5 hover:border-accent-border hover:shadow-md transition-all">
            <div class="flex items-center justify-between mb-2">
                <h3 class="font-semibold text-ink group-hover:text-accent transition-colors">@table.Label</h3>
                <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-paper-muted text-ink-secondary">@table.RowCount</span>
            </div>
            <p class="text-xs font-mono text-ink-muted">@table.EntityName</p>
            <p class="mt-3 text-sm text-accent opacity-0 group-hover:opacity-100 transition-opacity"><i aria-hidden="true" class="fas fa-arrow-right me-1"></i> مدیریت ردیف‌ها</p>
        </a>
    }
</div>
