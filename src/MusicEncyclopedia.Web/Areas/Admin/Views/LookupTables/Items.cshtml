@model LookupTableItemsViewModel
@{
    ViewData["Title"] = Model.Label;
    ViewData["ActiveMenu"] = "Lookup Tables";
}

<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 mb-6">
    <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between">
        <a href="/admin/lookup-tables" class="inline-flex items-center gap-2 px-3 py-2 text-sm text-gray-600 hover:text-gray-900 transition-colors"><i class="fas fa-arrow-left"></i> All Lookup Tables</a>
        <form method="post" action="/admin/lookup-tables/@Model.Key/create" class="flex flex-col sm:flex-row gap-2 items-end sm:items-center flex-1 justify-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Key" value="@Model.Key" />
            <div><label class="block text-xs font-medium text-gray-500 mb-1">Code</label><input type="text" name="Code" maxlength="50" class="w-full sm:w-40 px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="e.g. BOOK" /></div>
            <div class="flex-1 min-w-40"><label class="block text-xs font-medium text-gray-500 mb-1">Name</label><input type="text" name="Name" required maxlength="255" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="e.g. Book" /></div>
            <button type="submit" class="px-4 py-2 bg-green-600 text-white text-sm rounded-md hover:bg-green-700 transition-colors whitespace-nowrap"><i class="fas fa-plus"></i> Add</button>
        </form>
    </div>
</div>

<div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="text-start px-4 py-3 font-medium text-gray-600">Code</th>
                    <th class="text-start px-4 py-3 font-medium text-gray-600">Name</th>
                    <th class="text-end px-4 py-3 font-medium text-gray-600">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="3" class="px-4 py-8 text-center text-gray-500"><i class="fas fa-list-ul text-3xl text-gray-300 mb-2 block"></i>No rows yet. Add one above.</td></tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-4 py-2 font-mono text-xs text-gray-500">@item.Code</td>
                            <td class="px-4 py-2">
                                <form method="post" action="/admin/lookup-tables/@Model.Key/update" class="flex items-center gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Key" value="@Model.Key" />
                                    <input type="hidden" name="Id" value="@item.Id" />
                                    <input type="text" name="Code" value="@item.Code" maxlength="50" class="w-40 px-2 py-1.5 border border-gray-200 rounded-md text-xs focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                                    <input type="text" name="Name" value="@item.Name" required maxlength="255" class="flex-1 min-w-40 px-2 py-1.5 border border-gray-200 rounded-md text-xs focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                                    <button type="submit" class="px-2 py-1.5 text-xs text-blue-600 hover:bg-blue-50 rounded" title="Save"><i class="fas fa-save"></i></button>
                                </form>
                            </td>
                            <td class="px-4 py-2 text-end">
                                <form method="post" action="/admin/lookup-tables/@Model.Key/delete" onsubmit="return confirm('Delete this row? It will fail if the row is in use.');" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Key" value="@Model.Key" />
                                    <input type="hidden" name="Id" value="@item.Id" />
                                    <button type="submit" class="inline-flex items-center gap-1 px-2 py-1 text-xs text-red-600 hover:bg-red-50 rounded"><i class="fas fa-trash-alt"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
