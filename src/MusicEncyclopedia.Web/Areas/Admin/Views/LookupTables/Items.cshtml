@model LookupTableItemsViewModel
@{
    ViewData["Title"] = Model.Label;
    ViewData["ActiveMenu"] = "Lookup Tables";
}

<div class="bg-surface rounded-lg shadow-sm border border-rule p-4 mb-6">
    <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between">
        <a href="/admin/lookup-tables" class="inline-flex items-center gap-2 px-3 py-2 text-sm text-ink-secondary hover:text-ink transition-colors"><i aria-hidden="true" class="fas fa-arrow-left"></i> همه جدول‌های مرجع</a>
        <form method="post" action="/admin/lookup-tables/@Model.Key/create" class="flex flex-col sm:flex-row gap-2 items-end sm:items-center flex-1 justify-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Key" value="@Model.Key" />
            <div><label class="block text-xs font-medium text-ink-muted mb-1">کد</label><input type="text" name="Code" maxlength="50" class="w-full sm:w-40 px-3 py-2 border border-rule-strong rounded-md text-sm focus-visible:ring-2 focus-visible:ring-accent focus-visible:border-accent" placeholder="مثلاً BOOK" /></div>
            <div class="flex-1 min-w-40"><label class="block text-xs font-medium text-ink-muted mb-1">نام</label><input type="text" name="Name" required maxlength="255" class="form-control" placeholder="مثلاً کتاب" /></div>
            <button type="submit" class="px-4 py-2 bg-success text-on-accent text-sm rounded-md hover:bg-success-hover transition-colors whitespace-nowrap"><i aria-hidden="true" class="fas fa-plus"></i> افزودن</button>
        </form>
    </div>
</div>

<div class="bg-surface rounded-lg shadow-sm border border-rule overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-paper border-b border-rule">
                <tr>
                    <th class="text-start px-4 py-3 font-medium text-ink-secondary">کد</th>
                    <th class="text-start px-4 py-3 font-medium text-ink-secondary">نام</th>
                    <th class="text-end px-4 py-3 font-medium text-ink-secondary">عملیات</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-rule-light">
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="3" class="ui-state ui-state--empty"><i aria-hidden="true" class="fas fa-list-ul text-3xl text-ink-disabled mb-2 block"></i>هنوز ردیفی وجود ندارد. یکی در بالا افزوده کنید.</td></tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr class="hover:bg-paper transition-colors">
                            <td class="px-4 py-2 font-mono text-xs text-ink-muted">@item.Code</td>
                            <td class="px-4 py-2">
                                <form method="post" action="/admin/lookup-tables/@Model.Key/update" class="flex items-center gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Key" value="@Model.Key" />
                                    <input type="hidden" name="Id" value="@item.Id" />
                                    <input type="text" name="Code" value="@item.Code" maxlength="50" class="w-40 px-2 py-1.5 border border-rule rounded-md text-xs focus-visible:ring-2 focus-visible:ring-accent focus-visible:border-accent" />
                                    <input type="text" name="Name" value="@item.Name" required maxlength="255" class="flex-1 min-w-40 px-2 py-1.5 border border-rule rounded-md text-xs focus-visible:ring-2 focus-visible:ring-accent focus-visible:border-accent" />
                                    <button type="submit" class="px-2 py-1.5 text-xs text-accent hover:bg-accent-soft rounded min-w-11 min-h-11 inline-flex items-center justify-center" title="ذخیره"><i aria-hidden="true" class="fas fa-save"></i></button>
                                </form>
                            </td>
                            <td class="px-4 py-2 text-end">
                                <form method="post" action="/admin/lookup-tables/@Model.Key/delete" onsubmit="return confirm('Delete this row? It will fail if the row is in use.');" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Key" value="@Model.Key" />
                                    <input type="hidden" name="Id" value="@item.Id" />
                                    <button type="submit" class="inline-flex items-center gap-1 px-2 py-1 text-xs text-error hover:bg-error-soft rounded min-w-11 min-h-11 inline-flex items-center justify-center" aria-label="حذف"><i aria-hidden="true" class="fas fa-trash-alt"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
