@model PoemEditViewModel
@{
    ViewData["Title"] = $"Edit: {Model.Title}";
    ViewData["ActiveMenu"] = "Poems";
}

<form method="post" action="/admin/poems/@Model.PoemId/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="PoemId" />
    <input type="hidden" asp-for="RowVersion" />
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-red-50 border border-red-200 text-red-800 text-sm" role="alert"></div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">اطلاعات پایه</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2"><label asp-for="Title" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="Title" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /><span asp-validation-for="Title" class="text-xs text-red-600"></span></div>
                    <div><label asp-for="Slug" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="Slug" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /><span asp-validation-for="Slug" class="text-xs text-red-600"></span></div>
                    <div><label asp-for="OriginalTitle" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="OriginalTitle" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /></div>
                    <div><label asp-for="EnglishTitle" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="EnglishTitle" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /></div>
                    <div><label asp-for="PoetId" class="block text-sm font-medium text-gray-700 mb-1"></label><select asp-for="PoetId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"><option value="">-- انتخاب شاعر --</option>@foreach (var item in Model.Poets) { <option value="@item.PersonId">@item.FullName</option> }</select></div>
                    <div><label asp-for="PublicationId" class="block text-sm font-medium text-gray-700 mb-1"></label><select asp-for="PublicationId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"><option value="">-- انتخاب انتشارات --</option>@foreach (var item in Model.Publications) { <option value="@item.PublicationId">@item.Title</option> }</select></div>
                </div>
            </div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">جزئیات</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div><label asp-for="Source" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="Source" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /></div>
                    <div><label asp-for="Book" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="Book" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /></div>
                    <div><label asp-for="OriginalPublicationDate" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="OriginalPublicationDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /></div>
                    <div><label asp-for="OriginalPublicationDatePrecision" class="block text-sm font-medium text-gray-700 mb-1"></label><select asp-for="OriginalPublicationDatePrecision" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"><option value="">-- دقت --</option><option value="day">روز</option><option value="month">ماه</option><option value="year">سال</option></select></div>
                    <div class="md:col-span-2"><label asp-for="ExternalReferenceUrl" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="ExternalReferenceUrl" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /></div>
                </div>
            </div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">محتوا</h2>
                <div class="space-y-4">
                    <div><label asp-for="Copyright" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="Copyright" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /></div>
                    <div><label asp-for="CanonicalText" class="block text-sm font-medium text-gray-700 mb-1"></label><textarea asp-for="CanonicalText" rows="8" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea></div>
                    <div><label asp-for="Notes" class="block text-sm font-medium text-gray-700 mb-1"></label><textarea asp-for="Notes" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea></div>
                </div>
            </div>
        </div>
        <div class="space-y-6">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">عملیات</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors flex items-center justify-center gap-2"><i class="fas fa-save"></i> ذخیره تغییرات</button>
                <a href="/admin/poems" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-gray-600 bg-gray-100 rounded-md hover:bg-gray-200 transition-colors"><i class="fas fa-arrow-left me-1"></i> بازگشت به فهرست</a>
                <hr class="border-gray-200 my-3" />
                <form method="post" action="/admin/poems/@Model.PoemId/Delete" onsubmit="return confirm('Are you sure?');">@Html.AntiForgeryToken()<button type="submit" class="w-full px-4 py-2 text-sm text-red-600 border border-red-200 rounded-md hover:bg-red-50 transition-colors flex items-center justify-center gap-2"><i class="fas fa-trash-alt"></i> حذف شعر</button></form>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.1.0/jquery.validate.unobtrusive.min.js"></script>
}
