@model TrackWizardItem
@{
    var trackIndex = (int)ViewData["TrackIndex"]!;
    var shared = (AlbumWizardViewModel)ViewData["Shared"]!;
    string P(string field) => $"Tracks[{trackIndex}].{field}";
    string rowClasses = "form-control";
}

<div class="track-card bg-surface rounded-lg shadow-sm border border-rule p-5" data-idx="@trackIndex">
    <div class="flex items-center justify-between mb-4">
        <h3 class="text-base font-semibold text-ink">
            <i aria-hidden="true" class="fas fa-music text-accent me-2"></i>ترک <span class="track-no-label">@(trackIndex + 1)</span>
        </h3>
        <button type="button" class="remove-track px-3 py-1.5 text-xs text-error border border-error-border rounded-md hover:bg-error-soft transition-colors">
            <i aria-hidden="true" class="fas fa-trash-alt me-1"></i>حذف ترک
        </button>
    </div>

    <!-- Track basics -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="md:col-span-2">
            <label class="form-label">عنوان *</label>
            <input type="text" name="@P("Title")" value="@Model.Title"
                   data-val="true" data-val-required="عنوان ترک الزامی است."
                   data-track-title class="@rowClasses" />
            <span class="text-xs text-error" data-valmsg-for="@P("Title")" data-valmsg-replace="true"></span>
        </div>
        <div>
            <label class="form-label">Slug</label>
            <input type="text" name="@P("Slug")" value="@Model.Slug" data-track-slug class="@rowClasses" />
        </div>
        <div>
            <label class="form-label">عنوان مرتب‌سازی</label>
            <input type="text" name="@P("TitleSort")" value="@Model.TitleSort" class="@rowClasses" />
        </div>
        <div>
            <label class="form-label">عنوان اصلی</label>
            <input type="text" name="@P("OriginalTitle")" value="@Model.OriginalTitle" class="@rowClasses" />
        </div>
        <div>
            <label class="form-label">عنوان انگلیسی</label>
            <input type="text" name="@P("EnglishTitle")" value="@Model.EnglishTitle" class="@rowClasses" />
        </div>
    </div>

    <!-- Album-track row -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-4 border-t border-rule-light pt-4">
        <div>
            <label class="form-label">دیسک</label>
            <input type="number" name="@P("DiscNumber")" value="@(Model.DiscNumber > 0 ? Model.DiscNumber : 1)" data-track-disc class="@rowClasses" />
        </div>
        <div>
            <label class="form-label">شماره</label>
            <input type="number" name="@P("TrackNumber")" value="@Model.TrackNumber" data-track-no class="@rowClasses" />
        </div>
        <div class="flex items-end gap-4 pb-1">
            <label class="inline-flex items-center gap-1 cursor-pointer">
                <input type="checkbox" name="@P("IsBonus")" value="true" @(Model.IsBonus ? "checked" : "") class="rounded border-rule-strong text-accent" />
                <span class="text-xs text-ink-secondary">آهنگ جایزه</span>
            </label>
            <label class="inline-flex items-center gap-1 cursor-pointer">
                <input type="checkbox" name="@P("IsHidden")" value="true" @(Model.IsHidden ? "checked" : "") class="rounded border-rule-strong text-accent" />
                <span class="text-xs text-ink-secondary">مخفی</span>
            </label>
        </div>
        <div>
            <label class="form-label">مدت (ثانیه)</label>
            <input type="number" name="@P("DurationSeconds")" value="@Model.DurationSeconds" class="@rowClasses" />
        </div>
    </div>

    <!-- Music details -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-4 border-t border-rule-light pt-4">
        <div>
            <label class="form-label">در دسترس بودن متن</label>
            <select name="@P("LyricsAvailabilityTypeId")" class="@rowClasses">
                <option value="">-- انتخاب --</option>
                @foreach (var item in shared.LyricsAvailabilityTypeOptions)
                {
                    <option value="@item.LyricsAvailabilityTypeId" selected="@(Model.LyricsAvailabilityTypeId == item.LyricsAvailabilityTypeId)">@item.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">سبک آواز</label>
            <select name="@P("VocalStyleId")" class="@rowClasses">
                <option value="">-- انتخاب --</option>
                @foreach (var item in shared.VocalStyleOptions)
                {
                    <option value="@item.VocalStyleId" selected="@(Model.VocalStyleId == item.VocalStyleId)">@item.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">گام موسیقی</label>
            <select name="@P("MusicalKeyId")" class="@rowClasses">
                <option value="">-- انتخاب --</option>
                @foreach (var item in shared.MusicalKeyOptions)
                {
                    <option value="@item.MusicalKeyId" selected="@(Model.MusicalKeyId == item.MusicalKeyId)">@item.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">BPM</label>
            <input type="number" name="@P("BPM")" value="@Model.BPM" class="@rowClasses" />
        </div>
        <div>
            <label class="form-label">ISRC</label>
            <input type="text" name="@P("ISRC")" value="@Model.ISRC" class="@rowClasses" />
        </div>
        <div>
            <label class="form-label">تاریخ انتشار</label>
            <input type="date" name="@P("ReleaseDate")" value="@Model.ReleaseDate?.ToString("yyyy-MM-dd")" class="@rowClasses" />
        </div>
        <div>
            <label class="form-label">دقت تاریخ انتشار</label>
            <select name="@P("ReleaseDatePrecision")" class="@rowClasses">
                <option value="">-- دقت --</option>
                <option value="day" selected="@(Model.ReleaseDatePrecision == "day")">روز</option>
                <option value="month" selected="@(Model.ReleaseDatePrecision == "month")">ماه</option>
                <option value="year" selected="@(Model.ReleaseDatePrecision == "year")">سال</option>
            </select>
        </div>
        <div>
            <label class="form-label">تاریخ شروع ضبط</label>
            <input type="date" name="@P("RecordingStartDate")" value="@Model.RecordingStartDate?.ToString("yyyy-MM-dd")" class="@rowClasses" />
        </div>
        <div>
            <label class="form-label">تاریخ پایان ضبط</label>
            <input type="date" name="@P("RecordingEndDate")" value="@Model.RecordingEndDate?.ToString("yyyy-MM-dd")" class="@rowClasses" />
        </div>
        <div>
            <label class="form-label">دقت تاریخ ضبط</label>
            <select name="@P("RecordingDatePrecision")" class="@rowClasses">
                <option value="">-- دقت --</option>
                <option value="day" selected="@(Model.RecordingDatePrecision == "day")">روز</option>
                <option value="month" selected="@(Model.RecordingDatePrecision == "month")">ماه</option>
                <option value="year" selected="@(Model.RecordingDatePrecision == "year")">سال</option>
            </select>
        </div>
        <div class="flex items-end gap-4 pb-1">
            <label class="inline-flex items-center gap-1 cursor-pointer">
                <input type="checkbox" name="@P("IsInstrumental")" value="true" @(Model.IsInstrumental ? "checked" : "") class="rounded border-rule-strong text-accent" />
                <span class="text-xs text-ink-secondary">بی‌کلام است</span>
            </label>
            <label class="inline-flex items-center gap-1 cursor-pointer">
                <input type="checkbox" name="@P("IsExplicit")" value="true" @(Model.IsExplicit ? "checked" : "") class="rounded border-rule-strong text-accent" />
                <span class="text-xs text-ink-secondary">صریح است</span>
            </label>
        </div>
    </div>

    <!-- Description / copyright -->
    <div class="mt-4 border-t border-rule-light pt-4 space-y-4">
        <div>
            <label class="form-label">توضیحات</label>
            <textarea name="@P("Description")" rows="2" class="@rowClasses">@Model.Description</textarea>
        </div>
        <div>
            <label class="form-label">اعلامیه حق نشر</label>
            <input type="text" name="@P("CopyrightNotice")" value="@Model.CopyrightNotice" class="@rowClasses" />
        </div>
    </div>

    <!-- Assigns (multi-select checkboxes) -->
    <div class="mt-4 border-t border-rule-light pt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            <div class="flex items-center justify-between mb-2">
                <label class="block text-sm font-medium text-ink-secondary">سبک‌ها</label>
                <button type="button" class="btn-quick-add text-accent hover:text-accent-hover text-xs" data-qa-target="genre" title="افزودن سبک جدید"><i aria-hidden="true" class="fas fa-plus me-1"></i>جدید</button>
            </div>
            <div class="space-y-1 max-h-40 overflow-y-auto border border-rule rounded-md p-2" data-qa-options="genre">
                @foreach (var item in shared.GenreOptions)
                {
                    <label class="flex items-center gap-2 text-xs text-ink-secondary cursor-pointer">
                        <input type="checkbox" name="@P("GenreIds")" value="@item.GenreId" @(Model.GenreIds.Contains(item.GenreId) ? "checked" : "") class="rounded border-rule-strong text-accent" />
                        @item.Name
                    </label>
                }
            </div>
        </div>
        <div>
            <div class="flex items-center justify-between mb-2">
                <label class="block text-sm font-medium text-ink-secondary">حالت‌ها</label>
                <button type="button" class="btn-quick-add text-accent hover:text-accent-hover text-xs" data-qa-target="mood" title="افزودن حالت جدید"><i aria-hidden="true" class="fas fa-plus me-1"></i>جدید</button>
            </div>
            <div class="space-y-1 max-h-40 overflow-y-auto border border-rule rounded-md p-2" data-qa-options="mood">
                @foreach (var item in shared.MoodOptions)
                {
                    <label class="flex items-center gap-2 text-xs text-ink-secondary cursor-pointer">
                        <input type="checkbox" name="@P("MoodIds")" value="@item.MoodId" @(Model.MoodIds.Contains(item.MoodId) ? "checked" : "") class="rounded border-rule-strong text-accent" />
                        @item.Name
                    </label>
                }
            </div>
        </div>
        <div>
            <div class="flex items-center justify-between mb-2">
                <label class="block text-sm font-medium text-ink-secondary">سازها</label>
                <button type="button" class="btn-quick-add text-accent hover:text-accent-hover text-xs" data-qa-target="instrument" title="افزودن ساز جدید"><i aria-hidden="true" class="fas fa-plus me-1"></i>جدید</button>
            </div>
            <div class="space-y-1 max-h-40 overflow-y-auto border border-rule rounded-md p-2" data-qa-options="instrument">
                @foreach (var item in shared.InstrumentOptions)
                {
                    <label class="flex items-center gap-2 text-xs text-ink-secondary cursor-pointer">
                        <input type="checkbox" name="@P("InstrumentIds")" value="@item.InstrumentId" @(Model.InstrumentIds.Contains(item.InstrumentId) ? "checked" : "") class="rounded border-rule-strong text-accent" />
                        @item.Name
                    </label>
                }
            </div>
        </div>
        <div>
            <div class="flex items-center justify-between mb-2">
                <label class="block text-sm font-medium text-ink-secondary">نوع نسخه</label>
                <button type="button" class="btn-quick-add text-accent hover:text-accent-hover text-xs" data-qa-target="trackversiontype" title="افزودن نوع نسخه جدید"><i aria-hidden="true" class="fas fa-plus me-1"></i>جدید</button>
            </div>
            <div class="space-y-1 max-h-40 overflow-y-auto border border-rule rounded-md p-2" data-qa-options="trackversiontype">
                @foreach (var item in shared.TrackVersionTypeOptions)
                {
                    <label class="flex items-center gap-2 text-xs text-ink-secondary cursor-pointer">
                        <input type="checkbox" name="@P("VersionTypeIds")" value="@item.TrackVersionTypeId" @(Model.VersionTypeIds.Contains(item.TrackVersionTypeId) ? "checked" : "") class="rounded border-rule-strong text-accent" />
                        @item.Name
                    </label>
                }
            </div>
        </div>
    </div>

    <!-- Sung versions -->
    <div class="mt-4 border-t border-rule-light pt-4">
        <div class="flex items-center justify-between mb-2">
            <label class="text-sm font-medium text-ink-secondary">نسخه‌های خوانده‌شده</label>
            <button type="button" class="btn-add-sv px-3 py-1.5 text-xs bg-accent text-on-accent rounded-md hover:bg-accent-hover transition-colors">
                <i aria-hidden="true" class="fas fa-plus me-1"></i>افزودن نسخه
            </button>
        </div>
        <div class="sv-rows space-y-2">
            @for (var j = 0; j < Model.SungVersions.Count; j++)
            {
                var sv = Model.SungVersions[j];
                string SP(string field) => $"Tracks[{trackIndex}].SungVersions[{j}].{field}";
                <div class="sv-row grid grid-cols-1 md:grid-cols-4 gap-3 p-3 bg-paper rounded-md border border-rule">
                    <div>
                        <label class="block text-xs font-medium text-ink-secondary mb-1">نسخه موجود</label>
                        <select name="@SP("SungVersionId")" class="@rowClasses">
                            <option value="">-- ایجاد جدید --</option>
                            @foreach (var item in shared.SungVersionOptions)
                            {
                                <option value="@item.SungVersionId" selected="@(sv.SungVersionId == item.SungVersionId)">@item.Title</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-ink-secondary mb-1">عنوان (جدید)</label>
                        <input type="text" name="@SP("Title")" value="@sv.Title" class="@rowClasses" />
                    </div>
                    <div>
                        <div class="flex items-center justify-between mb-1">
                            <label class="block text-xs font-medium text-ink-secondary">شعر</label>
                            <button type="button" class="btn-quick-add text-accent hover:text-accent-hover text-xs min-w-11 min-h-11 inline-flex items-center justify-center" data-qa-target="poem" title="افزودن شعر جدید"><i aria-hidden="true" class="fas fa-plus"></i></button>
                        </div>
                        <select name="@SP("PoemId")" data-qa-options="poem" class="@rowClasses">
                            <option value="">-- انتخاب شعر --</option>
                            @foreach (var item in shared.PoemOptions)
                            {
                                <option value="@item.PoemId" selected="@(sv.PoemId == item.PoemId)">@item.Title</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-ink-secondary mb-1">سبک آواز</label>
                        <select name="@SP("VocalStyleId")" class="@rowClasses">
                            <option value="">-- انتخاب --</option>
                            @foreach (var item in shared.VocalStyleOptions)
                            {
                                <option value="@item.VocalStyleId" selected="@(sv.VocalStyleId == item.VocalStyleId)">@item.Name</option>
                            }
                        </select>
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-xs font-medium text-ink-secondary mb-1">متن</label>
                        <textarea name="@SP("Text")" rows="2" class="@rowClasses">@sv.Text</textarea>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-ink-secondary mb-1">یادداشت‌ها</label>
                        <input type="text" name="@SP("Notes")" value="@sv.Notes" class="@rowClasses" />
                    </div>
                    <div class="flex items-end gap-3 pb-1">
                        <label class="inline-flex items-center gap-1 cursor-pointer">
                            <input type="checkbox" name="@SP("IsCanonical")" value="true" @(sv.IsCanonical ? "checked" : "") class="rounded border-rule-strong text-accent" />
                            <span class="text-xs text-ink-secondary">نسخه اصلی</span>
                        </label>
                        <button type="button" class="remove-sv text-error hover:text-error-hover text-xs"><i aria-hidden="true" class="fas fa-times me-1"></i>حذف</button>
                    </div>
                </div>
            }
        </div>
        <template class="tpl-sv">
            <div class="sv-row grid grid-cols-1 md:grid-cols-4 gap-3 p-3 bg-paper rounded-md border border-rule">
                <div>
                    <label class="block text-xs font-medium text-ink-secondary mb-1">نسخه موجود</label>
                    <select name="__P__[0].SungVersionId" class="@rowClasses">
                        <option value="">-- ایجاد جدید --</option>
                        @foreach (var item in shared.SungVersionOptions)
                        {
                            <option value="@item.SungVersionId">@item.Title</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-ink-secondary mb-1">عنوان (جدید)</label>
                    <input type="text" name="__P__[0].Title" class="@rowClasses" />
                </div>
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="block text-xs font-medium text-ink-secondary">شعر</label>
                        <button type="button" class="btn-quick-add text-accent hover:text-accent-hover text-xs min-w-11 min-h-11 inline-flex items-center justify-center" data-qa-target="poem" title="افزودن شعر جدید"><i aria-hidden="true" class="fas fa-plus"></i></button>
                    </div>
                    <select name="__P__[0].PoemId" data-qa-options="poem" class="@rowClasses">
                        <option value="">-- انتخاب شعر --</option>
                        @foreach (var item in shared.PoemOptions)
                        {
                            <option value="@item.PoemId">@item.Title</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-ink-secondary mb-1">سبک آواز</label>
                    <select name="__P__[0].VocalStyleId" class="@rowClasses">
                        <option value="">-- انتخاب --</option>
                        @foreach (var item in shared.VocalStyleOptions)
                        {
                            <option value="@item.VocalStyleId">@item.Name</option>
                        }
                    </select>
                </div>
                <div class="md:col-span-2">
                    <label class="block text-xs font-medium text-ink-secondary mb-1">متن</label>
                    <textarea name="__P__[0].Text" rows="2" class="@rowClasses"></textarea>
                </div>
                <div>
                    <label class="block text-xs font-medium text-ink-secondary mb-1">یادداشت‌ها</label>
                    <input type="text" name="__P__[0].Notes" class="@rowClasses" />
                </div>
                <div class="flex items-end gap-3 pb-1">
                    <label class="inline-flex items-center gap-1 cursor-pointer">
                        <input type="checkbox" name="__P__[0].IsCanonical" value="true" class="rounded border-rule-strong text-accent" />
                        <span class="text-xs text-ink-secondary">نسخه اصلی</span>
                    </label>
                    <button type="button" class="remove-sv text-error hover:text-error-hover text-xs"><i aria-hidden="true" class="fas fa-times me-1"></i>حذف</button>
                </div>
            </div>
        </template>
    </div>

    <!-- Per-track credits -->
    <div class="mt-4 border-t border-rule-light pt-4">
        <div class="flex items-center justify-between mb-2">
            <label class="text-sm font-medium text-ink-secondary">عوامل ترک</label>
            <button type="button" class="btn-add-track-credit px-3 py-1.5 text-xs bg-accent text-on-accent rounded-md hover:bg-accent-hover transition-colors">
                <i aria-hidden="true" class="fas fa-plus me-1"></i>افزودن عامل
            </button>
        </div>
        <div class="track-credit-rows space-y-2">
            @for (var j = 0; j < Model.Credits.Count; j++)
            {
                var credit = Model.Credits[j];
                string CP(string field) => $"Tracks[{trackIndex}].Credits[{j}].{field}";
                <div class="credit-row grid grid-cols-2 md:grid-cols-4 gap-3 p-3 bg-paper rounded-md border border-rule">
                    <div>
                        <label class="block text-xs font-medium text-ink-secondary mb-1">نقش</label>
                        <select name="@CP("CreditRoleId")" class="@rowClasses">
                            <option value="">-- انتخاب --</option>
                            @foreach (var item in shared.CreditRoleOptions)
                            {
                                <option value="@item.CreditRoleId" selected="@(credit.CreditRoleId == item.CreditRoleId)">@item.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-ink-secondary mb-1">حوزه</label>
                        <select name="@CP("RoleScopeTypeId")" class="@rowClasses">
                            <option value="">-- انتخاب --</option>
                            @foreach (var item in shared.RoleScopeTypeOptions)
                            {
                                <option value="@item.RoleScopeTypeId" selected="@(credit.RoleScopeTypeId == item.RoleScopeTypeId)">@item.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <div class="flex items-center justify-between mb-1">
                            <label class="block text-xs font-medium text-ink-secondary">شخص</label>
                            <button type="button" class="btn-quick-add text-accent hover:text-accent-hover text-xs min-w-11 min-h-11 inline-flex items-center justify-center" data-qa-target="person" title="افزودن شخص جدید"><i aria-hidden="true" class="fas fa-plus"></i></button>
                        </div>
                        <select name="@CP("PersonId")" data-qa-options="person" class="@rowClasses">
                            <option value="">-- انتخاب --</option>
                            @foreach (var item in shared.PersonOptions)
                            {
                                <option value="@item.PersonId" selected="@(credit.PersonId == item.PersonId)">@item.FullName</option>
                            }
                        </select>
                    </div>
                    <div>
                        <div class="flex items-center justify-between mb-1">
                            <label class="block text-xs font-medium text-ink-secondary">شرکت</label>
                            <button type="button" class="btn-quick-add text-accent hover:text-accent-hover text-xs min-w-11 min-h-11 inline-flex items-center justify-center" data-qa-target="company" title="افزودن شرکت جدید"><i aria-hidden="true" class="fas fa-plus"></i></button>
                        </div>
                        <select name="@CP("CompanyId")" data-qa-options="company" class="@rowClasses">
                            <option value="">-- انتخاب --</option>
                            @foreach (var item in shared.CompanyOptions)
                            {
                                <option value="@item.CompanyId" selected="@(credit.CompanyId == item.CompanyId)">@item.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <div class="flex items-center justify-between mb-1">
                            <label class="block text-xs font-medium text-ink-secondary">ساز</label>
                            <button type="button" class="btn-quick-add text-accent hover:text-accent-hover text-xs min-w-11 min-h-11 inline-flex items-center justify-center" data-qa-target="instrument" title="افزودن ساز جدید"><i aria-hidden="true" class="fas fa-plus"></i></button>
                        </div>
                        <select name="@CP("InstrumentId")" data-qa-options="instrument" class="@rowClasses">
                            <option value="">-- انتخاب --</option>
                            @foreach (var item in shared.InstrumentOptions)
                            {
                                <option value="@item.InstrumentId" selected="@(credit.InstrumentId == item.InstrumentId)">@item.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-ink-secondary mb-1">ترتیب نمایش</label>
                        <input type="number" name="@CP("DisplayOrder")" value="@credit.DisplayOrder" class="@rowClasses" />
                    </div>
                    <div class="flex items-end gap-3 pb-1">
                        <label class="inline-flex items-center gap-1 cursor-pointer">
                            <input type="checkbox" name="@CP("IsPrimary")" value="true" @(credit.IsPrimary ? "checked" : "") class="rounded border-rule-strong text-accent" />
                            <span class="text-xs text-ink-secondary">اصلی</span>
                        </label>
                    </div>
                    <div class="flex items-end pb-1">
                        <button type="button" class="remove-credit text-error hover:text-error-hover text-xs"><i aria-hidden="true" class="fas fa-times me-1"></i>حذف</button>
                    </div>
                    <div class="md:col-span-4">
                        <label class="block text-xs font-medium text-ink-secondary mb-1">یادداشت‌ها</label>
                        <input type="text" name="@CP("Notes")" value="@credit.Notes" class="@rowClasses" />
                    </div>
                </div>
            }
        </div>
        <template class="tpl-track-credit">
            <div class="credit-row grid grid-cols-2 md:grid-cols-4 gap-3 p-3 bg-paper rounded-md border border-rule">
                <div>
                    <label class="block text-xs font-medium text-ink-secondary mb-1">نقش</label>
                    <select name="__P__[0].CreditRoleId" class="@rowClasses">
                        <option value="">-- انتخاب --</option>
                        @foreach (var item in shared.CreditRoleOptions)
                        {
                            <option value="@item.CreditRoleId">@item.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-ink-secondary mb-1">حوزه</label>
                    <select name="__P__[0].RoleScopeTypeId" class="@rowClasses">
                        <option value="">-- انتخاب --</option>
                        @foreach (var item in shared.RoleScopeTypeOptions)
                        {
                            <option value="@item.RoleScopeTypeId">@item.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="block text-xs font-medium text-ink-secondary">شخص</label>
                        <button type="button" class="btn-quick-add text-accent hover:text-accent-hover text-xs min-w-11 min-h-11 inline-flex items-center justify-center" data-qa-target="person" title="افزودن شخص جدید"><i aria-hidden="true" class="fas fa-plus"></i></button>
                    </div>
                    <select name="__P__[0].PersonId" data-qa-options="person" class="@rowClasses">
                        <option value="">-- انتخاب --</option>
                        @foreach (var item in shared.PersonOptions)
                        {
                            <option value="@item.PersonId">@item.FullName</option>
                        }
                    </select>
                </div>
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="block text-xs font-medium text-ink-secondary">شرکت</label>
                        <button type="button" class="btn-quick-add text-accent hover:text-accent-hover text-xs min-w-11 min-h-11 inline-flex items-center justify-center" data-qa-target="company" title="افزودن شرکت جدید"><i aria-hidden="true" class="fas fa-plus"></i></button>
                    </div>
                    <select name="__P__[0].CompanyId" data-qa-options="company" class="@rowClasses">
                        <option value="">-- انتخاب --</option>
                        @foreach (var item in shared.CompanyOptions)
                        {
                            <option value="@item.CompanyId">@item.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="block text-xs font-medium text-ink-secondary">ساز</label>
                        <button type="button" class="btn-quick-add text-accent hover:text-accent-hover text-xs min-w-11 min-h-11 inline-flex items-center justify-center" data-qa-target="instrument" title="افزودن ساز جدید"><i aria-hidden="true" class="fas fa-plus"></i></button>
                    </div>
                    <select name="__P__[0].InstrumentId" data-qa-options="instrument" class="@rowClasses">
                        <option value="">-- انتخاب --</option>
                        @foreach (var item in shared.InstrumentOptions)
                        {
                            <option value="@item.InstrumentId">@item.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-ink-secondary mb-1">ترتیب نمایش</label>
                    <input type="number" name="__P__[0].DisplayOrder" value="0" class="@rowClasses" />
                </div>
                <div class="flex items-end gap-3 pb-1">
                    <label class="inline-flex items-center gap-1 cursor-pointer">
                        <input type="checkbox" name="__P__[0].IsPrimary" value="true" class="rounded border-rule-strong text-accent" />
                        <span class="text-xs text-ink-secondary">اصلی</span>
                    </label>
                </div>
                <div class="flex items-end pb-1">
                    <button type="button" class="remove-credit text-error hover:text-error-hover text-xs"><i aria-hidden="true" class="fas fa-times me-1"></i>حذف</button>
                </div>
                <div class="md:col-span-4">
                    <label class="block text-xs font-medium text-ink-secondary mb-1">یادداشت‌ها</label>
                    <input type="text" name="__P__[0].Notes" class="@rowClasses" />
                </div>
            </div>
        </template>
    </div>
</div>
