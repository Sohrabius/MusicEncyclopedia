@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.1.0/jquery.validate.unobtrusive.min.js"></script>
    <script>
        (function () {
            var $form = $('#wizardForm');
            var current = parseInt($('#activeStep').val(), 10) || 1;

            if ($.validator && $.validator.unobtrusive) {
                $.validator.unobtrusive.parse($form);
            }

            // ── Step navigation ──────────────────────────────
            function showStep(n) {
                current = Math.max(1, Math.min(6, n));
                $('#activeStep').val(current);
                $('.wizard-step').addClass('hidden')
                    .filter('[data-step="' + current + '"]').removeClass('hidden');
                $('.wizard-step-badge').each(function () {
                    var s = +$(this).data('step');
                    $(this).find('.wizard-step-dot')
                        .toggleClass('border-blue-600 bg-blue-600 text-white', s === current)
                        .toggleClass('border-gray-300 bg-white text-gray-500', s !== current)
                        .html(s < current ? '<i class="fas fa-check"></i>' : s);
                });
                $('#btnBack').toggleClass('hidden', current === 1);
                $('#btnNext').toggleClass('hidden', current === 6);
                $('#btnSubmit').toggleClass('hidden', current !== 6);
                if (current === 6) updateReview();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            function validateStep() {
                var ok = true;
                $('.wizard-step[data-step="' + current + '"] [data-val="true"]').each(function () {
                    if (!$(this).valid()) ok = false;
                });
                return ok;
            }

            $('#btnNext').on('click', function () { if (validateStep()) showStep(current + 1); });
            $('#btnBack').on('click', function () { showStep(current - 1); });
            $('.wizard-step-badge').on('click', function () {
                var s = +$(this).data('step');
                if (s <= current) showStep(s);
            });

            // ── Renumbering of indexed field names ───────────
            function renumberNames(root, prefix, groups) {
                $(root).find('[name]').each(function () {
                    var parts = this.name.split('.');
                    var name = prefix;
                    for (var k = groups; k < parts.length; k++) name += '.' + parts[k];
                    this.name = name;
                });
            }

            function renumberGroup(containerSel, rowSel, prefix, groups) {
                var container = document.querySelector(containerSel);
                if (!container) return;
                Array.prototype.forEach.call(container.querySelectorAll(rowSel), function (row, j) {
                    renumberNames(row, prefix + '[' + j + ']', groups);
                });
            }

            function renumber() {
                $('#trackList .track-card').each(function (i) {
                    renumberNames(this, 'Tracks[' + i + ']', 1);
                    $(this).find('.sv-row').each(function (j) {
                        renumberNames(this, 'Tracks[' + i + '].SungVersions[' + j + ']', 2);
                    });
                    $(this).find('.credit-row').each(function (j) {
                        renumberNames(this, 'Tracks[' + i + '].Credits[' + j + ']', 2);
                    });
                });
                renumberGroup('.album-credit-rows', '.credit-row', 'AlbumCredits', 1);
                renumberGroup('.company-rows', '.company-row', 'Companies', 1);
                renumberGroup('.identifier-rows', '.identifier-row', 'Identifiers', 1);
                renumberGroup('.link-rows', '.link-row', 'Links', 1);
                renumberGroup('.relation-rows', '.relation-row', 'RelatedAlbums', 1);
                $('#trackList .track-card').each(function (i) {
                    $(this).find('.track-no-label').text(i + 1);
                    $(this).attr('data-idx', i);
                });
            }

            // ── Add rows ─────────────────────────────────────
            function addRow(containerSel, templateSel, prefix) {
                var $container = $(containerSel);
                var tpl = document.querySelector(templateSel);
                if (!tpl) return;
                var html = tpl.innerHTML.split('__P__').join(prefix);
                $container.append($(html));
                renumber();
            }

            $('#btnAddTrack').on('click', function () {
                var count = $('#trackList .track-card').length;
                $.get('/admin/albums/wizard/track-card', { index: count })
                    .done(function (html) {
                        $('#trackList').append(html);
                        $('#trackEmptyHint').remove();
                        renumber();
                    })
                    .fail(function () { alert('افزودن ترک ناموفق بود.'); });
            });

            $('#btnAddAlbumCredit').on('click', function () { addRow('.album-credit-rows', '#tpl-album-credit', 'AlbumCredits'); });
            $('#btnAddCompany').on('click', function () { addRow('.company-rows', '#tpl-company', 'Companies'); });
            $('#btnAddIdentifier').on('click', function () { addRow('.identifier-rows', '#tpl-identifier', 'Identifiers'); });
            $('#btnAddLink').on('click', function () { addRow('.link-rows', '#tpl-link', 'Links'); });
            $('#btnAddRelation').on('click', function () { addRow('.relation-rows', '#tpl-relation', 'RelatedAlbums'); });

            $form.on('click', '.btn-add-sv', function () {
                var $card = $(this).closest('.track-card');
                var i = $('#trackList .track-card').index($card[0]);
                var html = $card.find('.tpl-sv')[0].innerHTML.split('__P__').join('Tracks[' + i + '].SungVersions');
                $card.find('.sv-rows').append($(html));
                renumber();
            });
            $form.on('click', '.btn-add-track-credit', function () {
                var $card = $(this).closest('.track-card');
                var i = $('#trackList .track-card').index($card[0]);
                var html = $card.find('.tpl-track-credit')[0].innerHTML.split('__P__').join('Tracks[' + i + '].Credits');
                $card.find('.track-credit-rows').append($(html));
                renumber();
            });

            // ── Remove rows ──────────────────────────────────
            $form.on('click', '.remove-track', function () {
                if (!confirm('این ترک حذف شود؟')) return;
                $(this).closest('.track-card').remove();
                renumber();
            });
            $form.on('click', '.remove-sv', function () { $(this).closest('.sv-row').remove(); renumber(); });
            $form.on('click', '.remove-credit', function () { $(this).closest('.credit-row').remove(); renumber(); });
            $form.on('click', '.remove-company', function () { $(this).closest('.company-row').remove(); renumber(); });
            $form.on('click', '.remove-identifier', function () { $(this).closest('.identifier-row').remove(); renumber(); });
            $form.on('click', '.remove-link', function () { $(this).closest('.link-row').remove(); renumber(); });
            $form.on('click', '.remove-relation', function () { $(this).closest('.relation-row').remove(); renumber(); });

            // ── Slug auto-generation ─────────────────────────
            function slugify(value) {
                return String(value || '').toLowerCase()
                    .replace(/\s+/g, '-')
                    .replace(/[^a-z0-9\u0600-\u06FF\u0750-\u077F\u08A0-\u08FF-]/g, '')
                    .replace(/-{2,}/g, '-')
                    .replace(/^-+|-+$/g, '');
            }

            $form.on('input', '[data-album-title]', function () {
                if (!$('#AlbumSlugLocked').prop('checked')) $('#AlbumSlug').val(slugify($(this).val()));
            });
            $form.on('input', '[data-track-title]', function () {
                var $card = $(this).closest('.track-card');
                var $slug = $card.find('[data-track-slug]');
                if (!$slug.data('locked')) $slug.val(slugify($(this).val()));
            });
            $form.on('input', '[data-track-slug]', function () { $(this).data('locked', true); });
            $('#AlbumSlug').on('input', function () { $('#AlbumSlugLocked').prop('checked', true); });

            // ── Review summary ───────────────────────────────
            function countChecked(name) { return $('input[name="' + name + '"]:checked').length; }

            function updateReview() {
                var rows = [];
                rows.push('<p><strong>آلبوم:</strong> ' + ($('#Title').val() || '—') + '</p>');
                rows.push('<p><strong>سبک‌ها:</strong> ' + countChecked('GenreIds') + ' | <strong>حالت‌ها:</strong> ' + countChecked('MoodIds') + ' | <strong>زبان‌ها:</strong> ' + countChecked('LanguageIds') + ' | <strong>کشورها:</strong> ' + countChecked('CountryIds') + '</p>');
                rows.push('<p><strong>شرکت‌ها:</strong> ' + $('.company-rows .company-row').length + ' | <strong>شناسه‌ها:</strong> ' + $('.identifier-rows .identifier-row').length + '</p>');
                rows.push('<p><strong>ترک‌ها:</strong> ' + $('#trackList .track-card').length + ' | <strong>نسخه‌های خوانده‌شده:</strong> ' + $('#trackList .sv-row').length + '</p>');
                rows.push('<p><strong>عوامل آلبوم:</strong> ' + $('.album-credit-rows .credit-row').length + ' | <strong>عوامل ترک‌ها:</strong> ' + $('#trackList .credit-row').length + '</p>');
                rows.push('<p><strong>برچسب‌ها:</strong> ' + countChecked('TagIds') + ' | <strong>پیوندها:</strong> ' + $('.link-rows .link-row').length + ' | <strong>آلبوم‌های مرتبط:</strong> ' + $('.relation-rows .relation-row').length + '</p>');
                $('#review-summary').html(rows.join(''));
            }

            // ── Quick add (person, company, poem, genre, …) ────
            var qaTargets = {
                person:           { title: 'افزودن شخص جدید',       nameLabel: 'نام کامل',     fields: ['name', 'englishName'] },
                company:          { title: 'افزودن شرکت جدید',      nameLabel: 'نام شرکت',     fields: ['name', 'englishName'] },
                poem:             { title: 'افزودن شعر جدید',       nameLabel: 'عنوان شعر',    fields: ['name', 'poet'] },
                genre:            { title: 'افزودن سبک جدید',       nameLabel: 'نام سبک',      fields: ['name'] },
                mood:             { title: 'افزودن حالت جدید',      nameLabel: 'نام حالت',     fields: ['name'] },
                instrument:       { title: 'افزودن ساز جدید',       nameLabel: 'نام ساز',      fields: ['name'] },
                tag:              { title: 'افزودن برچسب جدید',     nameLabel: 'نام برچسب',    fields: ['name'] },
                albumcategory:    { title: 'افزودن دسته‌بندی جدید', nameLabel: 'نام دسته‌بندی', code: true, fields: ['code', 'name'] },
                language:         { title: 'افزودن زبان جدید',      nameLabel: 'نام زبان',     code: true, fields: ['code', 'name'] },
                country:          { title: 'افزودن کشور جدید',      nameLabel: 'نام کشور',     code: true, fields: ['code', 'name'] },
                trackversiontype: { title: 'افزودن نوع نسخه جدید',  nameLabel: 'نام نوع نسخه', code: true, fields: ['code', 'name'] }
            };

            var qaTrigger = null;
            var qaFieldClasses = '@fieldClasses';

            function qaEscapeHtml(s) {
                return String(s == null ? '' : s)
                    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }

            function qaOpen(target, $btn) {
                var cfg = qaTargets[target];
                if (!cfg) return;
                qaTrigger = $btn;
                $('#qaTarget').val(target);
                $('#qaTitle').text(cfg.title);
                $('#qaError').addClass('hidden').text('');
                var html = '';
                for (var i = 0; i < cfg.fields.length; i++) {
                    var f = cfg.fields[i];
                    if (f === 'code') {
                        html += '<div>'
                            + '<label class="block text-xs font-medium text-gray-600 mb-1" for="qaCode">کد *</label>'
                            + '<input type="text" name="Code" id="qaCode" dir="ltr" placeholder="مثلاً studio-album" class="' + qaFieldClasses + '" />'
                            + '</div>';
                    } else if (f === 'englishName') {
                        html += '<div>'
                            + '<label class="block text-xs font-medium text-gray-600 mb-1" for="qaEnglishName">نام انگلیسی</label>'
                            + '<input type="text" name="EnglishName" id="qaEnglishName" dir="ltr" class="' + qaFieldClasses + '" />'
                            + '</div>';
                    } else if (f === 'poet') {
                        var opts = '<option value="">-- بدون شاعر --</option>';
                        $('select[data-qa-options="person"]').first().find('option').each(function () {
                            if ($(this).val()) {
                                opts += '<option value="' + $(this).val() + '">' + qaEscapeHtml($(this).text()) + '</option>';
                            }
                        });
                        html += '<div>'
                            + '<label class="block text-xs font-medium text-gray-600 mb-1" for="qaPoet">شاعر</label>'
                            + '<select name="PoetId" id="qaPoet" class="' + qaFieldClasses + '">' + opts + '</select>'
                            + '</div>';
                    } else {
                        html += '<div>'
                            + '<label class="block text-xs font-medium text-gray-600 mb-1" for="qaName">' + cfg.nameLabel + ' *</label>'
                            + '<input type="text" name="Name" id="qaName" autofocus class="' + qaFieldClasses + '" />'
                            + '</div>';
                    }
                }
                $('#qaFields').html(html);
                $('#qaModal').removeClass('hidden');
                setTimeout(function () { $('#qaName').focus(); }, 50);
            }

            function qaClose() {
                $('#qaModal').addClass('hidden');
                qaTrigger = null;
            }

            $form.on('click', '.btn-quick-add', function () {
                qaOpen($(this).data('qa-target'), $(this));
            });
            $('#qaModal').on('click', '[data-qa-close]', qaClose);
            $(document).on('keydown', function (e) { if (e.key === 'Escape') qaClose(); });

            $('#qaForm').on('submit', function (e) {
                e.preventDefault();
                var $err = $('#qaError');
                $err.addClass('hidden').text('');
                $.ajax({
                    url: '/admin/albums/wizard/quick-add',
                    method: 'POST',
                    data: $(this).serialize(),
                    dataType: 'json'
                }).done(function (res) {
                    if (!res || !res.success) {
                        var msg = (res && res.errors && res.errors.length) ? res.errors.join(' ') : 'ذخیره ناموفق بود.';
                        $err.removeClass('hidden').text(msg);
                        return;
                    }
                    qaApplyOption($('#qaTarget').val(), res.id, res.name);
                    qaClose();
                }).fail(function (xhr) {
                    var msg = 'ذخیره ناموفق بود.';
                    try {
                        var body = JSON.parse(xhr.responseText);
                        if (body && body.errors && body.errors.length) msg = body.errors.join(' ');
                    } catch (_) { }
                    $err.removeClass('hidden').text(msg);
                });
            });

            // Inserts the new option into every matching dropdown / checkbox list.
            // The one the "+" was clicked from gets selected / checked.
            function qaApplyOption(kind, id, name) {
                var escName = qaEscapeHtml(name);
                var $triggerEl = qaTrigger ? qaTrigger.parent().next('[data-qa-options="' + kind + '"]') : $();
                $('[data-qa-options="' + kind + '"]').each(function () {
                    var $el = $(this);
                    if ($el.is('select')) {
                        $('<option>').val(id).text(name).appendTo($el);
                        if ($triggerEl.length && $el.is($triggerEl)) $el.val(String(id));
                    } else {
                        // Checkbox-list container — clone the name of its existing boxes.
                        var $first = $el.find('input[type="checkbox"]').first();
                        var nm = $first.attr('name') || 'GenreIds';
                        var $label = $('<label>').addClass('flex items-center gap-2 text-xs text-gray-700 cursor-pointer')
                            .append($('<input>').attr({ type: 'checkbox', name: nm, value: id })
                                .addClass('rounded border-gray-300 text-blue-600')
                                .prop('checked', $triggerEl.length && $el.is($triggerEl)))
                            .append(' ' + escName);
                        $el.append($label);
                    }
                });
            }

            showStep(current);
        })();
    </script>
}
