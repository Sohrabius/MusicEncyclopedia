@model AlbumWizardViewModel
@{
    ViewData["Title"] = "ایجاد آلبوم (گام‌به‌گام)";
    ViewData["ActiveMenu"] = "Albums";
    string fieldClasses = "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500";
    var stepMeta = new[]
    {
        (Label: "اطلاعات پایه", Icon: "fa-info-circle"),
        (Label: "طبقه‌بندی و نشر", Icon: "fa-tags"),
        (Label: "ترک‌ها", Icon: "fa-music"),
        (Label: "عوامل", Icon: "fa-users"),
        (Label: "برچسب‌ها و پیوندها", Icon: "fa-hashtag"),
        (Label: "مرور و ایجاد", Icon: "fa-check-circle")
    };
}

<!-- ============================================================
     Album Creation Wizard (single atomic form, 6 steps)
     ============================================================ -->
<form id="wizardForm" method="post" action="/admin/albums/wizard">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ActiveStep" id="activeStep" />

    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-red-50 border border-red-200 text-red-800 text-sm" role="alert"></div>

    <!-- ============================================================
         Stepper header
         ============================================================ -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 mb-6">
        <ol class="flex items-center justify-between overflow-x-auto gap-2" id="wizardStepper">
            @for (var s = 1; s <= stepMeta.Length; s++)
            {
                <li class="wizard-step-badge flex flex-col items-center gap-1.5 flex-1 min-w-[90px] cursor-pointer"
                    data-step="@s" title="@stepMeta[s - 1].Label">
                    <span class="wizard-step-dot w-9 h-9 rounded-full flex items-center justify-center text-sm font-semibold
                         border-2 transition-colors @(s == Model.ActiveStep ? "border-blue-600 bg-blue-600 text-white" : "border-gray-300 bg-white text-gray-500")">
                        @if (s < Model.ActiveStep)
                        {
                            <i class="fas fa-check"></i>
                        }
                        else
                        {
                            @s
                        }
                    </span>
                    <span class="text-[11px] text-gray-600 whitespace-nowrap">
                        <i class="fas @stepMeta[s - 1].Icon me-1 text-gray-400"></i>@stepMeta[s - 1].Label
                    </span>
                </li>
            }
        </ol>
    </div>

    <!-- ============================================================
         Step 1 — Album basics
         ============================================================ -->
    <section class="wizard-step bg-white rounded-lg shadow-sm border border-gray-200 p-5 mb-6" data-step="1">
        <h2 class="text-lg font-semibold text-gray-900 mb-4"><i class="fas fa-info-circle text-blue-500 me-2"></i>اطلاعات پایه</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="md:col-span-2">
                <label asp-for="Title" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Title" data-album-title class="@fieldClasses" />
                <span asp-validation-for="Title" class="text-xs text-red-600"></span>
            </div>
            <div>
                <label asp-for="Slug" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <div class="flex gap-2">
                    <input asp-for="Slug" id="AlbumSlug" class="@fieldClasses" dir="ltr" />
                    <label class="inline-flex items-center gap-1 shrink-0 cursor-pointer" title="قفل کردن slug (در صورت ویرایش دستی)">
                        <input type="checkbox" id="AlbumSlugLocked" class="rounded border-gray-300 text-blue-600" />
                        <span class="text-xs text-gray-500">قفل</span>
                    </label>
                </div>
                <span asp-validation-for="Slug" class="text-xs text-red-600"></span>
            </div>
            <div>
                <label asp-for="TitleSort" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="TitleSort" class="@fieldClasses" />
                <span asp-validation-for="TitleSort" class="text-xs text-red-600"></span>
            </div>
            <div>
                <label asp-for="OriginalTitle" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="OriginalTitle" class="@fieldClasses" />
                <span asp-validation-for="OriginalTitle" class="text-xs text-red-600"></span>
            </div>
            <div>
                <label asp-for="EnglishTitle" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="EnglishTitle" class="@fieldClasses" />
                <span asp-validation-for="EnglishTitle" class="text-xs text-red-600"></span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4 border-t border-gray-100 pt-4">
            <div>
                <div class="flex items-center justify-between mb-1">
                    <label asp-for="AlbumCategoryId" class="block text-sm font-medium text-gray-700"></label>
                    <button type="button" class="btn-quick-add text-blue-600 hover:text-blue-800 text-xs" data-qa-target="albumcategory" title="افزودن دسته‌بندی جدید"><i class="fas fa-plus me-1"></i>جدید</button>
                </div>
                <select asp-for="AlbumCategoryId"
                        data-val="true" data-val-required="دسته‌بندی آلبوم الزامی است." data-qa-options="albumcategory" class="@fieldClasses">
                    <option value="">-- انتخاب دسته‌بندی --</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.AlbumCategoryId">@cat.Name</option>
                    }
                </select>
                <span asp-validation-for="AlbumCategoryId" class="text-xs text-red-600"></span>
            </div>
            <div class="flex items-end pb-2">
                <label class="inline-flex items-center gap-2 cursor-pointer">
                    <input asp-for="IsOfficial" type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                    <span class="text-sm text-gray-700">@Html.DisplayNameFor(m => m.IsOfficial)</span>
                </label>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4 border-t border-gray-100 pt-4">
            <div>
                <label asp-for="ReleaseDate" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="ReleaseDate" type="date" class="@fieldClasses" />
                <span asp-validation-for="ReleaseDate" class="text-xs text-red-600"></span>
            </div>
            <div>
                <label asp-for="ReleaseDatePrecision" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <select asp-for="ReleaseDatePrecision" class="@fieldClasses">
                    <option value="">-- دقت --</option>
                    <option value="day">روز</option>
                    <option value="month">ماه</option>
                    <option value="year">سال</option>
                </select>
                <span asp-validation-for="ReleaseDatePrecision" class="text-xs text-red-600"></span>
            </div>
            <div>
                <label asp-for="RecordingStartDate" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="RecordingStartDate" type="date" class="@fieldClasses" />
                <span asp-validation-for="RecordingStartDate" class="text-xs text-red-600"></span>
            </div>
            <div>
                <label asp-for="RecordingEndDate" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="RecordingEndDate" type="date" class="@fieldClasses" />
                <span asp-validation-for="RecordingEndDate" class="text-xs text-red-600"></span>
            </div>
            <div>
                <label asp-for="RecordingDatePrecision" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <select asp-for="RecordingDatePrecision" class="@fieldClasses">
                    <option value="">-- دقت --</option>
                    <option value="day">روز</option>
                    <option value="month">ماه</option>
                    <option value="year">سال</option>
                </select>
                <span asp-validation-for="RecordingDatePrecision" class="text-xs text-red-600"></span>
            </div>
            <div>
                <label asp-for="DurationSeconds" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="DurationSeconds" type="number" class="@fieldClasses" />
                <span asp-validation-for="DurationSeconds" class="text-xs text-red-600"></span>
            </div>
            <div>
                <label asp-for="CoverMediaId" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <select asp-for="CoverMediaId" class="@fieldClasses">
                    <option value="">-- انتخاب رسانه --</option>
                    @foreach (var media in Model.MediaOptions)
                    {
                        <option value="@media.MediaId">@media.FileName</option>
                    }
                </select>
                <span asp-validation-for="CoverMediaId" class="text-xs text-red-600"></span>
            </div>
            <div>
                <label asp-for="CopyrightNotice" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="CopyrightNotice" class="@fieldClasses" />
                <span asp-validation-for="CopyrightNotice" class="text-xs text-red-600"></span>
            </div>
            <div class="md:col-span-2">
                <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <textarea asp-for="Description" rows="4" class="@fieldClasses"></textarea>
                <span asp-validation-for="Description" class="text-xs text-red-600"></span>
            </div>
        </div>
    </section>

    <!-- ============================================================
         Step 2 — Classification & distribution
         ============================================================ -->
    <section class="wizard-step bg-white rounded-lg shadow-sm border border-gray-200 p-5 mb-6 hidden" data-step="2">
        <h2 class="text-lg font-semibold text-gray-900 mb-4"><i class="fas fa-tags text-blue-500 me-2"></i>طبقه‌بندی و نشر</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <div class="flex items-center justify-between mb-2">
                    <label class="block text-sm font-medium text-gray-700">سبک‌ها</label>
                    <button type="button" class="btn-quick-add text-blue-600 hover:text-blue-800 text-xs" data-qa-target="genre" title="افزودن سبک جدید"><i class="fas fa-plus me-1"></i>جدید</button>
                </div>
                <div class="space-y-1 max-h-48 overflow-y-auto border border-gray-200 rounded-md p-2" data-qa-options="genre">
                    @foreach (var item in Model.GenreOptions)
                    {
                        <label class="flex items-center gap-2 text-xs text-gray-700 cursor-pointer">
                            <input type="checkbox" name="GenreIds" value="@item.GenreId" @(Model.GenreIds.Contains(item.GenreId) ? "checked" : "") class="rounded border-gray-300 text-blue-600" />
                            @item.Name
                        </label>
                    }
                </div>
            </div>
            <div>
                <div class="flex items-center justify-between mb-2">
                    <label class="block text-sm font-medium text-gray-700">حالت‌ها</label>
                    <button type="button" class="btn-quick-add text-blue-600 hover:text-blue-800 text-xs" data-qa-target="mood" title="افزودن حالت جدید"><i class="fas fa-plus me-1"></i>جدید</button>
                </div>
                <div class="space-y-1 max-h-48 overflow-y-auto border border-gray-200 rounded-md p-2" data-qa-options="mood">
                    @foreach (var item in Model.MoodOptions)
                    {
                        <label class="flex items-center gap-2 text-xs text-gray-700 cursor-pointer">
                            <input type="checkbox" name="MoodIds" value="@item.MoodId" @(Model.MoodIds.Contains(item.MoodId) ? "checked" : "") class="rounded border-gray-300 text-blue-600" />
                            @item.Name
                        </label>
                    }
                </div>
            </div>
            <div>
                <div class="flex items-center justify-between mb-2">
                    <label class="block text-sm font-medium text-gray-700">زبان‌ها</label>
                    <button type="button" class="btn-quick-add text-blue-600 hover:text-blue-800 text-xs" data-qa-target="language" title="افزودن زبان جدید"><i class="fas fa-plus me-1"></i>جدید</button>
                </div>
                <div class="space-y-1 max-h-48 overflow-y-auto border border-gray-200 rounded-md p-2" data-qa-options="language">
                    @foreach (var item in Model.LanguageOptions)
                    {
                        <label class="flex items-center gap-2 text-xs text-gray-700 cursor-pointer">
                            <input type="checkbox" name="LanguageIds" value="@item.LanguageId" @(Model.LanguageIds.Contains(item.LanguageId) ? "checked" : "") class="rounded border-gray-300 text-blue-600" />
                            @item.Name
                        </label>
                    }
                </div>
            </div>
            <div>
                <div class="flex items-center justify-between mb-2">
                    <label class="block text-sm font-medium text-gray-700">کشورها</label>
                    <button type="button" class="btn-quick-add text-blue-600 hover:text-blue-800 text-xs" data-qa-target="country" title="افزودن کشور جدید"><i class="fas fa-plus me-1"></i>جدید</button>
                </div>
                <div class="space-y-1 max-h-48 overflow-y-auto border border-gray-200 rounded-md p-2" data-qa-options="country">
                    @foreach (var item in Model.CountryOptions)
                    {
                        <label class="flex items-center gap-2 text-xs text-gray-700 cursor-pointer">
                            <input type="checkbox" name="CountryIds" value="@item.CountryId" @(Model.CountryIds.Contains(item.CountryId) ? "checked" : "") class="rounded border-gray-300 text-blue-600" />
                            @item.Name
                        </label>
                    }
                </div>
            </div>
        </div>

        <!-- Companies -->
        <div class="mt-6 border-t border-gray-100 pt-4">
            <div class="flex items-center justify-between mb-3">
                <label class="text-sm font-medium text-gray-700">شرکت‌های ناشر / توزیع</label>
                <button type="button" id="btnAddCompany" class="px-3 py-1.5 text-xs bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                    <i class="fas fa-plus me-1"></i>افزودن شرکت
                </button>
            </div>
            <div class="company-rows space-y-2">
                @for (var j = 0; j < Model.Companies.Count; j++)
                {
                    var company = Model.Companies[j];
                    <div class="company-row grid grid-cols-2 md:grid-cols-4 gap-3 p-3 bg-gray-50 rounded-md border border-gray-200">
                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <label class="block text-xs font-medium text-gray-600">شرکت</label>
                                <button type="button" class="btn-quick-add text-blue-600 hover:text-blue-800 text-xs" data-qa-target="company" title="افزودن شرکت جدید"><i class="fas fa-plus"></i></button>
                            </div>
                            <select name="Companies[@j].CompanyId" data-qa-options="company" class="@fieldClasses">
                                <option value="">-- انتخاب --</option>
                                @foreach (var item in Model.CompanyOptions)
                                {
                                    <option value="@item.CompanyId" selected="@(company.CompanyId == item.CompanyId)">@item.Name</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">نقش شرکت</label>
                            <select name="Companies[@j].CompanyRoleTypeId" class="@fieldClasses">
                                <option value="">-- انتخاب --</option>
                                @foreach (var item in Model.CompanyRoleTypeOptions)
                                {
                                    <option value="@item.CompanyRoleTypeId" selected="@(company.CompanyRoleTypeId == item.CompanyRoleTypeId)">@item.Name</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">شماره کاتالوگ</label>
                            <input type="text" name="Companies[@j].CatalogNumber" value="@company.CatalogNumber" class="@fieldClasses" />
                        </div>
                        <div class="flex items-end gap-3">
                            <div class="flex-1">
                                <label class="block text-xs font-medium text-gray-600 mb-1">بارکد</label>
                                <input type="text" name="Companies[@j].Barcode" value="@company.Barcode" class="@fieldClasses" />
                            </div>
                            <button type="button" class="remove-company text-red-600 hover:text-red-800 text-xs"><i class="fas fa-times"></i></button>
                        </div>
                    </div>
                }
            </div>
            <template id="tpl-company">
                <div class="company-row grid grid-cols-2 md:grid-cols-4 gap-3 p-3 bg-gray-50 rounded-md border border-gray-200">                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <label class="block text-xs font-medium text-gray-600">شرکت</label>
                                <button type="button" class="btn-quick-add text-blue-600 hover:text-blue-800 text-xs" data-qa-target="company" title="افزودن شرکت جدید"><i class="fas fa-plus"></i></button>
                            </div>
                            <select name="__P__[0].CompanyId" data-qa-options="company" class="@fieldClasses">
                            <option value="">-- انتخاب --</option>
                            @foreach (var item in Model.CompanyOptions)
                            {
                                <option value="@item.CompanyId">@item.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">نقش شرکت</label>
                        <select name="__P__[0].CompanyRoleTypeId" class="@fieldClasses">
                            <option value="">-- انتخاب --</option>
                            @foreach (var item in Model.CompanyRoleTypeOptions)
                            {
                                <option value="@item.CompanyRoleTypeId">@item.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">شماره کاتالوگ</label>
                        <input type="text" name="__P__[0].CatalogNumber" class="@fieldClasses" />
                    </div>
                    <div class="flex items-end gap-3">
                        <div class="flex-1">
                            <label class="block text-xs font-medium text-gray-600 mb-1">بارکد</label>
                            <input type="text" name="__P__[0].Barcode" class="@fieldClasses" />
                        </div>
                        <button type="button" class="remove-company text-red-600 hover:text-red-800 text-xs"><i class="fas fa-times"></i></button>
                    </div>
                </div>
            </template>
        </div>

        <!-- Identifiers -->
        <div class="mt-6 border-t border-gray-100 pt-4">
            <div class="flex items-center justify-between mb-3">
                <label class="text-sm font-medium text-gray-700">شناسه‌ها (بارکد، ISRC و…)</label>
                <button type="button" id="btnAddIdentifier" class="px-3 py-1.5 text-xs bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                    <i class="fas fa-plus me-1"></i>افزودن شناسه
                </button>
            </div>
            <div class="identifier-rows space-y-2">
                @for (var j = 0; j < Model.Identifiers.Count; j++)
                {
                    var identifier = Model.Identifiers[j];
                    <div class="identifier-row grid grid-cols-2 md:grid-cols-3 gap-3 p-3 bg-gray-50 rounded-md border border-gray-200">
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">نوع شناسه</label>
                            <select name="Identifiers[@j].IdentifierTypeId" class="@fieldClasses">
                                <option value="">-- انتخاب --</option>
                                @foreach (var item in Model.IdentifierTypeOptions)
                                {
                                    <option value="@item.IdentifierTypeId" selected="@(identifier.IdentifierTypeId == item.IdentifierTypeId)">@item.Name</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">مقدار</label>
                            <input type="text" name="Identifiers[@j].Value" value="@identifier.Value" class="@fieldClasses" />
                        </div>
                        <div class="flex items-end pb-1">
                            <button type="button" class="remove-identifier text-red-600 hover:text-red-800 text-xs"><i class="fas fa-times me-1"></i>حذف</button>
                        </div>
                    </div>
                }
            </div>
            <template id="tpl-identifier">
                <div class="identifier-row grid grid-cols-2 md:grid-cols-3 gap-3 p-3 bg-gray-50 rounded-md border border-gray-200">
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">نوع شناسه</label>
                        <select name="__P__[0].IdentifierTypeId" class="@fieldClasses">
                            <option value="">-- انتخاب --</option>
                            @foreach (var item in Model.IdentifierTypeOptions)
                            {
                                <option value="@item.IdentifierTypeId">@item.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">مقدار</label>
                        <input type="text" name="__P__[0].Value" class="@fieldClasses" />
                    </div>
                    <div class="flex items-end pb-1">
                        <button type="button" class="remove-identifier text-red-600 hover:text-red-800 text-xs"><i class="fas fa-times me-1"></i>حذف</button>
                    </div>
                </div>
            </template>
        </div>
    </section>

    <!-- ============================================================
         Step 3 — Tracks
         ============================================================ -->
    <section class="wizard-step mb-6 hidden" data-step="3">
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5 mb-4">
            <div class="flex items-center justify-between">
                <h2 class="text-lg font-semibold text-gray-900"><i class="fas fa-music text-blue-500 me-2"></i>ترک‌ها</h2>
                <button type="button" id="btnAddTrack" class="px-4 py-2 text-sm bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                    <i class="fas fa-plus me-1"></i>افزودن ترک
                </button>
            </div>
            <p class="text-xs text-gray-500 mt-1">برای هر ترک می‌توانید سبک‌ها، سازها، نسخه‌های خوانده‌شده (با انتخاب شعر) و عوامل را در همین‌جا ثبت کنید.</p>
        </div>
        <div id="trackList" class="space-y-4">
            @for (var i = 0; i < Model.Tracks.Count; i++)
            {
                <partial name="_WizardTrackCard" model="Model.Tracks[i]"
                         view-data='@(new ViewDataDictionary(ViewData) { { "TrackIndex", i }, { "Shared", Model } })' />
            }
        </div>
        @if (Model.Tracks.Count == 0)
        {
            <div id="trackEmptyHint" class="bg-white rounded-lg shadow-sm border border-dashed border-gray-300 p-8 text-center">
                <i class="fas fa-music text-3xl text-gray-300 mb-2"></i>
                <p class="text-sm text-gray-500">هنوز ترکی اضافه نشده است. با دکمه «افزودن ترک» شروع کنید — ترک‌ها اختیاری‌اند و می‌توانید آلبوم را بدون ترک بسازید.</p>
            </div>
        }
    </section>

    <!-- ============================================================
         Step 4 — Album credits
         ============================================================ -->
    <section class="wizard-step bg-white rounded-lg shadow-sm border border-gray-200 p-5 mb-6 hidden" data-step="4">
        <h2 class="text-lg font-semibold text-gray-900 mb-1"><i class="fas fa-users text-blue-500 me-2"></i>عوامل آلبوم</h2>
        <p class="text-xs text-gray-500 mb-4">عوامل کلی آلبوم (خواننده، تهیه‌کننده، آهنگساز و…). عوامل هر ترک در گام قبلی ثبت می‌شوند.</p>
        <div class="flex items-center justify-between mb-3">
            <label class="text-sm font-medium text-gray-700">عوامل</label>
            <button type="button" id="btnAddAlbumCredit" class="px-3 py-1.5 text-xs bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                <i class="fas fa-plus me-1"></i>افزودن عامل
            </button>
        </div>
        <div class="album-credit-rows space-y-2">
            @for (var j = 0; j < Model.AlbumCredits.Count; j++)
            {
                var credit = Model.AlbumCredits[j];
                <div class="credit-row grid grid-cols-2 md:grid-cols-4 gap-3 p-3 bg-gray-50 rounded-md border border-gray-200">
                    <div>
