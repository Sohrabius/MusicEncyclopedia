@model PublicationListViewModel
@{
    ViewData["Title"] = "انتشارات";
    ViewData["ActiveMenu"] = "Publications";
}

<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 mb-6">
    <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between">
        <form method="get" action="/admin/publications" class="flex items-center gap-2 flex-1 max-w-md">
            <div class="relative flex-1"><i class="fas fa-search absolute start-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i><input type="text" name="q" value="@Model.SearchQuery" placeholder="جستجو انتشاراتی..." class="w-full ps-9 pe-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /></div>
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-md hover:bg-blue-700 transition-colors"><i class="fas fa-search"></i></button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery)) { <a href="/admin/publications" class="px-3 py-2 text-sm text-gray-600 hover:text-gray-900"><i class="fas fa-times"></i> پاک کردن</a> }
        </form>
        <a href="/admin/publications/Create" class="inline-flex items-center gap-2 px-4 py-2 bg-green-600 text-white text-sm rounded-md hover:bg-green-700 transition-colors"><i class="fas fa-plus"></i> <span>ایجاد انتشارات</span></a>
    </div>
</div>

<div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr><th class="text-start px-4 py-3 font-medium text-gray-600">عنوان</th><th class="text-start px-4 py-3 font-medium text-gray-600">نوع</th><th class="text-start px-4 py-3 font-medium text-gray-600">شخص</th><th class="text-start px-4 py-3 font-medium text-gray-600">تاریخ</th><th class="text-center px-4 py-3 font-medium text-gray-600">وضعیت</th><th class="text-end px-4 py-3 font-medium text-gray-600">عملیات</th></tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (Model.Items.Items.Count == 0)
                {
                    <tr><td colspan="6" class="px-4 py-8 text-center text-gray-500"><i class="fas fa-book text-3xl text-gray-300 mb-2 block"></i>هنوز انتشاراتی وجود ندارد. <a href="/admin/publications/Create" class="text-blue-600 hover:underline">ایجاد کنید</a>.</td></tr>
                }
                else
                {
                    @foreach (var item in Model.Items.Items)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-4 py-3"><a href="/admin/publications/@item.PublicationId/Edit" class="text-blue-600 hover:underline font-medium">@item.Title</a><div class="text-xs text-gray-400 font-mono">@item.Slug</div></td>
                            <td class="px-4 py-3">@item.TypeName</td>
                            <td class="px-4 py-3">@item.PersonName</td>
                            <td class="px-4 py-3 text-gray-500">@(item.PublicationDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td class="px-4 py-3 text-center"><span class="inline-block px-2 py-0.5 text-xs rounded-full bg-green-50 text-green-700">فعال</span></td>
                            <td class="px-4 py-3 text-end">
                                <a href="/admin/publications/@item.PublicationId/Edit" class="inline-flex items-center gap-1 px-2 py-1 text-xs text-blue-600 hover:bg-blue-50 rounded"><i class="fas fa-edit"></i> ویرایش</a>
                                <form method="post" action="/admin/publications/@item.PublicationId/Delete" onsubmit="return confirm('Are you sure?');" class="inline">@Html.AntiForgeryToken()<button type="submit" class="inline-flex items-center gap-1 px-2 py-1 text-xs text-red-600 hover:bg-red-50 rounded"><i class="fas fa-trash-alt"></i> حذف</button></form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (Model.Items.TotalPages > 1)
    {
        <div class="flex items-center justify-between px-4 py-3 bg-gray-50 border-t border-gray-200">
            <p class="text-sm text-gray-500">صفحه <strong>@Model.Items.Page</strong> از <strong>@Model.Items.TotalPages</strong> (@Model.Items.TotalItems total)</p>
            <nav class="flex items-center gap-1">
                @if (Model.Items.Page > 1) { <a href="/admin/publications?page=@(Model.Items.Page - 1)&q=@Model.SearchQuery" class="px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-200 rounded"><i class="fas fa-chevron-right"></i> قبلی</a> }
                @if (Model.Items.Page < Model.Items.TotalPages) { <a href="/admin/publications?page=@(Model.Items.Page + 1)&q=@Model.SearchQuery" class="px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-200 rounded">بعدی <i class="fas fa-chevron-left"></i></a> }
            </nav>
        </div>
    }
</div>
