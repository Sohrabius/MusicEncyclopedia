@model PublicationEditViewModel
@{
    ViewData["Title"] = $"Edit: {Model.Title}";
    ViewData["ActiveMenu"] = "Publications";
}

<form method="post" action="/admin/publications/@Model.PublicationId/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="PublicationId" />
    <input type="hidden" asp-for="RowVersion" />
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-red-50 border border-red-200 text-red-800 text-sm" role="alert"></div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">اطلاعات پایه</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2"><label asp-for="Title" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="Title" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /><span asp-validation-for="Title" class="text-xs text-red-600"></span></div>
                    <div><label asp-for="PersonId" class="block text-sm font-medium text-gray-700 mb-1"></label><select asp-for="PersonId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"><option value="">-- انتخاب شخص --</option>@foreach (var p in Model.People) { <option value="@p.PersonId">@p.FullName</option> }</select><span asp-validation-for="PersonId" class="text-xs text-red-600"></span></div>
                    <div><label asp-for="PublicationTypeId" class="block text-sm font-medium text-gray-700 mb-1"></label><select asp-for="PublicationTypeId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"><option value="">-- هیچ‌کدام --</option>@foreach (var t in Model.PublicationTypes) { <option value="@t.PublicationTypeId">@t.Name</option> }</select></div>
                    <div><label asp-for="PublisherId" class="block text-sm font-medium text-gray-700 mb-1"></label><select asp-for="PublisherId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"><option value="">-- هیچ‌کدام --</option>@foreach (var c in Model.Companies) { <option value="@c.CompanyId">@c.Name</option> }</select></div>
                    <div><label asp-for="Slug" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="Slug" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /><span asp-validation-for="Slug" class="text-xs text-red-600"></span></div>
                </div>
            </div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">انتشارات جزئیات</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div><label asp-for="PublicationDate" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="PublicationDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /></div>
                    <div><label asp-for="PublicationDatePrecision" class="block text-sm font-medium text-gray-700 mb-1"></label><select asp-for="PublicationDatePrecision" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"><option value="">-- هیچ‌کدام --</option><option value="YEAR">سال</option><option value="MONTH">ماه</option><option value="DAY">روز</option></select></div>
                    <div><label asp-for="ISBN" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="ISBN" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /></div>
                </div>
            </div>
        </div>
        <div class="space-y-6">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">عملیات</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors flex items-center justify-center gap-2"><i class="fas fa-save"></i> ذخیره تغییرات</button>
                <a href="/admin/publications" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-gray-600 bg-gray-100 rounded-md hover:bg-gray-200 transition-colors"><i class="fas fa-arrow-left me-1"></i> بازگشت به فهرست</a>
                <hr class="border-gray-200 my-3" />
                <form method="post" action="/admin/publications/@Model.PublicationId/Delete" onsubmit="return confirm('Are you sure?');">@Html.AntiForgeryToken()<button type="submit" class="w-full px-4 py-2 text-sm text-red-600 border border-red-200 rounded-md hover:bg-red-50 transition-colors flex items-center justify-center gap-2"><i class="fas fa-trash-alt"></i> حذف</button></form>
            </div>
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
