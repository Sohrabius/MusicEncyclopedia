@model PublicationEditViewModel
@{
    ViewData["Title"] = "ایجاد انتشارات";
    ViewData["ActiveMenu"] = "Publications";
}

<form method="post" action="/admin/publications/Create">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-error-soft border border-error-border text-error-hover text-sm" role="alert"></div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">اطلاعات پایه</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" aria-live="polite" class="field-error"></span></div>
                    <div><label asp-for="PersonId" class="form-label"></label><select asp-for="PersonId" class="form-control"><option value="">-- انتخاب شخص --</option>@foreach (var p in Model.People) { <option value="@p.PersonId">@p.FullName</option> }</select><span asp-validation-for="PersonId" aria-live="polite" class="field-error"></span></div>
                    <div><label asp-for="PublicationTypeId" class="form-label"></label><select asp-for="PublicationTypeId" class="form-control"><option value="">-- هیچ‌کدام --</option>@foreach (var t in Model.PublicationTypes) { <option value="@t.PublicationTypeId">@t.Name</option> }</select></div>
                    <div><label asp-for="PublisherId" class="form-label"></label><select asp-for="PublisherId" class="form-control"><option value="">-- هیچ‌کدام --</option>@foreach (var c in Model.Companies) { <option value="@c.CompanyId">@c.Name</option> }</select></div>
                    <div><label asp-for="Slug" class="form-label"></label><input asp-for="Slug" class="form-control" /><span asp-validation-for="Slug" aria-live="polite" class="field-error"></span></div>
                </div>
            </div>
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">انتشارات جزئیات</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div><label asp-for="PublicationDate" class="form-label"></label><input asp-for="PublicationDate" type="date" class="form-control" /></div>
                    <div><label asp-for="PublicationDatePrecision" class="form-label"></label><select asp-for="PublicationDatePrecision" class="form-control"><option value="">-- هیچ‌کدام --</option><option value="YEAR">سال</option><option value="MONTH">ماه</option><option value="DAY">روز</option></select></div>
                    <div><label asp-for="ISBN" class="form-label"></label><input asp-for="ISBN" class="form-control" /></div>
                </div>
            </div>
        </div>
        <div class="space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">انتشار</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-accent text-on-accent text-sm font-medium rounded-md hover:bg-accent-hover transition-colors flex items-center justify-center gap-2"><i aria-hidden="true" class="fas fa-save"></i> ایجاد انتشارات</button>
                <a href="/admin/publications" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-ink-secondary bg-paper-muted rounded-md hover:bg-rule transition-colors">انصراف</a>
            </div>
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
