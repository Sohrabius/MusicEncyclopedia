@model ChartEditViewModel
@{
    ViewData["Title"] = "ایجاد جدول";
    ViewData["ActiveMenu"] = "Charts";
}

<form method="post" action="/admin/charts/Create">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-error-soft border border-error-border text-error-hover text-sm" role="alert"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">اطلاعات پایه</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="Slug" class="form-label"></label>
                        <input asp-for="Slug" class="form-control" placeholder="chart-slug" />
                        <span asp-validation-for="Slug" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="Publisher" class="form-label"></label>
                        <input asp-for="Publisher" class="form-control" />
                        <span asp-validation-for="Publisher" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="Frequency" class="form-label"></label>
                        <select asp-for="Frequency" class="form-control">
                            <option value="">-- انتخاب --</option>
                            <option value="Weekly">هفتگی</option>
                            <option value="Monthly">ماهانه</option>
                            <option value="Yearly">سالانه</option>
                            <option value="Daily">روزانه</option>
                        </select>
                        <span asp-validation-for="Frequency" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="CountryId" class="form-label"></label>
                        <select asp-for="CountryId" class="form-control">
                            <option value="">-- انتخاب کشور --</option>
                            @foreach (var c in Model.Countries)
                            {
                                <option value="@c.CountryId">@c.Name</option>
                            }
                        </select>
                        <span asp-validation-for="CountryId" aria-live="polite" class="field-error"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">انتشار</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-accent text-on-accent text-sm font-medium rounded-md hover:bg-accent-hover transition-colors flex items-center justify-center gap-2"><i aria-hidden="true" class="fas fa-save"></i> ایجاد جدول</button>
                <a href="/admin/charts" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-ink-secondary bg-paper-muted rounded-md hover:bg-rule transition-colors">انصراف</a>
            </div>
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
