@model PersonEditViewModel
@{
    ViewData["Title"] = "ایجاد شخص";
    ViewData["ActiveMenu"] = "People";
}

<form method="post" action="/admin/people/Create">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-red-50 border border-red-200 text-red-800 text-sm" role="alert"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <!-- Basic Information -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">اطلاعات پایه</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2">
                        <label asp-for="FullName" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="FullName" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <span asp-validation-for="FullName" class="text-xs text-red-600"></span>
                    </div>
                    <div>
                        <label asp-for="FullNameSort" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="FullNameSort" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    </div>
                    <div>
                        <label asp-for="Slug" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="Slug" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <span asp-validation-for="Slug" class="text-xs text-red-600"></span>
                    </div>
                    <div>
                        <label asp-for="OriginalName" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="OriginalName" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    </div>
                    <div>
                        <label asp-for="EnglishName" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="EnglishName" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    </div>
                </div>
            </div>

            <!-- Classification -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">دسته‌بندی</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="PersonKindId" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <select asp-for="PersonKindId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">-- انتخاب نوع --</option>
                            @foreach (var item in Model.PersonKinds)
                            {
                                <option value="@item.PersonKindId">@item.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label asp-for="NationalityCountryId" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <select asp-for="NationalityCountryId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">-- انتخاب کشور --</option>
                            @foreach (var item in Model.Countries)
                            {
                                <option value="@item.CountryId">@item.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Dates -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">تاریخ‌ها</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="BirthDate" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="BirthDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    </div>
                    <div>
                        <label asp-for="BirthDatePrecision" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <select asp-for="BirthDatePrecision" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">-- دقت --</option>
                            <option value="day">روز</option><option value="month">ماه</option><option value="year">سال</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="DeathDate" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="DeathDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    </div>
                    <div>
                        <label asp-for="DeathDatePrecision" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <select asp-for="DeathDatePrecision" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">-- دقت --</option>
                            <option value="day">روز</option><option value="month">ماه</option><option value="year">سال</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Biography -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">زندگی‌نامه</h2>
                <div>
                    <label asp-for="Biography" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <textarea asp-for="Biography" rows="6" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
                </div>
                <div class="mt-4">
                    <label asp-for="ImageMediaId" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="ImageMediaId" type="number" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="شناسه رسانه" />
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">انتشار</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors flex items-center justify-center gap-2">
                    <i class="fas fa-save"></i> ایجاد شخص
                </button>
                <a href="/admin/people" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-gray-600 bg-gray-100 rounded-md hover:bg-gray-200 transition-colors">انصراف</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
