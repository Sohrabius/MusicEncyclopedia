@model PersonEditViewModel
@{
    ViewData["Title"] = $"Edit: {Model.FullName}";
    ViewData["ActiveMenu"] = "People";
}

<form method="post" action="/admin/people/@Model.PersonId/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="PersonId" />
    <input type="hidden" asp-for="RowVersion" />
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-error-soft border border-error-border text-error-hover text-sm" role="alert"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">اطلاعات پایه</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="FullNameSort" class="form-label"></label>
                        <input asp-for="FullNameSort" class="form-control" />
                    </div>
                    <div>
                        <label asp-for="Slug" class="form-label"></label>
                        <input asp-for="Slug" class="form-control" />
                        <span asp-validation-for="Slug" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="OriginalName" class="form-label"></label>
                        <input asp-for="OriginalName" class="form-control" />
                    </div>
                    <div>
                        <label asp-for="EnglishName" class="form-label"></label>
                        <input asp-for="EnglishName" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">دسته‌بندی</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="PersonKindId" class="form-label"></label>
                        <select asp-for="PersonKindId" class="form-control">
                            <option value="">-- انتخاب نوع --</option>
                            @foreach (var item in Model.PersonKinds) { <option value="@item.PersonKindId">@item.Name</option> }
                        </select>
                    </div>
                    <div>
                        <label asp-for="NationalityCountryId" class="form-label"></label>
                        <select asp-for="NationalityCountryId" class="form-control">
                            <option value="">-- انتخاب کشور --</option>
                            @foreach (var item in Model.Countries) { <option value="@item.CountryId">@item.Name</option> }
                        </select>
                    </div>
                </div>
            </div>

            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">تاریخ‌ها</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="BirthDate" class="form-label"></label>
                        <input asp-for="BirthDate" type="date" class="form-control" />
                    </div>
                    <div>
                        <label asp-for="BirthDatePrecision" class="form-label"></label>
                        <select asp-for="BirthDatePrecision" class="form-control">
                            <option value="">-- دقت --</option>
                            <option value="day">روز</option><option value="month">ماه</option><option value="year">سال</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="DeathDate" class="form-label"></label>
                        <input asp-for="DeathDate" type="date" class="form-control" />
                    </div>
                    <div>
                        <label asp-for="DeathDatePrecision" class="form-label"></label>
                        <select asp-for="DeathDatePrecision" class="form-control">
                            <option value="">-- دقت --</option>
                            <option value="day">روز</option><option value="month">ماه</option><option value="year">سال</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">زندگی‌نامه</h2>
                <div>
                    <label asp-for="Biography" class="form-label"></label>
                    <textarea asp-for="Biography" rows="6" class="form-control"></textarea>
                </div>
                <div class="mt-4">
                    <label asp-for="ImageMediaId" class="form-label"></label>
                    <input asp-for="ImageMediaId" type="number" class="form-control" placeholder="شناسه رسانه" />
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">عملیات</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-accent text-on-accent text-sm font-medium rounded-md hover:bg-accent-hover transition-colors flex items-center justify-center gap-2">
                    <i aria-hidden="true" class="fas fa-save"></i> ذخیره تغییرات
                </button>
                <a href="/admin/people" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-ink-secondary bg-paper-muted rounded-md hover:bg-rule transition-colors">
                    <i aria-hidden="true" class="fas fa-arrow-left me-1"></i> بازگشت به فهرست
                </a>
                <hr class="border-rule my-3" />
                <form method="post" action="/admin/people/@Model.PersonId/Delete"
                      onsubmit="return confirm('Are you sure you want to delete this person? It will be soft-deleted and can be restored later.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full px-4 py-2 text-sm text-error border border-error-border rounded-md hover:bg-error-soft transition-colors flex items-center justify-center gap-2">
                        <i aria-hidden="true" class="fas fa-trash-alt"></i> حذف شخص
                    </button>
                </form>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.1.0/jquery.validate.unobtrusive.min.js"></script>
}
