@model SourceEditViewModel
@{
    ViewData["Title"] = "Create Source";
    ViewData["ActiveMenu"] = "Sources";
}

<form method="post" action="/admin/sources/Create">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-red-50 border border-red-200 text-red-800 text-sm" role="alert"></div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Basic Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2"><label asp-for="Title" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="Title" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /><span asp-validation-for="Title" class="text-xs text-red-600"></span></div>
                    <div><label asp-for="SourceTypeId" class="block text-sm font-medium text-gray-700 mb-1"></label><select asp-for="SourceTypeId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"><option value="">-- None --</option>@foreach (var t in Model.SourceTypes) { <option value="@t.SourceTypeId">@t.Name</option> }</select></div>
                    <div><label asp-for="Author" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="Author" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /></div>
                    <div><label asp-for="PublisherId" class="block text-sm font-medium text-gray-700 mb-1"></label><select asp-for="PublisherId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"><option value="">-- None --</option>@foreach (var c in Model.Companies) { <option value="@c.CompanyId">@c.Name</option> }</select></div>
                    <div><label asp-for="Slug" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="Slug" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /><span asp-validation-for="Slug" class="text-xs text-red-600"></span></div>
                </div>
            </div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Source Details</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div><label asp-for="PublicationDate" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="PublicationDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /></div>
                    <div><label asp-for="Url" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="Url" type="url" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="https://..." /></div>
                </div>
            </div>
        </div>
        <div class="space-y-6">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Publish</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors flex items-center justify-center gap-2"><i class="fas fa-save"></i> Create Source</button>
                <a href="/admin/sources" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-gray-600 bg-gray-100 rounded-md hover:bg-gray-200 transition-colors">Cancel</a>
            </div>
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
