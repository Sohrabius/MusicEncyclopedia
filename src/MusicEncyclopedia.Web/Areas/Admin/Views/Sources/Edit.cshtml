@model SourceEditViewModel
@{
    ViewData["Title"] = $"Edit: {Model.Title}";
    ViewData["ActiveMenu"] = "Sources";
}

<form method="post" action="/admin/sources/@Model.SourceId/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="SourceId" />
    <input type="hidden" asp-for="RowVersion" />
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-error-soft border border-error-border text-error-hover text-sm" role="alert"></div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">اطلاعات پایه</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" aria-live="polite" class="field-error"></span></div>
                    <div><label asp-for="SourceTypeId" class="form-label"></label><select asp-for="SourceTypeId" class="form-control"><option value="">-- هیچ‌کدام --</option>@foreach (var t in Model.SourceTypes) { <option value="@t.SourceTypeId">@t.Name</option> }</select></div>
                    <div><label asp-for="Author" class="form-label"></label><input asp-for="Author" class="form-control" /></div>
                    <div><label asp-for="PublisherId" class="form-label"></label><select asp-for="PublisherId" class="form-control"><option value="">-- هیچ‌کدام --</option>@foreach (var c in Model.Companies) { <option value="@c.CompanyId">@c.Name</option> }</select></div>
                    <div><label asp-for="Slug" class="form-label"></label><input asp-for="Slug" class="form-control" /><span asp-validation-for="Slug" aria-live="polite" class="field-error"></span></div>
                </div>
            </div>
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">منبع جزئیات</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div><label asp-for="PublicationDate" class="form-label"></label><input asp-for="PublicationDate" type="date" class="form-control" /></div>
                    <div><label asp-for="Url" class="form-label"></label><input asp-for="Url" type="url" class="form-control" placeholder="https://..." /></div>
                </div>
            </div>
        </div>
        <div class="space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">عملیات</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-accent text-on-accent text-sm font-medium rounded-md hover:bg-accent-hover transition-colors flex items-center justify-center gap-2"><i aria-hidden="true" class="fas fa-save"></i> ذخیره تغییرات</button>
                <a href="/admin/sources" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-ink-secondary bg-paper-muted rounded-md hover:bg-rule transition-colors"><i aria-hidden="true" class="fas fa-arrow-left me-1"></i> بازگشت به فهرست</a>
                <hr class="border-rule my-3" />
                <form method="post" action="/admin/sources/@Model.SourceId/Delete" onsubmit="return confirm('Are you sure?');">@Html.AntiForgeryToken()<button type="submit" class="w-full px-4 py-2 text-sm text-error border border-error-border rounded-md hover:bg-error-soft transition-colors flex items-center justify-center gap-2"><i aria-hidden="true" class="fas fa-trash-alt"></i> حذف</button></form>
            </div>
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
