@model RelatedItemsEditorViewModel
@{
    // Generic AJAX related-items editor used by album/track edit tabs.
    var editorId = $"ri-{Model.Kind}-{Model.EntityId}";
}

<div class="related-items-editor" id="@editorId"
     data-kind="@Model.Kind"
     data-entity-id="@Model.EntityId"
     data-uses-dropdown="@(Model.UsesDropdown ? "1" : "0")">

    <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-semibold text-ink-secondary">@Model.Title</h3>
        <span class="ri-count text-xs text-ink-muted">@Model.Items.Count assigned</span>
    </div>

    @if (Model.Items.Count == 0)
    {
        <p class="ri-empty text-xs text-ink-muted mb-3">
            <i aria-hidden="true" class="fas fa-info-circle text-accent me-1"></i>
            No @Model.Title.ToLower() assigned yet.
        </p>
    }

    <ul class="ri-list space-y-1.5 mb-3">
        @foreach (var item in Model.Items)
        {
            <li class="flex items-center justify-between gap-2 px-3 py-2 bg-paper rounded-md border border-rule text-sm"
                data-id="@item.Id">
                <span class="text-ink truncate">
                    @item.Label
                    @if (!string.IsNullOrWhiteSpace(item.Extra))
                    {
                        <span class="text-ink-muted text-xs">(@item.Extra)</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.RoleLabel))
                    {
                        <span class="inline-block ms-1 px-1.5 py-0.5 bg-accent-soft text-accent-hover text-xs rounded">@item.RoleLabel</span>
                    }
                </span>
                <button type="button"
                        class="ri-remove text-error hover:text-error-hover text-xs shrink-0 min-w-11 min-h-11 inline-flex items-center justify-center"
                        title="حذف"
                        data-id="@item.Id"><i aria-hidden="true" class="fas fa-times"></i></button>
            </li>
        }
    </ul>

    <!-- Add form -->
    <div class="ri-add-form flex flex-wrap items-end gap-2">
        @if (Model.UsesDropdown)
        {
            <div class="flex-1 min-w-[180px]">
                <label class="block text-xs font-medium text-ink-secondary mb-1">افزودن</label>
                <select class="ri-option w-full text-xs px-2 py-1.5 border border-rule-strong rounded">
                    <option value="">-- انتخاب --</option>
                    @foreach (var option in Model.Options)
                    {
                        <option value="@option.Id">@option.Label</option>
                    }
                </select>
            </div>
        }
        else
        {
            <div class="flex-1 min-w-[180px]">
                <label class="block text-xs font-medium text-ink-secondary mb-1">@Model.ExtraFieldLabel</label>
                <input type="text" class="ri-extra w-full text-xs px-2 py-1.5 border border-rule-strong rounded"
                       placeholder="@Model.ExtraFieldPlaceholder" />
            </div>
        }

        @if (Model.HasRoleField)
        {
            <div class="min-w-[140px]">
                <label class="block text-xs font-medium text-ink-secondary mb-1">@Model.RoleFieldLabel</label>
                <select class="ri-role w-full text-xs px-2 py-1.5 border border-rule-strong rounded">
                    <option value="">-- انتخاب --</option>
                    @foreach (var role in Model.RoleOptions)
                    {
                        <option value="@role.Id">@role.Label</option>
                    }
                </select>
            </div>
        }

        @if (Model.UsesDropdown && Model.HasExtraField)
        {
            <div class="min-w-[140px]">
                <label class="block text-xs font-medium text-ink-secondary mb-1">@Model.ExtraFieldLabel</label>
                <input type="text" class="ri-extra w-full text-xs px-2 py-1.5 border border-rule-strong rounded"
                       placeholder="@Model.ExtraFieldPlaceholder" />
            </div>
        }

        <button type="button"
                class="ri-add px-3 py-1.5 text-xs bg-accent text-on-accent rounded-md hover:bg-accent-hover transition-colors">
            <i aria-hidden="true" class="fas fa-plus"></i> افزودن
        </button>
    </div>

    <div class="ri-error ui-state--error mt-2 hidden">
        <p class="text-xs text-error bg-error-soft border border-error-border rounded px-2 py-1.5"></p>
    </div>
</div>

<script>
    (function () {
        var editor = document.getElementById('@editorId');
        if (!editor) return;

        function antiForgeryToken() {
            var el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        function showError(msg) {
            var box = editor.querySelector('.ri-error');
            box.querySelector('p').textContent = msg;
            box.classList.remove('hidden');
        }

        function hideError() {
            editor.querySelector('.ri-error').classList.add('hidden');
        }

        editor.querySelector('.ri-add').addEventListener('click', function () {
            hideError();
            var form = new FormData();
            form.append('kind', editor.dataset.kind);
            form.append('entityId', editor.dataset.entityId);

            var usesDropdown = editor.dataset.usesDropdown === '1';
            var option = editor.querySelector('.ri-option');
            var extraInput = editor.querySelector('.ri-extra');
            var role = editor.querySelector('.ri-role');

            if (usesDropdown) {
                form.append('optionId', option ? option.value : '');
            }
            if (extraInput) {
                form.append('extra', extraInput.value);
            }
            if (role) {
                form.append('roleId', role.value);
            }
            form.append('__RequestVerificationToken', antiForgeryToken());

            fetch('/admin/related-items/add', { method: 'POST', body: form })
                .then(function (r) { return r.json(); })
                .then(function (result) {
                    if (result.success) {
                        location.reload();
                    } else {
                        showError((result.errors || []).join(', '));
                    }
                })
                .catch(function () { showError('Request failed. Please try again.'); });
        });

        editor.querySelectorAll('.ri-remove').forEach(function (btn) {
            btn.addEventListener('click', function () {
                if (!confirm('حذف this item?'))) return;
                var form = new FormData();
                form.append('__RequestVerificationToken', antiForgeryToken());
                fetch('/admin/related-items/remove/' + editor.dataset.kind + '/' + btn.dataset.id, { method: 'POST', body: form })
                    .then(function (r) { return r.json(); })
                    .then(function (result) {
                        if (result.success) { location.reload(); }
                        else { showError((result.errors || []).join(', ')); }
                    })
                    .catch(function () { showError('Request failed. Please try again.'); });
            });
        });
    })();
</script>
