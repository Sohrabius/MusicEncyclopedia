@model AlbumTracklistViewModel
@{
    // Album tracklist editor (spec 10.5 "Tracklist" tab).
    var editorId = $"tracklist-{Model.AlbumId}";
}

<div class="album-tracklist-editor" id="@editorId" data-album-id="@Model.AlbumId">
    <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-semibold text-ink-secondary">فهرست ترک‌ها</h3>
        <span class="tl-count text-xs text-ink-muted">@Model.Rows.Count tracks</span>
    </div>

    @if (Model.Rows.Count == 0)
    {
        <p class="tl-empty text-xs text-ink-muted mb-3">
            <i aria-hidden="true" class="fas fa-info-circle text-accent me-1"></i>
            هیچ tracks on this album هنوز. افزودن an existing track or create a new one inline.
        </p>
    }

    <div class="admin-table-wrap mb-3">
        <table class="admin-table">
            <thead class="bg-paper border-b border-rule">
                <tr>
                    <th class="text-start px-2 py-2 font-medium text-ink-secondary w-8"></th>
                    <th class="text-start px-2 py-2 font-medium text-ink-secondary w-16">دیسک</th>
                    <th class="text-start px-2 py-2 font-medium text-ink-secondary w-16">#</th>
                    <th class="text-start px-2 py-2 font-medium text-ink-secondary">ترک</th>
                    <th class="text-start px-2 py-2 font-medium text-ink-secondary w-24">عنوان جایگزین</th>
                    <th class="text-start px-2 py-2 font-medium text-ink-secondary w-20">مدت (ثانیه)</th>
                    <th class="text-center px-2 py-2 font-medium text-ink-secondary w-16">آهنگ جایزه</th>
                    <th class="text-end px-2 py-2 font-medium text-ink-secondary w-32">عملیات</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-rule-light">
                @foreach (var row in Model.Rows)
                {
                    <tr data-album-track-id="@row.AlbumTrackId">
                        <td class="px-2 py-2 text-ink-muted">
                            <button type="button" class="tl-move-up hover:text-accent me-1 min-w-11 min-h-11 inline-flex items-center justify-center" title="Move up" data-id="@row.AlbumTrackId"><i aria-hidden="true" class="fas fa-chevron-up text-xs"></i></button>
                            <button type="button" class="tl-move-down hover:text-accent min-w-11 min-h-11 inline-flex items-center justify-center" title="Move down" data-id="@row.AlbumTrackId"><i aria-hidden="true" class="fas fa-chevron-down text-xs"></i></button>
                        </td>
                        <td class="px-2 py-2"><input type="number" class="tl-disc w-14 text-xs px-1.5 py-1 border border-rule-strong rounded" value="@row.DiscNumber" /></td>
                        <td class="px-2 py-2"><input type="number" class="tl-track-no w-14 text-xs px-1.5 py-1 border border-rule-strong rounded" value="@row.TrackNumber" /></td>
                        <td class="px-2 py-2 text-ink">
                            @if (!string.IsNullOrWhiteSpace(row.TitleOverride))
                            {
                                <span class="line-through text-ink-muted">@row.TrackTitle</span>
                                <span class="ms-1">@row.TitleOverride</span>
                            }
                            else
                            {
                                @row.TrackTitle
                            }
                        </td>
                        <td class="px-2 py-2"><input type="text" class="tl-title-override w-full text-xs px-1.5 py-1 border border-rule-strong rounded" value="@row.TitleOverride" placeholder="override" /></td>
                        <td class="px-2 py-2"><input type="number" class="tl-duration w-16 text-xs px-1.5 py-1 border border-rule-strong rounded" value="@row.DurationOverrideSeconds" /></td>
                        <td class="px-2 py-2 text-center">
                            <input type="checkbox" class="tl-bonus rounded border-rule-strong text-accent" @(row.IsBonus ? "checked" : "") />
                        </td>
                        <td class="px-2 py-2 text-end">
                            <button type="button" class="tl-save text-accent hover:text-accent-hover text-xs me-2 min-w-11 min-h-11 inline-flex items-center justify-center" data-id="@row.AlbumTrackId" aria-label="ذخیره"><i aria-hidden="true" class="fas fa-save"></i></button>
                            <button type="button" class="tl-remove text-error hover:text-error-hover text-xs min-w-11 min-h-11 inline-flex items-center justify-center" data-id="@row.AlbumTrackId" aria-label="حذف"><i aria-hidden="true" class="fas fa-trash-alt"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Add existing track -->
    <div class="flex flex-wrap items-end gap-2 mb-2">
        <div class="flex-1 min-w-[200px]">
            <label class="block text-xs font-medium text-ink-secondary mb-1">افزودن ترک موجود</label>
            <select class="tl-track-option w-full text-xs px-2 py-1.5 border border-rule-strong rounded">
                <option value="">-- انتخاب ترک --</option>
                @foreach (var option in Model.AvailableTracks)
                {
                    <option value="@option.TrackId">@option.Title</option>
                }
            </select>
        </div>
        <div class="w-20">
            <label class="block text-xs font-medium text-ink-secondary mb-1">دیسک</label>
            <input type="number" class="tl-new-disc w-full text-xs px-2 py-1.5 border border-rule-strong rounded" value="1" />
        </div>
        <div class="w-20">
            <label class="block text-xs font-medium text-ink-secondary mb-1">#</label>
            <input type="number" class="tl-new-no w-full text-xs px-2 py-1.5 border border-rule-strong rounded" value="0" placeholder="auto" />
        </div>
        <button type="button" class="tl-add-existing px-3 py-1.5 text-xs bg-accent text-on-accent rounded-md hover:bg-accent-hover transition-colors">
            <i aria-hidden="true" class="fas fa-plus"></i> افزودن
        </button>
    </div>

    <!-- Create inline -->
    <details class="tl-create-inline mb-2">
        <summary class="cursor-pointer text-xs text-accent hover:text-accent-hover">+ ایجاد ترک جدید درجا</summary>
        <div class="flex flex-wrap items-end gap-2 mt-2">
            <div class="flex-1 min-w-[200px]">
                <label class="block text-xs font-medium text-ink-secondary mb-1">عنوان</label>
                <input type="text" class="tl-new-title w-full text-xs px-2 py-1.5 border border-rule-strong rounded" />
            </div>
            <div class="w-20">
                <label class="block text-xs font-medium text-ink-secondary mb-1">دیسک</label>
                <input type="number" class="tl-new-disc-inline w-full text-xs px-2 py-1.5 border border-rule-strong rounded" value="1" />
            </div>
            <div class="w-20">
                <label class="block text-xs font-medium text-ink-secondary mb-1">#</label>
                <input type="number" class="tl-new-no-inline w-full text-xs px-2 py-1.5 border border-rule-strong rounded" value="0" placeholder="auto" />
            </div>
            <div class="w-24">
                <label class="block text-xs font-medium text-ink-secondary mb-1">مدت (ثانیه)</label>
                <input type="number" class="tl-new-duration w-full text-xs px-2 py-1.5 border border-rule-strong rounded" />
            </div>
            <button type="button" class="tl-create px-3 py-1.5 text-xs bg-success text-on-accent rounded-md hover:bg-success-hover transition-colors">
                <i aria-hidden="true" class="fas fa-plus"></i> ایجاد
            </button>
        </div>
    </details>

    <div class="tl-error ui-state--error mt-2 hidden">
        <p class="text-xs text-error bg-error-soft border border-error-border rounded px-2 py-1.5"></p>
    </div>
</div>

<script>
    (function () {
        var editor = document.getElementById('@editorId');
        if (!editor) return;

        var albumId = editor.dataset.albumId;

        function token() {
            var el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        function showError(msg) {
            var box = editor.querySelector('.tl-error');
            box.querySelector('p').textContent = msg;
            box.classList.remove('hidden');
        }

        function post(url, data, done) {
            var form = new FormData();
            Object.keys(data).forEach(function (k) { form.append(k, data[k]); });
            form.append('__RequestVerificationToken', token());
            fetch(url, { method: 'POST', body: form })
                .then(function (r) { return r.json(); })
                .then(function (result) {
                    if (result.success) { location.reload(); }
                    else { showError((result.errors || []).join(', ')); }
                })
                .catch(function () { showError('Request failed. Please try again.'); });
        }

        editor.querySelector('.tl-add-existing').addEventListener('click', function () {
            var option = editor.querySelector('.tl-track-option');
            if (!option.value) { showError('Select a track first.'); return; }
            post('/admin/album-tracklist/add-existing', {
                albumId: albumId,
                trackId: option.value,
                discNumber: editor.querySelector('.tl-new-disc').value || '1',
                trackNumber: editor.querySelector('.tl-new-no').value || '0',
                isBonus: 'false'
            });
        });

        editor.querySelector('.tl-create').addEventListener('click', function () {
            var title = editor.querySelector('.tl-new-title').value.trim();
            if (!title) { showError('Track title is required.'); return; }
            post('/admin/album-tracklist/create-inline', {
                albumId: albumId,
                title: title,
                discNumber: editor.querySelector('.tl-new-disc-inline').value || '1',
                trackNumber: editor.querySelector('.tl-new-no-inline').value || '0',
                durationSeconds: editor.querySelector('.tl-new-duration').value || '',
                isBonus: 'false'
            });
        });

        editor.querySelectorAll('.tl-save').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var row = btn.closest('tr');
                post('/admin/album-tracklist/update', {
                    albumTrackId: row.dataset.albumTrackId,
                    discNumber: row.querySelector('.tl-disc').value || '1',
                    trackNumber: row.querySelector('.tl-track-no').value || '0',
                    titleOverride: row.querySelector('.tl-title-override').value,
                    durationOverrideSeconds: row.querySelector('.tl-duration').value || '',
                    isBonus: row.querySelector('.tl-bonus').checked ? 'true' : 'false',
                    isHidden: 'false'
                });
            });
        });

        editor.querySelectorAll('.tl-remove').forEach(function (btn) {
            btn.addEventListener('click', function () {
                if (!confirm('این ترک از آلبوم حذف شود؟'))) return;
                var form = new FormData();
                form.append('__RequestVerificationToken', token());
                fetch('/admin/album-tracklist/remove/' + btn.dataset.id, { method: 'POST', body: form })
                    .then(function (r) { return r.json(); })
                    .then(function (result) {
                        if (result.success) { location.reload(); }
                        else { showError((result.errors || []).join(', ')); }
                    });
            });
        });

        editor.querySelectorAll('.tl-move-up, .tl-move-down').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var direction = btn.classList.contains('tl-move-up') ? 'up' : 'down';
                var form = new FormData();
                form.append('__RequestVerificationToken', token());
                fetch('/admin/album-tracklist/move/' + btn.dataset.id + '/' + direction, { method: 'POST', body: form })
                    .then(function (r) { return r.json(); })
                    .then(function (result) {
                        if (result.success) { location.reload(); }
                        else { showError((result.errors || []).join(', ')); }
                    });
            });
        });
    })();
</script>
