@model AliasListViewModel
@{
    // Partial view for the alias editor (spec 10.13).
}

<div class="alias-editor" data-entity-type-id="@Model.EntityTypeId" data-entity-id="@Model.EntityId">
    <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-semibold text-gray-700">Aliases</h3>
        <button type="button" class="btn-add-alias px-3 py-1.5 text-xs bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
            <i class="fas fa-plus"></i> Add Alias
        </button>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="text-start px-3 py-2 font-medium text-gray-600">Alias Name</th>
                    <th class="text-start px-3 py-2 font-medium text-gray-600">Type</th>
                    <th class="text-start px-3 py-2 font-medium text-gray-600">Language</th>
                    <th class="text-center px-3 py-2 font-medium text-gray-600">Primary</th>
                    <th class="text-end px-3 py-2 font-medium text-gray-600">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (Model.Aliases.Count == 0)
                {
                    <tr class="empty-row"><td colspan="5" class="px-3 py-6 text-center text-gray-500 text-xs">No aliases yet.</td></tr>
                }
                else
                {
                    @foreach (var alias in Model.Aliases)
                    {
                        <tr data-alias-id="@alias.AliasId">
                            <td class="px-3 py-2">@alias.AliasName</td>
                            <td class="px-3 py-2">@alias.AliasTypeId</td>
                            <td class="px-3 py-2">@alias.LanguageId</td>
                            <td class="px-3 py-2 text-center">@if(alias.IsPrimary){<i class="fas fa-check text-green-500"></i>}</td>
                            <td class="px-3 py-2 text-end">
                                <button type="button" class="btn-delete-alias text-red-600 hover:text-red-800 text-xs"><i class="fas fa-trash-alt"></i></button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="alias-form hidden mt-3 p-3 bg-gray-50 rounded-md border border-gray-200">
        <input type="hidden" class="alias-id" value="0" />
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            <div class="md:col-span-2">
                <label class="block text-xs font-medium text-gray-600 mb-1">Alias Name</label>
                <input type="text" class="alias-name w-full text-xs px-2 py-1.5 border border-gray-300 rounded" />
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">Type</label>
                <select class="alias-type-id w-full text-xs px-2 py-1.5 border border-gray-300 rounded">
                    <option value="">-- Select --</option>
                    @foreach (var at in Model.AliasTypes) { <option value="@at.AliasTypeId">@at.Name</option> }
                </select>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">Language</label>
                <select class="language-id w-full text-xs px-2 py-1.5 border border-gray-300 rounded">
                    <option value="">-- Select --</option>
                    @foreach (var lang in Model.Languages) { <option value="@lang.LanguageId">@lang.Name</option> }
                </select>
            </div>
        </div>
        <div class="flex items-center gap-4 mt-3">
            <label class="inline-flex items-center gap-1 cursor-pointer">
                <input type="checkbox" class="is-primary-alias rounded border-gray-300 text-blue-600" />
                <span class="text-xs text-gray-600">Primary</span>
            </label>
        </div>
        <div class="flex items-center gap-2 mt-3">
            <button type="button" class="btn-save-alias px-3 py-1.5 text-xs bg-blue-600 text-white rounded-md hover:bg-blue-700">Save</button>
            <button type="button" class="btn-cancel-alias px-3 py-1.5 text-xs text-gray-600 bg-gray-200 rounded-md hover:bg-gray-300">Cancel</button>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.alias-editor').forEach(function(editor) {
        var addBtn = editor.querySelector('.btn-add-alias');
        var form = editor.querySelector('.alias-form');
        var cancelBtn = editor.querySelector('.btn-cancel-alias');
        var saveBtn = editor.querySelector('.btn-save-alias');

        addBtn.addEventListener('click', function() {
            form.querySelector('.alias-id').value = '0';
            form.querySelector('.alias-name').value = '';
            form.querySelector('.alias-type-id').value = '';
            form.querySelector('.language-id').value = '';
            form.querySelector('.is-primary-alias').checked = false;
            form.classList.remove('hidden');
        });

        cancelBtn.addEventListener('click', function() { form.classList.add('hidden'); });

        saveBtn.addEventListener('click', function() {
            var data = new FormData();
            data.append('aliasId', form.querySelector('.alias-id').value);
            data.append('aliasName', form.querySelector('.alias-name').value);
            data.append('aliasTypeId', form.querySelector('.alias-type-id').value || '');
            data.append('languageId', form.querySelector('.language-id').value || '');
            data.append('isPrimary', form.querySelector('.is-primary-alias').checked ? 'true' : 'false');
            data.append('entityTypeId', editor.dataset.entityTypeId);
            data.append('entityId', editor.dataset.entityId);
            data.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            fetch('/admin/aliases/save', { method: 'POST', body: data })
                .then(function(r) { return r.json(); })
                .then(function(result) {
                    if (result.success) { location.reload(); }
                    else { alert('Error: ' + (result.errors || []).join(', ')); }
                });
        });

        editor.querySelectorAll('.btn-delete-alias').forEach(function(btn) {
            btn.addEventListener('click', function() {
                if (!confirm('Delete this alias?')) return;
                var row = this.closest('tr');
                var aliasId = row.dataset.aliasId;
                var data = new FormData();
                data.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
                fetch('/admin/aliases/delete/' + aliasId, { method: 'POST', body: data })
                    .then(function(r) { return r.json(); })
                    .then(function(result) {
                        if (result.success) { location.reload(); }
                        else { alert('Error: ' + (result.errors || []).join(', ')); }
                    });
            });
        });
    });
</script>
