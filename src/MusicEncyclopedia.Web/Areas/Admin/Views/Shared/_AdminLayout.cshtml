@inject Microsoft.AspNetCore.Identity.SignInManager<Microsoft.AspNetCore.Identity.IdentityUser> SignInManager
@inject Microsoft.AspNetCore.Identity.UserManager<Microsoft.AspNetCore.Identity.IdentityUser> UserManager

@{
    var userName = User.Identity?.Name ?? "مدیر";
    var displayName = userName;

    // Admin is Persian-only: force fa culture + RTL regardless of the request culture.
    var isRtl = true;
}

<!DOCTYPE html>
<html dir="rtl" lang="fa" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>@ViewData["Title"] - مدیریت - دایرة‌المعارف موسیقی</title>

    <!-- Fonts (self-hosted: Vazirmatn for fa/ar RTL, Inter for en/fr LTR) -->
    <link rel="stylesheet" href="~/css/fonts.css" />

    <!-- Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="~/js/tailwind-theme.js"></script>

    <!-- Shared design tokens and admin components -->
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/admin.css" />

    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-shell bg-paper-muted text-ink @(isRtl ? "rtl" : "")">
    <a href="#main-content" class="skip-link">پرش به محتوای اصلی</a>

    <!-- ============================================================
         Top Navigation Bar
         ============================================================ -->
    <header class="admin-topbar fixed top-0 start-0 end-0 z-30 h-16">
        <div class="admin-topbar__inner flex items-center justify-between h-full px-4 lg:px-6">
            <!-- Left: Brand & Mobile Menu Toggle -->
            <div class="flex items-center gap-3">
                <button id="sidebar-toggle"
                        class="lg:hidden min-w-11 min-h-11 p-2 rounded-md text-ink-muted hover:text-ink-secondary hover:bg-paper-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                        aria-label="باز/بستن منوی کناری"
                        aria-controls="sidebar"
                        aria-expanded="false"><i aria-hidden="true" class="fas fa-bars text-xl"></i></button>
                <a href="/admin" class="admin-brand flex items-center gap-2 text-lg font-bold transition-colors">
                    <i aria-hidden="true" class="admin-brand__icon fas fa-music"></i>
                    <span class="hidden sm:inline">مدیریت دایرة‌المعارف موسیقی</span>
                    <span class="sm:hidden">مدیریت</span>
                </a>
            </div>

            <!-- Right: User Info & Logout -->
            <div class="flex items-center gap-4">
                <span class="admin-user text-sm hidden md:inline">
                    <i aria-hidden="true" class="fas fa-user-circle text-ink-muted me-1"></i>
                    @displayName
                </span>
                <a href="/auth/logout"
                   class="admin-logout inline-flex items-center gap-1 px-3 py-1.5 text-sm rounded-md transition-colors"
                   aria-label="خروج"
                   title="خروج">
                    <i aria-hidden="true" class="fas fa-sign-out-alt"></i>
                    <span class="hidden sm:inline">خروج</span>
                </a>
            </div>
        </div>
    </header>

    <!-- ============================================================
         Sidebar + Main Content Wrapper
         ============================================================ -->
    <div class="flex pt-16 min-h-screen">

        <!-- Sidebar (spec 10.3) -->
        <aside id="sidebar"
               class="admin-sidebar fixed lg:static inset-y-0 start-0 z-20 text-ink-secondary transform translate-x-full lg:translate-x-0 transition-transform duration-200 ease-in-out overflow-y-auto sidebar-scroll pt-16 lg:pt-0"
               aria-hidden="true">

            <nav class="admin-sidebar__nav px-3 space-y-1 text-sm" aria-label="ناوبری مدیریت">

                <!-- Dashboard -->
                <a href="/admin"
                   class="nav-link-admin flex items-center gap-3 px-3 py-2.5 rounded-md @(ViewData["ActiveMenu"]?.ToString() == "Dashboard" ? "nav-active" : "")">
                    <i aria-hidden="true" class="fas fa-tachometer-alt w-5 text-center"></i>
                    <span>داشبورد</span>
                </a>

                <!-- Content Management -->
                <div class="admin-sidebar__section pt-4 pb-1 px-3 text-xs font-semibold uppercase tracking-wider">محتوا</div>

                @RenderNavItem("Albums", "آلبوم‌ها", "/admin/albums", "fa fa-compact-disc")
                @RenderNavItem("Tracks", "ترک‌ها", "/admin/tracks", "fa fa-music")
                @RenderNavItem("People", "اشخاص", "/admin/people", "fa fa-users")
                @RenderNavItem("Companies", "شرکت‌ها", "/admin/companies", "fa fa-building")
                @RenderNavItem("Poems", "شعرها", "/admin/poems", "fa fa-feather-alt")
                @RenderNavItem("Sung Versions", "نسخه‌های خوانده‌شده", "/admin/sung-versions", "fa fa-microphone-alt")
                @RenderNavItem("Publications", "انتشارات", "/admin/publications", "fa fa-book")
                @RenderNavItem("Genres", "سبک‌ها", "/admin/genres", "fa fa-tag")
                @RenderNavItem("Moods", "حالت‌ها", "/admin/moods", "fa fa-smile")
                @RenderNavItem("Instruments", "سازها", "/admin/instruments", "fa fa-guitar")

                <!-- Sessions & Events -->
                <div class="admin-sidebar__section pt-4 pb-1 px-3 text-xs font-semibold uppercase tracking-wider">جلسات و رویدادها</div>

                @RenderNavItem("Recording Sessions", "جلسات ضبط", "/admin/sessions", "fa fa-circle")
                @RenderNavItem("Performance Events", "رویدادهای اجرا", "/admin/events", "fa fa-calendar-alt")
                @RenderNavItem("Locations", "مکان‌ها", "/admin/locations", "fa fa-map-marker-alt")

                <!-- Awards & Charts -->
                <div class="admin-sidebar__section pt-4 pb-1 px-3 text-xs font-semibold uppercase tracking-wider">جوایز و جدول‌ها</div>

                @RenderNavItem("Awards", "جوایز", "/admin/awards", "fa fa-trophy")
                @RenderNavItem("Certifications", "گواهینامه‌ها", "/admin/certifications", "fa fa-certificate")
                @RenderNavItem("Charts", "جدول‌ها", "/admin/charts", "fa fa-chart-line")

                <!-- Media & References -->
                <div class="admin-sidebar__section pt-4 pb-1 px-3 text-xs font-semibold uppercase tracking-wider">رسانه و مراجع</div>

                @RenderNavItem("Media", "رسانه", "/admin/media", "fa fa-photo-video")
                @RenderNavItem("Sources", "منابع", "/admin/sources", "fa fa-database")
                @RenderNavItem("Citations", "ارجاع‌ها", "/admin/citations", "fa fa-quote-right")
                @RenderNavItem("Tags", "برچسب‌ها", "/admin/tags", "fa fa-hashtag")
                @RenderNavItem("Attributes", "ویژگی‌ها", "/admin/attributes", "fa fa-list-ul")
                @RenderNavItem("Localizations", "بومی‌سازی‌ها", "/admin/localizations", "fa fa-language")

                <!-- Settings -->
                <div class="admin-sidebar__section pt-4 pb-1 px-3 text-xs font-semibold uppercase tracking-wider">تنظیمات</div>

                @RenderNavItem("Lookup Tables", "جدول‌های مرجع", "/admin/lookup-tables", "fa fa-cog")
                @RenderNavItem("Users", "کاربران", "/admin/users", "fa fa-user-shield")
                @RenderNavItem("Roles", "نقش‌ها", "/admin/roles", "fa fa-shield-alt")
                @RenderNavItem("Settings", "تنظیمات", "/admin/settings", "fa fa-wrench")
                @RenderNavItem("Audit Log", "گزارش عملیات", "/admin/audit-log", "fa fa-history")
            </nav>
        </aside>

        <!-- Overlay for mobile sidebar -->
        <div id="sidebar-overlay"
             class="fixed inset-0 bg-overlay bg-opacity-50 z-10 hidden lg:hidden"
             aria-hidden="true"></div>

        <!-- ============================================================
             Main Content Area
             ============================================================ -->
        <main id="main-content" class="admin-main flex-1 overflow-x-hidden" role="main" tabindex="-1">

            <!-- Page Header -->
            <div class="admin-page-header">
                <h1 class="admin-page-title">@ViewData["Title"]</h1>
            </div>

            <!-- ============================================================
                 TempData Alerts (shared _Alerts partial)
                 ============================================================ -->
            @await Html.PartialAsync("_Alerts")

            @RenderBody()
        </main>
    </div>

    <!-- ============================================================
         Footer
         ============================================================ -->
    <footer class="admin-footer py-4 px-6 text-center text-xs">
        <p>&copy; @DateTime.Now.Year مدیریت دایرة‌المعارف موسیقی. کلیه حقوق محفوظ است.</p>
    </footer>

    <!-- ============================================================
         Scripts
         ============================================================ -->
    <script>
        // Mobile sidebar toggle
        document.addEventListener('DOMContentLoaded', function () {
            var toggle = document.getElementById('sidebar-toggle');
            var sidebar = document.getElementById('sidebar');
            var overlay = document.getElementById('sidebar-overlay');

            function openSidebar() {
                sidebar.classList.remove('translate-x-full');
                overlay.classList.remove('hidden');
                toggle.setAttribute('aria-expanded', 'true');
                sidebar.setAttribute('aria-hidden', 'false');
                sidebar.inert = false;
                document.body.style.overflow = 'hidden';
                var firstLink = sidebar.querySelector('a');
                if (firstLink) firstLink.focus();
            }
            function closeSidebar(returnFocus) {
                sidebar.classList.add('translate-x-full');
                overlay.classList.add('hidden');
                toggle.setAttribute('aria-expanded', 'false');
                sidebar.setAttribute('aria-hidden', 'true');
                sidebar.inert = true;
                document.body.style.overflow = '';
                if (returnFocus) toggle.focus();
            }

            if (toggle && sidebar && overlay) {
                var desktop = window.matchMedia('(min-width: 1024px)');
                function syncSidebarAccessibility() {
                    if (desktop.matches) {
                        sidebar.setAttribute('aria-hidden', 'false');
                        sidebar.inert = false;
                        toggle.setAttribute('aria-expanded', 'false');
                        document.body.style.overflow = '';
                    } else if (toggle.getAttribute('aria-expanded') !== 'true') {
                        sidebar.setAttribute('aria-hidden', 'true');
                        sidebar.inert = true;
                    }
                }

                toggle.addEventListener('click', function () {
                    if (sidebar.classList.contains('translate-x-full')) {
                        openSidebar();
                    } else {
                        closeSidebar(true);
                    }
                });
                overlay.addEventListener('click', function () { closeSidebar(true); });
                document.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
                        closeSidebar(true);
                    }
                    if (event.key === 'Tab' && toggle.getAttribute('aria-expanded') === 'true') {
                        var focusable = Array.from(sidebar.querySelectorAll('a, button, input, select, textarea'));
                        var first = focusable[0];
                        var last = focusable[focusable.length - 1];
                        if (event.shiftKey && document.activeElement === first) {
                            event.preventDefault();
                            last.focus();
                        } else if (!event.shiftKey && document.activeElement === last) {
                            event.preventDefault();
                            first.focus();
                        }
                    }
                });
                sidebar.querySelectorAll('a').forEach(function (link) {
                    link.addEventListener('click', function () { closeSidebar(false); });
                });
                desktop.addEventListener('change', syncSidebarAccessibility);
                syncSidebarAccessibility();
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    /// <summary>
    /// Helper to render a sidebar navigation item with active detection and icon.
    /// The <paramref name="key"/> is the stable English match key used by
    /// ViewData["ActiveMenu"]; <paramref name="label"/> is the Persian label.
    /// </summary>
    private Microsoft.AspNetCore.Html.HtmlString RenderNavItem(string key, string label, string url, string iconClass)
    {
        var isActive = string.Equals(ViewData["ActiveMenu"]?.ToString(), key, StringComparison.OrdinalIgnoreCase);
        var activeClass = isActive ? "nav-active" : "";
        var html = $"<a href=\"{url}\" class=\"nav-link-admin flex items-center gap-3 px-3 py-2.5 rounded-md {activeClass}\">" +
                   $"<i aria-hidden='true' class='{iconClass} w-5 text-center'></i>" +
                   $"<span>{label}</span>" +
                   $"</a>";
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }
}
