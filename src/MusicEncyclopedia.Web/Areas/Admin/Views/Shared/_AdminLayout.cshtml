@inject Microsoft.AspNetCore.Identity.SignInManager<Microsoft.AspNetCore.Identity.IdentityUser> SignInManager
@inject Microsoft.AspNetCore.Identity.UserManager<Microsoft.AspNetCore.Identity.IdentityUser> UserManager

@{
    var userName = User.Identity?.Name ?? "مدیر";
    var displayName = userName;

    // Admin is Persian-only: force fa culture + RTL regardless of the request culture.
    var dir = "rtl";
    var isRtl = true;
}

<!DOCTYPE html>
<html dir="rtl" lang="fa" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>@ViewData["Title"] - مدیریت - دایرة‌المعارف موسیقی</title>

    <!-- Fonts (self-hosted: Vazirmatn for fa/ar RTL, Inter for en/fr LTR) -->
    <link rel="stylesheet" href="~/css/fonts.css" />

    <!-- Admin component styles (alerts etc.) -->
    <link rel="stylesheet" href="~/css/admin.css" />

    <!-- Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            future: { hoverOnlyWhenSupported: true },
            theme: {
                extend: {
                    fontFamily: {
                        // Vazirmatn is loaded via fonts.css; Tailwind uses it for both
                        // directions here and the [dir=rtl] rules in fonts.css take over.
                        sans: ['Vazirmatn', 'Inter', 'system-ui', '-apple-system', 'sans-serif'],
                    },
                },
            },
        };
    </script>

    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    <style>
        /* Sidebar scrollbar styling */
        .sidebar-scroll::-webkit-scrollbar { width: 4px; }
        .sidebar-scroll::-webkit-scrollbar-track { background: transparent; }
        .sidebar-scroll::-webkit-scrollbar-thumb { background: #4a5568; border-radius: 2px; }
        .sidebar-scroll { scrollbar-width: thin; scrollbar-color: #4a5568 transparent; }

        /* Active nav link */
        .nav-active { background-color: rgba(59, 130, 246, 0.15); color: #3b82f6; border-inline-start: 3px solid #3b82f6; }
        .nav-link-admin { transition: all 0.15s ease; }
        .nav-link-admin:hover { background-color: rgba(255,255,255,0.05); }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-gray-100 text-gray-900 @(isRtl ? "rtl" : "")">

    <!-- ============================================================
         Top Navigation Bar
         ============================================================ -->
    <header class="fixed top-0 start-0 end-0 z-30 h-16 bg-white border-b border-gray-200 shadow-sm">
        <div class="flex items-center justify-between h-full px-4 lg:px-6">
            <!-- Left: Brand & Mobile Menu Toggle -->
            <div class="flex items-center gap-3">
                <button id="sidebar-toggle"
                        class="lg:hidden p-2 rounded-md text-gray-500 hover:text-gray-700 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                        aria-label="باز/بستن منوی کناری">
                    <i class="fas fa-bars text-xl"></i>
                </button>
                <a href="/admin" class="flex items-center gap-2 text-lg font-bold text-gray-800 hover:text-blue-600 transition-colors">
                    <i class="fas fa-music text-blue-600"></i>
                    <span class="hidden sm:inline">مدیریت دایرة‌المعارف موسیقی</span>
                    <span class="sm:hidden">مدیریت</span>
                </a>
            </div>

            <!-- Right: User Info & Logout -->
            <div class="flex items-center gap-4">
                <span class="text-sm text-gray-500 hidden md:inline">
                    <i class="fas fa-user-circle text-gray-400 me-1"></i>
                    @displayName
                </span>
                <a href="/auth/logout"
                   class="inline-flex items-center gap-1 px-3 py-1.5 text-sm text-gray-600 hover:text-red-600 hover:bg-red-50 rounded-md transition-colors"
                   title="خروج">
                    <i class="fas fa-sign-out-alt"></i>
                    <span class="hidden sm:inline">خروج</span>
                </a>
            </div>
        </div>
    </header>

    <!-- ============================================================
         Sidebar + Main Content Wrapper
         ============================================================ -->
    <div class="flex pt-16 min-h-screen">

        <!-- Sidebar (spec 10.3) -->
        <aside id="sidebar"
               class="fixed lg:static inset-y-0 start-0 z-20 w-64 bg-gray-900 text-gray-300 transform -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-in-out overflow-y-auto sidebar-scroll pt-16 lg:pt-0">

            <nav class="py-4 px-3 space-y-1 text-sm" aria-label="ناوبری مدیریت">

                <!-- Dashboard -->
                <a href="/admin"
                   class="nav-link-admin flex items-center gap-3 px-3 py-2.5 rounded-md @(ViewData["ActiveMenu"]?.ToString() == "Dashboard" ? "nav-active" : "")">
                    <i class="fas fa-tachometer-alt w-5 text-center"></i>
                    <span>داشبورد</span>
                </a>

                <!-- Content Management -->
                <div class="pt-4 pb-1 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">محتوا</div>

                @RenderNavItem("Albums", "آلبوم‌ها", "/admin/albums", "fa fa-compact-disc")
                @RenderNavItem("Tracks", "ترک‌ها", "/admin/tracks", "fa fa-music")
                @RenderNavItem("People", "اشخاص", "/admin/people", "fa fa-users")
                @RenderNavItem("Companies", "شرکت‌ها", "/admin/companies", "fa fa-building")
                @RenderNavItem("Poems", "شعرها", "/admin/poems", "fa fa-feather-alt")
                @RenderNavItem("Sung Versions", "نسخه‌های خوانده‌شده", "/admin/sung-versions", "fa fa-microphone-alt")
                @RenderNavItem("Publications", "انتشارات", "/admin/publications", "fa fa-book")
                @RenderNavItem("Genres", "سبک‌ها", "/admin/genres", "fa fa-tag")
                @RenderNavItem("Moods", "حالت‌ها", "/admin/moods", "fa fa-smile")
                @RenderNavItem("Instruments", "سازها", "/admin/instruments", "fa fa-guitar")

                <!-- Sessions & Events -->
                <div class="pt-4 pb-1 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">جلسات و رویدادها</div>

                @RenderNavItem("Recording Sessions", "جلسات ضبط", "/admin/sessions", "fa fa-circle")
                @RenderNavItem("Performance Events", "رویدادهای اجرا", "/admin/events", "fa fa-calendar-alt")
                @RenderNavItem("Locations", "مکان‌ها", "/admin/locations", "fa fa-map-marker-alt")

                <!-- Awards & Charts -->
                <div class="pt-4 pb-1 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">جوایز و جدول‌ها</div>

                @RenderNavItem("Awards", "جوایز", "/admin/awards", "fa fa-trophy")
                @RenderNavItem("Certifications", "گواهینامه‌ها", "/admin/certifications", "fa fa-certificate")
                @RenderNavItem("Charts", "جدول‌ها", "/admin/charts", "fa fa-chart-line")

                <!-- Media & References -->
                <div class="pt-4 pb-1 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">رسانه و مراجع</div>

                @RenderNavItem("Media", "رسانه", "/admin/media", "fa fa-photo-video")
                @RenderNavItem("Sources", "منابع", "/admin/sources", "fa fa-database")
                @RenderNavItem("Citations", "ارجاع‌ها", "/admin/citations", "fa fa-quote-right")
                @RenderNavItem("Tags", "برچسب‌ها", "/admin/tags", "fa fa-hashtag")
                @RenderNavItem("Attributes", "ویژگی‌ها", "/admin/attributes", "fa fa-list-ul")
                @RenderNavItem("Localizations", "بومی‌سازی‌ها", "/admin/localizations", "fa fa-language")

                <!-- Settings -->
                <div class="pt-4 pb-1 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">تنظیمات</div>

                @RenderNavItem("Lookup Tables", "جدول‌های مرجع", "/admin/lookup-tables", "fa fa-cog")
                @RenderNavItem("Users", "کاربران", "/admin/users", "fa fa-user-shield")
                @RenderNavItem("Roles", "نقش‌ها", "/admin/roles", "fa fa-shield-alt")
                @RenderNavItem("Settings", "تنظیمات", "/admin/settings", "fa fa-wrench")
                @RenderNavItem("Audit Log", "گزارش عملیات", "/admin/audit-log", "fa fa-history")
            </nav>
        </aside>

        <!-- Overlay for mobile sidebar -->
        <div id="sidebar-overlay"
             class="fixed inset-0 bg-black bg-opacity-50 z-10 hidden lg:hidden"
             aria-hidden="true"></div>

        <!-- ============================================================
             Main Content Area
             ============================================================ -->
        <main class="flex-1 p-4 lg:p-6 overflow-x-hidden" role="main">

            <!-- Page Header -->
            <div class="mb-6">
                <h1 class="text-2xl font-bold text-gray-900">@ViewData["Title"]</h1>
            </div>

            <!-- ============================================================
                 TempData Alerts (shared _Alerts partial)
                 ============================================================ -->
            @await Html.PartialAsync("_Alerts")

            @RenderBody()
        </main>
    </div>

    <!-- ============================================================
         Footer
         ============================================================ -->
    <footer class="bg-white border-t border-gray-200 py-4 px-6 text-center text-xs text-gray-500">
        <p>&copy; @DateTime.Now.Year مدیریت دایرة‌المعارف موسیقی. کلیه حقوق محفوظ است.</p>
    </footer>

    <!-- ============================================================
         Scripts
         ============================================================ -->
    <script>
        // Mobile sidebar toggle
        document.addEventListener('DOMContentLoaded', function () {
            var toggle = document.getElementById('sidebar-toggle');
            var sidebar = document.getElementById('sidebar');
            var overlay = document.getElementById('sidebar-overlay');

            function openSidebar() {
                sidebar.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            }
            function closeSidebar() {
                sidebar.classList.add('-translate-x-full');
                overlay.classList.add('hidden');
                document.body.style.overflow = '';
            }

            if (toggle && sidebar && overlay) {
                toggle.addEventListener('click', function () {
                    if (sidebar.classList.contains('-translate-x-full')) {
                        openSidebar();
                    } else {
                        closeSidebar();
                    }
                });
                overlay.addEventListener('click', closeSidebar);
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    /// <summary>
    /// Helper to render a sidebar navigation item with active detection and icon.
    /// The <paramref name="key"/> is the stable English match key used by
    /// ViewData["ActiveMenu"]; <paramref name="label"/> is the Persian label.
    /// </summary>
    private Microsoft.AspNetCore.Html.HtmlString RenderNavItem(string key, string label, string url, string iconClass)
    {
        var isActive = string.Equals(ViewData["ActiveMenu"]?.ToString(), key, StringComparison.OrdinalIgnoreCase);
        var activeClass = isActive ? "nav-active" : "";
        var html = $"<a href=\"{url}\" class=\"nav-link-admin flex items-center gap-3 px-3 py-2.5 rounded-md {activeClass}\">" +
                   $"<i class=\"{iconClass} w-5 text-center\"></i>" +
                   $"<span>{label}</span>" +
                   $"</a>";
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }
}
