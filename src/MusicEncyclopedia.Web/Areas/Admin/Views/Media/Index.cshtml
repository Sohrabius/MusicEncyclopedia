@model MediaListViewModel
@{
    ViewData["Title"] = "مدیریت رسانه";
    ViewData["ActiveMenu"] = "Media";
}

<div class="bg-surface rounded-lg shadow-sm border border-rule p-4 mb-6">
    <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between">
        <form method="get" action="/admin/media" class="flex items-center gap-2 flex-1 max-w-lg">
            <div class="relative flex-1">
                <i aria-hidden="true" class="fas fa-search absolute start-3 top-1/2 -translate-y-1/2 text-ink-muted text-sm"></i>
                <input type="text" name="q" value="@Model.SearchQuery" placeholder="جستجو رسانه‌ای files..." class="w-full ps-9 pe-3 py-2 border border-rule-strong rounded-md text-sm focus-visible:ring-2 focus-visible:ring-accent focus-visible:border-accent" />
            </div>
            <button type="submit" class="px-4 py-2 bg-accent text-on-accent text-sm rounded-md hover:bg-accent-hover transition-colors min-w-11 min-h-11 inline-flex items-center justify-center" aria-label="جستجو"><i aria-hidden="true" class="fas fa-search"></i></button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery)) { <a href="/admin/media" class="px-3 py-2 text-sm text-ink-secondary hover:text-ink"><i aria-hidden="true" class="fas fa-times"></i> پاک کردن</a> }
        </form>
        <a href="/admin/media/Upload" class="inline-flex items-center gap-2 px-4 py-2 bg-success text-on-accent text-sm rounded-md hover:bg-success-hover transition-colors"><i aria-hidden="true" class="fas fa-upload"></i> <span>بارگذاری رسانه</span></a>
    </div>

    <!-- Filter Bar -->
    <div class="flex flex-wrap items-center gap-3 mt-3 pt-3 border-t border-rule-light">
        <span class="text-xs text-ink-muted font-medium">فیلتر:</span>

        <!-- Media Type Filter -->
        <div class="flex items-center gap-1">
            <a href="/admin/media?mediaType=&q=@Model.SearchQuery"
               class="px-2 py-1 text-xs rounded @(string.IsNullOrEmpty(Model.MediaTypeFilter) ? "bg-accent-soft text-accent-hover" : "bg-paper-muted text-ink-secondary hover:bg-rule")">
                همه
            </a>
            @foreach (var mt in Model.MediaTypes)
            {
                <a href="/admin/media?mediaType=@mt.Code&q=@Model.SearchQuery"
                   class="px-2 py-1 text-xs rounded @(Model.MediaTypeFilter == mt.Code ? "bg-accent-soft text-accent-hover" : "bg-paper-muted text-ink-secondary hover:bg-rule")">
                    @mt.Name
                </a>
            }
        </div>

        <span class="text-xs text-ink-disabled">|</span>

        <!-- Assigned Entity Filter (simple) -->
        <div class="flex items-center gap-1">
            <select name="entityTypeId" id="filter-entity-type" class="px-2 py-1 text-xs border border-rule-strong rounded bg-surface">
                <option value="">نوع موجودیت</option>
                @foreach (var et in Model.EntityTypes)
                {
                    <option value="@et.EntityTypeId" selected="@(Model.AssignedEntityTypeId == et.EntityTypeId)">@et.Name</option>
                }
            </select>
            <input type="number" id="filter-entity-id" value="@Model.AssignedEntityId" placeholder="شناسه موجودیت" class="px-2 py-1 text-xs border border-rule-strong rounded w-20" />
            <button type="button" id="btn-apply-entity-filter" class="px-2 py-1 text-xs bg-accent text-on-accent rounded hover:bg-accent-hover">Go</button>
        </div>
    </div>
</div>

<div class="bg-surface rounded-lg shadow-sm border border-rule overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-paper border-b border-rule">
                <tr>
                    <th class="text-start px-4 py-3 font-medium text-ink-secondary">پیش‌نمایش</th>
                    <th class="text-start px-4 py-3 font-medium text-ink-secondary">نام فایل</th>
                    <th class="text-start px-4 py-3 font-medium text-ink-secondary">نوع</th>
                    <th class="text-end px-4 py-3 font-medium text-ink-secondary">اندازه</th>
                    <th class="text-center px-4 py-3 font-medium text-ink-secondary">ابعاد</th>
                    <th class="text-center px-4 py-3 font-medium text-ink-secondary">تخصیص‌ها</th>
                    <th class="text-end px-4 py-3 font-medium text-ink-secondary">عملیات</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-rule-light">
                @if (Model.Items.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="ui-state ui-state--empty">
                            <i aria-hidden="true" class="fas fa-photo-video text-3xl text-ink-disabled mb-2 block"></i>
                            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                            {
                                <span>هیچ فایل رسانه‌ای مطابق با "<strong>@Model.SearchQuery</strong>".</span>
                            }
                            else
                            {
                                <span>هنوز فایل رسانه‌ای وجود ندارد. <a href="/admin/media/Upload" class="text-accent hover:underline">بارگذاری کنید</a>.</span>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items.Items)
                    {
                        <tr class="hover:bg-paper transition-colors">
                            <td class="px-4 py-3">
                                @if (!string.IsNullOrEmpty(item.ThumbnailUrl150))
                                {
                                    <img src="@item.ThumbnailUrl150" alt="@item.FileName" class="w-12 h-12 object-cover rounded" />
                                }
                                else
                                {
                                    <div class="w-12 h-12 bg-paper-muted rounded flex items-center justify-center text-ink-muted">
                                        @switch (item.MediaTypeCode)
                                        {
                                            case "AUDIO": <i aria-hidden="true" class="fas fa-music text-lg"></i> break;
                                            case "VIDEO": <i aria-hidden="true" class="fas fa-video text-lg"></i> break;
                                            case "PDF":   <i aria-hidden="true" class="fas fa-file-pdf text-lg"></i> break;
                                            default:      <i aria-hidden="true" class="fas fa-file text-lg"></i> break;
                                        }
                                    </div>
                                }
                            </td>
                            <td class="px-4 py-3">
                                <a href="/admin/media/@item.MediaId/Edit" class="text-accent hover:underline font-medium text-xs">@item.FileName</a>
                            </td>
                            <td class="px-4 py-3">
                                <span class="inline-block px-2 py-0.5 text-xs rounded-full
                                    @(item.MediaTypeCode == "IMAGE" ? "bg-success-soft text-success-hover" :
                                      item.MediaTypeCode == "AUDIO" ? "bg-accent-soft text-accent-hover" :
                                      item.MediaTypeCode == "VIDEO" ? "bg-info-soft text-info-hover" :
                                      item.MediaTypeCode == "PDF" ? "bg-error-soft text-error-hover" :
                                      "bg-paper text-ink-secondary")">
                                    @item.MediaTypeName
                                </span>
                            </td>
                            <td class="px-4 py-3 text-end text-ink-muted text-xs">@item.FormattedFileSize</td>
                            <td class="px-4 py-3 text-center text-ink-muted text-xs">
                                @if (item.Width.HasValue && item.Height.HasValue)
                                {
                                    <span>@item.Width × @item.Height</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-center">
                                <span class="inline-block px-2 py-0.5 bg-paper-muted text-ink-secondary text-xs rounded-full">@item.AssignmentCount</span>
                            </td>
                            <td class="px-4 py-3 text-end">
                                <a href="/admin/media/@item.MediaId/Edit" class="inline-flex items-center gap-1 px-2 py-1 text-xs text-accent hover:bg-accent-soft rounded"><i aria-hidden="true" class="fas fa-edit"></i> ویرایش</a>
                                <form method="post" action="/admin/media/@item.MediaId/Delete" onsubmit="return confirm('Are you sure you want to delete this media file?');" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="inline-flex items-center gap-1 px-2 py-1 text-xs text-error hover:bg-error-soft rounded"><i aria-hidden="true" class="fas fa-trash-alt"></i> حذف</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.Items.TotalPages > 1)
    {
        <div class="flex items-center justify-between px-4 py-3 bg-paper border-t border-rule">
            <p class="text-sm text-ink-muted">صفحه <strong>@Model.Items.Page</strong> از <strong>@Model.Items.TotalPages</strong> (@Model.Items.TotalItems total)</p>
            <nav class="flex items-center gap-1">
                @if (Model.Items.Page > 1) { <a href="/admin/media?page=@(Model.Items.Page - 1)&q=@Model.SearchQuery&mediaType=@Model.MediaTypeFilter" class="px-3 py-1.5 text-sm text-ink-secondary hover:bg-rule rounded"><i aria-hidden="true" class="fas fa-chevron-right"></i> قبلی</a> }
                @if (Model.Items.Page < Model.Items.TotalPages) { <a href="/admin/media?page=@(Model.Items.Page + 1)&q=@Model.SearchQuery&mediaType=@Model.MediaTypeFilter" class="px-3 py-1.5 text-sm text-ink-secondary hover:bg-rule rounded">بعدی <i aria-hidden="true" class="fas fa-chevron-left"></i></a> }
            </nav>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('btn-apply-entity-filter').addEventListener('click', function () {
                var entityTypeId = document.getElementById('filter-entity-type').value;
                var entityId = document.getElementById('filter-entity-id').value;
                if (entityTypeId && entityId) {
                    window.location.href = '/admin/media?entityTypeId=' + entityTypeId + '&entityId=' + entityId + '&q=@Model.SearchQuery';
                }
            });
        });
    </script>
}
