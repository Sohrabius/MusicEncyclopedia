@model MediaListViewModel
@{
    ViewData["Title"] = "مدیریت رسانه";
    ViewData["ActiveMenu"] = "Media";
}

<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 mb-6">
    <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between">
        <form method="get" action="/admin/media" class="flex items-center gap-2 flex-1 max-w-lg">
            <div class="relative flex-1">
                <i class="fas fa-search absolute start-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" name="q" value="@Model.SearchQuery" placeholder="جستجو رسانه‌ای files..." class="w-full ps-9 pe-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
            </div>
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-md hover:bg-blue-700 transition-colors"><i class="fas fa-search"></i></button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery)) { <a href="/admin/media" class="px-3 py-2 text-sm text-gray-600 hover:text-gray-900"><i class="fas fa-times"></i> پاک کردن</a> }
        </form>
        <a href="/admin/media/Upload" class="inline-flex items-center gap-2 px-4 py-2 bg-green-600 text-white text-sm rounded-md hover:bg-green-700 transition-colors"><i class="fas fa-upload"></i> <span>بارگذاری رسانه</span></a>
    </div>

    <!-- Filter Bar -->
    <div class="flex flex-wrap items-center gap-3 mt-3 pt-3 border-t border-gray-100">
        <span class="text-xs text-gray-500 font-medium">فیلتر:</span>

        <!-- Media Type Filter -->
        <div class="flex items-center gap-1">
            <a href="/admin/media?mediaType=&q=@Model.SearchQuery"
               class="px-2 py-1 text-xs rounded @(string.IsNullOrEmpty(Model.MediaTypeFilter) ? "bg-blue-100 text-blue-700" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
                همه
            </a>
            @foreach (var mt in Model.MediaTypes)
            {
                <a href="/admin/media?mediaType=@mt.Code&q=@Model.SearchQuery"
                   class="px-2 py-1 text-xs rounded @(Model.MediaTypeFilter == mt.Code ? "bg-blue-100 text-blue-700" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
                    @mt.Name
                </a>
            }
        </div>

        <span class="text-xs text-gray-300">|</span>

        <!-- Assigned Entity Filter (simple) -->
        <div class="flex items-center gap-1">
            <select name="entityTypeId" id="filter-entity-type" class="px-2 py-1 text-xs border border-gray-300 rounded bg-white">
                <option value="">نوع موجودیت</option>
                @foreach (var et in Model.EntityTypes)
                {
                    <option value="@et.EntityTypeId" selected="@(Model.AssignedEntityTypeId == et.EntityTypeId)">@et.Name</option>
                }
            </select>
            <input type="number" id="filter-entity-id" value="@Model.AssignedEntityId" placeholder="شناسه موجودیت" class="px-2 py-1 text-xs border border-gray-300 rounded w-20" />
            <button type="button" id="btn-apply-entity-filter" class="px-2 py-1 text-xs bg-blue-600 text-white rounded hover:bg-blue-700">Go</button>
        </div>
    </div>
</div>

<div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="text-start px-4 py-3 font-medium text-gray-600">پیش‌نمایش</th>
                    <th class="text-start px-4 py-3 font-medium text-gray-600">نام فایل</th>
                    <th class="text-start px-4 py-3 font-medium text-gray-600">نوع</th>
                    <th class="text-end px-4 py-3 font-medium text-gray-600">اندازه</th>
                    <th class="text-center px-4 py-3 font-medium text-gray-600">ابعاد</th>
                    <th class="text-center px-4 py-3 font-medium text-gray-600">تخصیص‌ها</th>
                    <th class="text-end px-4 py-3 font-medium text-gray-600">عملیات</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (Model.Items.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="px-4 py-8 text-center text-gray-500">
                            <i class="fas fa-photo-video text-3xl text-gray-300 mb-2 block"></i>
                            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                            {
                                <span>هیچ فایل رسانه‌ای مطابق با "<strong>@Model.SearchQuery</strong>".</span>
                            }
                            else
                            {
                                <span>هنوز فایل رسانه‌ای وجود ندارد. <a href="/admin/media/Upload" class="text-blue-600 hover:underline">بارگذاری کنید</a>.</span>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items.Items)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-4 py-3">
                                @if (!string.IsNullOrEmpty(item.ThumbnailUrl150))
                                {
                                    <img src="@item.ThumbnailUrl150" alt="@item.FileName" class="w-12 h-12 object-cover rounded" />
                                }
                                else
                                {
                                    <div class="w-12 h-12 bg-gray-100 rounded flex items-center justify-center text-gray-400">
                                        @switch (item.MediaTypeCode)
                                        {
                                            case "AUDIO": <i class="fas fa-music text-lg"></i> break;
                                            case "VIDEO": <i class="fas fa-video text-lg"></i> break;
                                            case "PDF":   <i class="fas fa-file-pdf text-lg"></i> break;
                                            default:      <i class="fas fa-file text-lg"></i> break;
                                        }
                                    </div>
                                }
                            </td>
                            <td class="px-4 py-3">
                                <a href="/admin/media/@item.MediaId/Edit" class="text-blue-600 hover:underline font-medium text-xs">@item.FileName</a>
                            </td>
                            <td class="px-4 py-3">
                                <span class="inline-block px-2 py-0.5 text-xs rounded-full
                                    @(item.MediaTypeCode == "IMAGE" ? "bg-green-50 text-green-700" :
                                      item.MediaTypeCode == "AUDIO" ? "bg-blue-50 text-blue-700" :
                                      item.MediaTypeCode == "VIDEO" ? "bg-purple-50 text-purple-700" :
                                      item.MediaTypeCode == "PDF" ? "bg-red-50 text-red-700" :
                                      "bg-gray-50 text-gray-700")">
                                    @item.MediaTypeName
                                </span>
                            </td>
                            <td class="px-4 py-3 text-end text-gray-500 text-xs">@item.FormattedFileSize</td>
                            <td class="px-4 py-3 text-center text-gray-500 text-xs">
                                @if (item.Width.HasValue && item.Height.HasValue)
                                {
                                    <span>@item.Width × @item.Height</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-center">
                                <span class="inline-block px-2 py-0.5 bg-gray-100 text-gray-600 text-xs rounded-full">@item.AssignmentCount</span>
                            </td>
                            <td class="px-4 py-3 text-end">
                                <a href="/admin/media/@item.MediaId/Edit" class="inline-flex items-center gap-1 px-2 py-1 text-xs text-blue-600 hover:bg-blue-50 rounded"><i class="fas fa-edit"></i> ویرایش</a>
                                <form method="post" action="/admin/media/@item.MediaId/Delete" onsubmit="return confirm('Are you sure you want to delete this media file?');" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="inline-flex items-center gap-1 px-2 py-1 text-xs text-red-600 hover:bg-red-50 rounded"><i class="fas fa-trash-alt"></i> حذف</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.Items.TotalPages > 1)
    {
        <div class="flex items-center justify-between px-4 py-3 bg-gray-50 border-t border-gray-200">
            <p class="text-sm text-gray-500">صفحه <strong>@Model.Items.Page</strong> از <strong>@Model.Items.TotalPages</strong> (@Model.Items.TotalItems total)</p>
            <nav class="flex items-center gap-1">
                @if (Model.Items.Page > 1) { <a href="/admin/media?page=@(Model.Items.Page - 1)&q=@Model.SearchQuery&mediaType=@Model.MediaTypeFilter" class="px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-200 rounded"><i class="fas fa-chevron-right"></i> قبلی</a> }
                @if (Model.Items.Page < Model.Items.TotalPages) { <a href="/admin/media?page=@(Model.Items.Page + 1)&q=@Model.SearchQuery&mediaType=@Model.MediaTypeFilter" class="px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-200 rounded">بعدی <i class="fas fa-chevron-left"></i></a> }
            </nav>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('btn-apply-entity-filter').addEventListener('click', function () {
                var entityTypeId = document.getElementById('filter-entity-type').value;
                var entityId = document.getElementById('filter-entity-id').value;
                if (entityTypeId && entityId) {
                    window.location.href = '/admin/media?entityTypeId=' + entityTypeId + '&entityId=' + entityId + '&q=@Model.SearchQuery';
                }
            });
        });
    </script>
}
