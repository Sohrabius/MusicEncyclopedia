@model AdminDashboardViewModel
@{
    ViewData["Title"] = "داشبورد";
    ViewData["ActiveMenu"] = "Dashboard";
}

<!-- ============================================================
     Stats Cards Row
     ============================================================ -->
<div class="admin-stat-grid">
    <!-- Albums -->
    <div class="admin-stat-card">
        <div class="admin-stat-card__icon admin-stat-card__icon--accent">
            <i aria-hidden="true" class="fas fa-compact-disc"></i>
        </div>
        <div>
            <p class="admin-stat-card__label">آلبوم‌ها</p>
            <p class="admin-stat-card__value">@Model.AlbumCount.ToString("N0")</p>
        </div>
    </div>

    <!-- Tracks -->
    <div class="admin-stat-card">
        <div class="admin-stat-card__icon admin-stat-card__icon--teal">
            <i aria-hidden="true" class="fas fa-music"></i>
        </div>
        <div>
            <p class="admin-stat-card__label">ترک‌ها</p>
            <p class="admin-stat-card__value">@Model.TrackCount.ToString("N0")</p>
        </div>
    </div>

    <!-- People -->
    <div class="admin-stat-card">
        <div class="admin-stat-card__icon admin-stat-card__icon--teal">
            <i aria-hidden="true" class="fas fa-users"></i>
        </div>
        <div>
            <p class="admin-stat-card__label">اشخاص</p>
            <p class="admin-stat-card__value">@Model.PersonCount.ToString("N0")</p>
        </div>
    </div>

    <!-- Companies -->
    <div class="admin-stat-card">
        <div class="admin-stat-card__icon admin-stat-card__icon--amber">
            <i aria-hidden="true" class="fas fa-building"></i>
        </div>
        <div>
            <p class="admin-stat-card__label">شرکت‌ها</p>
            <p class="admin-stat-card__value">@Model.CompanyCount.ToString("N0")</p>
        </div>
    </div>

    <!-- Poems -->
    <div class="admin-stat-card">
        <div class="admin-stat-card__icon admin-stat-card__icon--error">
            <i aria-hidden="true" class="fas fa-feather-alt"></i>
        </div>
        <div>
            <p class="admin-stat-card__label">شعرها</p>
            <p class="admin-stat-card__value">@Model.PoemCount.ToString("N0")</p>
        </div>
    </div>
</div>

<!-- ============================================================
     Quick Links (Spec 10.3 — Admin Navigation)
     ============================================================ -->
<div class="admin-card admin-form-card mb-8">
    <h2 class="admin-card__title mb-4 flex items-center gap-2">
        <i aria-hidden="true" class="fas fa-link text-accent"></i> دسترسی سریع
    </h2>
    <div class="admin-quick-links">
        <a href="/admin/albums" class="admin-quick-link">
            <i aria-hidden="true" class="fas fa-compact-disc text-accent w-4 text-center"></i> آلبوم‌ها
        </a>
        <a href="/admin/tracks" class="admin-quick-link">
            <i aria-hidden="true" class="fas fa-music text-success w-4 text-center"></i> ترک‌ها
        </a>
        <a href="/admin/people" class="admin-quick-link">
            <i aria-hidden="true" class="fas fa-users text-info w-4 text-center"></i> اشخاص
        </a>
        <a href="/admin/companies" class="admin-quick-link">
            <i aria-hidden="true" class="fas fa-building text-warning w-4 text-center"></i> شرکت‌ها
        </a>
        <a href="/admin/genres" class="admin-quick-link">
            <i aria-hidden="true" class="fas fa-tag text-info w-4 text-center"></i> سبک‌ها
        </a>
        <a href="/admin/moods" class="admin-quick-link">
            <i aria-hidden="true" class="fas fa-smile text-info w-4 text-center"></i> حالت‌ها
        </a>
        <a href="/admin/instruments" class="admin-quick-link">
            <i aria-hidden="true" class="fas fa-guitar text-warning w-4 text-center"></i> سازها
        </a>
        <a href="/admin/poems" class="admin-quick-link">
            <i aria-hidden="true" class="fas fa-feather-alt text-error w-4 text-center"></i> شعرها
        </a>
        <a href="/admin/awards" class="admin-quick-link">
            <i aria-hidden="true" class="fas fa-trophy text-warning w-4 text-center"></i> جوایز
        </a>
        <a href="/admin/charts" class="admin-quick-link">
            <i aria-hidden="true" class="fas fa-chart-line text-info w-4 text-center"></i> جدول‌ها
        </a>
        <a href="/admin/citations" class="admin-quick-link">
            <i aria-hidden="true" class="fas fa-quote-right text-info w-4 text-center"></i> ارجاع‌ها
        </a>
        <a href="/admin/users" class="admin-quick-link">
            <i aria-hidden="true" class="fas fa-user-shield text-ink-muted w-4 text-center"></i> کاربران
        </a>
    </div>
</div>

<!-- ============================================================
     Recent Additions
     ============================================================ -->
<div class="admin-grid--two mb-8">
    <!-- Recent Albums -->
    <div class="admin-card admin-form-card">
        <h2 class="admin-card__title mb-4 flex items-center gap-2">
            <i aria-hidden="true" class="fas fa-compact-disc text-accent"></i> آلبوم‌های اخیر
        </h2>
        @if (Model.RecentAlbums.Count == 0)
        {
            <p class="text-sm text-ink-muted">هنوز آلبومی وجود ندارد.</p>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr class="text-left text-ink-muted border-b border-rule-light">
                            <th class="pb-2 font-medium">عنوان</th>
                            <th class="pb-2 font-medium">دسته‌بندی</th>
                            <th class="pb-2 font-medium">تاریخ انتشار</th>
                            <th class="pb-2 font-medium text-end">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var album in Model.RecentAlbums)
                        {
                            <tr class="border-b border-rule-light hover:bg-paper">
                                <td class="py-2">
                                    <a href="/admin/albums/@album.AlbumId/Edit" class="text-accent hover:underline font-medium">
                                        @album.Title
                                    </a>
                                </td>
                                <td class="py-2 text-ink-muted">@album.CategoryName</td>
                                <td class="py-2 text-ink-muted">@album.ReleaseDate?.ToString("yyyy-MM-dd")</td>
                                <td class="py-2 text-end">
                                    <a href="/admin/albums/@album.AlbumId/Edit" class="text-accent hover:text-accent-hover" title="ویرایش"><i aria-hidden="true" class="fas fa-edit"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-3 text-end">
                <a href="/admin/albums" class="text-sm text-accent hover:underline">
                    مشاهده همه آلبوم‌ها <i aria-hidden="true" class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>
        }
    </div>

    <!-- Recent Tracks -->
    <div class="admin-card admin-form-card">
        <h2 class="admin-card__title mb-4 flex items-center gap-2">
            <i aria-hidden="true" class="fas fa-music text-success"></i> ترک‌های اخیر
        </h2>
        @if (Model.RecentTracks.Count == 0)
        {
            <p class="text-sm text-ink-muted">هنوز ترکی وجود ندارد.</p>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr class="text-left text-ink-muted border-b border-rule-light">
                            <th class="pb-2 font-medium">عنوان</th>
                            <th class="pb-2 font-medium">آلبوم</th>
                            <th class="pb-2 font-medium">مدت</th>
                            <th class="pb-2 font-medium text-end">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var track in Model.RecentTracks)
                        {
                            <tr class="border-b border-rule-light hover:bg-paper">
                                <td class="py-2">
                                    <a href="/admin/tracks/@track.TrackId/Edit" class="text-accent hover:underline font-medium">
                                        @track.Title
                                    </a>
                                </td>
                                <td class="py-2 text-ink-muted">@track.AlbumTitle</td>
                                <td class="py-2 text-ink-muted">
                                    @if (track.DurationSeconds.HasValue)
                                    {
                                        var ts = TimeSpan.FromSeconds(track.DurationSeconds.Value);
                                        @string.Format("{0}:{1:D2}", (int)ts.TotalMinutes, ts.Seconds)
                                    }
                                </td>
                                <td class="py-2 text-end">
                                    <a href="/admin/tracks/@track.TrackId/Edit" class="text-accent hover:text-accent-hover" title="ویرایش"><i aria-hidden="true" class="fas fa-edit"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-3 text-end">
                <a href="/admin/tracks" class="text-sm text-accent hover:underline">
                    مشاهده همه ترک‌ها <i aria-hidden="true" class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>
        }
    </div>
</div>
