@model CompanyEditViewModel
@{
    ViewData["Title"] = $"Edit: {Model.Name}";
    ViewData["ActiveMenu"] = "Companies";
}

<form method="post" action="/admin/companies/@Model.CompanyId/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CompanyId" />
    <input type="hidden" asp-for="RowVersion" />
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-red-50 border border-red-200 text-red-800 text-sm" role="alert"></div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">اطلاعات پایه</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2">
                        <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="Name" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <span asp-validation-for="Name" class="text-xs text-red-600"></span>
                    </div>
                    <div><label asp-for="NameSort" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="NameSort" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /></div>
                    <div><label asp-for="Slug" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="Slug" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /><span asp-validation-for="Slug" class="text-xs text-red-600"></span></div>
                    <div><label asp-for="OriginalName" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="OriginalName" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /></div>
                    <div><label asp-for="EnglishName" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="EnglishName" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /></div>
                </div>
            </div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">دسته‌بندی</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div><label asp-for="CompanyTypeId" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <select asp-for="CompanyTypeId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">-- انتخاب نوع --</option>
                            @foreach (var item in Model.CompanyTypes) { <option value="@item.CompanyTypeId">@item.Name</option> }
                        </select></div>
                    <div><label asp-for="CountryId" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <select asp-for="CountryId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">-- انتخاب کشور --</option>
                            @foreach (var item in Model.Countries) { <option value="@item.CountryId">@item.Name</option> }
                        </select></div>
                </div>
            </div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">جزئیات</h2>
                <div class="space-y-4">
                    <div><label asp-for="Website" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="Website" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="https://..." /></div>
                    <div><label asp-for="History" class="block text-sm font-medium text-gray-700 mb-1"></label><textarea asp-for="History" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea></div>
                </div>
            </div>
        </div>
        <div class="space-y-6">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">عملیات</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors flex items-center justify-center gap-2"><i class="fas fa-save"></i> ذخیره تغییرات</button>
                <a href="/admin/companies" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-gray-600 bg-gray-100 rounded-md hover:bg-gray-200 transition-colors"><i class="fas fa-arrow-left me-1"></i> بازگشت به فهرست</a>
                <hr class="border-gray-200 my-3" />
                <form method="post" action="/admin/companies/@Model.CompanyId/Delete" onsubmit="return confirm('Are you sure you want to delete this company? It will be soft-deleted and can be restored later.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full px-4 py-2 text-sm text-red-600 border border-red-200 rounded-md hover:bg-red-50 transition-colors flex items-center justify-center gap-2"><i class="fas fa-trash-alt"></i> حذف شرکت</button>
                </form>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.1.0/jquery.validate.unobtrusive.min.js"></script>
}
