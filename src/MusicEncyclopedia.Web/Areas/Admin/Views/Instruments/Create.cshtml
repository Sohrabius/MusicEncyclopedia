@model InstrumentEditViewModel
@{
    ViewData["Title"] = "Create Instrument";
    ViewData["ActiveMenu"] = "Instruments";
}

<form method="post" action="/admin/instruments/Create">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-red-50 border border-red-200 text-red-800 text-sm" role="alert"></div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Basic Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2"><label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="Name" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /><span asp-validation-for="Name" class="text-xs text-red-600"></span></div>
                    <div class="md:col-span-2"><label asp-for="Slug" class="block text-sm font-medium text-gray-700 mb-1"></label><input asp-for="Slug" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" /><span asp-validation-for="Slug" class="text-xs text-red-600"></span></div>
                </div>
            </div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Classification</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div><label asp-for="InstrumentFamilyId" class="block text-sm font-medium text-gray-700 mb-1"></label><select asp-for="InstrumentFamilyId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"><option value="">-- Select Family --</option>@foreach (var item in Model.InstrumentFamilies) { <option value="@item.InstrumentFamilyId">@item.Name</option> }</select></div>
                    <div><label asp-for="CountryId" class="block text-sm font-medium text-gray-700 mb-1"></label><select asp-for="CountryId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"><option value="">-- Select Country --</option>@foreach (var item in Model.Countries) { <option value="@item.CountryId">@item.Name</option> }</select></div>
                </div>
            </div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Details</h2>
                <div class="space-y-4">
                    <div><label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-1"></label><textarea asp-for="Description" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea></div>
                    <div><label asp-for="HistoricalNotes" class="block text-sm font-medium text-gray-700 mb-1"></label><textarea asp-for="HistoricalNotes" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea></div>
                </div>
            </div>
        </div>
        <div class="space-y-6">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Publish</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors flex items-center justify-center gap-2"><i class="fas fa-save"></i> Create Instrument</button>
                <a href="/admin/instruments" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-gray-600 bg-gray-100 rounded-md hover:bg-gray-200 transition-colors">Cancel</a>
            </div>
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
