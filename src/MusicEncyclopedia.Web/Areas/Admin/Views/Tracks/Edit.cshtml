@model TrackEditViewModel
@{
    ViewData["Title"] = $"Edit: {Model.Title}";
    ViewData["ActiveMenu"] = "Tracks";
}

<form method="post" action="/admin/tracks/@Model.TrackId/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="TrackId" />
    <input type="hidden" asp-for="RowVersion" />

    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-red-50 border border-red-200 text-red-800 text-sm" role="alert"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Main Column -->
        <div class="lg:col-span-2 space-y-6">

            <!-- Basic Information -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">اطلاعات پایه</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2">
                        <label asp-for="Title" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="Title" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <span asp-validation-for="Title" class="text-xs text-red-600"></span>
                    </div>

                    <div>
                        <label asp-for="TitleSort" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="TitleSort" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    </div>

                    <div>
                        <label asp-for="Slug" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="Slug" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <span asp-validation-for="Slug" class="text-xs text-red-600"></span>
                    </div>

                    <div>
                        <label asp-for="OriginalTitle" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="OriginalTitle" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    </div>

                    <div>
                        <label asp-for="EnglishTitle" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="EnglishTitle" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    </div>
                </div>
            </div>

            <!-- Classification -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">دسته‌بندی</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="LyricsAvailabilityTypeId" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <select asp-for="LyricsAvailabilityTypeId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">-- انتخاب --</option>
                            @foreach (var item in Model.LyricsAvailabilityTypes)
                            {
                                <option value="@item.LyricsAvailabilityTypeId">@item.Name</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label asp-for="VocalStyleId" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <select asp-for="VocalStyleId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">-- انتخاب --</option>
                            @foreach (var item in Model.VocalStyles)
                            {
                                <option value="@item.VocalStyleId">@item.Name</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label asp-for="MusicalKeyId" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <select asp-for="MusicalKeyId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">-- انتخاب --</option>
                            @foreach (var item in Model.MusicalKeys)
                            {
                                <option value="@item.MusicalKeyId">@item.Name</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label asp-for="BPM" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="BPM" type="number" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <span asp-validation-for="BPM" class="text-xs text-red-600"></span>
                    </div>

                    <div class="flex items-center gap-4 pt-6">
                        <label class="inline-flex items-center gap-2 cursor-pointer">
                            <input asp-for="IsInstrumental" type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                            <span class="text-sm text-gray-700">@Html.DisplayNameFor(m => m.IsInstrumental)</span>
                        </label>
                        <label class="inline-flex items-center gap-2 cursor-pointer">
                            <input asp-for="IsExplicit" type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                            <span class="text-sm text-gray-700">@Html.DisplayNameFor(m => m.IsExplicit)</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Dates -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">تاریخ‌ها</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="ReleaseDate" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="ReleaseDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    </div>
                    <div>
                        <label asp-for="ReleaseDatePrecision" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <select asp-for="ReleaseDatePrecision" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">-- دقت --</option>
                            <option value="day">روز</option>
                            <option value="month">ماه</option>
                            <option value="year">سال</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="RecordingStartDate" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="RecordingStartDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    </div>
                    <div>
                        <label asp-for="RecordingEndDate" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="RecordingEndDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    </div>
                    <div>
                        <label asp-for="RecordingDatePrecision" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <select asp-for="RecordingDatePrecision" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">-- دقت --</option>
                            <option value="day">روز</option>
                            <option value="month">ماه</option>
                            <option value="year">سال</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Description & Details -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">توضیحات & جزئیات</h2>
                <div class="space-y-4">
                    <div>
                        <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <textarea asp-for="Description" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="DurationSeconds" class="block text-sm font-medium text-gray-700 mb-1"></label>
                            <input asp-for="DurationSeconds" type="number" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                            <span asp-validation-for="DurationSeconds" class="text-xs text-red-600"></span>
                        </div>
                        <div>
                            <label asp-for="ISRC" class="block text-sm font-medium text-gray-700 mb-1"></label>
                            <input asp-for="ISRC" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="12 characters" />
                            <span asp-validation-for="ISRC" class="text-xs text-red-600"></span>
                        </div>
                        <div class="md:col-span-2">
                            <label asp-for="CopyrightNotice" class="block text-sm font-medium text-gray-700 mb-1"></label>
                            <input asp-for="CopyrightNotice" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Related Editors Tabs (Placeholder) -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
                <div class="border-b border-gray-200">
                    <nav class="flex overflow-x-auto" aria-label="Related editors tabs">
                        <button type="button" class="tab-btn active px-4 py-3 text-sm font-medium text-blue-600 border-b-2 border-blue-600 whitespace-nowrap" data-tab="tab-album-appearances">
                            <i class="fas fa-compact-disc me-1"></i> آلبوم Appearances
                        </button>
                        <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="tab-artist-credits">
                            <i class="fas fa-users me-1"></i> Artist عوامل
                        </button>
                        <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="tab-genres">
                            <i class="fas fa-tag me-1"></i> سبک‌ها
                        </button>
                        <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="tab-moods">
                            <i class="fas fa-smile me-1"></i> حالت‌ها
                        </button>
                        <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="tab-instruments">
                            <i class="fas fa-guitar me-1"></i> سازها
                        </button>
                        <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="tab-musician-credits">
                            <i class="fas fa-user me-1"></i> Musician عوامل
                        </button>
                        <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="tab-sung-version">
                            <i class="fas fa-microphone-alt me-1"></i> Sung Version
                        </button>
                        <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="tab-original-poem">
                            <i class="fas fa-feather-alt me-1"></i> Original شعر
                        </button>
                        <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="tab-version-type">
                            <i class="fas fa-code-branch me-1"></i> Version نوع
                        </button>
                        <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="tab-related-tracks">
                            <i class="fas fa-link me-1"></i> Related ترک‌ها
                        </button>
                        <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="tab-recording-session">
                            <i class="fas fa-circle me-1"></i> Recording جلسه
                        </button>
                        <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="tab-live-performance">
                            <i class="fas fa-calendar-alt me-1"></i> Live Performance
                        </button>
                        <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="tab-aliases">
                            <i class="fas fa-tag me-1"></i> نام‌های مستعار
                        </button>
                        <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="tab-localization">
                            <i class="fas fa-language me-1"></i> بومی‌سازی
                        </button>
                        <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="tab-tags">
                            <i class="fas fa-hashtag me-1"></i> برچسب‌ها
                        </button>
                        <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="tab-links">
                            <i class="fas fa-link me-1"></i> پیوندها
                        </button>
                        <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="tab-media">
                            <i class="fas fa-photo-video me-1"></i> رسانه
                        </button>
                        <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="tab-citations">
                            <i class="fas fa-quote-right me-1"></i> ارجاع‌ها
                        </button>
                        <button type="button" class="tab-btn px-4 py-3 text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap" data-tab="tab-attributes">
                            <i class="fas fa-list-ul me-1"></i> ویژگی‌ها
                        </button>
                    </nav>
                </div>
                <div class="p-5">
                    <!-- Album Appearances -->
                    <div id="tab-album-appearances" class="tab-panel">
                        <p class="text-sm text-gray-500">
                            <i class="fas fa-compact-disc text-indigo-400 me-1"></i>
                            افزودن this track to an album from the album's
                            <a href="/admin/albums" class="text-blue-600 hover:underline">ویرایشگر فهرست ترک‌ها</a>.
                        </p>
                    </div>

                    <!-- Artist Credits -->
                    <div id="tab-artist-credits" class="tab-panel hidden">
                        <div data-editor-url="/admin/credits/@Model.EntityTypeId/@Model.TrackId"></div>
                    </div>

                    <!-- Genres -->
                    <div id="tab-genres" class="tab-panel hidden">
                        <div data-editor-url="/admin/related-items/track-genres/@Model.TrackId"></div>
                    </div>

                    <!-- Moods -->
                    <div id="tab-moods" class="tab-panel hidden">
                        <div data-editor-url="/admin/related-items/track-moods/@Model.TrackId"></div>
                    </div>

                    <!-- Instruments -->
                    <div id="tab-instruments" class="tab-panel hidden">
                        <div data-editor-url="/admin/related-items/track-instruments/@Model.TrackId"></div>
                    </div>

                    <!-- Musician Credits -->
                    <div id="tab-musician-credits" class="tab-panel hidden">
                        <div data-editor-url="/admin/credits/@Model.EntityTypeId/@Model.TrackId"></div>
                    </div>

                    <!-- Sung Version -->
                    <div id="tab-sung-version" class="tab-panel hidden">
                        <div data-editor-url="/admin/related-items/track-sung-versions/@Model.TrackId"></div>
                    </div>

                    <!-- Original Poem -->
                    <div id="tab-original-poem" class="tab-panel hidden">
                        <p class="text-sm text-gray-500">
                            <i class="fas fa-feather-alt text-pink-400 me-1"></i>
                            Associate a poem from the
                            <a href="/admin/poems" class="text-blue-600 hover:underline">شعرها</a>
                            section.
                        </p>
                    </div>

                    <!-- Version Type -->
                    <div id="tab-version-type" class="tab-panel hidden">
                        <div data-editor-url="/admin/related-items/track-version-types/@Model.TrackId"></div>
                    </div>

                    <!-- Related Tracks -->
                    <div id="tab-related-tracks" class="tab-panel hidden">
                        <div data-editor-url="/admin/related-items/track-related/@Model.TrackId"></div>
                    </div>

                    <!-- Recording Session -->
                    <div id="tab-recording-session" class="tab-panel hidden">
                        <p class="text-sm text-gray-500">
                            <i class="fas fa-circle text-emerald-400 me-1"></i>
                            پیوند sessions from the
                            <a href="/admin/sessions" class="text-blue-600 hover:underline">جلسات ضبط</a>
                            section.
                        </p>
                    </div>

                    <!-- Live Performance -->
                    <div id="tab-live-performance" class="tab-panel hidden">
                        <p class="text-sm text-gray-500">
                            <i class="fas fa-calendar-alt text-amber-400 me-1"></i>
                            پیوند رویدادی from the
                            <a href="/admin/events" class="text-blue-600 hover:underline">رویدادهای اجرا</a>
                            section.
                        </p>
                    </div>

                    <!-- Aliases -->
                    <div id="tab-aliases" class="tab-panel hidden">
                        <div data-editor-url="/admin/aliases/@Model.EntityTypeId/@Model.TrackId"></div>
                    </div>

                    <!-- Localization -->
                    <div id="tab-localization" class="tab-panel hidden">
                        <p class="text-sm text-gray-500">
                            <i class="fas fa-language text-pink-400 me-1"></i>
                            Manage localized field values from the
                            <a href="/admin/localizations" class="text-blue-600 hover:underline">بومی‌سازی‌ها</a>
                            section (EntityType Track, EntityId @Model.TrackId).
                        </p>
                    </div>

                    <!-- Tags -->
                    <div id="tab-tags" class="tab-panel hidden">
                        <p class="text-sm text-gray-500">
                            <i class="fas fa-hashtag text-violet-400 me-1"></i>
                            Attach برچسبی from the
                            <a href="/admin/tags" class="text-blue-600 hover:underline">برچسب‌ها</a>
                            section.
                        </p>
                    </div>

                    <!-- Links -->
                    <div id="tab-links" class="tab-panel hidden">
                        <p class="text-sm text-gray-500">
                            <i class="fas fa-link text-sky-400 me-1"></i>
                            Manage external پیوندی from the
                            <a href="/admin/links" class="text-blue-600 hover:underline">پیوندها</a>
                            section (EntityType Track, EntityId @Model.TrackId).
                        </p>
                    </div>

                    <!-- Media -->
                    <div id="tab-media" class="tab-panel hidden">
                        <p class="text-sm text-gray-500">
                            <i class="fas fa-photo-video text-emerald-400 me-1"></i>
                            بارگذاری and assign رسانه‌ای from the
                            <a href="/admin/media" class="text-blue-600 hover:underline">رسانه</a>
                            section.
                        </p>
                    </div>

                    <!-- Citations -->
                    <div id="tab-citations" class="tab-panel hidden">
                        <p class="text-sm text-gray-500">
                            <i class="fas fa-quote-right text-amber-400 me-1"></i>
                            افزودن ارجاعی from the
                            <a href="/admin/citations" class="text-blue-600 hover:underline">ارجاع‌ها</a>
                            section (EntityType Track, EntityId @Model.TrackId).
                        </p>
                    </div>

                    <!-- Attributes -->
                    <div id="tab-attributes" class="tab-panel hidden">
                        <div data-editor-url="/admin/attribute-values/@Model.EntityTypeId/@Model.TrackId"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">عملیات</h2>
                <div class="space-y-3">
                    <button type="submit"
                            class="w-full px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors flex items-center justify-center gap-2">
                        <i class="fas fa-save"></i> ذخیره تغییرات
                    </button>
                    <a href="/admin/tracks"
                       class="w-full block text-center px-4 py-2.5 text-sm text-gray-600 bg-gray-100 rounded-md hover:bg-gray-200 transition-colors">
                        <i class="fas fa-arrow-left me-1"></i> بازگشت به فهرست
                    </a>
                    <hr class="border-gray-200" />
                    <form method="post" action="/admin/tracks/@Model.TrackId/Delete"
                          onsubmit="return confirm('Are you sure you want to delete this track? It will be soft-deleted and can be restored later.');">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="w-full px-4 py-2 text-sm text-red-600 border border-red-200 rounded-md hover:bg-red-50 transition-colors flex items-center justify-center gap-2">
                            <i class="fas fa-trash-alt"></i> حذف ترک
                        </button>
                    </form>
                </div>
            </div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-sm font-semibold text-gray-700 mb-3">ترک اطلاعات</h2>
                <dl class="space-y-2 text-xs">
                    <div class="flex justify-between">
                        <dt class="text-gray-500">ID</dt>
                        <dd class="text-gray-900 font-mono">@Model.TrackId</dd>
                    </div>
                </dl>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.1.0/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var loadedTabs = {};

            function loadEditor(panel) {
                var holder = panel.querySelector('[data-editor-url]');
                if (!holder || holder.dataset.loaded) return;
                holder.dataset.loaded = '1';
                var url = holder.dataset.editorUrl;
                holder.innerHTML = '<p class="text-sm text-gray-400"><i class="fas fa-spinner fa-spin me-1"></i>در حال بارگذاری…</p>';
                fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) {
                        if (!r.ok) throw new Error('Failed to load editor');
                        return r.text();
                    })
                    .then(function (html) { holder.innerHTML = html; })
                    .catch(function () { holder.innerHTML = '<p class="text-sm text-red-600">بارگذاری ویرایشگر ناموفق بود.</p>'; });
            }

            var tabBtns = document.querySelectorAll('.tab-btn');
            var panels = document.querySelectorAll('.tab-panel');
            tabBtns.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    tabBtns.forEach(function (b) {
                        b.classList.remove('text-blue-600', 'border-b-2', 'border-blue-600');
                        b.classList.add('text-gray-500');
                    });
                    this.classList.remove('text-gray-500');
                    this.classList.add('text-blue-600', 'border-b-2', 'border-blue-600');
                    panels.forEach(function (p) { p.classList.add('hidden'); });
                    var targetId = this.getAttribute('data-tab');
                    var targetPanel = document.getElementById(targetId);
                    if (targetPanel) {
                        targetPanel.classList.remove('hidden');
                        loadEditor(targetPanel);
                    }
                });
            });

            panels.forEach(function (p) { if (!p.classList.contains('hidden')) loadEditor(p); });
        });
    </script>
}
