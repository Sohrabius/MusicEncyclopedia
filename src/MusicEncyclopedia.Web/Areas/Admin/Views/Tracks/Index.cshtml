@model TrackListViewModel
@{
    ViewData["Title"] = "Tracks";
    ViewData["ActiveMenu"] = "Tracks";
}

<!-- Search & Actions Bar -->
<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 mb-6">
    <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between">
        <form method="get" action="/admin/tracks" class="flex items-center gap-2 flex-1 max-w-md">
            <div class="relative flex-1">
                <i class="fas fa-search absolute start-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text"
                       name="q"
                       value="@Model.SearchQuery"
                       placeholder="Search tracks..."
                       class="w-full ps-9 pe-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
            </div>
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-md hover:bg-blue-700 transition-colors">
                <i class="fas fa-search"></i>
            </button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
            {
                <a href="/admin/tracks" class="px-3 py-2 text-sm text-gray-600 hover:text-gray-900">
                    <i class="fas fa-times"></i> Clear
                </a>
            }
        </form>

        <a href="/admin/tracks/Create"
           class="inline-flex items-center gap-2 px-4 py-2 bg-green-600 text-white text-sm rounded-md hover:bg-green-700 transition-colors">
            <i class="fas fa-plus"></i>
            <span>Create Track</span>
        </a>
    </div>
</div>

<!-- Track Table -->
<div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="text-start px-4 py-3 font-medium text-gray-600">Title</th>
                    <th class="text-start px-4 py-3 font-medium text-gray-600">Slug</th>
                    <th class="text-start px-4 py-3 font-medium text-gray-600">Album</th>
                    <th class="text-center px-4 py-3 font-medium text-gray-600">Duration</th>
                    <th class="text-center px-4 py-3 font-medium text-gray-600">Status</th>
                    <th class="text-end px-4 py-3 font-medium text-gray-600">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (Model.Items.Items.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="px-4 py-8 text-center text-gray-500">
                            <i class="fas fa-music text-3xl text-gray-300 mb-2 block"></i>
                            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                            {
                                <span>No tracks found matching "<strong>@Model.SearchQuery</strong>".</span>
                            }
                            else
                            {
                                <span>No tracks yet. <a href="/admin/tracks/Create" class="text-blue-600 hover:underline">Create one</a>.</span>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var track in Model.Items.Items)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-4 py-3">
                                <a href="/admin/tracks/@track.TrackId/Edit" class="text-blue-600 hover:underline font-medium">
                                    @track.Title
                                </a>
                                @if (!string.IsNullOrEmpty(track.OriginalTitle) && track.OriginalTitle != track.Title)
                                {
                                    <span class="text-gray-400 text-xs ms-1">(@track.OriginalTitle)</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-gray-500 font-mono text-xs">@track.Slug</td>
                            <td class="px-4 py-3 text-gray-500">@track.AlbumTitle</td>
                            <td class="px-4 py-3 text-center text-gray-500">
                                @if (track.DurationSeconds.HasValue)
                                {
                                    var mins = track.DurationSeconds.Value / 60;
                                    var secs = track.DurationSeconds.Value % 60;
                                    <span>@mins:@secs.ToString("D2")</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-center">
                                <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-green-50 text-green-700">Active</span>
                            </td>
                            <td class="px-4 py-3 text-end">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="/admin/tracks/@track.TrackId/Edit"
                                       class="inline-flex items-center gap-1 px-2 py-1 text-xs text-blue-600 hover:bg-blue-50 rounded"
                                       title="Edit">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <form method="post" action="/admin/tracks/@track.TrackId/Delete"
                                          onsubmit="return confirm('Are you sure you want to delete this track? It can be restored later.');"
                                          class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="inline-flex items-center gap-1 px-2 py-1 text-xs text-red-600 hover:bg-red-50 rounded"
                                                title="Soft delete">
                                            <i class="fas fa-trash-alt"></i> Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.Items.TotalPages > 1)
    {
        <div class="flex items-center justify-between px-4 py-3 bg-gray-50 border-t border-gray-200">
            <p class="text-sm text-gray-500">
                Showing page <strong>@Model.Items.Page</strong> of <strong>@Model.Items.TotalPages</strong>
                (@Model.Items.TotalItems total tracks)
            </p>
            <nav class="flex items-center gap-1" aria-label="Pagination">
                @if (Model.Items.Page > 1)
                {
                    <a href="/admin/tracks?page=@(Model.Items.Page - 1)&q=@Model.SearchQuery"
                       class="px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-200 rounded">
                        <i class="fas fa-chevron-right"></i> Previous
                    </a>
                }
                @if (Model.Items.Page < Model.Items.TotalPages)
                {
                    <a href="/admin/tracks?page=@(Model.Items.Page + 1)&q=@Model.SearchQuery"
                       class="px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-200 rounded">
                        Next <i class="fas fa-chevron-left"></i>
                    </a>
                }
            </nav>
        </div>
    }
</div>
