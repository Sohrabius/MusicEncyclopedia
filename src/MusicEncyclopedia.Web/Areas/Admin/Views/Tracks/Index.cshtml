@model TrackListViewModel
@{
    ViewData["Title"] = "ترک‌ها";
    ViewData["ActiveMenu"] = "Tracks";
}

<!-- Search & Actions Bar -->
<div class="bg-surface rounded-lg shadow-sm border border-rule p-4 mb-6">
    <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between">
        <form method="get" action="/admin/tracks" class="flex items-center gap-2 flex-1 max-w-md">
            <div class="relative flex-1">
                <i aria-hidden="true" class="fas fa-search absolute start-3 top-1/2 -translate-y-1/2 text-ink-muted text-sm"></i>
                <input type="text"
                       name="q"
                       value="@Model.SearchQuery"
                       placeholder="جستجوی ترک‌ها..."
                       class="w-full ps-9 pe-3 py-2 border border-rule-strong rounded-md text-sm focus-visible:ring-2 focus-visible:ring-accent focus-visible:border-accent" />
            </div>
            <button type="submit" class="px-4 py-2 bg-accent text-on-accent text-sm rounded-md hover:bg-accent-hover transition-colors min-w-11 min-h-11 inline-flex items-center justify-center" aria-label="جستجو"><i aria-hidden="true" class="fas fa-search"></i></button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
            {
                <a href="/admin/tracks" class="px-3 py-2 text-sm text-ink-secondary hover:text-ink">
                    <i aria-hidden="true" class="fas fa-times"></i> پاک کردن
                </a>
            }
        </form>

        <a href="/admin/tracks/Create"
           class="inline-flex items-center gap-2 px-4 py-2 bg-success text-on-accent text-sm rounded-md hover:bg-success-hover transition-colors">
            <i aria-hidden="true" class="fas fa-plus"></i>
            <span>ایجاد ترک</span>
        </a>
    </div>
</div>

<!-- Track Table -->
<div class="bg-surface rounded-lg shadow-sm border border-rule overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-paper border-b border-rule">
                <tr>
                    <th class="text-start px-4 py-3 font-medium text-ink-secondary">عنوان</th>
                    <th class="text-start px-4 py-3 font-medium text-ink-secondary">Slug</th>
                    <th class="text-start px-4 py-3 font-medium text-ink-secondary">آلبوم</th>
                    <th class="text-center px-4 py-3 font-medium text-ink-secondary">مدت</th>
                    <th class="text-center px-4 py-3 font-medium text-ink-secondary">وضعیت</th>
                    <th class="text-end px-4 py-3 font-medium text-ink-secondary">عملیات</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-rule-light">
                @if (Model.Items.Items.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="ui-state ui-state--empty">
                            <i aria-hidden="true" class="fas fa-music text-3xl text-ink-disabled mb-2 block"></i>
                            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                            {
                                <span>هیچ ترکی مطابق با "<strong>@Model.SearchQuery</strong>".</span>
                            }
                            else
                            {
                                <span>هنوز ترکی وجود ندارد. <a href="/admin/tracks/Create" class="text-accent hover:underline">ایجاد کنید</a>.</span>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var track in Model.Items.Items)
                    {
                        <tr class="hover:bg-paper transition-colors">
                            <td class="px-4 py-3">
                                <a href="/admin/tracks/@track.TrackId/Edit" class="text-accent hover:underline font-medium">
                                    @track.Title
                                </a>
                                @if (!string.IsNullOrEmpty(track.OriginalTitle) && track.OriginalTitle != track.Title)
                                {
                                    <span class="text-ink-muted text-xs ms-1">(@track.OriginalTitle)</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-ink-muted font-mono text-xs">@track.Slug</td>
                            <td class="px-4 py-3 text-ink-muted">@track.AlbumTitle</td>
                            <td class="px-4 py-3 text-center text-ink-muted">
                                @if (track.DurationSeconds.HasValue)
                                {
                                    var mins = track.DurationSeconds.Value / 60;
                                    var secs = track.DurationSeconds.Value % 60;
                                    <span>@mins:@secs.ToString("D2")</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-center">
                                <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-success-soft text-success-hover">فعال</span>
                            </td>
                            <td class="px-4 py-3 text-end">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="/admin/tracks/@track.TrackId/Edit"
                                       class="inline-flex items-center gap-1 px-2 py-1 text-xs text-accent hover:bg-accent-soft rounded"
                                       title="ویرایش">
                                        <i aria-hidden="true" class="fas fa-edit"></i> ویرایش
                                    </a>
                                    <form method="post" action="/admin/tracks/@track.TrackId/Delete"
                                          onsubmit="return confirm('Are you sure you want to delete this track? It can be restored later.');"
                                          class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="inline-flex items-center gap-1 px-2 py-1 text-xs text-error hover:bg-error-soft rounded"
                                                title="Soft delete">
                                            <i aria-hidden="true" class="fas fa-trash-alt"></i> حذف
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.Items.TotalPages > 1)
    {
        <div class="flex items-center justify-between px-4 py-3 bg-paper border-t border-rule">
            <p class="text-sm text-ink-muted">
                نمایش صفحه <strong>@Model.Items.Page</strong> از <strong>@Model.Items.TotalPages</strong>
                (@Model.Items.TotalItems total tracks)
            </p>
            <nav class="flex items-center gap-1" aria-label="صفحه‌بندی">
                @if (Model.Items.Page > 1)
                {
                    <a href="/admin/tracks?page=@(Model.Items.Page - 1)&q=@Model.SearchQuery"
                       class="px-3 py-1.5 text-sm text-ink-secondary hover:bg-rule rounded">
                        <i aria-hidden="true" class="fas fa-chevron-right"></i> قبلی
                    </a>
                }
                @if (Model.Items.Page < Model.Items.TotalPages)
                {
                    <a href="/admin/tracks?page=@(Model.Items.Page + 1)&q=@Model.SearchQuery"
                       class="px-3 py-1.5 text-sm text-ink-secondary hover:bg-rule rounded">
                        بعدی <i aria-hidden="true" class="fas fa-chevron-left"></i>
                    </a>
                }
            </nav>
        </div>
    }
</div>
