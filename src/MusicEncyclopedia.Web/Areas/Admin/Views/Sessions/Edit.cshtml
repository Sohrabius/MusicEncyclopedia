@model SessionEditViewModel
@{
    ViewData["Title"] = $"Edit: {Model.Slug}";
    ViewData["ActiveMenu"] = "Recording Sessions";
}

<form method="post" action="/admin/sessions/@Model.RecordingSessionId/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="RecordingSessionId" />
    <input type="hidden" asp-for="RowVersion" />
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-error-soft border border-error-border text-error-hover text-sm" role="alert"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">اطلاعات پایه</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2">
                        <label asp-for="Slug" class="form-label"></label>
                        <input asp-for="Slug" class="form-control" />
                        <span asp-validation-for="Slug" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="SessionTypeId" class="form-label"></label>
                        <select asp-for="SessionTypeId" class="form-control">
                            <option value="">-- انتخاب نوع --</option>
                            @foreach (var st in Model.SessionTypes)
                            {
                                <option value="@st.SessionTypeId">@st.Name</option>
                            }
                        </select>
                        <span asp-validation-for="SessionTypeId" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="LocationId" class="form-label"></label>
                        <select asp-for="LocationId" class="form-control">
                            <option value="">-- انتخاب مکان --</option>
                            @foreach (var loc in Model.Locations)
                            {
                                <option value="@loc.LocationId">@loc.Name</option>
                            }
                        </select>
                        <span asp-validation-for="LocationId" aria-live="polite" class="field-error"></span>
                    </div>
                </div>
            </div>

            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">تاریخ‌ها</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="StartDate" class="form-label"></label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                        <span asp-validation-for="StartDate" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="EndDate" class="form-label"></label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                        <span asp-validation-for="EndDate" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="DatePrecision" class="form-label"></label>
                        <select asp-for="DatePrecision" class="form-control">
                            <option value="">-- دقت --</option>
                            <option value="day">روز</option>
                            <option value="month">ماه</option>
                            <option value="year">سال</option>
                        </select>
                        <span asp-validation-for="DatePrecision" aria-live="polite" class="field-error"></span>
                    </div>
                </div>
            </div>

            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">یادداشت‌ها</h2>
                <div>
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" rows="5" class="form-control"></textarea>
                    <span asp-validation-for="Notes" aria-live="polite" class="field-error"></span>
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">عملیات</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-accent text-on-accent text-sm font-medium rounded-md hover:bg-accent-hover transition-colors flex items-center justify-center gap-2"><i aria-hidden="true" class="fas fa-save"></i> ذخیره تغییرات</button>
                <a href="/admin/sessions" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-ink-secondary bg-paper-muted rounded-md hover:bg-rule transition-colors"><i aria-hidden="true" class="fas fa-arrow-left me-1"></i> بازگشت به فهرست</a>
                <hr class="border-rule my-3" />
                <form method="post" action="/admin/sessions/@Model.RecordingSessionId/Delete" onsubmit="return confirm('Are you sure you want to delete this session?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full px-4 py-2 text-sm text-error border border-error-border rounded-md hover:bg-error-soft transition-colors flex items-center justify-center gap-2"><i aria-hidden="true" class="fas fa-trash-alt"></i> حذف جلسه</button>
                </form>
            </div>
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-sm font-semibold text-ink-secondary mb-2">اطلاعات جلسه</h2>
                <dl class="space-y-2 text-xs">
                    <div class="flex justify-between"><dt class="text-ink-muted">ID</dt><dd class="text-ink font-mono">@Model.RecordingSessionId</dd></div>
                </dl>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.1.0/jquery.validate.unobtrusive.min.js"></script>
}
