@model SessionListViewModel
@{
    ViewData["Title"] = "جلسات ضبط";
    ViewData["ActiveMenu"] = "Recording Sessions";
}

<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 mb-6">
    <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between">
        <form method="get" action="/admin/sessions" class="flex items-center gap-2 flex-1 max-w-md">
            <div class="relative flex-1">
                <i class="fas fa-search absolute start-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" name="q" value="@Model.SearchQuery" placeholder="جستجو sessions..." class="w-full ps-9 pe-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
            </div>
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-md hover:bg-blue-700 transition-colors"><i class="fas fa-search"></i></button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery)) { <a href="/admin/sessions" class="px-3 py-2 text-sm text-gray-600 hover:text-gray-900"><i class="fas fa-times"></i> پاک کردن</a> }
        </form>
        <a href="/admin/sessions/Create" class="inline-flex items-center gap-2 px-4 py-2 bg-green-600 text-white text-sm rounded-md hover:bg-green-700 transition-colors"><i class="fas fa-plus"></i> <span>ایجاد جلسه</span></a>
    </div>
</div>

<div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="text-start px-4 py-3 font-medium text-gray-600">Slug</th>
                    <th class="text-start px-4 py-3 font-medium text-gray-600">نوع</th>
                    <th class="text-start px-4 py-3 font-medium text-gray-600">تاریخ شروع</th>
                    <th class="text-start px-4 py-3 font-medium text-gray-600">تاریخ پایان</th>
                    <th class="text-start px-4 py-3 font-medium text-gray-600">مکان</th>
                    <th class="text-center px-4 py-3 font-medium text-gray-600">وضعیت</th>
                    <th class="text-end px-4 py-3 font-medium text-gray-600">عملیات</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (Model.Items.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="px-4 py-8 text-center text-gray-500">
                            <i class="fas fa-circle text-3xl text-gray-300 mb-2 block"></i>
                            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                            {
                                <span>هیچ جلسه‌ای مطابق با "<strong>@Model.SearchQuery</strong>".</span>
                            }
                            else
                            {
                                <span>هنوز جلسه‌ای وجود ندارد. <a href="/admin/sessions/Create" class="text-blue-600 hover:underline">ایجاد کنید</a>.</span>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var session in Model.Items.Items)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-4 py-3"><a href="/admin/sessions/@session.RecordingSessionId/Edit" class="text-blue-600 hover:underline font-medium">@session.Slug</a></td>
                            <td class="px-4 py-3">@if (!string.IsNullOrWhiteSpace(session.SessionTypeName)) { <span class="inline-block px-2 py-0.5 bg-blue-50 text-blue-700 text-xs rounded-full">@session.SessionTypeName</span> }</td>
                            <td class="px-4 py-3 text-gray-500">@session.StartDate?.ToString("yyyy-MM-dd")</td>
                            <td class="px-4 py-3 text-gray-500">@session.EndDate?.ToString("yyyy-MM-dd")</td>
                            <td class="px-4 py-3 text-gray-500">@session.LocationName</td>
                            <td class="px-4 py-3 text-center"><span class="inline-block px-2 py-0.5 text-xs rounded-full bg-green-50 text-green-700">فعال</span></td>
                            <td class="px-4 py-3 text-end">
                                <a href="/admin/sessions/@session.RecordingSessionId/Edit" class="inline-flex items-center gap-1 px-2 py-1 text-xs text-blue-600 hover:bg-blue-50 rounded"><i class="fas fa-edit"></i> ویرایش</a>
                                <form method="post" action="/admin/sessions/@session.RecordingSessionId/Delete" onsubmit="return confirm('Are you sure you want to delete this session?');" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="inline-flex items-center gap-1 px-2 py-1 text-xs text-red-600 hover:bg-red-50 rounded"><i class="fas fa-trash-alt"></i> حذف</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.Items.TotalPages > 1)
    {
        <div class="flex items-center justify-between px-4 py-3 bg-gray-50 border-t border-gray-200">
            <p class="text-sm text-gray-500">صفحه <strong>@Model.Items.Page</strong> از <strong>@Model.Items.TotalPages</strong> (@Model.Items.TotalItems total)</p>
            <nav class="flex items-center gap-1">
                @if (Model.Items.Page > 1) { <a href="/admin/sessions?page=@(Model.Items.Page - 1)&q=@Model.SearchQuery" class="px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-200 rounded"><i class="fas fa-chevron-right"></i> قبلی</a> }
                @if (Model.Items.Page < Model.Items.TotalPages) { <a href="/admin/sessions?page=@(Model.Items.Page + 1)&q=@Model.SearchQuery" class="px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-200 rounded">بعدی <i class="fas fa-chevron-left"></i></a> }
            </nav>
        </div>
    }
</div>
