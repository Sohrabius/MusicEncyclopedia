@model AuditLogListViewModel
@{
    ViewData["Title"] = "گزارش عملیات";
    ViewData["ActiveMenu"] = "Audit Log";
}

<div class="bg-surface rounded-lg shadow-sm border border-rule p-4 mb-6">
    <form method="get" action="/admin/audit-log" class="flex flex-col md:flex-row gap-3 items-end md:items-center">
        <div class="relative flex-1 max-w-md"><i aria-hidden="true" class="fas fa-search absolute start-3 top-1/2 -translate-y-1/2 text-ink-muted text-sm"></i><input type="text" name="q" value="@Model.SearchQuery" placeholder="جستجو user, action, details..." class="w-full ps-9 pe-3 py-2 border border-rule-strong rounded-md text-sm focus-visible:ring-2 focus-visible:ring-accent focus-visible:border-accent" /></div>
        <div><label class="block text-xs font-medium text-ink-muted mb-1">نوع موجودیت</label><input type="text" name="entityType" value="@Model.EntityTypeFilter" placeholder="مثلاً آلبوم" class="w-full md:w-44 px-3 py-2 border border-rule-strong rounded-md text-sm focus-visible:ring-2 focus-visible:ring-accent focus-visible:border-accent" /></div>
        <div><label class="block text-xs font-medium text-ink-muted mb-1">نتیجه</label>
            <select name="success" class="w-full md:w-36 px-3 py-2 border border-rule-strong rounded-md text-sm focus-visible:ring-2 focus-visible:ring-accent focus-visible:border-accent">
                <option value="">همه</option>
                @if (Model.SuccessFilter == true)
                {
                    <option value="true" selected>موفق</option>
                }
                else
                {
                    <option value="true">موفق</option>
                }
                @if (Model.SuccessFilter == false)
                {
                    <option value="false" selected>ناموفق</option>
                }
                else
                {
                    <option value="false">ناموفق</option>
                }
            </select>
        </div>
        <button type="submit" class="px-4 py-2 bg-accent text-on-accent text-sm rounded-md hover:bg-accent-hover transition-colors"><i aria-hidden="true" class="fas fa-filter"></i> فیلتر</button>
        @if (!string.IsNullOrWhiteSpace(Model.SearchQuery) || !string.IsNullOrWhiteSpace(Model.EntityTypeFilter) || Model.SuccessFilter.HasValue)
        {
            <a href="/admin/audit-log" class="px-3 py-2 text-sm text-ink-secondary hover:text-ink"><i aria-hidden="true" class="fas fa-times"></i> پاک کردن</a>
        }
    </form>
</div>

<div class="bg-surface rounded-lg shadow-sm border border-rule overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-paper border-b border-rule">
                <tr>
                    <th class="text-start px-4 py-3 font-medium text-ink-secondary">زمان‌بندی</th>
                    <th class="text-start px-4 py-3 font-medium text-ink-secondary">کاربر</th>
                    <th class="text-start px-4 py-3 font-medium text-ink-secondary">عملیات</th>
                    <th class="text-start px-4 py-3 font-medium text-ink-secondary">موجودیت</th>
                    <th class="text-center px-4 py-3 font-medium text-ink-secondary">نتیجه</th>
                    <th class="text-end px-4 py-3 font-medium text-ink-secondary">جزئیات</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-rule-light">
                @if (Model.Items.Items.Count == 0)
                {
                    <tr><td colspan="6" class="ui-state ui-state--empty"><i aria-hidden="true" class="fas fa-history text-3xl text-ink-disabled mb-2 block"></i>هیچ موردی در گزارش عملیات یافت نشد.</td></tr>
                }
                else
                {
                    @foreach (var item in Model.Items.Items)
                    {
                        <tr class="hover:bg-paper transition-colors">
                            <td class="px-4 py-3 whitespace-nowrap text-xs text-ink-muted">@item.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="px-4 py-3">@item.UserName</td>
                            <td class="px-4 py-3 font-mono text-xs">@item.Action</td>
                            <td class="px-4 py-3 text-xs text-ink-muted">@item.EntityType@(item.EntityId.HasValue ? $" #{item.EntityId}" : "")</td>
                            <td class="px-4 py-3 text-center">
                                @if (item.IsSuccess)
                                {
                                    <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-success-soft text-success-hover">OK</span>
                                }
                                else
                                {
                                    <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-error-soft text-error-hover">ناموفق</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-end">
                                <a href="/admin/audit-log/@item.AuditLogId" class="inline-flex items-center gap-1 px-2 py-1 text-xs text-accent hover:bg-accent-soft rounded"><i aria-hidden="true" class="fas fa-eye"></i> مشاهده</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (Model.Items.TotalPages > 1)
    {
        <div class="flex items-center justify-between px-4 py-3 bg-paper border-t border-rule">
            <p class="text-sm text-ink-muted">صفحه <strong>@Model.Items.Page</strong> از <strong>@Model.Items.TotalPages</strong> (@Model.Items.TotalItems total)</p>
            <nav class="flex items-center gap-1">
                @if (Model.Items.Page > 1) { <a href="/admin/audit-log?page=@(Model.Items.Page - 1)&q=@Model.SearchQuery&entityType=@Model.EntityTypeFilter&success=@(Model.SuccessFilter?.ToString().ToLowerInvariant())" class="px-3 py-1.5 text-sm text-ink-secondary hover:bg-rule rounded"><i aria-hidden="true" class="fas fa-chevron-right"></i> قبلی</a> }
                @if (Model.Items.Page < Model.Items.TotalPages) { <a href="/admin/audit-log?page=@(Model.Items.Page + 1)&q=@Model.SearchQuery&entityType=@Model.EntityTypeFilter&success=@(Model.SuccessFilter?.ToString().ToLowerInvariant())" class="px-3 py-1.5 text-sm text-ink-secondary hover:bg-rule rounded">بعدی <i aria-hidden="true" class="fas fa-chevron-left"></i></a> }
            </nav>
        </div>
    }
</div>
