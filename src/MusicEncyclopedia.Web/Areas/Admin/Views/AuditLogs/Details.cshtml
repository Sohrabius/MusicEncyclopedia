@model AuditLogDetailViewModel
@{
    ViewData["Title"] = $"Audit Entry #{Model.AuditLogId}";
    ViewData["ActiveMenu"] = "Audit Log";
}

<div class="max-w-3xl">
    <div class="bg-surface rounded-lg shadow-sm border border-rule overflow-hidden">
        <div class="px-5 py-4 border-b border-rule flex items-center justify-between">
            <h2 class="text-lg font-semibold text-ink">Audit Entry #@Model.AuditLogId</h2>
            <span class="inline-block px-2 py-0.5 text-xs rounded-full @(Model.IsSuccess ? "bg-success-soft text-success-hover" : "bg-error-soft text-error-hover")">@(Model.IsSuccess ? "Success" : "Failed")</span>
        </div>
        <dl class="divide-y divide-rule-light text-sm">
            <div class="px-5 py-3 grid grid-cols-3 gap-4"><dt class="text-ink-muted font-medium">زمان‌بندی</dt><dd class="col-span-2">@Model.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss 'UTC'zzz")</dd></div>
            <div class="px-5 py-3 grid grid-cols-3 gap-4"><dt class="text-ink-muted font-medium">کاربر</dt><dd class="col-span-2">@Model.UserName</dd></div>
            <div class="px-5 py-3 grid grid-cols-3 gap-4"><dt class="text-ink-muted font-medium">عملیات</dt><dd class="col-span-2 font-mono text-xs">@Model.Action</dd></div>
            <div class="px-5 py-3 grid grid-cols-3 gap-4"><dt class="text-ink-muted font-medium">موجودیت</dt><dd class="col-span-2">@(Model.EntityType is null ? "—" : $"{Model.EntityType}{(Model.EntityId.HasValue ? $" #{Model.EntityId}" : "")}")</dd></div>
            <div class="px-5 py-3 grid grid-cols-3 gap-4"><dt class="text-ink-muted font-medium">آدرس IP</dt><dd class="col-span-2 font-mono text-xs">@(Model.IpAddress ?? "—")</dd></div>
            <div class="px-5 py-3 grid grid-cols-3 gap-4"><dt class="text-ink-muted font-medium">جزئیات</dt><dd class="col-span-2">@(string.IsNullOrWhiteSpace(Model.Details) ? "—" : Model.Details)</dd></div>
        </dl>
    </div>

    <div class="mt-4">
        <a href="/admin/audit-log" class="inline-flex items-center gap-2 px-4 py-2.5 text-sm text-ink-secondary bg-paper-muted rounded-md hover:bg-rule transition-colors"><i aria-hidden="true" class="fas fa-arrow-left"></i> بازگشت به گزارش عملیات</a>
    </div>
</div>
