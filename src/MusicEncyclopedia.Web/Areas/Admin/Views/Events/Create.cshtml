@model EventEditViewModel
@{
    ViewData["Title"] = "ایجاد رویداد اجرا";
    ViewData["ActiveMenu"] = "Performance Events";
}

<form method="post" action="/admin/events/Create">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-error-soft border border-error-border text-error-hover text-sm" role="alert"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">اطلاعات پایه</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2">
                        <label asp-for="Slug" class="form-label"></label>
                        <input asp-for="Slug" class="form-control" placeholder="event-slug" />
                        <span asp-validation-for="Slug" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="EventTypeId" class="form-label"></label>
                        <select asp-for="EventTypeId" class="form-control">
                            <option value="">-- انتخاب نوع --</option>
                            @foreach (var et in Model.EventTypes)
                            {
                                <option value="@et.EventTypeId">@et.Name</option>
                            }
                        </select>
                        <span asp-validation-for="EventTypeId" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="LocationId" class="form-label"></label>
                        <select asp-for="LocationId" class="form-control">
                            <option value="">-- انتخاب محل برگزاری --</option>
                            @foreach (var loc in Model.Locations)
                            {
                                <option value="@loc.LocationId">@loc.Name</option>
                            }
                        </select>
                        <span asp-validation-for="LocationId" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="Date" class="form-label"></label>
                        <input asp-for="Date" type="datetime-local" class="form-control" />
                        <span asp-validation-for="Date" aria-live="polite" class="field-error"></span>
                    </div>
                </div>
            </div>

            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">یادداشت‌ها</h2>
                <div class="space-y-4">
                    <div>
                        <label asp-for="AudienceInfo" class="form-label"></label>
                        <textarea asp-for="AudienceInfo" rows="3" class="form-control"></textarea>
                        <span asp-validation-for="AudienceInfo" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="PerformanceNotes" class="form-label"></label>
                        <textarea asp-for="PerformanceNotes" rows="3" class="form-control"></textarea>
                        <span asp-validation-for="PerformanceNotes" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="ImprovisationNotes" class="form-label"></label>
                        <textarea asp-for="ImprovisationNotes" rows="3" class="form-control"></textarea>
                        <span asp-validation-for="ImprovisationNotes" aria-live="polite" class="field-error"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">انتشار</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-accent text-on-accent text-sm font-medium rounded-md hover:bg-accent-hover transition-colors flex items-center justify-center gap-2"><i aria-hidden="true" class="fas fa-save"></i> ایجاد رویداد</button>
                <a href="/admin/events" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-ink-secondary bg-paper-muted rounded-md hover:bg-rule transition-colors">انصراف</a>
            </div>
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
