@model EventEditViewModel
@{
    ViewData["Title"] = "Create Performance Event";
    ViewData["ActiveMenu"] = "Performance Events";
}

<form method="post" action="/admin/events/Create">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-red-50 border border-red-200 text-red-800 text-sm" role="alert"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Basic Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2">
                        <label asp-for="Slug" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="Slug" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="event-slug" />
                        <span asp-validation-for="Slug" class="text-xs text-red-600"></span>
                    </div>
                    <div>
                        <label asp-for="EventTypeId" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <select asp-for="EventTypeId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">-- Select Type --</option>
                            @foreach (var et in Model.EventTypes)
                            {
                                <option value="@et.EventTypeId">@et.Name</option>
                            }
                        </select>
                        <span asp-validation-for="EventTypeId" class="text-xs text-red-600"></span>
                    </div>
                    <div>
                        <label asp-for="LocationId" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <select asp-for="LocationId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">-- Select Venue --</option>
                            @foreach (var loc in Model.Locations)
                            {
                                <option value="@loc.LocationId">@loc.Name</option>
                            }
                        </select>
                        <span asp-validation-for="LocationId" class="text-xs text-red-600"></span>
                    </div>
                    <div>
                        <label asp-for="Date" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="Date" type="datetime-local" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <span asp-validation-for="Date" class="text-xs text-red-600"></span>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Notes</h2>
                <div class="space-y-4">
                    <div>
                        <label asp-for="AudienceInfo" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <textarea asp-for="AudienceInfo" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
                        <span asp-validation-for="AudienceInfo" class="text-xs text-red-600"></span>
                    </div>
                    <div>
                        <label asp-for="PerformanceNotes" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <textarea asp-for="PerformanceNotes" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
                        <span asp-validation-for="PerformanceNotes" class="text-xs text-red-600"></span>
                    </div>
                    <div>
                        <label asp-for="ImprovisationNotes" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <textarea asp-for="ImprovisationNotes" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
                        <span asp-validation-for="ImprovisationNotes" class="text-xs text-red-600"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Publish</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors flex items-center justify-center gap-2"><i class="fas fa-save"></i> Create Event</button>
                <a href="/admin/events" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-gray-600 bg-gray-100 rounded-md hover:bg-gray-200 transition-colors">Cancel</a>
            </div>
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
