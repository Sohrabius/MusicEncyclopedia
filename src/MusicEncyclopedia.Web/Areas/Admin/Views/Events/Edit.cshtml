@model EventEditViewModel
@{
    ViewData["Title"] = $"Edit: {Model.Slug}";
    ViewData["ActiveMenu"] = "Performance Events";
}

<form method="post" action="/admin/events/@Model.PerformanceEventId/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="PerformanceEventId" />
    <input type="hidden" asp-for="RowVersion" />
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-error-soft border border-error-border text-error-hover text-sm" role="alert"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">اطلاعات پایه</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="md:col-span-2">
                        <label asp-for="Slug" class="form-label"></label>
                        <input asp-for="Slug" class="form-control" />
                        <span asp-validation-for="Slug" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="EventTypeId" class="form-label"></label>
                        <select asp-for="EventTypeId" class="form-control">
                            <option value="">-- انتخاب نوع --</option>
                            @foreach (var et in Model.EventTypes) { <option value="@et.EventTypeId">@et.Name</option> }
                        </select>
                        <span asp-validation-for="EventTypeId" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="LocationId" class="form-label"></label>
                        <select asp-for="LocationId" class="form-control">
                            <option value="">-- انتخاب محل برگزاری --</option>
                            @foreach (var loc in Model.Locations) { <option value="@loc.LocationId">@loc.Name</option> }
                        </select>
                        <span asp-validation-for="LocationId" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="Date" class="form-label"></label>
                        <input asp-for="Date" type="datetime-local" class="form-control" />
                        <span asp-validation-for="Date" aria-live="polite" class="field-error"></span>
                    </div>
                </div>
            </div>

            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">یادداشت‌ها</h2>
                <div class="space-y-4">
                    <div>
                        <label asp-for="AudienceInfo" class="form-label"></label>
                        <textarea asp-for="AudienceInfo" rows="3" class="form-control"></textarea>
                        <span asp-validation-for="AudienceInfo" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="PerformanceNotes" class="form-label"></label>
                        <textarea asp-for="PerformanceNotes" rows="3" class="form-control"></textarea>
                        <span asp-validation-for="PerformanceNotes" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="ImprovisationNotes" class="form-label"></label>
                        <textarea asp-for="ImprovisationNotes" rows="3" class="form-control"></textarea>
                        <span asp-validation-for="ImprovisationNotes" aria-live="polite" class="field-error"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">عملیات</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-accent text-on-accent text-sm font-medium rounded-md hover:bg-accent-hover transition-colors flex items-center justify-center gap-2"><i aria-hidden="true" class="fas fa-save"></i> ذخیره تغییرات</button>
                <a href="/admin/events" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-ink-secondary bg-paper-muted rounded-md hover:bg-rule transition-colors"><i aria-hidden="true" class="fas fa-arrow-left me-1"></i> بازگشت به فهرست</a>
                <hr class="border-rule my-3" />
                <form method="post" action="/admin/events/@Model.PerformanceEventId/Delete" onsubmit="return confirm('Are you sure you want to delete this event?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full px-4 py-2 text-sm text-error border border-error-border rounded-md hover:bg-error-soft transition-colors flex items-center justify-center gap-2"><i aria-hidden="true" class="fas fa-trash-alt"></i> حذف رویداد</button>
                </form>
            </div>
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-sm font-semibold text-ink-secondary mb-2">اطلاعات رویداد</h2>
                <dl class="space-y-2 text-xs">
                    <div class="flex justify-between"><dt class="text-ink-muted">ID</dt><dd class="text-ink font-mono">@Model.PerformanceEventId</dd></div>
                </dl>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.1.0/jquery.validate.unobtrusive.min.js"></script>
}
