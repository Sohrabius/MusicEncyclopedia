@model UserListViewModel
@{
    ViewData["Title"] = "کاربران";
    ViewData["ActiveMenu"] = "Users";
}

<div class="bg-surface rounded-lg shadow-sm border border-rule p-4 mb-6">
    <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between">
        <form method="get" action="/admin/users" class="flex items-center gap-2 flex-1 max-w-md">
            <div class="relative flex-1"><i aria-hidden="true" class="fas fa-search absolute start-3 top-1/2 -translate-y-1/2 text-ink-muted text-sm"></i><input type="text" name="q" value="@Model.SearchQuery" placeholder="جستجو by email..." class="w-full ps-9 pe-3 py-2 border border-rule-strong rounded-md text-sm focus-visible:ring-2 focus-visible:ring-accent focus-visible:border-accent" /></div>
            <button type="submit" class="px-4 py-2 bg-accent text-on-accent text-sm rounded-md hover:bg-accent-hover transition-colors min-w-11 min-h-11 inline-flex items-center justify-center" aria-label="جستجو"><i aria-hidden="true" class="fas fa-search"></i></button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery)) { <a href="/admin/users" class="px-3 py-2 text-sm text-ink-secondary hover:text-ink"><i aria-hidden="true" class="fas fa-times"></i> پاک کردن</a> }
        </form>
        <a href="/admin/roles" class="inline-flex items-center gap-2 px-4 py-2 bg-ink-secondary text-on-accent text-sm rounded-md hover:bg-ink-secondary transition-colors"><i aria-hidden="true" class="fas fa-shield-alt"></i> <span>مدیریت نقش‌ها</span></a>
    </div>
</div>

<div class="bg-surface rounded-lg shadow-sm border border-rule overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-paper border-b border-rule">
                <tr>
                    <th class="text-start px-4 py-3 font-medium text-ink-secondary">ایمیل</th>
                    <th class="text-start px-4 py-3 font-medium text-ink-secondary">نقش‌ها</th>
                    <th class="text-center px-4 py-3 font-medium text-ink-secondary">دسترسی‌ها</th>
                    <th class="text-center px-4 py-3 font-medium text-ink-secondary">وضعیت</th>
                    <th class="text-end px-4 py-3 font-medium text-ink-secondary">عملیات</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-rule-light">
                @if (Model.Items.Items.Count == 0)
                {
                    <tr><td colspan="5" class="ui-state ui-state--empty"><i aria-hidden="true" class="fas fa-users text-3xl text-ink-disabled mb-2 block"></i>هیچ کاربری یافت نشد.</td></tr>
                }
                else
                {
                    @foreach (var item in Model.Items.Items)
                    {
                        <tr class="hover:bg-paper transition-colors">
                            <td class="px-4 py-3">
                                <a href="/admin/users/@item.Id/Edit" class="text-accent hover:underline font-medium">@item.Email</a>
                                @if (!item.EmailConfirmed) { <span class="ms-2 inline-block px-2 py-0.5 text-xs rounded-full bg-warning-soft text-warning-hover" title="ایمیل تأیید نشده">تأییدنشده</span> }
                            </td>
                            <td class="px-4 py-3">
                                @if (item.Roles.Count == 0)
                                {
                                    <span class="text-ink-muted text-xs">بدون نقش</span>
                                }
                                else
                                {
                                    @foreach (var role in item.Roles)
                                    {
                                        <span class="inline-block me-1 mb-1 px-2 py-0.5 text-xs rounded-full bg-accent-soft text-accent-hover">@role</span>
                                    }
                                }
                            </td>
                            <td class="px-4 py-3 text-center">
                                @if (item.PermissionCount > 0)
                                {
                                    <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-success-soft text-success-hover">@item.PermissionCount direct</span>
                                }
                                else
                                {
                                    <span class="text-ink-muted text-xs">0</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-center">
                                @if (item.IsLockedOut)
                                {
                                    <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-error-soft text-error-hover">قفل‌شده</span>
                                }
                                else
                                {
                                    <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-success-soft text-success-hover">فعال</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-end">
                                <a href="/admin/users/@item.Id/Edit" class="inline-flex items-center gap-1 px-2 py-1 text-xs text-accent hover:bg-accent-soft rounded"><i aria-hidden="true" class="fas fa-edit"></i> ویرایش</a>
                                <form method="post" action="/admin/users/@item.Id/Delete" onsubmit="return confirm('Are you sure you want to delete this user?');" class="inline">@Html.AntiForgeryToken()<button type="submit" class="inline-flex items-center gap-1 px-2 py-1 text-xs text-error hover:bg-error-soft rounded"><i aria-hidden="true" class="fas fa-trash-alt"></i> حذف</button></form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (Model.Items.TotalPages > 1)
    {
        <div class="flex items-center justify-between px-4 py-3 bg-paper border-t border-rule">
            <p class="text-sm text-ink-muted">صفحه <strong>@Model.Items.Page</strong> از <strong>@Model.Items.TotalPages</strong> (@Model.Items.TotalItems total)</p>
            <nav class="flex items-center gap-1">
                @if (Model.Items.Page > 1) { <a href="/admin/users?page=@(Model.Items.Page - 1)&q=@Model.SearchQuery" class="px-3 py-1.5 text-sm text-ink-secondary hover:bg-rule rounded"><i aria-hidden="true" class="fas fa-chevron-right"></i> قبلی</a> }
                @if (Model.Items.Page < Model.Items.TotalPages) { <a href="/admin/users?page=@(Model.Items.Page + 1)&q=@Model.SearchQuery" class="px-3 py-1.5 text-sm text-ink-secondary hover:bg-rule rounded">بعدی <i aria-hidden="true" class="fas fa-chevron-left"></i></a> }
            </nav>
        </div>
    }
</div>
