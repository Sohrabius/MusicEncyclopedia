@model AlbumListViewModel
@{
    ViewData["Title"] = "آلبوم‌ها";
    ViewData["ActiveMenu"] = "Albums";
}

<!-- ============================================================
     Search & Actions Bar (spec 10.4)
     ============================================================ -->
<div class="admin-toolbar">
    <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between">
        <!-- Search Form -->
        <form method="get" action="/admin/albums" class="flex items-center gap-2 flex-1 max-w-md">
            <div class="relative flex-1">
                <i aria-hidden="true" class="fas fa-search absolute start-3 top-1/2 -translate-y-1/2 text-ink-muted text-sm"></i>
                <input type="text"
                       name="q"
                       value="@Model.SearchQuery"
                       placeholder="جستجوی آلبوم‌ها..."
                       class="w-full ps-9 pe-3 py-2 border border-rule-strong rounded-md text-sm focus-visible:ring-2 focus-visible:ring-accent focus-visible:border-accent" />
            </div>
            <button type="submit" class="px-4 py-2 bg-accent text-on-accent text-sm rounded-md hover:bg-accent-hover transition-colors min-w-11 min-h-11 inline-flex items-center justify-center" aria-label="جستجو"><i aria-hidden="true" class="fas fa-search"></i></button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
            {
                <a href="/admin/albums" class="px-3 py-2 text-sm text-ink-secondary hover:text-ink">
                    <i aria-hidden="true" class="fas fa-times"></i> پاک کردن
                </a>
            }
        </form>

        <div class="flex items-center gap-2">
            @if (Model.Deleted)
            {
                <a href="/admin/albums"
                   class="inline-flex items-center gap-2 px-4 py-2 bg-surface border border-rule-strong text-ink-secondary text-sm rounded-md hover:bg-paper transition-colors">
                    <i aria-hidden="true" class="fas fa-list"></i>
                    <span>آلبوم‌های فعال</span>
                </a>
            }
            else
            {
                <a href="/admin/albums?deleted=true"
                   class="inline-flex items-center gap-2 px-4 py-2 bg-surface border border-rule-strong text-ink-secondary text-sm rounded-md hover:bg-paper transition-colors">
                    <i aria-hidden="true" class="fas fa-trash-restore"></i>
                    <span>آلبوم‌های حذف‌شده</span>
                </a>
            }
            <a href="/admin/albums/wizard"
               class="inline-flex items-center gap-2 px-4 py-2 bg-accent text-on-accent text-sm rounded-md hover:bg-accent-hover transition-colors">
                <i aria-hidden="true" class="fas fa-wand-magic-sparkles"></i>
                <span>ایجاد با ویزارد</span>
            </a>
            <a href="/admin/albums/Create"
               class="inline-flex items-center gap-2 px-4 py-2 bg-success text-on-accent text-sm rounded-md hover:bg-success-hover transition-colors">
                <i aria-hidden="true" class="fas fa-plus"></i>
                <span>ایجاد آلبوم</span>
            </a>
        </div>
    </div>
</div>

<!-- ============================================================
     Album Table (spec 10.4)
     ============================================================ -->
<div class="admin-table-wrap">
    <div class="overflow-x-auto">
        <table class="admin-table">
            <thead class="bg-paper border-b border-rule">
                <tr>
                    <th class="text-center px-4 py-3 font-medium text-ink-secondary"><input type="checkbox" id="select-all" class="rounded border-rule-strong text-accent focus-visible:ring-accent" title="انتخاب همه در صفحه" /></th>
                    <th class="text-start px-4 py-3 font-medium text-ink-secondary">عنوان</th>
                    <th class="text-start px-4 py-3 font-medium text-ink-secondary">Slug</th>
                    <th class="text-start px-4 py-3 font-medium text-ink-secondary">دسته‌بندی</th>
                    <th class="text-start px-4 py-3 font-medium text-ink-secondary">تاریخ انتشار</th>
                    <th class="text-center px-4 py-3 font-medium text-ink-secondary">وضعیت</th>
                    <th class="text-end px-4 py-3 font-medium text-ink-secondary">عملیات</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-rule-light">
                @if (Model.Items.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="ui-state ui-state--empty">
                            <i aria-hidden="true" class="fas fa-compact-disc text-3xl text-ink-disabled mb-2 block"></i>
                            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                            {
                                <span>هیچ آلبومی مطابق با "<strong>@Model.SearchQuery</strong>".</span>
                            }
                            else
                            {
                                <span>هنوز آلبومی وجود ندارد. <a href="/admin/albums/Create" class="text-accent hover:underline">ایجاد کنید</a>.</span>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var album in Model.Items.Items)
                    {
                        <tr class="hover:bg-paper transition-colors">
                            <td class="px-4 py-3 text-center">
                                <input type="checkbox" name="row-checkbox" value="@album.AlbumId" class="row-checkbox rounded border-rule-strong text-accent focus-visible:ring-accent" />
                            </td>
                            <td class="px-4 py-3">
                                <a href="/admin/albums/@album.AlbumId/Edit" class="text-accent hover:underline font-medium">
                                    @album.Title
                                </a>
                                @if (!string.IsNullOrEmpty(album.OriginalTitle) && album.OriginalTitle != album.Title)
                                {
                                    <span class="text-ink-muted text-xs ms-1">(@album.OriginalTitle)</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-ink-muted font-mono text-xs">@album.Slug</td>
                            <td class="px-4 py-3">
                                @if (!string.IsNullOrEmpty(album.CategoryName))
                                {
                                    <span class="inline-block px-2 py-0.5 bg-accent-soft text-accent-hover text-xs rounded-full">@album.CategoryName</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-ink-muted">@album.ReleaseDate?.ToString("yyyy-MM-dd")</td>
                            <td class="px-4 py-3 text-center">
                                @if (album.IsDeleted)
                                {
                                    <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-error-soft text-error-hover">حذف‌شده</span>
                                }
                                else
                                {
                                    <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-success-soft text-success-hover">فعال</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-end">
                                <div class="flex items-center justify-end gap-2">
                                    @if (album.IsDeleted)
                                    {
                                        <form method="post" action="/admin/albums/@album.AlbumId/Restore" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="inline-flex items-center gap-1 px-2 py-1 text-xs text-success hover:bg-success-soft rounded"
                                                    title="بازیابی">
                                                <i aria-hidden="true" class="fas fa-undo"></i> بازیابی
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a href="/admin/albums/@album.AlbumId/Edit"
                                           class="inline-flex items-center gap-1 px-2 py-1 text-xs text-accent hover:bg-accent-soft rounded"
                                           title="ویرایش">
                                            <i aria-hidden="true" class="fas fa-edit"></i> ویرایش
                                        </a>
                                        <form method="post" action="/admin/albums/@album.AlbumId/Delete"
                                              onsubmit="return confirm('Are you sure you want to delete this album? It can be restored later.');"
                                              class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="inline-flex items-center gap-1 px-2 py-1 text-xs text-error hover:bg-error-soft rounded"
                                                    title="Soft delete">
                                                <i aria-hidden="true" class="fas fa-trash-alt"></i> حذف
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- ============================================================
         Pagination (spec 10.4)
         ============================================================ -->
    @if (Model.Items.TotalPages > 1)
    {
        <div class="admin-pagination">
            <p class="text-sm text-ink-muted">
                نمایش صفحه <strong>@Model.Items.Page</strong> از <strong>@Model.Items.TotalPages</strong>
                (@Model.Items.TotalItems total albums)
            </p>
            <nav class="flex items-center gap-1" aria-label="صفحه‌بندی">
                @if (Model.Items.Page > 1)
                {
                    <a href="/admin/albums?page=@(Model.Items.Page - 1)&q=@Model.SearchQuery"
                       class="admin-pagination__link">
                        <i aria-hidden="true" class="fas fa-chevron-right"></i> قبلی
                    </a>
                }
                @if (Model.Items.Page < Model.Items.TotalPages)
                {
                    <a href="/admin/albums?page=@(Model.Items.Page + 1)&q=@Model.SearchQuery"
                       class="admin-pagination__link">
                        بعدی <i aria-hidden="true" class="fas fa-chevron-left"></i>
                    </a>
                }
            </nav>
    </div>
}

@section Scripts {
    <script>
        (function () {
            const selectAll = document.getElementById('select-all');
            const checkboxes = Array.from(document.querySelectorAll('.row-checkbox'));
            const bulkSubmit = document.getElementById('bulk-submit');
            const bulkCount = document.getElementById('bulk-count');

            if (!selectAll || !bulkSubmit) { return; }

            function update() {
                const checked = checkboxes.filter(c => c.checked);
                bulkCount.textContent = checked.length + ' selected';
                bulkSubmit.disabled = checked.length === 0;
                bulkSubmit.className = checked.length === 0
                    ? 'inline-flex items-center gap-2 px-3 py-1.5 text-xs bg-rule text-ink-muted rounded cursor-not-allowed transition-colors'
                    : 'inline-flex items-center gap-2 px-3 py-1.5 text-xs bg-error text-on-accent rounded hover:bg-error-hover transition-colors';
                selectAll.checked = checkboxes.length > 0 && checked.length === checkboxes.length;
                selectAll.indeterminate = checked.length > 0 && checked.length < checkboxes.length;
            }

            selectAll.addEventListener('change', function () {
                checkboxes.forEach(c => { c.checked = selectAll.checked; });
                update();
            });

            checkboxes.forEach(c => c.addEventListener('change', update));

            // Keep the bulk form's hidden inputs in sync with the selection.
            const bulkForm = document.getElementById('bulk-form');
            if (bulkForm) {
                bulkForm.addEventListener('submit', function (e) {
                    const checked = checkboxes.filter(c => c.checked).map(c => c.value);
                    if (checked.length === 0) { e.preventDefault(); return; }
                    // Keep only the selected ids as form fields.
                    checkboxes.forEach(c => c.removeAttribute('name'));
                    // Re-attach only the selected ids as form fields.
                    document.querySelectorAll('#bulk-form input[name="ids"]').forEach(i => i.remove());
                    checked.forEach(id => {
                        const input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'ids';
                        input.value = id;
                        bulkForm.appendChild(input);
                    });
                });
            }
        })();
    </script>
}
</div>

<!-- ============================================================
     Bulk Actions (spec 10.4)
     ============================================================ -->
@if (Model.Items.Items.Count > 0)
{
    <form id="bulk-form" method="post"
          action="@(Model.Deleted ? "/admin/albums/bulk-restore" : "/admin/albums/bulk-delete")"
          onsubmit="return confirm('@(Model.Deleted ? "Restore" : "Delete") the selected album(s)?');">
        @Html.AntiForgeryToken()
        <div class="admin-card admin-form-card mt-4">
            <h3 class="text-sm font-semibold text-ink-secondary mb-2">
                <i aria-hidden="true" class="fas fa-layer-group me-1 text-accent"></i> عملیات گروهی
            </h3>
            <div class="flex flex-wrap items-center gap-3">
                <span id="bulk-count" class="text-xs text-ink-muted">0 انتخاب‌شده</span>
                <button id="bulk-submit" type="submit" disabled
                        class="inline-flex items-center gap-2 px-3 py-1.5 text-xs bg-rule text-ink-muted rounded cursor-not-allowed transition-colors">
                    <i aria-hidden="true" class="fas @(Model.Deleted ? "fa-undo" : "fa-trash-alt")"></i>
                    @(Model.Deleted ? "Bulk Restore" : "Bulk Soft Delete")
                </button>
            </div>
        </div>
    </form>
}
