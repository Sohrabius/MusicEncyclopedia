@model AlbumListViewModel
@{
    ViewData["Title"] = "آلبوم‌ها";
    ViewData["ActiveMenu"] = "Albums";
}

<!-- ============================================================
     Search & Actions Bar (spec 10.4)
     ============================================================ -->
<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 mb-6">
    <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between">
        <!-- Search Form -->
        <form method="get" action="/admin/albums" class="flex items-center gap-2 flex-1 max-w-md">
            <div class="relative flex-1">
                <i class="fas fa-search absolute start-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text"
                       name="q"
                       value="@Model.SearchQuery"
                       placeholder="جستجوی آلبوم‌ها..."
                       class="w-full ps-9 pe-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
            </div>
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-md hover:bg-blue-700 transition-colors">
                <i class="fas fa-search"></i>
            </button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
            {
                <a href="/admin/albums" class="px-3 py-2 text-sm text-gray-600 hover:text-gray-900">
                    <i class="fas fa-times"></i> پاک کردن
                </a>
            }
        </form>

        <div class="flex items-center gap-2">
            @if (Model.Deleted)
            {
                <a href="/admin/albums"
                   class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 text-gray-700 text-sm rounded-md hover:bg-gray-50 transition-colors">
                    <i class="fas fa-list"></i>
                    <span>آلبوم‌های فعال</span>
                </a>
            }
            else
            {
                <a href="/admin/albums?deleted=true"
                   class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 text-gray-700 text-sm rounded-md hover:bg-gray-50 transition-colors">
                    <i class="fas fa-trash-restore"></i>
                    <span>آلبوم‌های حذف‌شده</span>
                </a>
            }
            <a href="/admin/albums/wizard"
               class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm rounded-md hover:bg-blue-700 transition-colors">
                <i class="fas fa-wand-magic-sparkles"></i>
                <span>ایجاد با ویزارد</span>
            </a>
            <a href="/admin/albums/Create"
               class="inline-flex items-center gap-2 px-4 py-2 bg-green-600 text-white text-sm rounded-md hover:bg-green-700 transition-colors">
                <i class="fas fa-plus"></i>
                <span>ایجاد آلبوم</span>
            </a>
        </div>
    </div>
</div>

<!-- ============================================================
     Album Table (spec 10.4)
     ============================================================ -->
<div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="text-center px-4 py-3 font-medium text-gray-600"><input type="checkbox" id="select-all" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" title="انتخاب همه در صفحه" /></th>
                    <th class="text-start px-4 py-3 font-medium text-gray-600">عنوان</th>
                    <th class="text-start px-4 py-3 font-medium text-gray-600">Slug</th>
                    <th class="text-start px-4 py-3 font-medium text-gray-600">دسته‌بندی</th>
                    <th class="text-start px-4 py-3 font-medium text-gray-600">تاریخ انتشار</th>
                    <th class="text-center px-4 py-3 font-medium text-gray-600">وضعیت</th>
                    <th class="text-end px-4 py-3 font-medium text-gray-600">عملیات</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (Model.Items.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="px-4 py-8 text-center text-gray-500">
                            <i class="fas fa-compact-disc text-3xl text-gray-300 mb-2 block"></i>
                            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                            {
                                <span>هیچ آلبومی مطابق با "<strong>@Model.SearchQuery</strong>".</span>
                            }
                            else
                            {
                                <span>هنوز آلبومی وجود ندارد. <a href="/admin/albums/Create" class="text-blue-600 hover:underline">ایجاد کنید</a>.</span>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var album in Model.Items.Items)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-4 py-3 text-center">
                                <input type="checkbox" name="row-checkbox" value="@album.AlbumId" class="row-checkbox rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                            </td>
                            <td class="px-4 py-3">
                                <a href="/admin/albums/@album.AlbumId/Edit" class="text-blue-600 hover:underline font-medium">
                                    @album.Title
                                </a>
                                @if (!string.IsNullOrEmpty(album.OriginalTitle) && album.OriginalTitle != album.Title)
                                {
                                    <span class="text-gray-400 text-xs ms-1">(@album.OriginalTitle)</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-gray-500 font-mono text-xs">@album.Slug</td>
                            <td class="px-4 py-3">
                                @if (!string.IsNullOrEmpty(album.CategoryName))
                                {
                                    <span class="inline-block px-2 py-0.5 bg-blue-50 text-blue-700 text-xs rounded-full">@album.CategoryName</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-gray-500">@album.ReleaseDate?.ToString("yyyy-MM-dd")</td>
                            <td class="px-4 py-3 text-center">
                                @if (album.IsDeleted)
                                {
                                    <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-red-50 text-red-700">حذف‌شده</span>
                                }
                                else
                                {
                                    <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-green-50 text-green-700">فعال</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-end">
                                <div class="flex items-center justify-end gap-2">
                                    @if (album.IsDeleted)
                                    {
                                        <form method="post" action="/admin/albums/@album.AlbumId/Restore" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="inline-flex items-center gap-1 px-2 py-1 text-xs text-green-600 hover:bg-green-50 rounded"
                                                    title="بازیابی">
                                                <i class="fas fa-undo"></i> بازیابی
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a href="/admin/albums/wizard/@album.AlbumId"
                                           class="inline-flex items-center gap-1 px-2 py-1 text-xs text-indigo-600 hover:bg-indigo-50 rounded"
                                           title="ویرایش با ویزارد">
                                            <i class="fas fa-wand-magic-sparkles"></i>
                                        </a>
                                        <a href="/admin/albums/@album.AlbumId/Edit"
                                           class="inline-flex items-center gap-1 px-2 py-1 text-xs text-blue-600 hover:bg-blue-50 rounded"
                                           title="ویرایش">
                                            <i class="fas fa-edit"></i> ویرایش
                                        </a>
                                        <form method="post" action="/admin/albums/@album.AlbumId/Delete"
                                              onsubmit="return confirm('Are you sure you want to delete this album? It can be restored later.');"
                                              class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="inline-flex items-center gap-1 px-2 py-1 text-xs text-red-600 hover:bg-red-50 rounded"
                                                    title="Soft delete">
                                                <i class="fas fa-trash-alt"></i> حذف
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- ============================================================
         Pagination (spec 10.4)
         ============================================================ -->
    @if (Model.Items.TotalPages > 1)
    {
        <div class="flex items-center justify-between px-4 py-3 bg-gray-50 border-t border-gray-200">
            <p class="text-sm text-gray-500">
                نمایش صفحه <strong>@Model.Items.Page</strong> از <strong>@Model.Items.TotalPages</strong>
                (@Model.Items.TotalItems total albums)
            </p>
            <nav class="flex items-center gap-1" aria-label="صفحه‌بندی">
                @if (Model.Items.Page > 1)
                {
                    <a href="/admin/albums?page=@(Model.Items.Page - 1)&q=@Model.SearchQuery"
                       class="px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-200 rounded">
                        <i class="fas fa-chevron-right"></i> قبلی
                    </a>
                }
                @if (Model.Items.Page < Model.Items.TotalPages)
                {
                    <a href="/admin/albums?page=@(Model.Items.Page + 1)&q=@Model.SearchQuery"
                       class="px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-200 rounded">
                        بعدی <i class="fas fa-chevron-left"></i>
                    </a>
                }
            </nav>
    </div>
}

@section Scripts {
    <script>
        (function () {
            const selectAll = document.getElementById('select-all');
            const checkboxes = Array.from(document.querySelectorAll('.row-checkbox'));
            const bulkSubmit = document.getElementById('bulk-submit');
            const bulkCount = document.getElementById('bulk-count');

            if (!selectAll || !bulkSubmit) { return; }

            function update() {
                const checked = checkboxes.filter(c => c.checked);
                bulkCount.textContent = checked.length + ' selected';
                bulkSubmit.disabled = checked.length === 0;
                bulkSubmit.className = checked.length === 0
                    ? 'inline-flex items-center gap-2 px-3 py-1.5 text-xs bg-gray-200 text-gray-500 rounded cursor-not-allowed transition-colors'
                    : 'inline-flex items-center gap-2 px-3 py-1.5 text-xs bg-red-600 text-white rounded hover:bg-red-700 transition-colors';
                selectAll.checked = checkboxes.length > 0 && checked.length === checkboxes.length;
                selectAll.indeterminate = checked.length > 0 && checked.length < checkboxes.length;
            }

            selectAll.addEventListener('change', function () {
                checkboxes.forEach(c => { c.checked = selectAll.checked; });
                update();
            });

            checkboxes.forEach(c => c.addEventListener('change', update));

            // Keep the bulk form's hidden inputs in sync with the selection.
            const bulkForm = document.getElementById('bulk-form');
            if (bulkForm) {
                bulkForm.addEventListener('submit', function (e) {
                    const checked = checkboxes.filter(c => c.checked).map(c => c.value);
                    if (checked.length === 0) { e.preventDefault(); return; }
                    // Keep only the selected ids as form fields.
                    checkboxes.forEach(c => c.removeAttribute('name'));
                    // Re-attach only the selected ids as form fields.
                    document.querySelectorAll('#bulk-form input[name="ids"]').forEach(i => i.remove());
                    checked.forEach(id => {
                        const input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'ids';
                        input.value = id;
                        bulkForm.appendChild(input);
                    });
                });
            }
        })();
    </script>
}
</div>

<!-- ============================================================
     Bulk Actions (spec 10.4)
     ============================================================ -->
@if (Model.Items.Items.Count > 0)
{
    <form id="bulk-form" method="post"
          action="@(Model.Deleted ? "/admin/albums/bulk-restore" : "/admin/albums/bulk-delete")"
          onsubmit="return confirm('@(Model.Deleted ? "Restore" : "Delete") the selected album(s)?');">
        @Html.AntiForgeryToken()
        <div class="mt-4 bg-white rounded-lg shadow-sm border border-gray-200 p-4">
            <h3 class="text-sm font-semibold text-gray-700 mb-2">
                <i class="fas fa-layer-group me-1 text-blue-600"></i> عملیات گروهی
            </h3>
            <div class="flex flex-wrap items-center gap-3">
                <span id="bulk-count" class="text-xs text-gray-500">0 انتخاب‌شده</span>
                <button id="bulk-submit" type="submit" disabled
                        class="inline-flex items-center gap-2 px-3 py-1.5 text-xs bg-gray-200 text-gray-500 rounded cursor-not-allowed transition-colors">
                    <i class="fas @(Model.Deleted ? "fa-undo" : "fa-trash-alt")"></i>
                    @(Model.Deleted ? "Bulk Restore" : "Bulk Soft Delete")
                </button>
            </div>
        </div>
    </form>
}
