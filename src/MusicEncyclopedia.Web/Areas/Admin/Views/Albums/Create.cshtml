@model AlbumEditViewModel
@{
    ViewData["Title"] = "ایجاد آلبوم";
    ViewData["ActiveMenu"] = "Albums";
}

<!-- ============================================================
     Create Album Form (spec 10.5)
     ============================================================ -->
<form method="post" action="/admin/albums/Create" enctype="application/x-www-form-urlencoded" class="admin-form">
    @Html.AntiForgeryToken()

    <!-- Validation Summary -->
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-error-soft border border-error-border text-error-hover text-sm" role="alert"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- ============================================================
             Main Column (Left / Center)
             ============================================================ -->
        <div class="lg:col-span-2 space-y-6">

            <!-- Basic Information -->
            <div class="admin-card admin-form-card">
                <h2 class="text-lg font-semibold text-ink mb-4">اطلاعات پایه</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Title -->
                    <div class="md:col-span-2">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" aria-live="polite" class="field-error"></span>
                    </div>

                    <!-- Title Sort -->
                    <div>
                        <label asp-for="TitleSort" class="form-label"></label>
                        <input asp-for="TitleSort" class="form-control" />
                        <span asp-validation-for="TitleSort" aria-live="polite" class="field-error"></span>
                    </div>

                    <!-- Slug -->
                    <div>
                        <label asp-for="Slug" class="form-label"></label>
                        <input asp-for="Slug" class="form-control" />
                        <span asp-validation-for="Slug" aria-live="polite" class="field-error"></span>
                    </div>

                    <!-- Original Title -->
                    <div>
                        <label asp-for="OriginalTitle" class="form-label"></label>
                        <input asp-for="OriginalTitle" class="form-control" />
                        <span asp-validation-for="OriginalTitle" aria-live="polite" class="field-error"></span>
                    </div>

                    <!-- English Title -->
                    <div>
                        <label asp-for="EnglishTitle" class="form-label"></label>
                        <input asp-for="EnglishTitle" class="form-control" />
                        <span asp-validation-for="EnglishTitle" aria-live="polite" class="field-error"></span>
                    </div>
                </div>
            </div>

            <!-- Classification -->
            <div class="admin-card admin-form-card">
                <h2 class="text-lg font-semibold text-ink mb-4">دسته‌بندی</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Category -->
                    <div>
                        <label asp-for="AlbumCategoryId" class="form-label"></label>
                        <select asp-for="AlbumCategoryId" class="form-control">
                            <option value="">-- انتخاب دسته‌بندی --</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.AlbumCategoryId">@cat.Name</option>
                            }
                        </select>
                        <span asp-validation-for="AlbumCategoryId" aria-live="polite" class="field-error"></span>
                    </div>

                    <!-- Is Official -->
                    <div class="flex items-end pb-2">
                        <label class="inline-flex items-center gap-2 cursor-pointer">
                            <input asp-for="IsOfficial" type="checkbox" class="rounded border-rule-strong text-accent focus-visible:ring-accent" />
                            <span class="text-sm text-ink-secondary">@Html.DisplayNameFor(m => m.IsOfficial)</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Dates -->
            <div class="admin-card admin-form-card">
                <h2 class="text-lg font-semibold text-ink mb-4">تاریخ‌ها</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Release Date -->
                    <div>
                        <label asp-for="ReleaseDate" class="form-label"></label>
                        <input asp-for="ReleaseDate" type="date" class="form-control" />
                        <span asp-validation-for="ReleaseDate" aria-live="polite" class="field-error"></span>
                    </div>

                    <!-- Release Date Precision -->
                    <div>
                        <label asp-for="ReleaseDatePrecision" class="form-label"></label>
                        <select asp-for="ReleaseDatePrecision" class="form-control">
                            <option value="">-- دقت --</option>
                            <option value="day">روز</option>
                            <option value="month">ماه</option>
                            <option value="year">سال</option>
                        </select>
                        <span asp-validation-for="ReleaseDatePrecision" aria-live="polite" class="field-error"></span>
                    </div>

                    <!-- Recording Start -->
                    <div>
                        <label asp-for="RecordingStartDate" class="form-label"></label>
                        <input asp-for="RecordingStartDate" type="date" class="form-control" />
                        <span asp-validation-for="RecordingStartDate" aria-live="polite" class="field-error"></span>
                    </div>

                    <!-- Recording End -->
                    <div>
                        <label asp-for="RecordingEndDate" class="form-label"></label>
                        <input asp-for="RecordingEndDate" type="date" class="form-control" />
                        <span asp-validation-for="RecordingEndDate" aria-live="polite" class="field-error"></span>
                    </div>

                    <!-- Recording Date Precision -->
                    <div>
                        <label asp-for="RecordingDatePrecision" class="form-label"></label>
                        <select asp-for="RecordingDatePrecision" class="form-control">
                            <option value="">-- دقت --</option>
                            <option value="day">روز</option>
                            <option value="month">ماه</option>
                            <option value="year">سال</option>
                        </select>
                        <span asp-validation-for="RecordingDatePrecision" aria-live="polite" class="field-error"></span>
                    </div>
                </div>
            </div>

            <!-- Description & Media -->
            <div class="admin-card admin-form-card">
                <h2 class="text-lg font-semibold text-ink mb-4">توضیحات و رسانه</h2>
                <div class="space-y-4">
                    <!-- Description -->
                    <div>
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" rows="5" class="form-control"></textarea>
                        <span asp-validation-for="Description" aria-live="polite" class="field-error"></span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Cover Media -->
                        <div>
                            <label asp-for="CoverMediaId" class="form-label"></label>
                            <input asp-for="CoverMediaId" type="number" class="form-control" placeholder="شناسه رسانه" />
                            <span asp-validation-for="CoverMediaId" aria-live="polite" class="field-error"></span>
                        </div>

                        <!-- Duration -->
                        <div>
                            <label asp-for="DurationSeconds" class="form-label"></label>
                            <input asp-for="DurationSeconds" type="number" class="form-control" placeholder="مدت به ثانیه" />
                            <span asp-validation-for="DurationSeconds" aria-live="polite" class="field-error"></span>
                        </div>

                        <!-- Copyright -->
                        <div class="md:col-span-2">
                            <label asp-for="CopyrightNotice" class="form-label"></label>
                            <input asp-for="CopyrightNotice" class="form-control" />
                            <span asp-validation-for="CopyrightNotice" aria-live="polite" class="field-error"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================
             Sidebar Column (Right)
             ============================================================ -->
        <div class="space-y-6">

            <!-- Publish / Save -->
            <div class="admin-card admin-form-card">
                <h2 class="text-lg font-semibold text-ink mb-4">انتشار</h2>
                <div class="space-y-3">
                    <button type="submit"
                            class="w-full px-4 py-2.5 bg-accent text-on-accent text-sm font-medium rounded-md hover:bg-accent-hover transition-colors flex items-center justify-center gap-2">
                        <i aria-hidden="true" class="fas fa-save"></i> ایجاد آلبوم
                    </button>
                    <a href="/admin/albums"
                       class="w-full block text-center px-4 py-2.5 text-sm text-ink-secondary bg-paper-muted rounded-md hover:bg-rule transition-colors">
                        انصراف
                    </a>
                </div>
            </div>

            <!-- Info Card -->
            <div class="admin-card admin-form-card">
                <h2 class="text-sm font-semibold text-ink-secondary mb-2">درباره ایجاد آلبوم</h2>
                <ul class="text-xs text-ink-muted space-y-1 list-disc list-inside">
                    <li>تمام فیلدهای مشخص‌شده با * الزامی هستند.</li>
                    <li>در صورت خالی بودن، Slug به‌صورت خودکار از عنوان ساخته می‌شود.</li>
                    <li>مدت به ثانیه مشخص می‌شود.</li>
                    <li>پس از ایجاد، می‌توانید سبک‌ها، حالت‌ها، ترک‌ها و موارد دیگر را در صفحه ویرایش مدیریت کنید.</li>
                </ul>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
