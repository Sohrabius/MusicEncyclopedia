@model AlbumEditViewModel
@{
    ViewData["Title"] = "Create Album";
    ViewData["ActiveMenu"] = "Albums";
}

<!-- ============================================================
     Create Album Form (spec 10.5)
     ============================================================ -->
<form method="post" action="/admin/albums/Create" enctype="application/x-www-form-urlencoded">
    @Html.AntiForgeryToken()

    <!-- Validation Summary -->
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-red-50 border border-red-200 text-red-800 text-sm" role="alert"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- ============================================================
             Main Column (Left / Center)
             ============================================================ -->
        <div class="lg:col-span-2 space-y-6">

            <!-- Basic Information -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Basic Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Title -->
                    <div class="md:col-span-2">
                        <label asp-for="Title" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="Title" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <span asp-validation-for="Title" class="text-xs text-red-600"></span>
                    </div>

                    <!-- Title Sort -->
                    <div>
                        <label asp-for="TitleSort" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="TitleSort" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <span asp-validation-for="TitleSort" class="text-xs text-red-600"></span>
                    </div>

                    <!-- Slug -->
                    <div>
                        <label asp-for="Slug" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="Slug" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <span asp-validation-for="Slug" class="text-xs text-red-600"></span>
                    </div>

                    <!-- Original Title -->
                    <div>
                        <label asp-for="OriginalTitle" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="OriginalTitle" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <span asp-validation-for="OriginalTitle" class="text-xs text-red-600"></span>
                    </div>

                    <!-- English Title -->
                    <div>
                        <label asp-for="EnglishTitle" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="EnglishTitle" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <span asp-validation-for="EnglishTitle" class="text-xs text-red-600"></span>
                    </div>
                </div>
            </div>

            <!-- Classification -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Classification</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Category -->
                    <div>
                        <label asp-for="AlbumCategoryId" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <select asp-for="AlbumCategoryId" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">-- Select Category --</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.AlbumCategoryId">@cat.Name</option>
                            }
                        </select>
                        <span asp-validation-for="AlbumCategoryId" class="text-xs text-red-600"></span>
                    </div>

                    <!-- Is Official -->
                    <div class="flex items-end pb-2">
                        <label class="inline-flex items-center gap-2 cursor-pointer">
                            <input asp-for="IsOfficial" type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                            <span class="text-sm text-gray-700">@Html.DisplayNameFor(m => m.IsOfficial)</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Dates -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Dates</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Release Date -->
                    <div>
                        <label asp-for="ReleaseDate" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="ReleaseDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <span asp-validation-for="ReleaseDate" class="text-xs text-red-600"></span>
                    </div>

                    <!-- Release Date Precision -->
                    <div>
                        <label asp-for="ReleaseDatePrecision" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <select asp-for="ReleaseDatePrecision" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">-- Precision --</option>
                            <option value="day">Day</option>
                            <option value="month">Month</option>
                            <option value="year">Year</option>
                        </select>
                        <span asp-validation-for="ReleaseDatePrecision" class="text-xs text-red-600"></span>
                    </div>

                    <!-- Recording Start -->
                    <div>
                        <label asp-for="RecordingStartDate" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="RecordingStartDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <span asp-validation-for="RecordingStartDate" class="text-xs text-red-600"></span>
                    </div>

                    <!-- Recording End -->
                    <div>
                        <label asp-for="RecordingEndDate" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="RecordingEndDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                        <span asp-validation-for="RecordingEndDate" class="text-xs text-red-600"></span>
                    </div>

                    <!-- Recording Date Precision -->
                    <div>
                        <label asp-for="RecordingDatePrecision" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <select asp-for="RecordingDatePrecision" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">-- Precision --</option>
                            <option value="day">Day</option>
                            <option value="month">Month</option>
                            <option value="year">Year</option>
                        </select>
                        <span asp-validation-for="RecordingDatePrecision" class="text-xs text-red-600"></span>
                    </div>
                </div>
            </div>

            <!-- Description & Media -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Description & Media</h2>
                <div class="space-y-4">
                    <!-- Description -->
                    <div>
                        <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <textarea asp-for="Description" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
                        <span asp-validation-for="Description" class="text-xs text-red-600"></span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Cover Media -->
                        <div>
                            <label asp-for="CoverMediaId" class="block text-sm font-medium text-gray-700 mb-1"></label>
                            <input asp-for="CoverMediaId" type="number" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Media ID" />
                            <span asp-validation-for="CoverMediaId" class="text-xs text-red-600"></span>
                        </div>

                        <!-- Duration -->
                        <div>
                            <label asp-for="DurationSeconds" class="block text-sm font-medium text-gray-700 mb-1"></label>
                            <input asp-for="DurationSeconds" type="number" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Duration in seconds" />
                            <span asp-validation-for="DurationSeconds" class="text-xs text-red-600"></span>
                        </div>

                        <!-- Copyright -->
                        <div class="md:col-span-2">
                            <label asp-for="CopyrightNotice" class="block text-sm font-medium text-gray-700 mb-1"></label>
                            <input asp-for="CopyrightNotice" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                            <span asp-validation-for="CopyrightNotice" class="text-xs text-red-600"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================
             Sidebar Column (Right)
             ============================================================ -->
        <div class="space-y-6">

            <!-- Publish / Save -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Publish</h2>
                <div class="space-y-3">
                    <button type="submit"
                            class="w-full px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 transition-colors flex items-center justify-center gap-2">
                        <i class="fas fa-save"></i> Create Album
                    </button>
                    <a href="/admin/albums"
                       class="w-full block text-center px-4 py-2.5 text-sm text-gray-600 bg-gray-100 rounded-md hover:bg-gray-200 transition-colors">
                        Cancel
                    </a>
                </div>
            </div>

            <!-- Info Card -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <h2 class="text-sm font-semibold text-gray-700 mb-2">About Album Creation</h2>
                <ul class="text-xs text-gray-500 space-y-1 list-disc list-inside">
                    <li>All fields marked with * are required.</li>
                    <li>The slug is auto-generated from the title if left empty.</li>
                    <li>Duration is specified in total seconds.</li>
                    <li>After creation, you can manage genres, moods, tracks, and more on the edit page.</li>
                </ul>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
