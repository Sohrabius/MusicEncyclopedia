@model LocalizationEditViewModel
@{
    ViewData["Title"] = "ایجاد بومی‌سازی";
    ViewData["ActiveMenu"] = "Localizations";
}

<form method="post" action="/admin/localizations/Create">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="mb-4 px-4 py-3 rounded-md bg-error-soft border border-error-border text-error-hover text-sm" role="alert"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">بومی‌سازی جزئیات</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="EntityTypeId" class="form-label"></label>
                        <select asp-for="EntityTypeId" class="form-control">
                            <option value="">-- انتخاب نوع موجودیت --</option>
                            @foreach (var et in Model.EntityTypes)
                            {
                                <option value="@et.EntityTypeId">@et.Name (@et.Code)</option>
                            }
                        </select>
                        <span asp-validation-for="EntityTypeId" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="EntityId" class="form-label"></label>
                        <input asp-for="EntityId" type="number" class="form-control" placeholder="شناسه موجودیت" />
                        <span asp-validation-for="EntityId" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="LanguageId" class="form-label"></label>
                        <select asp-for="LanguageId" class="form-control">
                            <option value="">-- انتخاب زبان --</option>
                            @foreach (var lang in Model.Languages)
                            {
                                <option value="@lang.LanguageId">@lang.Name (@lang.Code)</option>
                            }
                        </select>
                        <span asp-validation-for="LanguageId" aria-live="polite" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="FieldName" class="form-label"></label>
                        <input asp-for="FieldName" class="form-control" placeholder="مثلاً عنوان, توضیحات" />
                        <span asp-validation-for="FieldName" aria-live="polite" class="field-error"></span>
                    </div>
                </div>
            </div>
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">متن بومی‌شده</h2>
                <div>
                    <label asp-for="LocalizedText" class="form-label"></label>
                    <textarea asp-for="LocalizedText" rows="6" class="form-control"></textarea>
                    <span asp-validation-for="LocalizedText" aria-live="polite" class="field-error"></span>
                </div>
            </div>
        </div>
        <div class="space-y-6">
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-lg font-semibold text-ink mb-4">انتشار</h2>
                <button type="submit" class="w-full px-4 py-2.5 bg-accent text-on-accent text-sm font-medium rounded-md hover:bg-accent-hover transition-colors flex items-center justify-center gap-2"><i aria-hidden="true" class="fas fa-save"></i> ایجاد بومی‌سازی</button>
                <a href="/admin/localizations" class="w-full block text-center mt-3 px-4 py-2.5 text-sm text-ink-secondary bg-paper-muted rounded-md hover:bg-rule transition-colors">انصراف</a>
            </div>
            <div class="bg-surface rounded-lg shadow-sm border border-rule p-5">
                <h2 class="text-sm font-semibold text-ink-secondary mb-2">درباره بومی‌سازی‌ها</h2>
                <ul class="text-xs text-ink-muted space-y-1 list-disc list-inside">
                    <li>بومی‌سازی‌ها مقادیر ترجمه‌شده فیلدها را برای موجودیت‌ها ذخیره می‌کنند.</li>
                    <li>نوع موجودیت و شناسه را برای مرتبط‌کردن این ترجمه انتخاب کنید.</li>
                    <li>نام فیلد باید با نام ویژگی مطابقت داشته باشد (مثلاً, "عنوان", "توضیحات").</li>
                </ul>
            </div>
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
